@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/DiseaseEnhancerOntology>
  a owl:Ontology ;
  rdfs:label "Disease Enhancer Ontology" ;
  skos:prefLabel "Disease Enhancer Ontology" ;
  skos:definition "An ontology for describing disease-associated enhancers.".

<owl:Class rdf:ID="Enhancer">
  a owl:Class ;
  rdfs:label "Enhancer" ;
  skos:prefLabel "Enhancer" ;
  skos:definition "A regulatory DNA sequence that modulates gene expression.".
</owl:Class>

<owl:Class rdf:ID="GenomicCoordinate">
  a owl:Class ;
  rdfs:label "Genomic Coordinate" ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "A location on the genome, typically represented as a pair of coordinates (start and end).".
</owl:Class>

<owl:ObjectProperty rdf:ID="hasGenomicCoordinate">
  a owl:ObjectProperty ;
  rdfs:label "Has Genomic Coordinate" ;
  skos:prefLabel "Has Genomic Coordinate" ;
  skos:definition "The relationship between an enhancer and its genomic coordinates.".
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:ID="genomicCoordinate">
  a owl:DatatypeProperty ;
  rdfs:label "Genomic Coordinate" ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "The actual value of the genomic coordinate." ;
  obo:synonym "chromosome, start, end" .
</owl:DatatypeProperty>

<owl:ObjectProperty rdf:ID="hasEvidence">
  a owl:ObjectProperty ;
  rdfs:label "Has Evidence" ;
  skos:prefLabel "Has Evidence" ;
  skos:definition "The relationship between an enhancer and its supporting evidence.".
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:ID="evidencePMID">
  a owl:DatatypeProperty ;
  rdfs:label "Evidence PMID" ;
  skos:prefLabel "Evidence PMID" ;
  skos:definition "The PubMed ID of the study supporting the enhancer.".
</owl:DatatypeProperty>

<owl:ObjectProperty rdf:ID="hasTargetGene">
  a owl:ObjectProperty ;
  rdfs:label "Has Target Gene" ;
  skos:prefLabel "Has Target Gene" ;
  skos:definition "The relationship between an enhancer and its target gene.".
</owl:ObjectProperty>

<owl:Class rdf:ID="Disease">
  a owl:Class ;
  rdfs:label "Disease" ;
  skos:prefLabel "Disease" ;
  skos:definition "A medical condition caused by genetic or environmental factors.".
</owl:Class>

<owl:ObjectProperty rdf:ID="associatedWithDisease">
  a owl:ObjectProperty ;
  rdfs:label "Associated with Disease" ;
  skos:prefLabel "Associated with Disease" ;
  skos:definition "The relationship between an enhancer and the disease it is associated with.".
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:ID="diseasePMID">
  a owl:DatatypeProperty ;
  rdfs:label "Disease PMID" ;
  skos:prefLabel "Disease PMID" ;
  skos:definition "The PubMed ID of the study linking the enhancer to the disease.".
</owl:DatatypeProperty>

<owl:ObjectProperty rdf:ID="hasTranscriptionFactor">
  a owl:ObjectProperty ;
  rdfs:label "Has Transcription Factor" ;
  skos:prefLabel "Has Transcription Factor" ;
  skos:definition "The relationship between an enhancer and the transcription factors it interacts with.".
</owl:ObjectProperty>

<owl:Class rdf:ID="TranscriptionFactor">
  a owl:Class ;
  rdfs:label "Transcription Factor" ;
  skos:prefLabel "Transcription Factor" ;
  skos:definition "A protein that regulates gene expression by binding to specific DNA sequences.".
</owl:Class>

<owl:ObjectProperty rdf:ID="interactsWith">
  a owl:ObjectProperty ;
  rdfs:label "Interacts with" ;
  skos:prefLabel "Interacts with" ;
  skos:definition "The relationship between two transcription factors.".
</owl:ObjectProperty>