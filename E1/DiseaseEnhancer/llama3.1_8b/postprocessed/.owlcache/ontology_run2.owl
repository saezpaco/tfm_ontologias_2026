<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/HasGenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has Genomic Coordinate</rdfs:label>
    <skos:prefLabel>Has Genomic Coordinate</skos:prefLabel>
    <skos:definition>The enhancer has the genomic coordinate.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://example.org/GenomicCoordinate"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Chr">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Chromosome</rdfs:label>
    <skos:prefLabel>Chromosome</skos:prefLabel>
    <skos:definition>The chromosome on which the enhancer is located.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/IsEvidenceFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Is Evidence For</rdfs:label>
    <skos:prefLabel>Is Evidence For</skos:prefLabel>
    <skos:definition>The evidence is for the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Evidence"/>
    <rdfs:range rdf:resource="http://example.org/CrmEnhancer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Start">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Start Coordinate</rdfs:label>
    <skos:prefLabel>Start Coordinate</skos:prefLabel>
    <skos:definition>The start coordinate of the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/End">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>End Coordinate</rdfs:label>
    <skos:prefLabel>End Coordinate</skos:prefLabel>
    <skos:definition>The end coordinate of the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/CurrentAssembly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Current Genome Assembly</rdfs:label>
    <skos:prefLabel>Current Genome Assembly</skos:prefLabel>
    <skos:definition>The current genome assembly used for the enhancer coordinates.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/CurrentChr">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Current Chromosome</rdfs:label>
    <skos:prefLabel>Current Chromosome</skos:prefLabel>
    <skos:definition>The current chromosome on which the enhancer is located.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Assembly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Genome Assembly</rdfs:label>
    <skos:prefLabel>Genome Assembly</skos:prefLabel>
    <skos:definition>The genome assembly used for the enhancer coordinates.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/MinimumRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Minimum Ratio</rdfs:label>
    <skos:prefLabel>Minimum Ratio</skos:prefLabel>
    <skos:definition>The minimum ratio of the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Evidence</rdfs:label>
    <skos:prefLabel>Evidence</skos:prefLabel>
    <skos:definition>The evidence for the enhancer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/CurrentEnd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Current End Coordinate</rdfs:label>
    <skos:prefLabel>Current End Coordinate</skos:prefLabel>
    <skos:definition>The current end coordinate of the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/DiseaseEnhancerOntology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Disease Enhancer Ontology</rdfs:label>
    <skos:prefLabel>Disease Enhancer Ontology</skos:prefLabel>
    <skos:definition>An ontology for describing enhancers associated with diseases.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/CurrentStart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Current Start Coordinate</rdfs:label>
    <skos:prefLabel>Current Start Coordinate</skos:prefLabel>
    <skos:definition>The current start coordinate of the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/PubMedId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>PubMed ID</rdfs:label>
    <skos:prefLabel>PubMed ID</skos:prefLabel>
    <skos:definition>The PubMed ID of the evidence.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Evidence"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/GenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Genomic Coordinate</rdfs:label>
    <skos:prefLabel>Genomic Coordinate</skos:prefLabel>
    <skos:definition>A location on the genome.</skos:definition>
    <rdfs:subClassOf rdf:resource="obo:SO_0000163"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/CrmEnhancer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cis-Regulatory Module/Enhancer</rdfs:label>
    <skos:prefLabel>Cis-Regulatory Module/Enhancer</skos:prefLabel>
    <skos:definition>A region of DNA that modulates the transcription rate of its target genes.</skos:definition>
    <rdfs:subClassOf rdf:resource="obo:SO_0000163"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/TargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Target Gene</rdfs:label>
    <skos:prefLabel>Target Gene</skos:prefLabel>
    <skos:definition>The target gene of the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="obo:SO_0000163"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/AssociatedDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Associated Disease</rdfs:label>
    <skos:prefLabel>Associated Disease</skos:prefLabel>
    <skos:definition>The disease associated with the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="obo:DOID_0000068"/>
  </rdf:Description>
</rdf:RDF>
