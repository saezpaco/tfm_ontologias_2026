<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/CrmEnhancer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cis-Regulatory Module (CRM) / Enhancer</rdfs:label>
    <skos:prefLabel>Cis-Regulatory Module (CRM) / Enhancer</skos:prefLabel>
    <skos:definition>A region of DNA that modulates the transcription rate of its target genes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/obo:SO_0000739">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cis-Regulatory Module (CRM)</rdfs:label>
    <skos:prefLabel>Cis-Regulatory Module (CRM)</skos:prefLabel>
    <skos:definition>A region of DNA that modulates the transcription rate of its target genes.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://example.org/CrmEnhancer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/EnhancerSequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>enhancer sequence</rdfs:label>
    <skos:prefLabel>enhancer sequence</skos:prefLabel>
    <skos:definition>The DNA sequence that makes up the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://example.org/GenomicCoordinate"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Disease</rdfs:label>
    <skos:prefLabel>Disease</skos:prefLabel>
    <skos:definition>A medical condition that affects an individual.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/GenomicCoordinateStart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>genomic coordinate start</rdfs:label>
    <skos:prefLabel>genomic coordinate start</skos:prefLabel>
    <skos:definition>The starting position of the genomic coordinate.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/AssociatedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>associated with</rdfs:label>
    <skos:prefLabel>associated with</skos:prefLabel>
    <skos:definition>The relationship between an enhancer and the disease it is associated with.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://example.org/Disease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Assembly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>assembly</rdfs:label>
    <skos:prefLabel>assembly</skos:prefLabel>
    <skos:definition>The assembly version of the genomic coordinate.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Evidence</rdfs:label>
    <skos:prefLabel>Evidence</skos:prefLabel>
    <skos:definition>A piece of information that supports the existence or functionality of an enhancer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/obo:GO_0045893">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>positive regulation of transcription</rdfs:label>
    <skos:prefLabel>positive regulation of transcription</skos:prefLabel>
    <skos:definition>The process by which an enhancer modulates the transcription rate of its target gene.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://example.org/ModulatesTranscription"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/HasSkosMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has skos match</rdfs:label>
    <skos:prefLabel>has skos match</skos:prefLabel>
    <skos:definition>The relationship between an enhancer and its corresponding SKOS concept.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/DiseaseEnhancerOntology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Disease Enhancer Ontology</rdfs:label>
    <skos:prefLabel>Disease Enhancer Ontology</skos:prefLabel>
    <skos:definition>An ontology for describing enhancers associated with diseases.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ModulatesTranscription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>modulates transcription</rdfs:label>
    <skos:prefLabel>modulates transcription</skos:prefLabel>
    <skos:definition>The relationship between an enhancer and its target gene, where the enhancer modulates the transcription rate of the target gene.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://example.org/TargetGene"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/GenomicCoordinateEnd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>genomic coordinate end</rdfs:label>
    <skos:prefLabel>genomic coordinate end</skos:prefLabel>
    <skos:definition>The ending position of the genomic coordinate.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/TargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Target Gene</rdfs:label>
    <skos:prefLabel>Target Gene</skos:prefLabel>
    <skos:definition>A gene whose transcription is modulated by the enhancer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/GenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Genomic Coordinate</rdfs:label>
    <skos:prefLabel>Genomic Coordinate</skos:prefLabel>
    <skos:definition>A location on a chromosome, typically represented as a pair of integers (start and end).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/HasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has evidence</rdfs:label>
    <skos:prefLabel>has evidence</skos:prefLabel>
    <skos:definition>The relationship between an enhancer and its associated evidence.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/CrmEnhancer"/>
    <rdfs:range rdf:resource="http://example.org/Evidence"/>
  </rdf:Description>
</rdf:RDF>
