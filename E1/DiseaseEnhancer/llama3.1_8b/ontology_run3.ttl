@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/DiseaseEnhancerOntology>
  a owl:Ontology ;
  rdfs:label "Disease Enhancer Ontology" ;
  skos:prefLabel "Disease Enhancer Ontology" ;
  skos:definition "An ontology for describing enhancers associated with diseases." .

<http://example.org/CrmEnhancer>
  a owl:Class ;
  rdfs:label "Cis-Regulatory Module (CRM) / Enhancer" ;
  skos:prefLabel "Cis-Regulatory Module (CRM) / Enhancer" ;
  skos:definition "A region of DNA that modulates the transcription rate of its target genes." .

<http://example.org/GenomicCoordinate>
  a owl:Class ;
  rdfs:label "Genomic Coordinate" ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "A location on a chromosome, typically represented as a pair of integers (start and end)." .

<http://example.org/EnhancerSequence>
  a owl:ObjectProperty ;
  rdfs:label "enhancer sequence" ;
  skos:prefLabel "enhancer sequence" ;
  skos:definition "The DNA sequence that makes up the enhancer." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range <http://example.org/GenomicCoordinate> .

<http://example.org/TargetGene>
  a owl:Class ;
  rdfs:label "Target Gene" ;
  skos:prefLabel "Target Gene" ;
  skos:definition "A gene whose transcription is modulated by the enhancer." .

<http://example.org/ModulatesTranscription>
  a owl:ObjectProperty ;
  rdfs:label "modulates transcription" ;
  skos:prefLabel "modulates transcription" ;
  skos:definition "The relationship between an enhancer and its target gene, where the enhancer modulates the transcription rate of the target gene." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range <http://example.org/TargetGene> .

<http://example.org/Evidence>
  a owl:Class ;
  rdfs:label "Evidence" ;
  skos:prefLabel "Evidence" ;
  skos:definition "A piece of information that supports the existence or functionality of an enhancer." .

<http://example.org/HasEvidence>
  a owl:ObjectProperty ;
  rdfs:label "has evidence" ;
  skos:prefLabel "has evidence" ;
  skos:definition "The relationship between an enhancer and its associated evidence." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range <http://example.org/Evidence> .

<http://example.org/GenomicCoordinateStart>
  a owl:DatatypeProperty ;
  rdfs:label "genomic coordinate start" ;
  skos:prefLabel "genomic coordinate start" ;
  skos:definition "The starting position of the genomic coordinate." ;
  rdfs:domain <http://example.org/GenomicCoordinate> ;
  rdfs:range xsd:int .

<http://example.org/GenomicCoordinateEnd>
  a owl:DatatypeProperty ;
  rdfs:label "genomic coordinate end" ;
  skos:prefLabel "genomic coordinate end" ;
  skos:definition "The ending position of the genomic coordinate." ;
  rdfs:domain <http://example.org/GenomicCoordinate> ;
  rdfs:range xsd:int .

<http://example.org/Assembly>
  a owl:DatatypeProperty ;
  rdfs:label "assembly" ;
  skos:prefLabel "assembly" ;
  skos:definition "The assembly version of the genomic coordinate." ;
  rdfs:domain <http://example.org/GenomicCoordinate> ;
  rdfs:range xsd:string .

<http://example.org/Disease>
  a owl:Class ;
  rdfs:label "Disease" ;
  skos:prefLabel "Disease" ;
  skos:definition "A medical condition that affects an individual." .

<http://example.org/AssociatedWith>
  a owl:ObjectProperty ;
  rdfs:label "associated with" ;
  skos:prefLabel "associated with" ;
  skos:definition "The relationship between an enhancer and the disease it is associated with." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range <http://example.org/Disease> .

<http://example.org/HasSkosMatch>
  a owl:ObjectProperty ;
  rdfs:label "has skos match" ;
  skos:prefLabel "has skos match" ;
  skos:definition "The relationship between an enhancer and its corresponding SKOS concept." ;
  rdfs:domain <http://example.org/CrmEnhancer> .

<http://example.org/obo:SO_0000739>
  a owl:Class ;
  rdfs:label "Cis-Regulatory Module (CRM)" ;
  skos:prefLabel "Cis-Regulatory Module (CRM)" ;
  skos:definition "A region of DNA that modulates the transcription rate of its target genes." .

<http://example.org/obo:SO_0000739>
  rdfs:subClassOf <http://example.org/CrmEnhancer> .

<http://example.org/obo:GO_0045893>
  a owl:Class ;
  rdfs:label "positive regulation of transcription" ;
  skos:prefLabel "positive regulation of transcription" ;
  skos:definition "The process by which an enhancer modulates the transcription rate of its target gene." .

<http://example.org/obo:GO_0045893>
  rdfs:subClassOf <http://example.org/ModulatesTranscription> .