@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/DiseaseEnhancerOntology>
  a owl:Ontology ;
  rdfs:label "Disease Enhancer Ontology" ;
  skos:prefLabel "Disease Enhancer Ontology" ;
  skos:definition "An ontology for describing enhancers associated with diseases." .

<http://example.org/CrmEnhancer>
  a owl:Class ;
  rdfs:label "Cis-Regulatory Module/Enhancer" ;
  skos:prefLabel "Cis-Regulatory Module/Enhancer" ;
  skos:definition "A region of DNA that modulates the transcription rate of its target genes." .

<http://example.org/CrmEnhancer>
  rdfs:subClassOf <obo:SO_0000163> .

<http://example.org/GenomicCoordinate>
  a owl:Class ;
  rdfs:label "Genomic Coordinate" ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "A location on the genome." .

<http://example.org/GenomicCoordinate>
  rdfs:subClassOf <obo:SO_0000163> .

<http://example.org/Chr>
  a owl:DatatypeProperty ;
  rdfs:label "Chromosome" ;
  skos:prefLabel "Chromosome" ;
  skos:definition "The chromosome on which the enhancer is located." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range xsd:string .

<http://example.org/Start>
  a owl:DatatypeProperty ;
  rdfs:label "Start Coordinate" ;
  skos:prefLabel "Start Coordinate" ;
  skos:definition "The start coordinate of the enhancer." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range xsd:integer .

<http://example.org/End>
  a owl:DatatypeProperty ;
  rdfs:label "End Coordinate" ;
  skos:prefLabel "End Coordinate" ;
  skos:definition "The end coordinate of the enhancer." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range xsd:integer .

<http://example.org/Assembly>
  a owl:DatatypeProperty ;
  rdfs:label "Genome Assembly" ;
  skos:prefLabel "Genome Assembly" ;
  skos:definition "The genome assembly used for the enhancer coordinates." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range xsd:string .

<http://example.org/CurrentChr>
  a owl:DatatypeProperty ;
  rdfs:label "Current Chromosome" ;
  skos:prefLabel "Current Chromosome" ;
  skos:definition "The current chromosome on which the enhancer is located." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range xsd:string .

<http://example.org/CurrentStart>
  a owl:DatatypeProperty ;
  rdfs:label "Current Start Coordinate" ;
  skos:prefLabel "Current Start Coordinate" ;
  skos:definition "The current start coordinate of the enhancer." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range xsd:integer .

<http://example.org/CurrentEnd>
  a owl:DatatypeProperty ;
  rdfs:label "Current End Coordinate" ;
  skos:prefLabel "Current End Coordinate" ;
  skos:definition "The current end coordinate of the enhancer." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range xsd:integer .

<http://example.org/CurrentAssembly>
  a owl:DatatypeProperty ;
  rdfs:label "Current Genome Assembly" ;
  skos:prefLabel "Current Genome Assembly" ;
  skos:definition "The current genome assembly used for the enhancer coordinates." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range xsd:string .

<http://example.org/MinimumRatio>
  a owl:DatatypeProperty ;
  rdfs:label "Minimum Ratio" ;
  skos:prefLabel "Minimum Ratio" ;
  skos:definition "The minimum ratio of the enhancer." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range xsd:float .

<http://example.org/Evidence>
  a owl:Class ;
  rdfs:label "Evidence" ;
  skos:prefLabel "Evidence" ;
  skos:definition "The evidence for the enhancer." .

<http://example.org/PubMedId>
  a owl:DatatypeProperty ;
  rdfs:label "PubMed ID" ;
  skos:prefLabel "PubMed ID" ;
  skos:definition "The PubMed ID of the evidence." ;
  rdfs:domain <http://example.org/Evidence> ;
  rdfs:range xsd:string .

<http://example.org/TargetGene>
  a owl:ObjectProperty ;
  rdfs:label "Target Gene" ;
  skos:prefLabel "Target Gene" ;
  skos:definition "The target gene of the enhancer." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range <obo:SO_0000163> .

<http://example.org/AssociatedDisease>
  a owl:ObjectProperty ;
  rdfs:label "Associated Disease" ;
  skos:prefLabel "Associated Disease" ;
  skos:definition "The disease associated with the enhancer." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range <obo:DOID_0000068> .

<http://example.org/HasGenomicCoordinate>
  a owl:ObjectProperty ;
  rdfs:label "Has Genomic Coordinate" ;
  skos:prefLabel "Has Genomic Coordinate" ;
  skos:definition "The enhancer has the genomic coordinate." ;
  rdfs:domain <http://example.org/CrmEnhancer> ;
  rdfs:range <http://example.org/GenomicCoordinate> .

<http://example.org/IsEvidenceFor>
  a owl:ObjectProperty ;
  rdfs:label "Is Evidence For" ;
  skos:prefLabel "Is Evidence For" ;
  skos:definition "The evidence is for the enhancer." ;
  rdfs:domain <http://example.org/Evidence> ;
  rdfs:range <http://example.org/CrmEnhancer> .