<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cis-Regulatory Module</skos:prefLabel>
    <skos:definition>A genomic region that regulates the expression of genes, often containing multiple binding sites for transcription factors.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000165"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Disease</skos:prefLabel>
    <skos:definition>A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasGenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has genomic coordinate</skos:prefLabel>
    <skos:definition>Specifies the genomic coordinates of a sequence.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/Enhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gene</skos:prefLabel>
    <skos:definition>A sequence of DNA that contains the necessary information to produce a functional product, typically a protein.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000704"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/Enhancer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Enhancer</skos:prefLabel>
    <skos:definition>A short region of DNA that can increase transcription of genes.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000165"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>associated with disease</skos:prefLabel>
    <skos:definition>Relates an enhancer to a disease it is associated with.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/Enhancer"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/Disease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>has target gene</skos:prefLabel>
    <skos:definition>Relates an enhancer to its target gene.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/Enhancer"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasEvidencePMID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has evidence PMID</skos:prefLabel>
    <skos:definition>Specifies the PubMed ID for the evidence supporting the enhancer's function.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/Enhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has score</skos:prefLabel>
    <skos:definition>Specifies the score indicating the confidence or strength of the enhancer's activity.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/Enhancer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
</rdf:RDF>
