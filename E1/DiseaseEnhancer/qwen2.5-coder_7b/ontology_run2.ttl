@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "CRM Enhancer Ontology" ;
    skos:definition "An ontology for representing CRM enhancers and their properties." ;
}

crm:Enhancer a owl:Class ;
    rdfs:subClassOf obo:SO_0001217 ;
    skos:prefLabel "CRM enhancer" ;
    skos:definition "A region of DNA that enhances the transcription of a CRM gene." .

crm:GenomicCoordinate a owl:Class ;
    skos:prefLabel "Genomic coordinate" ;
    skos:definition "A specific location on a chromosome." .

crm:startCoordinate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Coordinate" ;
    skos:definition "The starting position of the genomic coordinate on the chromosome." .

crm:endCoordinate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Coordinate" ;
    skos:definition "The ending position of the genomic coordinate on the chromosome." .

crm:evidence a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:Evidence ;
    skos:prefLabel "Evidence" ;
    skos:definition "Supporting evidence for the existence or function of an enhancer." .

crm:Evidence a owl:Class ;
    skos:prefLabel "Evidence" ;
    skos:definition "Information that supports a conclusion or hypothesis." .

crm:evidenceType a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range obo:GO_0012501 ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of evidence supporting the enhancer's function." .

crm:evidenceSource a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Source" ;
    skos:definition "The source or reference where the evidence is found." .