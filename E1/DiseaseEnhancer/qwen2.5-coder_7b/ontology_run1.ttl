@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology {
    skos:prefLabel "CRM Enhancer Ontology";
    skos:definition "An ontology for representing CRM enhancers and their properties.";
}

crm:Enhancer a owl:Class ;
    rdfs:subClassOf obo:BFO_0000061 ;  # Biological entity
    skos:prefLabel "CRM Enhancer";
    skos:definition "A genomic region that enhances the transcription of CRM genes.";

crm:startCoordinate a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Coordinate";
    skos:definition "The starting base pair position of the enhancer on the chromosome.";

crm:endCoordinate a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Coordinate";
    skos:definition "The ending base pair position of the enhancer on the chromosome.";

crm:evidence a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:EFO_0001234 ;  # Evidence
    skos:prefLabel "Evidence";
    skos:definition "Supporting evidence for the enhancer's function.";

crm:evidenceType a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range obo:GO_0008279 ;  # Experimental method
    skos:prefLabel "Evidence Type";
    skos:definition "The type of experimental evidence supporting the enhancer's function.";

crm:evidenceSource a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Source";
    skos:definition "The source of the evidence, such as a publication or experiment."

crm:geneEnhanced a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001217 ;  # Gene
    skos:prefLabel "Gene Enhanced";
    skos:definition "The gene that is enhanced by the enhancer.";

crm:enhancedBy a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001217 ;  # Gene
    skos:prefLabel "Enhanced By";
    skos:definition "The gene that enhances the enhancer.";

crm:enhancementLevel a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "Enhancement Level";
    skos:definition "The level of enhancement provided by the enhancer."

crm:enhancementMechanism a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0008279 ;  # Biological process
    skos:prefLabel "Enhancement Mechanism";
    skos:definition "The biological mechanism by which the enhancer enhances gene expression."

crm:enhancerType a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001217 ;  # Enhancer type
    skos:prefLabel "Enhancer Type";
    skos:definition "The type of enhancer, such as a promoter or insulator."

crm:enhancerLocation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001217 ;  # Chromosomal location
    skos:prefLabel "Enhancer Location";
    skos:definition "The chromosomal location of the enhancer."

crm:enhancerOrientation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001217 ;  # Orientation
    skos:prefLabel "Enhancer Orientation";
    skos:definition "The orientation of the enhancer on the chromosome."

crm:enhancerSize a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Enhancer Size";
    skos:definition "The size of the enhancer in base pairs."
}