@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix : <http://example.org/ontology/> .

<http://example.org/ontology/FANTOM5> a owl:Ontology .

### Classes

:CRM a owl:Class ;
    skos:prefLabel "Cis-Regulatory Module" ;
    skos:definition "A genomic region that regulates the expression of target genes, identified as an enhancer in the FANTOM5 database." ;
    skos:exactMatch obo:SO_0000165 .

:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, typically a protein." ;
    skos:exactMatch obo:SO_0000704 .

:TranscriptionFactor a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that binds to specific DNA sequences, thereby controlling the rate of transcription of genetic information." ;
    skos:exactMatch obo:GO_0003700 .

### Object Properties

:hasTargetGene a owl:ObjectProperty ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates a CRM to its target gene." ;
    rdfs:domain :CRM ;
    rdfs:range :Gene .

:interactsWithTF a owl:ObjectProperty ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Relates a CRM to a transcription factor that interacts with it." ;
    rdfs:domain :CRM ;
    rdfs:range :TranscriptionFactor .

### Datatype Properties

:hasOrigChr a owl:DatatypeProperty ;
    skos:prefLabel "has original chromosome" ;
    skos:definition "The chromosome on which the CRM was originally identified." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string .

:hasOrigStart a owl:DatatypeProperty ;
    skos:prefLabel "has original start" ;
    skos:definition "The start position of the CRM on the original chromosome." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:integer .

:hasOrigEnd a owl:DatatypeProperty ;
    skos:prefLabel "has original end" ;
    skos:definition "The end position of the CRM on the original chromosome." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:integer .

:hasCurrentChr a owl:DatatypeProperty ;
    skos:prefLabel "has current chromosome" ;
    skos:definition "The chromosome on which the CRM is currently mapped." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string .

:hasCurrentStart a owl:DatatypeProperty ;
    skos:prefLabel "has current start" ;
    skos:definition "The start position of the CRM on the current chromosome." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:integer .

:hasCurrentEnd a owl:DatatypeProperty ;
    skos:prefLabel "has current end" ;
    skos:definition "The end position of the CRM on the current chromosome." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:integer .

:hasEvidencePMID a owl:DatatypeProperty ;
    skos:prefLabel "has evidence PMID" ;
    skos:definition "The PubMed ID of the publication providing evidence for the CRM." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string .

:hasEnhancerMethod a owl:DatatypeProperty ;
    skos:prefLabel "has enhancer method" ;
    skos:definition "The method used to identify the CRM as an enhancer." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string .
