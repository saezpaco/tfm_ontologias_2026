<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GENO_0000897">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has chromosome</skos:prefLabel>
    <skos:definition>The chromosome on which a genomic feature is located.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/GENO_0000897"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/SO_0000167"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SO_0000167">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Enhancer</skos:prefLabel>
    <skos:definition>A cis-acting sequence that increases the utilization of some eukaryotic promoters and can function in either orientation and in any location relative to the promoter.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000167"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GENO_0000895">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has genomic start position</skos:prefLabel>
    <skos:definition>The start position of a genomic feature on a chromosome.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/GENO_0000895"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/SO_0000167"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GENO_0000900">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has minimum ratio</skos:prefLabel>
    <skos:definition>The minimum ratio of enhancer activity observed.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/SO_0000167"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GENO_0000896">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has genomic end position</skos:prefLabel>
    <skos:definition>The end position of a genomic feature on a chromosome.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/GENO_0000896"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/SO_0000167"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002205">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>has target gene</skos:prefLabel>
    <skos:definition>Relates a regulatory region to its target gene.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0002205"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/SO_0000167"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/SO_0000704"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GENO_0000899">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has score</skos:prefLabel>
    <skos:definition>A score representing the confidence or strength of the enhancer activity.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/SO_0000167"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GENO_0000898">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has assembly version</skos:prefLabel>
    <skos:definition>The genome assembly version used for the genomic coordinates.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/GENO_0000898"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/SO_0000167"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SO_0000165">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cis-regulatory module</skos:prefLabel>
    <skos:definition>A region of DNA that regulates the expression of genes.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000165"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ECO_0000000">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has evidence</skos:prefLabel>
    <skos:definition>Evidence supporting the assertion of a genomic feature.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/ECO_0000000"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/SO_0000167"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
</rdf:RDF>
