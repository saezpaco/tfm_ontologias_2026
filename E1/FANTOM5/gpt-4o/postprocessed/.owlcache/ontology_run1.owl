<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/ontology/hasEnhancerMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has enhancer method</skos:prefLabel>
    <skos:definition>The method used to identify the CRM as an enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasCurrentStart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has current start</skos:prefLabel>
    <skos:definition>The start position of the CRM on the current chromosome.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasCurrentChr">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has current chromosome</skos:prefLabel>
    <skos:definition>The chromosome on which the CRM is currently mapped.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasOrigEnd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has original end</skos:prefLabel>
    <skos:definition>The end position of the CRM on the original chromosome.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasEvidencePMID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has evidence PMID</skos:prefLabel>
    <skos:definition>The PubMed ID of the publication providing evidence for the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasCurrentEnd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has current end</skos:prefLabel>
    <skos:definition>The end position of the CRM on the current chromosome.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasOrigStart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has original start</skos:prefLabel>
    <skos:definition>The start position of the CRM on the original chromosome.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>has target gene</skos:prefLabel>
    <skos:definition>Relates a CRM to its target gene.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/interactsWithTF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>interacts with transcription factor</skos:prefLabel>
    <skos:definition>Relates a CRM to a transcription factor that interacts with it.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/TranscriptionFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cis-Regulatory Module</skos:prefLabel>
    <skos:definition>A genomic region that regulates the expression of target genes, identified as an enhancer in the FANTOM5 database.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000165"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
    <skos:definition>A protein that binds to specific DNA sequences, thereby controlling the rate of transcription of genetic information.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/GO_0003700"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gene</skos:prefLabel>
    <skos:definition>A sequence of DNA that contains the necessary information to produce a functional product, typically a protein.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000704"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasOrigChr">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has original chromosome</skos:prefLabel>
    <skos:definition>The chromosome on which the CRM was originally identified.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/FANTOM5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
</rdf:RDF>
