@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
obo:SO_0000165 a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "A region of DNA that regulates the expression of genes." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000165> .

obo:SO_0000167 a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-acting sequence that increases the utilization of some eukaryotic promoters and can function in either orientation and in any location (upstream or downstream) relative to the promoter." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000167> .

obo:GENE a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A locatable region of genomic sequence, corresponding to a unit of inheritance, which is associated with regulatory regions, transcribed regions and/or other functional sequence regions." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000704> .

# Object Properties
obo:RO_0002205 a owl:ObjectProperty ;
    skos:prefLabel "regulates expression of" ;
    skos:definition "A relationship between a regulatory element and a gene it regulates." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002205> ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range obo:GENE .

# Datatype Properties
obo:hasGenomicCoordinate a owl:DatatypeProperty ;
    skos:prefLabel "has genomic coordinate" ;
    skos:definition "The genomic coordinate of a sequence feature." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:string .

obo:hasExperimentalEvidence a owl:DatatypeProperty ;
    skos:prefLabel "has experimental evidence" ;
    skos:definition "The type of experimental evidence supporting the existence of the enhancer." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:string .

obo:hasPMID a owl:DatatypeProperty ;
    skos:prefLabel "has PMID" ;
    skos:definition "The PubMed ID of the publication providing evidence for the enhancer." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:string .

obo:hasScore a owl:DatatypeProperty ;
    skos:prefLabel "has score" ;
    skos:definition "The score assigned to the enhancer based on experimental data." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:float .