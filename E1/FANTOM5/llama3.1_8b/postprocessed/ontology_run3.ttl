@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/FANTOM5>
  a owl:Ontology ;
  rdfs:label "FANTOM5 Enhancers" ;
  skos:prefLabel "FANTOM5 Enhancers" ;
  skos:definition "Enhancer sequences identified by CAGE-seq in the human genome." .

<http://example.org/CRM>
  a owl:Class ;
  rdfs:label "Cis-Regulatory Module (CRM)" ;
  skos:prefLabel "Cis-Regulatory Module" ;
  skos:definition "A region of DNA that regulates gene expression by binding transcription factors." .

<http://example.org/Enhancer>
  a owl:Class ;
  rdfs:label "Enhancer" ;
  skos:prefLabel "Enhancer" ;
  skos:definition "A type of CRM that activates gene expression." ;
  rdfs:subClassOf <http://example.org/CRM> .

<http://example.org/GenomicCoordinate>
  a owl:Class ;
  rdfs:label "Genomic Coordinate" ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "A location on the genome." .

<http://example.org/Chr>
  a owl:DatatypeProperty ;
  rdfs:label "Chromosome" ;
  skos:prefLabel "Chromosome" ;
  skos:definition "The chromosome where the enhancer is located." ;
  rdfs:domain <http://example.org/Enhancer> ;
  rdfs:range xsd:string .

<http://example.org/Start>
  a owl:DatatypeProperty ;
  rdfs:label "Start Coordinate" ;
  skos:prefLabel "Start Coordinate" ;
  skos:definition "The start coordinate of the enhancer on the chromosome." ;
  rdfs:domain <http://example.org/Enhancer> ;
  rdfs:range xsd:integer .

<http://example.org/End>
  a owl:DatatypeProperty ;
  rdfs:label "End Coordinate" ;
  skos:prefLabel "End Coordinate" ;
  skos:definition "The end coordinate of the enhancer on the chromosome." ;
  rdfs:domain <http://example.org/Enhancer> ;
  rdfs:range xsd:integer .

<http://example.org/Assembly>
  a owl:DatatypeProperty ;
  rdfs:label "Genome Assembly" ;
  skos:prefLabel "Genome Assembly" ;
  skos:definition "The genome assembly used to identify the enhancer." ;
  rdfs:domain <http://example.org/Enhancer> ;
  rdfs:range xsd:string .

<http://example.org/Evidence>
  a owl:ObjectProperty ;
  rdfs:label "Experimental Evidence" ;
  skos:prefLabel "Experimental Evidence" ;
  skos:definition "The experimental evidence supporting the enhancer's activity." ;
  rdfs:domain <http://example.org/Enhancer> ;
  rdfs:range <http://example.org/EvidenceType> .

<http://example.org/EvidenceType>
  a owl:Class ;
  rdfs:label "Evidence Type" ;
  skos:prefLabel "Evidence Type" ;
  skos:definition "The type of experimental evidence supporting the enhancer's activity." .

<http://example.org/CAGEseq>
  a owl:ObjectProperty ;
  rdfs:label "CAGE-seq Evidence" ;
  skos:prefLabel "CAGE-seq Evidence" ;
  skos:definition "Evidence from CAGE-seq experiments supporting the enhancer's activity." ;
  rdfs:domain <http://example.org/Enhancer> ;
  rdfs:range <http://example.org/EvidenceType> .

<http://example.org/TargetGene>
  a owl:ObjectProperty ;
  rdfs:label "Target Gene" ;
  skos:prefLabel "Target Gene" ;
  skos:definition "The gene regulated by the enhancer." ;
  rdfs:domain <http://example.org/Enhancer> ;
  rdfs:range <http://example.org/Gene> .

<http://example.org/Gene>
  a owl:Class ;
  rdfs:label "Gene" ;
  skos:prefLabel "Gene" ;
  skos:definition "A unit of heredity that is passed from one generation to the next." .

<http://example.org/TranscriptionFactor>
  a owl:ObjectProperty ;
  rdfs:label "Transcription Factor" ;
  skos:prefLabel "Transcription Factor" ;
  skos:definition "A protein that binds to DNA and regulates gene expression." ;
  rdfs:domain <http://example.org/Enhancer> ;
  rdfs:range <http://example.org/Gene> .

<http://example.org/Disease>
  a owl:ObjectProperty ;
  rdfs:label "Associated Disease" ;
  skos:prefLabel "Associated Disease" ;
  skos:definition "A disease associated with the enhancer's activity." ;
  rdfs:domain <http://example.org/Enhancer> ;
  rdfs:range <http://example.org/DiseaseType> .

<http://example.org/DiseaseType>
  a owl:Class ;
  rdfs:label "Disease Type" ;
  skos:prefLabel "Disease Type" ;
  skos:definition "The type of disease associated with the enhancer's activity." .