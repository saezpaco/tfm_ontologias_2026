<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/AssociatedDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Associated Disease</rdfs:label>
    <skos:prefLabel>Associated Diseases</skos:prefLabel>
    <skos:definition>A disease associated with the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Crm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/InteractingTF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Interacting Transcription Factor</rdfs:label>
    <skos:prefLabel>Interacting TFs</skos:prefLabel>
    <skos:definition>A transcription factor that interacts with the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Crm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ExactMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Exact Match</rdfs:label>
    <skos:prefLabel>Exact Match Mapping</skos:prefLabel>
    <skos:definition>A mapping between an enhancer and its exact match in another ontology.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Crm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Chr">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Chromosome</rdfs:label>
    <skos:prefLabel>Chromosome ID</skos:prefLabel>
    <skos:definition>The chromosome on which the enhancer is located.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Crm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Evidence</rdfs:label>
    <skos:prefLabel>Experimental Evidence</skos:prefLabel>
    <skos:definition>A piece of evidence supporting the existence of an enhancer.</skos:definition>
    <rdfs:subClassOf rdf:resource="obo:SO_0000163"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Start">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Start Coordinate</rdfs:label>
    <skos:prefLabel>Start Position</skos:prefLabel>
    <skos:definition>The start coordinate of the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Crm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/FANTOM5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>FANTOM5 Enhancer Database</rdfs:label>
    <skos:prefLabel>FANTOM5 Enhancers</skos:prefLabel>
    <skos:definition>Database of enhancers identified by CAGE-seq.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/End">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>End Coordinate</rdfs:label>
    <skos:prefLabel>End Position</skos:prefLabel>
    <skos:definition>The end coordinate of the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Crm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/CAGESeq">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>CAGE-Seq Experiment</rdfs:label>
    <skos:prefLabel>CAGE-Seq Evidence</skos:prefLabel>
    <skos:definition>An experiment that identified the enhancer using CAGE-seq.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Evidence"/>
    <rdfs:range rdf:resource="http://example.org/Crm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/TargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Target Gene</rdfs:label>
    <skos:prefLabel>Target Genes</skos:prefLabel>
    <skos:definition>The gene that is regulated by the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Crm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Crm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cis-Regulatory Module (CRM)</rdfs:label>
    <skos:prefLabel>Enhancer</skos:prefLabel>
    <skos:definition>A region of DNA that regulates gene expression.</skos:definition>
    <rdfs:subClassOf rdf:resource="obo:SO_0000163"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Enh2Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Enhancer to Gene</rdfs:label>
    <skos:prefLabel>Enh2Gene Mapping</skos:prefLabel>
    <skos:definition>A mapping between an enhancer and its target gene.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Crm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/TFs2Enh">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Transcription Factor to Enhancer</rdfs:label>
    <skos:prefLabel>TFs2Enh Mapping</skos:prefLabel>
    <skos:definition>A mapping between a transcription factor and an enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:range rdf:resource="http://example.org/Crm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/obo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Open Biological Ontologies</rdfs:label>
    <skos:prefLabel>OBO Foundry</skos:prefLabel>
    <skos:definition>A collection of ontologies for biological data.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/CloseMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Close Match</rdfs:label>
    <skos:prefLabel>Close Match Mapping</skos:prefLabel>
    <skos:definition>A mapping between an enhancer and its close match in another ontology.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Crm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb7d33aed419f4ec2bd33b050db3e410fb1">
    <rdf:first rdf:resource="http://example.org/Chr"/>
    <rdf:rest rdf:nodeID="nb7d33aed419f4ec2bd33b050db3e410fb2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/CellLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Cell Line</rdfs:label>
    <skos:prefLabel>Cell Line Activity</skos:prefLabel>
    <skos:definition>The cell line in which the enhancer was active.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/Crm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/Enhancer">
    <owl:equivalentClass rdf:resource="http://example.org/Crm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/GenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Genomic Coordinate</rdfs:label>
    <skos:prefLabel>Genomic Coordinates</skos:prefLabel>
    <skos:definition>A set of coordinates that define the location of a genomic feature.</skos:definition>
    <rdfs:subClassOf rdf:resource="obo:SO_0000163"/>
    <owl:intersectionOf rdf:nodeID="nb7d33aed419f4ec2bd33b050db3e410fb1"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb7d33aed419f4ec2bd33b050db3e410fb3">
    <rdf:first rdf:resource="http://example.org/End"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb7d33aed419f4ec2bd33b050db3e410fb2">
    <rdf:first rdf:resource="http://example.org/Start"/>
    <rdf:rest rdf:nodeID="nb7d33aed419f4ec2bd33b050db3e410fb3"/>
  </rdf:Description>
</rdf:RDF>
