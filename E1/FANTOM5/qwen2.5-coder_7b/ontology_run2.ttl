@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology rdf:about "http://example.com/fantom5-enhancers" ;
    rdfs:label "FANTOM5 Enhancers Ontology" ;
    rdfs:comment "An ontology for enhancers identified by CAGE-seq in FANTOM5 dataset." ;

crm:Enhancer a owl:Class ;
    skos:prefLabel "Cis-Regulatory Module (CRM)" ;
    skos:definition "A cis-regulatory module that modulates the transcription rate of target genes." ;
    rdfs:subClassOf obo:SIO_010245 ;  # Biological Region

crm:hasGenomicStart a owl:ObjectProperty ;
    skos:prefLabel "Has Genomic Start" ;
    skos:definition "The start position of the enhancer in the genome." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer .

crm:hasGenomicEnd a owl:ObjectProperty ;
    skos:prefLabel "Has Genomic End" ;
    skos:definition "The end position of the enhancer in the genome." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer .

crm:hasEvidence a owl:ObjectProperty ;
    skos:prefLabel "Has Evidence" ;
    skos:definition "Experimental evidence supporting the existence of the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SIO_010245 ;  # Biological Region

crm:evidenceType a owl:ObjectProperty ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of evidence used to support the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SIO_010245 ;  # Biological Region

crm:evidenceSource a owl:ObjectProperty ;
    skos:prefLabel "Evidence Source" ;
    skos:definition "The source of the evidence supporting the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string .

crm:targetGene a owl:ObjectProperty ;
    skos:prefLabel "Target Gene" ;
    skos:definition "A gene that is regulated by the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SIO_010245 ;  # Biological Region

crm:evidenceConfidence a owl:ObjectProperty ;
    skos:prefLabel "Evidence Confidence" ;
    skos:definition "The level of confidence in the evidence supporting the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string .

crm:evidencePublication a owl:ObjectProperty ;
    skos:prefLabel "Evidence Publication" ;
    skos:definition "A publication that reports evidence for the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SIO_010245 ;  # Biological Region

crm:evidenceMethod a owl:ObjectProperty ;
    skos:prefLabel "Evidence Method" ;
    skos:definition "The method used to generate the evidence for the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string .

crm:evidenceSupportingGenes a owl:ObjectProperty ;
    skos:prefLabel "Evidence Supporting Genes" ;
    skos:definition "Genes that support the existence of the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SIO_010245 ;  # Biological Region

crm:evidenceContradictingGenes a owl:ObjectProperty ;
    skos:prefLabel "Evidence Contradicting Genes" ;
    skos:definition "Genes that contradict the existence of the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SIO_010245 ;  # Biological Region

crm:evidenceSupportingRegions a owl:ObjectProperty ;
    skos:prefLabel "Evidence Supporting Regions" ;
    skos:definition "Genomic regions that support the existence of the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SIO_010245 ;  # Biological Region

crm:evidenceContradictingRegions a owl:ObjectProperty ;
    skos:prefLabel "Evidence Contradicting Regions" ;
    skos:definition "Genomic regions that contradict the existence of the enhancer." ;
