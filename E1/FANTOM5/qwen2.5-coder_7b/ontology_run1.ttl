@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology rdf:about "http://example.com/fantom5-enhancers" ;
    rdfs:label "FANTOM5 Enhancers Ontology" ;
    rdfs:comment "An ontology for enhancer sequences identified by CAGE-seq in FANTOM5 dataset." ;

crm:Enhancer a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-regulatory module that modulates the transcription rate of target genes." ;
    rdfs:subClassOf obo:SIO_010247 ;  # Regulatory Element

crm:GenomicCoordinate a owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A coordinate within the genome that specifies the location of an enhancer." ;

crm:startCoordinate a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Coordinate" ;
    skos:definition "The starting position of the genomic coordinate." ;

crm:endCoordinate a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Coordinate" ;
    skos:definition "The ending position of the genomic coordinate." ;

crm:evidence a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range rdf:Resource ;
    skos:prefLabel "Evidence" ;
    skos:definition "Supporting evidence for the enhancer sequence." ;

crm:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:GenomicCoordinate ;
    skos:prefLabel "Has Genomic Coordinate" ;
    skos:definition "The genomic coordinate associated with the enhancer." ;

crm:evidenceType a owl:DatatypeProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of evidence supporting the enhancer sequence." ;

crm:evidenceSource a owl:DatatypeProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Source" ;
    skos:definition "The source of the evidence for the enhancer sequence." ;

crm:enhancerID a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "Enhancer ID" ;
    skos:definition "A unique identifier for the enhancer sequence." ;

crm:enhancerName a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "Enhancer Name" ;
    skos:definition "The name of the enhancer sequence." ;

crm:enhancerDescription a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "Enhancer Description" ;
    skos:definition "A description of the enhancer sequence." ;

crm:enhancerLocation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001467 ;  # Chromosome
    skos:prefLabel "Enhancer Location" ;
    skos:definition "The chromosome location of the enhancer sequence." ;

crm:enhancerOrientation a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "Enhancer Orientation" ;
    skos:definition "The orientation (forward/reverse) of the enhancer sequence." ;

crm:enhancerSize a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Enhancer Size" ;
    skos:definition "The size of the enhancer sequence in base pairs." ;

crm:enhancerFunction a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Function" ;
    skos:definition "The function of the enhancer sequence in transcriptional regulation." ;

crm:enhancerExpression a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Expression" ;
    skos:definition "The expression pattern of the enhancer sequence." ;

crm:enhancerRegulates a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulates" ;
    skos:definition "The genes or processes regulated by the enhancer sequence." ;

crm:enhancerExpressionLevel a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float ;
    skos:prefLabel "Enhancer Expression Level" ;
    skos:definition "The level of expression of the enhancer sequence." ;

crm:enhancerExpressionPattern a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "Enhancer Expression Pattern" ;
    skos:definition "The pattern of expression of the enhancer sequence." ;

crm:enhancerRegulationType a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "Enhancer Regulation Type" ;
    skos:definition "The type of regulation exerted by the enhancer sequence." ;

crm:enhancerRegulationTarget a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Target" ;
    skos:definition "The target of the regulation exerted by the enhancer sequence." ;

crm:enhancerRegulationMechanism a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Mechanism" ;
    skos:definition "The mechanism of regulation exerted by the enhancer sequence." ;

crm:enhancerRegulationIntensity a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float ;
    skos:prefLabel "Enhancer Regulation Intensity" ;
    skos:definition "The intensity of regulation exerted by the enhancer sequence." ;

crm:enhancerRegulationSpecificity a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float ;
    skos:prefLabel "Enhancer Regulation Specificity" ;
    skos:definition "The specificity of regulation exerted by the enhancer sequence." ;

crm:enhancerRegulationDuration a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:duration ;
    skos:prefLabel "Enhancer Regulation Duration" ;
    skos:definition "The duration of regulation exerted by the enhancer sequence." ;

crm:enhancerRegulationContext a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Context" ;
    skos:definition "The context in which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationLocation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Location" ;
    skos:definition "The location at which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismType a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Mechanism Type" ;
    skos:definition "The type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismIntensity a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float ;
    skos:prefLabel "Enhancer Regulation Mechanism Intensity" ;
    skos:definition "The intensity of the mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismSpecificity a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float ;
    skos:prefLabel "Enhancer Regulation Mechanism Specificity" ;
    skos:definition "The specificity of the mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismDuration a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:duration ;
    skos:prefLabel "Enhancer Regulation Mechanism Duration" ;
    skos:definition "The duration of the mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismContext a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Mechanism Context" ;
    skos:definition "The context in which the mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismLocation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Mechanism Location" ;
    skos:definition "The location at which the mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeIntensity a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float ;
    skos:prefLabel "Enhancer Regulation Mechanism Type Intensity" ;
    skos:definition "The intensity of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeSpecificity a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float ;
    skos:prefLabel "Enhancer Regulation Mechanism Type Specificity" ;
    skos:definition "The specificity of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeDuration a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:duration ;
    skos:prefLabel "Enhancer Regulation Mechanism Type Duration" ;
    skos:definition "The duration of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeContext a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Mechanism Type Context" ;
    skos:definition "The context in which the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeLocation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Mechanism Type Location" ;
    skos:definition "The location at which the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeIntensitySpecificity a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float ;
    skos:prefLabel "Enhancer Regulation Mechanism Type Intensity Specificity" ;
    skos:definition "The intensity and specificity of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeIntensitySpecificityDuration a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:duration ;
    skos:prefLabel "Enhancer Regulation Mechanism Type Intensity Specificity Duration" ;
    skos:definition "The duration of the intensity and specificity of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeIntensitySpecificityDurationContext a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Mechanism Type Intensity Specificity Duration Context" ;
    skos:definition "The context in which the duration of the intensity and specificity of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeIntensitySpecificityDurationContextLocation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Mechanism Type Intensity Specificity Duration Context Location" ;
    skos:definition "The location at which the duration of the intensity and specificity of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeIntensitySpecificityDurationContextLocationType a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Mechanism Type Intensity Specificity Duration Context Location Type" ;
    skos:definition "The type of location at which the duration of the intensity and specificity of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeIntensitySpecificityDurationContextLocationTypeIntensity a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float ;
    skos:prefLabel "Enhancer Regulation Mechanism Type Intensity Specificity Duration Context Location Type Intensity" ;
    skos:definition "The intensity of the type of location at which the duration of the intensity and specificity of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeIntensitySpecificityDurationContextLocationTypeIntensitySpecificity a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float ;
    skos:prefLabel "Enhancer Regulation Mechanism Type Intensity Specificity Duration Context Location Type Intensity Specificity" ;
    skos:definition "The intensity and specificity of the type of location at which the duration of the intensity and specificity of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeIntensitySpecificityDurationContextLocationTypeIntensitySpecificityDuration a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:duration ;
    skos:prefLabel "Enhancer Regulation Mechanism Type Intensity Specificity Duration Context Location Type Intensity Specificity Duration" ;
    skos:definition "The duration of the intensity and specificity of the type of location at which the duration of the intensity and specificity of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeIntensitySpecificityDurationContextLocationTypeIntensitySpecificityDurationContext a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Mechanism Type Intensity Specificity Duration Context Location Type Intensity Specificity Duration Context" ;
    skos:definition "The context in which the duration of the intensity and specificity of the type of location at which the duration of the intensity and specificity of the type of mechanism by which the regulation exerted by the enhancer sequence occurs." ;

crm:enhancerRegulationMechanismTypeIntensitySpecificityDurationContextLocationTypeIntensitySpecificityDurationContextLocation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # Transcriptional regulation
    skos:prefLabel "Enhancer Regulation Mechanism Type Intensity Specificity Duration Context Location Type Intensity Specificity Duration Context Location" ;
    skos:definition "The location at which the duration of the intensity and specificity of the type of location at which the duration of the intensity and specificity of the type of mechanism by which the regulation exerted by the enhancer sequence