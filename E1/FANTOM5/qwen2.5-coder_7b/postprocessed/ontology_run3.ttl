@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://rdf.biogateway.eu/crm/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    rdfs:comment "An ontology for enhancers identified by CAGE-seq in FANTOM5 dataset." ;
}

crm:Enhancer a owl:Class ;
    skos:prefLabel "Cis-Regulatory Module (CRM)" ;
    skos:definition "A cis-regulatory module that modulates the transcription rate of target genes in the human genome." ;
    rdfs:subClassOf obo:SIO_010245 ;  # Biological Region

crm:hasGenomicStart a owl:ObjectProperty ;
    skos:prefLabel "Has Genomic Start" ;
    skos:definition "The start position of the enhancer on the genome." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer .

crm:hasGenomicEnd a owl:ObjectProperty ;
    skos:prefLabel "Has Genomic End" ;
    skos:definition "The end position of the enhancer on the genome." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer .

crm:locatedOnChromosome a owl:ObjectProperty ;
    skos:prefLabel "Located On Chromosome" ;
    skos:definition "The chromosome where the enhancer is located." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001217 .  # Chromosome

crm:evidence a owl:ObjectProperty ;
    skos:prefLabel "Evidence" ;
    skos:definition "The experimental evidence supporting the enhancer's function." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0008279 .  # Experimental Evidence

crm:hasTargetGene a owl:ObjectProperty ;
    skos:prefLabel "Has Target Gene" ;
    skos:definition "The gene that is regulated by the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001217 .  # Gene

crm:evidenceType a owl:ObjectProperty ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of experimental evidence used to support the enhancer's function." ;
    rdfs:domain crm:Evidence ;
    rdfs:range obo:GO_0008279 .  # Experimental Evidence

crm:evidenceSource a owl:ObjectProperty ;
    skos:prefLabel "Evidence Source" ;
    skos:definition "The source of the experimental evidence supporting the enhancer's function." ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string .

crm:evidencePublication a owl:ObjectProperty ;
    skos:prefLabel "Evidence Publication" ;
    skos:definition "The publication that describes the experimental evidence supporting the enhancer's function." ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string .
