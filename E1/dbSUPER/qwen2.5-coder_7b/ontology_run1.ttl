@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "CRM Enhancer Ontology" ;
    rdfs:comment "A formal representation of CRM enhancers and their properties." ;
}

crm:Enhancer a owl:Class ;
    skos:prefLabel "CRM Enhancer" ;
    skos:definition "A genomic region that enhances the transcription of a gene or set of genes." ;
    rdfs:subClassOf obo:SIO_010243 ;  # Biological Region

crm:GenomicCoordinate a owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location within the genome." ;

crm:startCoordinate a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Coordinate" ;
    skos:definition "The starting position of the genomic coordinate." ;

crm:endCoordinate a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Coordinate" ;
    skos:definition "The ending position of the genomic coordinate." ;

crm:evidence a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range rdf:Resource ;
    skos:prefLabel "Evidence" ;
    skos:definition "Supporting information or data for the enhancer." ;

crm:literatureReference a owl:Class ;
    skos:prefLabel "Literature Reference" ;
    skos:definition "A reference to a scientific publication supporting the enhancer." ;

crm:citation a owl:DatatypeProperty ;
    rdfs:domain crm:literatureReference ;
    rdfs:range xsd:string ;
    skos:prefLabel "Citation" ;
    skos:definition "The bibliographic citation for the literature reference." ;

crm:enhancerLocation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:GenomicCoordinate ;
    skos:prefLabel "Enhancer Location" ;
    skos:definition "The genomic location of the enhancer." ;

crm:enhancerType a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "Enhancer Type" ;
    skos:definition "The type or subtype of the enhancer." ;

crm:enhancerFunction a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "Enhancer Function" ;
    skos:definition "The biological function of the enhancer." ;

crm:enhancerGene a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001217 ;  # Gene
    skos:prefLabel "Enhanced Gene" ;
    skos:definition "The gene that is enhanced by the enhancer." ;

crm:enhancerSpecies a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:NCBITaxon_9606 ;  # Homo sapiens
    skos:prefLabel "Enhancer Species" ;
    skos:definition "The species in which the enhancer is found." ;

crm:enhancerExpression a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Expression
    skos:prefLabel "Enhancer Expression" ;
    skos:definition "The expression pattern of the enhancer." ;

crm:enhancerRegulation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Regulation
    skos:prefLabel "Enhancer Regulation" ;
    skos:definition "The regulation of gene expression by the enhancer." ;

crm:enhancerInteraction a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Interaction
    skos:prefLabel "Enhancer Interaction" ;
    skos:definition "The interaction of the enhancer with other biological entities." ;

crm:enhancerLocalization a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Localization
    skos:prefLabel "Enhancer Localization" ;
    skos:definition "The localization of the enhancer within the cell or organism." ;

crm:enhancerActivity a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Activity
    skos:prefLabel "Enhancer Activity" ;
    skos:definition "The activity of the enhancer in regulating gene expression." ;

crm:enhancerStability a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Stability
    skos:prefLabel "Enhancer Stability" ;
    skos:definition "The stability of the enhancer in maintaining its function." ;

crm:enhancerConservation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Conservation
    skos:prefLabel "Enhancer Conservation" ;
    skos:definition "The conservation of the enhancer across different species." ;

crm:enhancerFunctionality a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Functionality
    skos:prefLabel "Enhancer Functionality" ;
    skos:definition "The functionality of the enhancer in its biological context." ;

crm:enhancerComplexity a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Complexity
    skos:prefLabel "Enhancer Complexity" ;
    skos:definition "The complexity of the enhancer in regulating gene expression." ;

crm:enhancerRegulatoryNetwork a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Regulatory Network
    skos:prefLabel "Enhancer Regulatory Network" ;
    skos:definition "The regulatory network in which the enhancer participates." ;

crm:enhancerTranscriptionalActivity a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Activity
    skos:prefLabel "Enhancer Transcriptional Activity" ;
    skos:definition "The transcriptional activity of the enhancer in regulating gene expression." ;

crm:enhancerEpigeneticModification a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Epigenetic Modification
    skos:prefLabel "Enhancer Epigenetic Modification" ;
    skos:definition "The epigenetic modification of the enhancer in regulating gene expression." ;

crm:enhancerTranscriptionalRegulation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Regulation
    skos:prefLabel "Enhancer Transcriptional Regulation" ;
    skos:definition "The transcriptional regulation of gene expression by the enhancer." ;

crm:enhancerTranscriptionalActivation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Activation
    skos:prefLabel "Enhancer Transcriptional Activation" ;
    skos:definition "The transcriptional activation of gene expression by the enhancer." ;

crm:enhancerTranscriptionalInhibition a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Inhibition
    skos:prefLabel "Enhancer Transcriptional Inhibition" ;
    skos:definition "The transcriptional inhibition of gene expression by the enhancer." ;

crm:enhancerTranscriptionalStimulation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Stimulation
    skos:prefLabel "Enhancer Transcriptional Stimulation" ;
    skos:definition "The transcriptional stimulation of gene expression by the enhancer." ;

crm:enhancerTranscriptionalRepression a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Repression
    skos:prefLabel "Enhancer Transcriptional Repression" ;
    skos:definition "The transcriptional repression of gene expression by the enhancer." ;

crm:enhancerTranscriptionalPromotion a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Promotion
    skos:prefLabel "Enhancer Transcriptional Promotion" ;
    skos:definition "The transcriptional promotion of gene expression by the enhancer." ;

crm:enhancerTranscriptionalSuppression a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Suppression
    skos:prefLabel "Enhancer Transcriptional Suppression" ;
    skos:definition "The transcriptional suppression of gene expression by the enhancer." ;

crm:enhancerTranscriptionalInduction a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Induction
    skos:prefLabel "Enhancer Transcriptional Induction" ;
    skos:definition "The transcriptional induction of gene expression by the enhancer." ;

crm:enhancerTranscriptionalReduction a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Reduction
    skos:prefLabel "Enhancer Transcriptional Reduction" ;
    skos:definition "The transcriptional reduction of gene expression by the enhancer." ;

crm:enhancerTranscriptionalAmplification a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Amplification
    skos:prefLabel "Enhancer Transcriptional Amplification" ;
    skos:definition "The transcriptional amplification of gene expression by the enhancer." ;

crm:enhancerTranscriptionalAttenuation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Attenuation
    skos:prefLabel "Enhancer Transcriptional Attenuation" ;
    skos:definition "The transcriptional attenuation of gene expression by the enhancer." ;

crm:enhancerTranscriptionalDownregulation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Downregulation
    skos:prefLabel "Enhancer Transcriptional Downregulation" ;
    skos:definition "The transcriptional downregulation of gene expression by the enhancer." ;

crm:enhancerTranscriptionalUpregulation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Upregulation
    skos:prefLabel "Enhancer Transcriptional Upregulation" ;
    skos:definition "The transcriptional upregulation of gene expression by the enhancer." ;

crm:enhancerTranscriptionalDowncontrol a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Downcontrol
    skos:prefLabel "Enhancer Transcriptional Downcontrol" ;
    skos:definition "The transcriptional downcontrol of gene expression by the enhancer." ;

crm:enhancerTranscriptionalUpcontrol a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Upcontrol
    skos:prefLabel "Enhancer Transcriptional Upcontrol" ;
    skos:definition "The transcriptional upcontrol of gene expression by the enhancer." ;

crm:enhancerTranscriptionalInactivation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Inactivation
    skos:prefLabel "Enhancer Transcriptional Inactivation" ;
    skos:definition "The transcriptional inactivation of gene expression by the enhancer." ;

crm:enhancerTranscriptionalActivation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Activation
    skos:prefLabel "Enhancer Transcriptional Activation" ;
    skos:definition "The transcriptional activation of gene expression by the enhancer." ;

crm:enhancerTranscriptionalInhibition a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Inhibition
    skos:prefLabel "Enhancer Transcriptional Inhibition" ;
    skos:definition "The transcriptional inhibition of gene expression by the enhancer." ;

crm:enhancerTranscriptionalStimulation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Stimulation
    skos:prefLabel "Enhancer Transcriptional Stimulation" ;
    skos:definition "The transcriptional stimulation of gene expression by the enhancer." ;

crm:enhancerTranscriptionalRepression a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Repression
    skos:prefLabel "Enhancer Transcriptional Repression" ;
    skos:definition "The transcriptional repression of gene expression by the enhancer." ;

crm:enhancerTranscriptionalPromotion a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Promotion
    skos:prefLabel "Enhancer Transcriptional Promotion" ;
    skos:definition "The transcriptional promotion of gene expression by the enhancer." ;

crm:enhancerTranscriptionalSuppression a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Suppression
    skos:prefLabel "Enhancer Transcriptional Suppression" ;
    skos:definition "The transcriptional suppression of gene expression by the enhancer." ;

crm:enhancerTranscriptionalInduction a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Induction
    skos:prefLabel "Enhancer Transcriptional Induction" ;
    skos:definition "The transcriptional induction of gene expression by the enhancer." ;

crm:enhancerTranscriptionalReduction a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Reduction
    skos:prefLabel "Enhancer Transcriptional Reduction" ;
    skos:definition "The transcriptional reduction of gene expression by the enhancer." ;

crm:enhancerTranscriptionalAmplification a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Amplification
    skos:prefLabel "Enhancer Transcriptional Amplification" ;
    skos:definition "The transcriptional amplification of gene expression by the enhancer." ;

crm:enhancerTranscriptionalAttenuation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0016572 ;  # Transcriptional Attenuation
    skos:prefLabel "Enhancer Transcriptional Attenuation" ;
    skos:definition "The transcriptional attenuation of gene expression by the enhancer." ;

