@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/dbSUPER#CRM>
  a owl:Class ;
  rdfs:label "Cis-Regulatory Module"^^xsd:string ;
  skos:prefLabel "Cis-Regulatory Module"@en ;
  skos:definition "A region of DNA that regulates gene expression."@en .

<http://example.org/dbSUPER#GenomicCoordinate>
  a owl:Class ;
  rdfs:label "Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Genomic Coordinate"@en ;
  skos:definition "A location on the genome."@en .

<http://example.org/dbSUPER#EnhancerSequence>
  a owl:ObjectProperty ;
  rdfs:label "Enhancer Sequence"^^xsd:string ;
  skos:prefLabel "Enhancer Sequence"@en ;
  skos:definition "The DNA sequence of an enhancer region."@en .

<http://example.org/dbSUPER#TargetGene>
  a owl:ObjectProperty ;
  rdfs:label "Target Gene"^^xsd:string ;
  skos:prefLabel "Target Gene"@en ;
  skos:definition "A gene regulated by the enhancer sequence."@en .

<http://example.org/dbSUPER#Evidence>
  a owl:ObjectProperty ;
  rdfs:label "Evidence"^^xsd:string ;
  skos:prefLabel "Evidence"@en ;
  skos:definition "Experimental evidence supporting the enhancer-target interaction."@en .

<http://example.org/dbSUPER#CellLineActivity>
  a owl:ObjectProperty ;
  rdfs:label "Cell Line Activity"^^xsd:string ;
  skos:prefLabel "Cell Line Activity"@en ;
  skos:definition "The activity of the enhancer sequence in a specific cell line."@en .

<http://example.org/dbSUPER#AssociatedDisease>
  a owl:ObjectProperty ;
  rdfs:label "Associated Disease"^^xsd:string ;
  skos:prefLabel "Associated Disease"@en ;
  skos:definition "A disease associated with the enhancer sequence."@en .

<http://example.org/dbSUPER#InteractingTranscriptionFactor>
  a owl:ObjectProperty ;
  rdfs:label "Interacting Transcription Factor"^^xsd:string ;
  skos:prefLabel "Interacting Transcription Factor"@en ;
  skos:definition "A transcription factor interacting with the enhancer sequence."@en .

<http://example.org/dbSUPER#GenomicCoordinate>
  a owl:ObjectProperty ;
  rdfs:label "Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Genomic Coordinate"@en ;
  skos:definition "A location on the genome."@en .

<http://example.org/dbSUPER#StartCoordinate>
  a owl:DatatypeProperty ;
  rdfs:label "Start Coordinate"^^xsd:string ;
  skos:prefLabel "Start Coordinate"@en ;
  skos:definition "The start position of the genomic coordinate."@en ;
  obo:range obo:OBONamespace("SO") .

<http://example.org/dbSUPER#EndCoordinate>
  a owl:DatatypeProperty ;
  rdfs:label "End Coordinate"^^xsd:string ;
  skos:prefLabel "End Coordinate"@en ;
  skos:definition "The end position of the genomic coordinate."@en ;
  obo:range obo:OBONamespace("SO") .

<http://example.org/dbSUPER#EvidenceType>
  a owl:DatatypeProperty ;
  rdfs:label "Evidence Type"^^xsd:string ;
  skos:prefLabel "Evidence Type"@en ;
  skos:definition "The type of evidence supporting the enhancer-target interaction."@en ;
  obo:range obo:OBONamespace("SO") .

<http://example.org/dbSUPER#CellLine>
  a owl:ObjectProperty ;
  rdfs:label "Cell Line"^^xsd:string ;
  skos:prefLabel "Cell Line"@en ;
  skos:definition "The cell line in which the enhancer sequence is active."@en .

<http://example.org/dbSUPER#Disease>
  a owl:ObjectProperty ;
  rdfs:label "Disease"^^xsd:string ;
  skos:prefLabel "Disease"@en ;
  skos:definition "A disease associated with the enhancer sequence."@en .

<http://example.org/dbSUPER#TranscriptionFactor>
  a owl:ObjectProperty ;
  rdfs:label "Transcription Factor"^^xsd:string ;
  skos:prefLabel "Transcription Factor"@en ;
  skos:definition "A transcription factor interacting with the enhancer sequence."@en .

<http://example.org/dbSUPER#crm>
  a <http://example.org/dbSUPER#CRM> ;
  <http://example.org/dbSUPER#EnhancerSequence> <http://example.org/dbSUPER#GenomicCoordinate> ;
  <http://example.org/dbSUPER#TargetGene> <http://example.org/dbSUPER#GenomicCoordinate> ;
  <http://example.org/dbSUPER#Evidence> <http://example.org/dbSUPER#EvidenceType> ;
  <http://example.org/dbSUPER#CellLineActivity> <http://example.org/dbSUPER#CellLine> ;
  <http://example.org/dbSUPER#AssociatedDisease> <http://example.org/dbSUPER#Disease> ;
  <http://example.org/dbSUPER#InteractingTranscriptionFactor> <http://example.org/dbSUPER#TranscriptionFactor> .

<http://example.org/dbSUPER#genomicCoordinate>
  a <http://example.org/dbSUPER#GenomicCoordinate> ;
  <http://example.org/dbSUPER#StartCoordinate> "1234"^^xsd:integer ;
  <http://example.org/dbSUPER#EndCoordinate> "5678"^^xsd:integer .

<http://example.org/dbSUPER#evidence>
  a <http://example.org/dbSUPER#Evidence> ;
  <http://example.org/dbSUPER#EvidenceType> "ChIP-seq"^^xsd:string .

<http://example.org/dbSUPER#cellLine>
  a <http://example.org/dbSUPER#CellLine> ;
  <http://example.org/dbSUPER#CellLineActivity> "high"^^xsd:string .

<http://example.org/dbSUPER#disease>
  a <http://example.org/dbSUPER#Disease> ;
  <http://example.org/dbSUPER#AssociatedDisease> "cancer"^^xsd:string .

<http://example.org/dbSUPER#transcriptionFactor>
  a <http://example.org/dbSUPER#TranscriptionFactor> ;
  <http://example.org/dbSUPER#InteractingTranscriptionFactor> "TF1"^^xsd:string .