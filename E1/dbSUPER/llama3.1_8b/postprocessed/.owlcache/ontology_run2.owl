<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/dbSUPER#hasEnhancerSequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has enhancer sequence</rdfs:label>
    <skos:prefLabel xml:lang="en">has enhancer sequence</skos:prefLabel>
    <skos:definition xml:lang="en">The DNA sequence of an enhancer region.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/dbSUPER#CRM"/>
    <rdfs:range rdf:resource="http://example.org/dbSUPER#GenomicCoordinateRange"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/dbSUPER#evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evidence</rdfs:label>
    <skos:prefLabel xml:lang="en">Evidence</skos:prefLabel>
    <skos:definition xml:lang="en">A statement that supports the existence of an enhancer region.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000177"/>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/GO_0045976"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/dbSUPER#hasGenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has genomic coordinate</rdfs:label>
    <skos:prefLabel xml:lang="en">has genomic coordinate</skos:prefLabel>
    <skos:definition xml:lang="en">The genomic location of an enhancer region.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/dbSUPER#CRM"/>
    <rdfs:range rdf:resource="http://example.org/dbSUPER#GenomicCoordinate"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/dbSUPER#hasCellLineActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has cell line activity</rdfs:label>
    <skos:prefLabel xml:lang="en">has cell line activity</skos:prefLabel>
    <skos:definition xml:lang="en">The activity of a cell line in an enhancer region.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/dbSUPER#skos:closeMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">skos:closeMatch</rdfs:label>
    <skos:prefLabel xml:lang="en">skos:closeMatch</skos:prefLabel>
    <skos:definition xml:lang="en">A close match to a concept in another ontology.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/dbSUPER#hasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has evidence</rdfs:label>
    <skos:prefLabel xml:lang="en">has evidence</skos:prefLabel>
    <skos:definition xml:lang="en">The evidence supporting the existence of an enhancer region.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/dbSUPER#CRM"/>
    <rdfs:range rdf:resource="http://example.org/dbSUPER#evidence"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/dbSUPER#GenomicCoordinateRange">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genomic Coordinate Range</rdfs:label>
    <skos:prefLabel xml:lang="en">Genomic Coordinate Range</skos:prefLabel>
    <skos:definition xml:lang="en">A range of genomic coordinates.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000176"/>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/GO_0045974"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/dbSUPER#cellLineActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Line Activity</rdfs:label>
    <skos:prefLabel xml:lang="en">Cell Line Activity</skos:prefLabel>
    <skos:definition xml:lang="en">The activity of a cell line in an enhancer region.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/dbSUPER#skos:exactMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">skos:exactMatch</rdfs:label>
    <skos:prefLabel xml:lang="en">skos:exactMatch</skos:prefLabel>
    <skos:definition xml:lang="en">An exact match to a concept in another ontology.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/dbSUPER#CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cis-Regulatory Module</rdfs:label>
    <skos:prefLabel xml:lang="en">Cis-Regulatory Module</skos:prefLabel>
    <skos:definition xml:lang="en">A region of DNA that regulates gene expression.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000163"/>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/GO_0045975"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/dbSUPER#EnhancerSequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enhancer sequence</rdfs:label>
    <skos:prefLabel xml:lang="en">enhancer sequence</skos:prefLabel>
    <skos:definition xml:lang="en">The DNA sequence of an enhancer region.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/dbSUPER#GenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genomic Coordinate</rdfs:label>
    <skos:prefLabel xml:lang="en">Genomic Coordinate</skos:prefLabel>
    <skos:definition xml:lang="en">A location on the genome.</skos:definition>
  </rdf:Description>
</rdf:RDF>
