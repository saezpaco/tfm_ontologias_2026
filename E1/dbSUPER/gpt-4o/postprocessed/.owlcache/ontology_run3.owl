<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/ontology/chromosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>chromosome</skos:prefLabel>
    <skos:definition>The chromosome on which the genomic coordinate is located.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/startPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>start position</skos:prefLabel>
    <skos:definition>The start position of the genomic coordinate on the chromosome.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/GenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Genomic Coordinate</skos:prefLabel>
    <skos:definition>A specific location on a chromosome, defined by a start and end position.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasGenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>has genomic coordinate</skos:prefLabel>
    <skos:definition>Relates a CRM to its genomic coordinates.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>associated with disease</skos:prefLabel>
    <skos:definition>Indicates a disease associated with a CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Disease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/evidenceMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>evidence method</skos:prefLabel>
    <skos:definition>The method used to identify the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cis-Regulatory Module</skos:prefLabel>
    <skos:definition>A genomic region that regulates the transcription of target genes, often containing multiple binding sites for transcription factors.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000165"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/endPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>end position</skos:prefLabel>
    <skos:definition>The end position of the genomic coordinate on the chromosome.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/targetsGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>targets gene</skos:prefLabel>
    <skos:definition>Indicates the gene that is regulated by a CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CellLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cell Line</skos:prefLabel>
    <skos:definition>A cell culture developed from a single cell and therefore consisting of cells with a uniform genetic makeup.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/assembly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>assembly</skos:prefLabel>
    <skos:definition>The genome assembly version used for the genomic coordinate.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gene</skos:prefLabel>
    <skos:definition>A sequence of DNA that contains the necessary information to produce a functional product, typically a protein.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000704"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Disease</skos:prefLabel>
    <skos:definition>A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/activeInCellLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>active in cell line</skos:prefLabel>
    <skos:definition>Indicates the cell line in which a CRM is active.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/CellLine"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/score">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>score</skos:prefLabel>
    <skos:definition>A score representing the confidence or strength of the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
</rdf:RDF>
