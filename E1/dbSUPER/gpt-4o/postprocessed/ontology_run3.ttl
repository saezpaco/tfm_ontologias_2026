@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/dbSUPER> a owl:Ontology .

### Classes
<http://example.org/ontology/CRM> a owl:Class ;
    skos:prefLabel "Cis-Regulatory Module" ;
    skos:definition "A genomic region that regulates the transcription of target genes, often containing multiple binding sites for transcription factors." ;
    skos:exactMatch obo:SO_0000165 .

<http://example.org/ontology/GenomicCoordinate> a owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location on a chromosome, defined by a start and end position." .

<http://example.org/ontology/CellLine> a owl:Class ;
    skos:prefLabel "Cell Line" ;
    skos:definition "A cell culture developed from a single cell and therefore consisting of cells with a uniform genetic makeup." .

<http://example.org/ontology/Gene> a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, typically a protein." ;
    skos:exactMatch obo:SO_0000704 .

<http://example.org/ontology/Disease> a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms." ;
    skos:exactMatch obo:DOID_4 .

### Object Properties
<http://example.org/ontology/hasGenomicCoordinate> a owl:ObjectProperty ;
    skos:prefLabel "has genomic coordinate" ;
    skos:definition "Relates a CRM to its genomic coordinates." ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/GenomicCoordinate> .

<http://example.org/ontology/activeInCellLine> a owl:ObjectProperty ;
    skos:prefLabel "active in cell line" ;
    skos:definition "Indicates the cell line in which a CRM is active." ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/CellLine> .

<http://example.org/ontology/targetsGene> a owl:ObjectProperty ;
    skos:prefLabel "targets gene" ;
    skos:definition "Indicates the gene that is regulated by a CRM." ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Gene> .

<http://example.org/ontology/associatedWithDisease> a owl:ObjectProperty ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Indicates a disease associated with a CRM." ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Disease> .

### Datatype Properties
<http://example.org/ontology/chromosome> a owl:DatatypeProperty ;
    skos:prefLabel "chromosome" ;
    skos:definition "The chromosome on which the genomic coordinate is located." ;
    rdfs:domain <http://example.org/ontology/GenomicCoordinate> ;
    rdfs:range xsd:string .

<http://example.org/ontology/startPosition> a owl:DatatypeProperty ;
    skos:prefLabel "start position" ;
    skos:definition "The start position of the genomic coordinate on the chromosome." ;
    rdfs:domain <http://example.org/ontology/GenomicCoordinate> ;
    rdfs:range xsd:integer .

<http://example.org/ontology/endPosition> a owl:DatatypeProperty ;
    skos:prefLabel "end position" ;
    skos:definition "The end position of the genomic coordinate on the chromosome." ;
    rdfs:domain <http://example.org/ontology/GenomicCoordinate> ;
    rdfs:range xsd:integer .

<http://example.org/ontology/assembly> a owl:DatatypeProperty ;
    skos:prefLabel "assembly" ;
    skos:definition "The genome assembly version used for the genomic coordinate." ;
    rdfs:domain <http://example.org/ontology/GenomicCoordinate> ;
    rdfs:range xsd:string .

<http://example.org/ontology/evidenceMethod> a owl:DatatypeProperty ;
    skos:prefLabel "evidence method" ;
    skos:definition "The method used to identify the CRM." ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string .

<http://example.org/ontology/score> a owl:DatatypeProperty ;
    skos:prefLabel "score" ;
    skos:definition "A score representing the confidence or strength of the CRM." ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:float .