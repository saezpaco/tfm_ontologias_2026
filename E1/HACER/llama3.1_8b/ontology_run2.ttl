@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/hacer>
  a owl:Ontology ;
  rdfs:label "Human Active Cis-regulatory Elements database" ;
  skos:prefLabel "HACER Database" ;
  skos:definition "Database of human active cis-regulatory elements." .

crm:CRM
  a owl:Class ;
  rdfs:label "Cis-Regulatory Module (CRM)" ;
  skos:prefLabel "CRM" ;
  skos:definition "A region of DNA that regulates gene expression." ;
  rdfs:subClassOf obo:SO_0000163 .

crm:GenomicCoordinate
  a owl:ObjectProperty ;
  rdfs:label "Genomic Coordinate" ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "A point in the genome where a CRM is located." ;
  rdfs:domain crm:CRM ;
  rdfs:range xsd:string .

crm:hasOriginalChr
  a owl:ObjectProperty ;
  rdfs:label "Has Original Chromosome" ;
  skos:prefLabel "Has Original Chr" ;
  skos:definition "The original chromosome where the CRM is located." ;
  rdfs:domain crm:CRM ;
  rdfs:range xsd:string .

crm:hasOriginalStart
  a owl:ObjectProperty ;
  rdfs:label "Has Original Start Coordinate" ;
  skos:prefLabel "Has Original Start" ;
  skos:definition "The original start coordinate of the CRM." ;
  rdfs:domain crm:CRM ;
  rdfs:range xsd:string .

crm:hasOriginalEnd
  a owl:ObjectProperty ;
  rdfs:label "Has Original End Coordinate" ;
  skos:prefLabel "Has Original End" ;
  skos:definition "The original end coordinate of the CRM." ;
  rdfs:domain crm:CRM ;
  rdfs:range xsd:string .

crm:evidence
  a owl:ObjectProperty ;
  rdfs:label "Evidence for CRM Activity" ;
  skos:prefLabel "Evidence" ;
  skos:definition "Experimental evidence supporting CRM activity." ;
  rdfs:domain crm:CRM ;
  rdfs:range obo:SO_0000315 .

crm:hasCellLine
  a owl:ObjectProperty ;
  rdfs:label "Has Cell Line" ;
  skos:prefLabel "Has Cell Line" ;
  skos:definition "The cell line where CRM activity was observed." ;
  rdfs:domain crm:CRM ;
  rdfs:range xsd:string .

crm:hasTargetGene
  a owl:ObjectProperty ;
  rdfs:label "Has Target Gene" ;
  skos:prefLabel "Has Target Gene" ;
  skos:definition "The gene regulated by the CRM." ;
  rdfs:domain crm:CRM ;
  rdfs:range obo:SO_0000704 .

crm:hasDisease
  a owl:ObjectProperty ;
  rdfs:label "Has Disease Association" ;
  skos:prefLabel "Has Disease" ;
  skos:definition "The disease associated with CRM activity." ;
  rdfs:domain crm:CRM ;
  rdfs:range obo:SO_0000705 .

crm:hasTranscriptionFactor
  a owl:ObjectProperty ;
  rdfs:label "Has Transcription Factor" ;
  skos:prefLabel "Has Transcription Factor" ;
  skos:definition "The transcription factor interacting with the CRM." ;
  rdfs:domain crm:CRM ;
  rdfs:range obo:SO_0000706 .

crm:evidencePMID
  a owl:DatatypeProperty ;
  rdfs:label "Evidence PMID" ;
  skos:prefLabel "Evidence PMID" ;
  skos:definition "The PubMed ID of the evidence supporting CRM activity." ;
  rdfs:domain crm:CRM ;
  rdfs:range xsd:string .

crm:evidenceMethod
  a owl:DatatypeProperty ;
  rdfs:label "Evidence Method" ;
  skos:prefLabel "Evidence Method" ;
  skos:definition "The method used to determine CRM activity." ;
  rdfs:domain crm:CRM ;
  rdfs:range xsd:string .

crm:diseasePMID
  a owl:DatatypeProperty ;
  rdfs:label "Disease PMID" ;
  skos:prefLabel "Disease PMID" ;
  skos:definition "The PubMed ID of the disease associated with CRM activity." ;
  rdfs:domain crm:CRM ;
  rdfs:range xsd:string .

crm:diseaseMethod
  a owl:DatatypeProperty ;
  rdfs:label "Disease Method" ;
  skos:prefLabel "Disease Method" ;
  skos:definition "The method used to determine disease association." ;
  rdfs:domain crm:CRM ;
  rdfs:range xsd:string .

crm:refsnpID
  a owl:DatatypeProperty ;
  rdfs:label "RefSNP ID" ;
  skos:prefLabel "RefSNP ID" ;
  skos:definition "The RefSNP ID associated with the CRM." ;
  rdfs:domain crm:CRM ;
  rdfs:range xsd:string .

crm:evidenceType
  a owl:ObjectProperty ;
  rdfs:label "Evidence Type" ;
  skos:prefLabel "Evidence Type" ;
  skos:definition "The type of evidence supporting CRM activity." ;
  rdfs:domain crm:CRM ;
  rdfs:range obo:SO_0000315 .

crm:diseaseType
  a owl:ObjectProperty ;
  rdfs:label "Disease Type" ;
  skos:prefLabel "Disease Type" ;
  skos:definition "The type of disease associated with CRM activity." ;
  rdfs:domain crm:CRM ;
  rdfs:range obo:SO_0000705 .