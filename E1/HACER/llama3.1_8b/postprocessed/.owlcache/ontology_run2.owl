>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasTranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has Transcription Factor</rdfs:label>
    <skos:prefLabel>Has Transcription Factor</skos:prefLabel>
    <skos:definition>The transcription factor interacting with the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/SO_0000706"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/GenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Genomic Coordinate</rdfs:label>
    <skos:prefLabel>Genomic Coordinate</skos:prefLabel>
    <skos:definition>A point in the genome where a CRM is located.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasOriginalEnd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has Original End Coordinate</rdfs:label>
    <skos:prefLabel>Has Original End</skos:prefLabel>
    <skos:definition>The original end coordinate of the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasOriginalStart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has Original Start Coordinate</rdfs:label>
    <skos:prefLabel>Has Original Start</skos:prefLabel>
    <skos:definition>The original start coordinate of the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has Disease Association</rdfs:label>
    <skos:prefLabel>Has Disease</skos:prefLabel>
    <skos:definition>The disease associated with CRM activity.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/SO_0000705"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has Target Gene</rdfs:label>
    <skos:prefLabel>Has Target Gene</skos:prefLabel>
    <skos:definition>The gene regulated by the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/SO_0000704"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasOriginalChr">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has Original Chromosome</rdfs:label>
    <skos:prefLabel>Has Original Chr</skos:prefLabel>
    <skos:definition>The original chromosome where the CRM is located.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/hacer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Human Active Cis-regulatory Elements database</rdfs:label>
    <skos:prefLabel>HACER Database</skos:prefLabel>
    <skos:definition>Database of human active cis-regulatory elements.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/diseaseMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Disease Method</rdfs:label>
    <skos:prefLabel>Disease Method</skos:prefLabel>
    <skos:definition>The method used to determine disease association.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/evidenceMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Evidence Method</rdfs:label>
    <skos:prefLabel>Evidence Method</skos:prefLabel>
    <skos:definition>The method used to determine CRM activity.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasCellLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has Cell Line</rdfs:label>
    <skos:prefLabel>Has Cell Line</skos:prefLabel>
    <skos:definition>The cell line where CRM activity was observed.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Evidence for CRM Activity</rdfs:label>
    <skos:prefLabel>Evidence</skos:prefLabel>
    <skos:definition>Experimental evidence supporting CRM activity.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/SO_0000315"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/evidenceType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Evidence Type</rdfs:label>
    <skos:prefLabel>Evidence Type</skos:prefLabel>
    <skos:definition>The type of evidence supporting CRM activity.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/SO_0000315"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/diseaseType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Disease Type</rdfs:label>
    <skos:prefLabel>Disease Type</skos:prefLabel>
    <skos:definition>The type of disease associated with CRM activity.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/SO_0000705"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/refsnpID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>RefSNP ID</rdfs:label>
    <skos:prefLabel>RefSNP ID</skos:prefLabel>
    <skos:definition>The RefSNP ID associated with the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/diseasePMID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Disease PMID</rdfs:label>
    <skos:prefLabel>Disease PMID</skos:prefLabel>
    <skos:definition>The PubMed ID of the disease associated with CRM activity.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/evidencePMID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Evidence PMID</rdfs:label>
    <skos:prefLabel>Evidence PMID</skos:prefLabel>
    <skos:definition>The PubMed ID of the evidence supporting CRM activity.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cis-Regulatory Module (CRM)</rdfs:label>
    <skos:prefLabel>CRM</skos:prefLabel>
    <skos:definition>A region of DNA that regulates gene expression.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0000163"/>
  </rdf:Description>
</rdf:RDF>
