@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://rdf.biogateway.eu/crm/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "Human Active Cis-regulatory Elements Database Ontology" ;
    skos:prefLabel "HACE Ontology" ;
    skos:definition "An ontology for representing and describing cis-regulatory elements in the human genome." ;
}

crm:Enhancer a owl:Class ;
    rdfs:subClassOf obo:SO_0001765 ;
    skos:prefLabel "Cis-regulatory element" ;
    skos:definition "A region of DNA that affects the transcription, translation, or stability of another gene." .

crm:GenomicCoordinate a owl:Class ;
    rdfs:subClassOf obo:SO_0001765 ;
    skos:prefLabel "Genomic coordinate" ;
    skos:definition "A specific location within a genome." .

crm:startCoordinate a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Coordinate" ;
    skos:definition "The starting position of the genomic coordinate on the chromosome." ;

crm:endCoordinate a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Coordinate" ;
    skos:definition "The ending position of the genomic coordinate on the chromosome." .

crm:evidence a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0008279 ;
    skos:prefLabel "Evidence" ;
    skos:definition "Supporting information or data that confirms the presence or function of a cis-regulatory element." .

crm:evidenceType a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range obo:GO_0008279 ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of evidence used to support the presence or function of a cis-regulatory element." .

crm:evidenceSource a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:anyURI ;
    skos:prefLabel "Evidence Source" ;
    skos:definition "The source from which the evidence was obtained." .
