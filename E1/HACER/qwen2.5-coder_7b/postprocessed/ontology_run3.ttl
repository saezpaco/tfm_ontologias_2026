@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://rdf.biogateway.eu/crm/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "Human Active Cis-regulatory Elements Database Ontology" ;
    skos:prefLabel "HACE Ontology" ;
    skos:definition "An ontology for representing and linking data from the Human Active Cis-regulatory Elements (HACE) database." ;
}

crm:Enhancer a owl:Class ;
    rdfs:label "Cis-Regulatory Element" ;
    skos:prefLabel "Cis-Regulatory Element" ;
    skos:definition "A DNA sequence that can affect the transcription of other genes in the same chromosome." ;
    skos:exactMatch obo:SIO_010245 .

crm:GenomicCoordinate a owl:Class ;
    rdfs:label "Genomic Coordinate" ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location on a chromosome." ;

crm:startCoordinate a owl:DatatypeProperty ;
    rdfs:label "Start Coordinate" ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Coordinate" ;
    skos:definition "The starting position of the genomic coordinate." ;

crm:endCoordinate a owl:DatatypeProperty ;
    rdfs:label "End Coordinate" ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Coordinate" ;
    skos:definition "The ending position of the genomic coordinate." ;

crm:evidence a owl:ObjectProperty ;
    rdfs:label "Evidence" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:Evidence ;
    skos:prefLabel "Evidence" ;
    skos:definition "Supporting information for the enhancer's function." ;

crm:Evidence a owl:Class ;
    rdfs:label "Evidence" ;
    skos:prefLabel "Evidence" ;
    skos:definition "Information that supports or confirms the existence of an enhancer." ;

crm:evidenceType a owl:DatatypeProperty ;
    rdfs:label "Evidence Type" ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of evidence supporting the enhancer's function." ;

crm:evidenceSource a owl:DatatypeProperty ;
    rdfs:label "Evidence Source" ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:anyURI ;
    skos:prefLabel "Evidence Source" ;
    skos:definition "The source of the evidence supporting the enhancer's function." ;

crm:evidenceDescription a owl:DatatypeProperty ;
    rdfs:label "Evidence Description" ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Description" ;
    skos:definition "A description of the evidence supporting the enhancer's function." ;

crm:enhances a owl:ObjectProperty ;
    rdfs:label "Enhances" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;
    skos:prefLabel "Enhances" ;
    skos:definition "The process by which an enhancer increases the transcription of a gene." ;
    skos:closeMatch obo:GO_0003725 .

crm:transcriptionFactor a owl:ObjectProperty ;
    rdfs:label "Transcription Factor" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001468 ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that binds to DNA and regulates the transcription of genes." ;
    skos:closeMatch obo:SO_0001468 .

crm:cellType a owl:ObjectProperty ;
    rdfs:label "Cell Type" ;
    rdfs:domain crm:Evidence ;
    rdfs:range obo:CL_0000579 ;
    skos:prefLabel "Cell Type" ;
    skos:definition "A type of cell in the body." ;
    skos:closeMatch obo:CL_0000579 .

crm:tissueType a owl:ObjectProperty ;
    rdfs:label "Tissue Type" ;
    rdfs:domain crm:Evidence ;
    rdfs:range obo:UBERON_0001062 ;
    skos:prefLabel "Tissue Type" ;
    skos:definition "A type of tissue in the body." ;
    skos:closeMatch obo:UBERON_0001062 .
