<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/ontology/Evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Evidence</skos:prefLabel>
    <skos:definition>Information supporting the existence or function of a biological entity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/chromosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>chromosome</skos:prefLabel>
    <skos:definition>The chromosome on which the genomic coordinate is located.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/startPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:prefLabel>start position</skos:prefLabel>
    <skos:definition>The start position of the genomic coordinate on the chromosome.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/assemblyVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>assembly version</skos:prefLabel>
    <skos:definition>The genome assembly version used for the genomic coordinate.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/GenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Genomic Coordinate</skos:prefLabel>
    <skos:definition>A specific location on a chromosome defined by a start and end position.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/Evidence"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>method</skos:prefLabel>
    <skos:definition>The method used to obtain the evidence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/minimumRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <skos:prefLabel>minimum ratio</skos:prefLabel>
    <skos:definition>The minimum ratio of activity observed for the CRM.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasGenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <skos:prefLabel>has genomic coordinate</skos:prefLabel>
    <skos:definition>Associates a CRM with its genomic coordinates.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Evidence"/>
    <skos:prefLabel>has evidence</skos:prefLabel>
    <skos:definition>Associates a CRM with evidence supporting its function.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/PMID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/Evidence"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>PubMed ID</skos:prefLabel>
    <skos:definition>The PubMed ID of the publication providing the evidence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cis-regulatory Module</skos:prefLabel>
    <skos:definition>A genomic region that regulates the expression of a target gene.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000165"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/score">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <skos:prefLabel>score</skos:prefLabel>
    <skos:definition>A score representing the activity level of the CRM.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/endPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:prefLabel>end position</skos:prefLabel>
    <skos:definition>The end position of the genomic coordinate on the chromosome.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
</rdf:RDF>
