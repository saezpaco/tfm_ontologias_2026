<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Genomic Coordinate</skos:prefLabel>
    <skos:definition>A specific location on a chromosome, defined by a start and end position.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/evidenceMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/ExperimentalEvidence"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>evidence method</skos:prefLabel>
    <skos:definition>The method used to obtain experimental evidence for the cis-regulatory module.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/hasExperimentalEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/ExperimentalEvidence"/>
    <skos:prefLabel>has experimental evidence</skos:prefLabel>
    <skos:definition>Associates a cis-regulatory module with the experimental evidence supporting its function.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/endPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:prefLabel>end position</skos:prefLabel>
    <skos:definition>The end position of the genomic coordinate on the chromosome.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/startPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:prefLabel>start position</skos:prefLabel>
    <skos:definition>The start position of the genomic coordinate on the chromosome.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/chromosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>chromosome</skos:prefLabel>
    <skos:definition>The chromosome on which the genomic coordinate is located.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/Enhancer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Enhancer</skos:prefLabel>
    <skos:definition>A type of cis-regulatory module that increases the transcription of target genes.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000165"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/assembly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>assembly</skos:prefLabel>
    <skos:definition>The genome assembly version used for the genomic coordinate.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/hasGenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate"/>
    <skos:prefLabel>has genomic coordinate</skos:prefLabel>
    <skos:definition>Associates a cis-regulatory module with its genomic coordinates.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/ExperimentalEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Experimental Evidence</skos:prefLabel>
    <skos:definition>Evidence obtained through experimental methods to support the existence or function of a biological entity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cis-regulatory Module</skos:prefLabel>
    <skos:definition>A genomic region that regulates the expression of genes, often containing multiple binding sites for transcription factors.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000165"/>
  </rdf:Description>
</rdf:RDF>
