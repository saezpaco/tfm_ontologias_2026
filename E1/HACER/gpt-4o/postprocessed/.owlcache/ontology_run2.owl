<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/ontology/hasStartPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has start position</skos:prefLabel>
    <skos:definition>The start position of the genomic coordinate.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasChromosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has chromosome</skos:prefLabel>
    <skos:definition>The chromosome on which the genomic coordinate is located.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/GenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Genomic Coordinate</skos:prefLabel>
    <skos:definition>A specific location on a chromosome defined by a start and end position.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/regulatesTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>regulates target gene</skos:prefLabel>
    <skos:definition>Indicates the target gene regulated by the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/TargetGene"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasEvidencePMID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has evidence PMID</skos:prefLabel>
    <skos:definition>The PubMed ID of the publication providing evidence for the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasGenomicCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>has genomic coordinate</skos:prefLabel>
    <skos:definition>Relates a CRM to its genomic coordinates.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cis-regulatory Module</skos:prefLabel>
    <skos:definition>A genomic region that regulates the expression of a target gene.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000165"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>associated with disease</skos:prefLabel>
    <skos:definition>Indicates the disease associated with the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Disease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/TargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Target Gene</skos:prefLabel>
    <skos:definition>A gene whose expression is regulated by a cis-regulatory module.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000704"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/interactsWithTF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>interacts with transcription factor</skos:prefLabel>
    <skos:definition>Indicates the transcription factor that interacts with the CRM.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/TranscriptionFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasAssembly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has assembly</skos:prefLabel>
    <skos:definition>The genome assembly version of the genomic coordinate.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CellLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cell Line</skos:prefLabel>
    <skos:definition>A cell culture developed from a single cell and therefore consisting of cells with a uniform genetic makeup.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasEndPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has end position</skos:prefLabel>
    <skos:definition>The end position of the genomic coordinate.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/GenomicCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Disease</skos:prefLabel>
    <skos:definition>A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/activeInCellLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>active in cell line</skos:prefLabel>
    <skos:definition>Indicates the cell line in which the CRM is active.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/CellLine"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
    <skos:definition>A protein that binds to specific DNA sequences, thereby controlling the rate of transcription of genetic information.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/GO_0003700"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/HACER">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
</rdf:RDF>
