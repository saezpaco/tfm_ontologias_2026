@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://rdf.biogateway.eu/gene/9606/> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .
@prefix nuccore: <http://ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix linkml: <https://w3id.org/linkml/> .

hcrm:crm_ID rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000727 ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" ;
    skos:prefLabel "crm/crm_ID" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ; #in taxon "human"
    dc:hasVersion assembly:GCF_000001405.26 ; #hg38 assembly as reference
    obo:BFO_0000050 nuccore:chr_ID ; #chromosome
    obo:GENO_0000895 "start_position"^^xsd:string ;
    obo:GENO_0000894 "end_position"^^xsd:string .

<http://rdf.biogateway.eu/crm/9606/crm_ID#database_name> rdf:type hcrm:crm_ID ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position according to database_name" ;
    skos:prefLabel "crm#crm_ID#database_name" ;
    obo:TXPO_0003500 obo:BTO_ID ; #Cell line, cell type or anatomical structure
    obo:TXPO_0003500 obo:CL_ID ; #Cell type
    obo:TXPO_0003500 obo:CLO_ID ; #Cell line
    obo:TXPO_0003500 obo:UBERON_ID ; #Anatomical structure
    schema:evidenceOrigin <original_URL_crossreference> ; #Crossreference
    rdfs:isDefinedBy obo:ECO_ID ; #Experimental evidence
    sio:SIO_000772 id_pubmed:pubmed_ID ; #Article
    sio:SIO_000253 <original_URL_database> . #Original Database

obo:SO_0000727 rdf:type owl:Class ;
    skos:prefLabel "CRM" ;
    skos:altLabel "cis-regulatory module" ;
    linkml:is_a biolink:RegulatoryRegion .

nuccore:chr_ID rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000340 ;
    skos:prefLabel "chr_name" ;
    biolink:category biolink:GenomicSequenceLocalization ;
    skos:closeMatch obo:NCIT_ID .

obo:NCBITaxon_9606 biolink:category biolink:OrganismTaxon .

assembly:GCF_000001405.26 rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0001505 ;
    skos:prefLabel "GRCh38" ;
    skos:altLabel "hg38" ;
    biolink:category biolink:Genome .

obo:CL_ID biolink:category biolink:Cell .
obo:CLO_ID biolink:category biolink:CellLine .
obo:UBERON_ID biolink:category biolink:GrossAnatomicalStructure .
obo:ECO_ID biolink:category biolink:EvidenceType .

id_pubmed:pubmed_ID skos:exactMatch pubmed:pubmed_ID .
pubmed:pubmed_ID biolink:category biolink:Article .

<original_URL_database> rdf:type owl:Class ;
    rdfs:subClassOf obo:NCIT_C15426 ;
    skos:prefLabel "database_name" ;
    biolink:category biolink:InformationResource .

obo:NCIT_C15426 rdf:type owl:Class ;
    skos:prefLabel "Database" .

<http://rdf.biogateway.eu/crm2pgene/bgw!crm_ID--hgncsymbol!9606/gene_sybmol> rdf:type owl:Class ;
    rdfs:subClassOf rdf:Statement ;
    rdf:subject hcrm:crm_ID ;
    rdf:predicate obo:RO_0002429 ;
    rdf:object hgene:gene_sybmol ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" ;
    skos:definition "Association between cis-regulatory module CRMHS00000003515 and gene TBX5" .

hcrm:crm_ID obo:RO_0002429 hgene:gene_sybmol .

hgene:gene_symbol skos:closeMatch id_ncbigene:GeneID ;
    biolink:category biolink:Gene .
