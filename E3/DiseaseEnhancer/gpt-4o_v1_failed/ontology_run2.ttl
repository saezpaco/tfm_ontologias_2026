hcrm:CRMHS00000001594 rdf:type obo:SO_0000727 ;
    skos:prefLabel "CRMHS00000001594" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ;
    dc:hasVersion assembly:GCF_000001405.26 ;
    obo:BFO_0000050 nuccore:chr5 ;
    obo:GENO_0000895 "125315470"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    obo:GENO_0000894 "125318494"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    sio:SIO_000772 id_pubmed:25701871 ;
    sio:SIO_000253 <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> ;
    obo:RO_0002429 hgene:LMNB1 .

crm2pgene:bgw!CRMHS00000001594--hgncsymbol!9606/LMNB1 rdf:type owl:Class ;
    rdfs:subClassOf rdf:Statement ;
    rdf:subject hcrm:CRMHS00000001594 ;
    rdf:predicate obo:RO_0002429 ;
    rdf:object hgene:LMNB1 ;
    skos:prefLabel "bgw!CRMHS00000001594--hgncsymbol!9606/LMNB1" ;
    skos:definition "Association between cis-regulatory module CRMHS00000001594 and gene LMNB1" ;
    sio:SIO_000772 id_pubmed:25701871 ;
    sio:SIO_000253 <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> .

hgene:LMNB1 skos:closeMatch id_ncbigene:LMNB1 ;
    biolink:category biolink:Gene .

disease:169500 rdf:type owl:Class ;
    skos:prefLabel "Pelizaeus-Merzbacher disease" ;
    skos:exactMatch <http://omim.org/entry/169500> .

