@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://purl.obolibrary.org/obo/hgnc#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgnc#> .
@prefix assembly: <http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore: <http://purl.obolibrary.org/obo/nuccore#> .
@prefix pubmed:  <http://purl.obolibrary.org/obo/pubmed#> .
@prefix id_pubmed: <http://purl.obolibrary.org/obo/id_pubmed#> .
@prefix id_ncbigene: <http://purl.obolibrary.org/obo/id_ncbigene#> .
@prefix dbsuper: <http://purl.obolibrary.org/obo/dbsuper#> .

# Classes
<http://example.org/DiseaseEnhancer> a owl:Ontology ;
    rdfs:label "Disease Enhancer Ontology" ;
    skos:prefLabel "Disease Enhancer Ontology"@en .
<http://example.org/CisRegulatoryModule> a owl:Class ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:prefLabel "Cis-Regulatory Module"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/crm#CisRegulatoryModule> .
<http://example.org/EnhancerSequence> a owl:Class ;
    rdfs:label "Enhancer Sequence" ;
    skos:prefLabel "Enhancer Sequence"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/crm#CisRegulatoryModule> .
<http://example.org/DiseaseAssociation> a owl:Class ;
    rdfs:label "Disease Association" ;
    skos:prefLabel "Disease Association"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/crm#CisRegulatoryModule> .
<http://example.org/GeneAssociation> a owl:Class ;
    rdfs:label "Gene Association" ;
    skos:prefLabel "Gene Association"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/crm#CisRegulatoryModule> .

# Properties
<http://example.org/hasEnhancerSequence> a owl:ObjectProperty ;
    rdfs:label "Has Enhancer Sequence" ;
    skos:prefLabel "Has Enhancer Sequence"@en ;
    rdfs:domain <http://example.org/CisRegulatoryModule> ;
    rdfs:range <http://example.org/EnhancerSequence> .
<http://example.org/hasDiseaseAssociation> a owl:ObjectProperty ;
    rdfs:label "Has Disease Association" ;
    skos:prefLabel "Has Disease Association"@en ;
    rdfs:domain <http://example.org/CisRegulatoryModule> ;
    rdfs:range <http://example.org/DiseaseAssociation> .
<http://example.org/hasGeneAssociation> a owl:ObjectProperty ;
    rdfs:label "Has Gene Association" ;
    skos:prefLabel "Has Gene Association"@en ;
    rdfs:domain <http://example.org/CisRegulatoryModule> ;
    rdfs:range <http://example.org/GeneAssociation> .

# Individuals
<http://example.org/CRM1> a <http://example.org/CisRegulatoryModule> ;
    <http://example.org/hasEnhancerSequence> <http://example.org/ES1> .
<http://example.org/CRM2> a <http://example.org/CisRegulatoryModule> ;
    <http://example.org/hasDiseaseAssociation> <http://example.org/DA1> .

# Alignments
<http://purl.obolibrary.org/obo/crm#CisRegulatoryModule> skos:exactMatch <http://example.org/CisRegulatoryModule> .
<http://purl.obolibrary.org/obo/hgnc#Gene> skos:closeMatch <http://example.org/GeneAssociation> .