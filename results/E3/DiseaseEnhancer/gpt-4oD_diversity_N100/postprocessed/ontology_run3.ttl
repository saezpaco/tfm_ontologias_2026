@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix crm2tfac: <http://rdf.biogateway.eu/crm2tfac/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix hgnc:    <http://identifiers.org/hgnc/> .
@prefix mesh:    <http://id.nlm.nih.gov/mesh/> .
@prefix doid:    <http://purl.obolibrary.org/obo/DOID_> .
@prefix omim:    <http://purl.obolibrary.org/obo/OMIM_> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> a owl:Ontology ;
    rdfs:label "DiseaseEnhancer" ;
    dc:description "Enhancers associated with diseases" ;
    dc:source <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> .

### Classes ###
biolink:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch <http://www.licpathway.net/ENdb/> .

biolink:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

biolink:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch crm2phen:Disease .

biolink:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCIT_C17207> .

### Properties ###
biolink:hasGenomicLocation a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    skos:exactMatch <http://www.licpathway.net/ENdb/> .

biolink:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    skos:exactMatch crm2pgene:targetsGene .

biolink:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    skos:exactMatch crm2phen:associatedWithDisease .

biolink:interactsWithTF a owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    skos:exactMatch crm2tfac:interactsWithTF .

### Individuals ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00027685823> a biolink:Enhancer ;
    biolink:hasGenomicLocation [
        a sio:SIO_000984 ;
        sio:SIO_000300 "chr1:155217211-155226809"^^xsd:string ;
        sio:SIO_000221 "hg38"^^xsd:string
    ] ;
    biolink:targetsGene hgnc:CKS1B ;
    biolink:associatedWithDisease mesh:D051436 ;
    dc:identifier "CRMHS00027685823" ;
    pubmed:29093029 .

