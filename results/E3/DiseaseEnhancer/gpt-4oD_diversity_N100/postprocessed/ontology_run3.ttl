<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00027685647> a biolink:Enhancer ;
    biolink:hasGenomicLocation [
        a sio:SIO_000984 ;
        sio:SIO_000300 "chr4:88002050-88003648"^^xsd:string ;
        sio:SIO_000221 "hg38"^^xsd:string
    ] ;
