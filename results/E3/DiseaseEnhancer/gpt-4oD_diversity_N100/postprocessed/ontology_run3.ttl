<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00000006099> a biolink:Enhancer ;
    biolink:hasGenomicLocation [
        a sio:SIO_000984 ;
        sio:SIO_000300 "chr8:127386357-127404755"^^xsd:string ;
        sio:SIO_000221 "hg38"^^xsd:string
    ] ;
