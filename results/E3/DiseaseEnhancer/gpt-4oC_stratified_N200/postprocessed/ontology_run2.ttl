@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix crm2tfac: <http://rdf.biogateway.eu/crm2tfac/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm2phen/bgw!> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix id_pubmed: <http://rdf.biogateway.eu/id_pubmed/> .
@prefix id_ncbigene: <http://rdf.biogateway.eu/id_ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> rdf:type owl:Ontology ;
    rdfs:label "DiseaseEnhancer Ontology" ;
    dc:description "Ontology for enhancers associated with diseases" .

### Classes ###
biolink:Enhancer rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch crm2phen:Enhancer .

biolink:Gene rdf:type owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

biolink:Disease rdf:type owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch crm2phen:Disease .

biolink:TranscriptionFactor rdf:type owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch obo:NCIT_C17207 .

### Properties ###
biolink:hasGenomicLocation rdf:type owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    skos:exactMatch crm2phen:hasGenomicLocation .

biolink:targetsGene rdf:type owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    skos:exactMatch crm2pgene:targetsGene .

biolink:associatedWithDisease rdf:type owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    skos:exactMatch crm2phen:associatedWithDisease .

biolink:interactsWithTranscriptionFactor rdf:type owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    skos:exactMatch crm2tfac:interactsWithTranscriptionFactor .

biolink:hasPubMedID rdf:type owl:DatatypeProperty ;
    rdfs:label "has PubMed ID" ;
    skos:exactMatch pubmed:hasPubMedID .

### Individuals ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00027685658> rdf:type biolink:Enhancer ;
    biolink:hasGenomicLocation [
        a biolink:GenomicLocation ;
        schema:chromosome "chr20" ;
        schema:startPosition "63252073"^^xsd:integer ;
        schema:endPosition "63256931"^^xsd:integer ;
        schema:assembly "hg38"
    ] ;
    biolink:targetsGene <http://rdf.biogateway.eu/id_ncbigene/NKAIN4> ;
    biolink:associatedWithDisease obo:DOID_1612 ;
    biolink:hasPubMedID id_pubmed:27723759 .

<http://rdf.biogateway.eu/id_ncbigene/NKAIN4> rdf:type biolink:Gene ;
    rdfs:label "NKAIN4" .

obo:DOID_1612 rdf:type biolink:Disease ;
    rdfs:label "Disease associated with DOID:1612" .

id_pubmed:27723759 rdf:type pubmed:PubMedID ;
    rdfs:label "PubMed ID 27723759" .

# Additional individuals and properties would be defined similarly for other rows in the dataset.