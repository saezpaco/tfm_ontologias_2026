@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2tfac: <http://rdf.biogateway.eu/crm2tfac/> .
@prefix hgnc: <http://identifiers.org/hgnc/> .
@prefix doid: <http://purl.obolibrary.org/obo/DOID_> .
@prefix mesh: <http://id.nlm.nih.gov/mesh/> .
@prefix omim: <http://purl.obolibrary.org/obo/OMIM_> .
@prefix pubmed: <http://identifiers.org/pubmed/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> rdf:type owl:Ontology ;
    rdfs:label "DiseaseEnhancer Ontology" ;
    dc:description "Ontology for enhancers associated with diseases" ;
    dc:source <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> .

### Classes ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch crm2phen:Enhancer .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Gene> rdf:type owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Disease> rdf:type owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch crm2phen:Disease .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/TranscriptionFactor> rdf:type owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch crm2tfac:TranscriptionFactor .

### Properties ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/hasGenomicCoordinate> rdf:type owl:ObjectProperty ;
    rdfs:label "has genomic coordinate" ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:range <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/GenomicCoordinate> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/targetsGene> rdf:type owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:range <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Gene> ;
    skos:exactMatch crm2pgene:targetsGene .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/associatedWithDisease> rdf:type owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:range <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Disease> ;
    skos:exactMatch crm2phen:associatedWithDisease .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/interactsWithTF> rdf:type owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:range <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/TranscriptionFactor> ;
    skos:exactMatch crm2tfac:interactsWithTF .

### Individuals ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00027685658> rdf:type <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:label "CRMHS00027685658" ;
    <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/hasGenomicCoordinate> [
        rdf:type <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/GenomicCoordinate> ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/orig_chr> "chr20" ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/orig_start> "61883425"^^xsd:integer ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/orig_end> "61888283"^^xsd:integer ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/orig_assembly> "hg19" ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/current_chr> "chr20" ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/current_start> "63252073"^^xsd:integer ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/current_end> "63256931"^^xsd:integer ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/current_assembly> "hg38"
    ] ;
    <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/targetsGene> hgnc:NKAIN4 ;
    <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/associatedWithDisease> doid:1612 ;
    dc:source pubmed:27723759 .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00000005790> rdf:type <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:label "CRMHS00000005790" ;
    <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/hasGenomicCoordinate> [
        rdf:type <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/GenomicCoordinate> ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/orig_chr> "chr10" ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/orig_start> "43581056"^^xsd:integer ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/orig_end> "43583056"^^xsd:integer ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/orig_assembly> "hg19" ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/current_chr> "chr10" ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/current_start> "43085608"^^xsd:integer ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/current_end> "43087608"^^xsd:integer ;
        <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/current_assembly> "hg38"
    ] ;
    <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/targetsGene> hgnc:RET ;
    <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/associatedWithDisease> doid:10487 ;
    dc:source pubmed:25839327 .

# Additional individuals would follow the same pattern...