@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://purl.obolibrary.org/obo/hcrm#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgene#> .
@prefix assembly: <http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore:  <http://purl.obolibrary.org/obo/nuccore#> .
@prefix pubmed:   <http://purl.obolibrary.org/obo/pubmed#> .
@prefix id_pubmed: <http://purl.obolibrary.org/obo/id_pubmed#> .
@prefix id_ncbigene: <http://purl.obolibrary.org/obo/id_ncbigene#> .
@prefix dbsuper:  <http://purl.obolibrary.org/obo/dbsuper#> .

# Classes
hcrm:Crm a owl:Class ;
    rdfs:label "Crm" ;
    skos:exactMatch obo:hcrm_0000011 .

hcrm:Assembly a owl:Class ;
    rdfs:label "Assembly" ;
    skos:closeMatch assembly:assembly_1000 .

nuccore:Nuccore a owl:Class ;
    rdfs:label "Nuccore" ;
    skos:exactMatch nuccore:nuccore_1000 .

pubmed:Pubmed a owl:Class ;
    rdfs:label "Pubmed" ;
    skos:closeMatch pubmed:pubmed_1000 .

id_pubmed:Id_Pubmed a owl:Class ;
    rdfs:label "Id_Pubmed" ;
    skos:exactMatch id_pubmed:id_pubmed_1000 .

id_ncbigene:Id_Ncbigene a owl:Class ;
    rdfs:label "Id_Ncbigene" ;
    skos:closeMatch id_ncbigene:id_ncbigene_1000 .

dbsuper:Dbsuper a owl:Class ;
    rdfs:label "Dbsuper" ;
    skos:exactMatch dbsuper:dbsuper_1000 .

# Properties
hcrm:Crm_id a rdf:Property ;
    rdfs:label "Crm_id" ;
    skos:closeMatch obo:hcrm_0000012 .

assembly:Assembly_assembly a rdf:Property ;
    rdfs:label "Assembly_assembly" ;
    skos:exactMatch assembly:assembly_assembly_1000 .

nuccore:Nuccore_nuccore a rdf:Property ;
    rdfs:label "Nuccore_nuccore" ;
    skos:closeMatch nuccore:nuccore_nuccore_1000 .

pubmed:Pubmed_pubmed a rdf:Property ;
    rdfs:label "Pubmed_pubmed" ;
    skos:exactMatch pubmed:pubmed_pubmed_1000 .

id_pubmed:Id_Pubmed_id_pubmed a rdf:Property ;
    rdfs:label "Id_Pubmed_id_pubmed" ;
    skos:closeMatch id_pubmed:id_pubmed_id_pubmed_1000 .

id_ncbigene:Id_Ncbigene_id_ncbigene a rdf:Property ;
    rdfs:label "Id_Ncbigene_id_ncbigene" ;
    skos:exactMatch id_ncbigene:id_ncbigene_id_ncbigene_1000 .

dbsuper:Dbsuper_dbsuper a rdf:Property ;
    rdfs:label "Dbsuper_dbsuper" ;
    skos:closeMatch dbsuper:dbsuper_dbsuper_1000 .