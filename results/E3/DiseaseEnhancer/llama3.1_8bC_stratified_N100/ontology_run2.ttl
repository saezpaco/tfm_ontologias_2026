# === COLUMN → ONTOLOGY CLASS MAPPINGS ===
# Column 'orig_end':
hcrm:orig_end rdfs:label "ENdb" .
hcrm:orig_end skos:exactMatch <http://www.licpathway.net/ENdb/> .

# Column 'current_end':
hcrm:current_end rdfs:label "ENdb" .
hcrm:current_end skos:exactMatch <http://www.licpathway.net/ENdb/> .

# Column 'hgnc_symbol_target_genes':
crm2pgene:hgnc_symbol_target_genes rdfs:label "bgw!CRMHS00000003515--doid!1682" .
crm2pgene:hgnc_symbol_target_genes skos:exactMatch <http://rdf.biogateway.eu/crm2phen/bgw!CRMHS00000003515--doid!1682> .

# Column 'disease_PMID':
crm2phen:disease_PMID rdfs:label "bgw!CRMHS00000003515--doid!1682" .
crm2phen:disease_PMID skos:exactMatch <http://rdf.biogateway.eu/crm2phen/bgw!CRMHS00000003515--doid!1682> .

# Column 'crm_ID':
crm2tfac:crm_ID rdfs:label "bgw!crm_ID--uniprot!uniprot_ID" .
crm2tfac:crm_ID skos:exactMatch <http://rdf.biogateway.eu/crm2tfac/bgw!crm_ID--uniprot!uniprot_ID> .

# Column 'biosample_name':
assembly:biosample_name rdfs:label "database_name" .
assembly:biosample_name skos:closeMatch <original_URL_database> .

# Column 'original_ID':
hgene:original_ID rdfs:label "bgw!crm_ID--uniprot!uniprot_ID" .
hgene:original_ID skos:exactMatch <http://rdf.biogateway.eu/crm2tfac/bgw!crm_ID--uniprot!uniprot_ID> .

# Column 'hgnc_symbol_target_genes':
