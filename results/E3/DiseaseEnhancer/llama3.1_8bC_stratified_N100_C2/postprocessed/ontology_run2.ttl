@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://rdf.biogateway.eu/crm2phen_example#> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2gene#> .
@prefix hgene:   <http://rdf.biogateway.eu/hgene#> .
@prefix assembly: <http://rdf.biogateway.eu/assembly#> .
@prefix nuccore: <http://rdf.biogateway.eu/nuccore#> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed#> .
@prefix id_pubmed: <http://rdf.biogateway.eu/id_pubmed#> .
@prefix id_ncbigene: <http://rdf.biogateway.eu/id_ncbigene#> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper#> .

# === RECOMMENDED ONTOLOGIES (semantic search) ===
hcrm:crm2phen_example a owl:Ontology ;
    rdfs:label "crm2phen_example" ;
    skos:prefLabel "crm2phen_example" .
crm2pgene:crm2gene a owl:Ontology ;
    rdfs:label "crm2gene" ;
    skos:prefLabel "crm2gene" .

# === COLUMN → ONTOLOGY CLASS MAPPINGS ===
hcrm:CRMHS00000003515 a crm2pgene:CRMHS00000003515 ;
    rdf:type owl:NamedIndividual ;
    rdfs:label "bgw!CRMHS00000003515--hgncsymbol!9606/TBX5" ;
    skos:prefLabel "bgw!CRMHS00000003515--hgncsymbol!9606/TBX5" .

# === REUSE CISREG CLASSES AND PROPERTIES ===
crm2pgene:CRMHS00000003515 a crm2pgene:Gene ;
    rdfs:label "TBX5" ;
    skos:prefLabel "TBX5" .