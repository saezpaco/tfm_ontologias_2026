@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix hgene:   <http://rdf.biogateway.eu/hgene/> .
@prefix assembly: <http://rdf.biogateway.eu/assembly/> .
@prefix nuccore: <http://rdf.biogateway.eu/nuccore/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix id_pubmed: <http://rdf.biogateway.eu/id_pubmed/> .
@prefix id_ncbigene: <http://rdf.biogateway.eu/id_ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> a owl:Ontology ;
    rdfs:label "DiseaseEnhancer" ;
    dc:description "Enhancers asociados a enfermedades" ;
    dc:source <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> .

### Classes ###
biolink:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch crm2pgene:Enhancer .

biolink:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

biolink:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch crm2phen:Disease .

biolink:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch obo:NCIT_C17207 .

### Properties ###
biolink:has_sequence_location a owl:ObjectProperty ;
    rdfs:label "has sequence location" ;
    skos:exactMatch crm2pgene:has_sequence_location .

biolink:has_target_gene a owl:ObjectProperty ;
    rdfs:label "has target gene" ;
    skos:exactMatch crm2pgene:has_target_gene .

biolink:associated_with_disease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    skos:exactMatch crm2phen:associated_with_disease .

biolink:interacts_with_transcription_factor a owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    skos:exactMatch crm2pgene:interacts_with_transcription_factor .

