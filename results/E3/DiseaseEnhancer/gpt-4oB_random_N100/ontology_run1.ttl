@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix hgnc:    <http://identifiers.org/hgnc/> .
@prefix doid:    <http://purl.obolibrary.org/obo/DOID_> .
@prefix mesh:    <http://id.nlm.nih.gov/mesh/> .
@prefix omim:    <http://purl.obolibrary.org/obo/OMIM_> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> rdf:type owl:Ontology ;
    rdfs:label "DiseaseEnhancer Ontology" ;
    dc:description "Ontology for enhancers associated with diseases" ;
    dc:source <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> .

### Classes ###
biolink:Enhancer rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/Enhancer> .

biolink:Gene rdf:type owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/Gene> .

biolink:Disease rdf:type owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/Disease> .

biolink:TranscriptionFactor rdf:type owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCIT_C17207> .

### Properties ###
biolink:hasGenomicLocation rdf:type owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    rdfs:domain biolink:Enhancer ;
    rdfs:range schema:Place .

biolink:targetsGene rdf:type owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain biolink:Enhancer ;
    rdfs:range biolink:Gene ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/targetsGene> .

biolink:associatedWithDisease rdf:type owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain biolink:Enhancer ;
    rdfs:range biolink:Disease ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/associatedWithDisease> .

biolink:interactsWithTranscriptionFactor rdf:type owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    rdfs:domain biolink:Enhancer ;
    rdfs:range biolink:TranscriptionFactor ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/interactsWithTranscriptionFactor> .

### Individuals ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00027685825> rdf:type biolink:Enhancer ;
    rdfs:label "CRMHS00027685825" ;
    biolink:hasGenomicLocation [
        rdf:type schema:Place ;
        schema:identifier "chr4:88037770-88039770" ;
        schema:genomeAssembly "hg38"
    ] ;
    biolink:targetsGene hgnc:PIGY ;
    biolink:associatedWithDisease doid:784 ;
    biolink:interactsWithTranscriptionFactor [] .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00027685608> rdf:type biolink:Enhancer ;
    rdfs:label "CRMHS00027685608" ;
