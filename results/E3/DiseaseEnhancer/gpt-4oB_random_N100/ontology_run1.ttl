<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00027685533> rdf:type biolink:Enhancer ;
    rdfs:label "CRMHS00027685533" ;
    biolink:hasGenomicLocation [
        rdf:type schema:Place ;
        schema:identifier "chr3:15558295-15558493" ;
