<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00000005889> rdf:type biolink:Enhancer ;
    rdfs:label "CRMHS00000005889" ;
    biolink:hasGenomicLocation [
        rdf:type schema:Place ;
        schema:identifier "chr18:48913832-48948630" ;
