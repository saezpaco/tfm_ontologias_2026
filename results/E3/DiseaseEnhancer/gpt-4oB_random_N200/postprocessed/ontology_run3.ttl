@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix hgnc:    <http://identifiers.org/hgnc/> .
@prefix pubmed:  <http://identifiers.org/pubmed/> .
@prefix doid:    <http://purl.obolibrary.org/obo/DOID_> .
@prefix mesh:    <http://id.nlm.nih.gov/mesh/> .
@prefix omim:    <http://identifiers.org/omim/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> rdf:type owl:Ontology ;
    rdfs:label "DiseaseEnhancer Ontology" ;
    dc:description "Ontology for enhancers associated with diseases" ;
    dc:source <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> .

### Classes ###
crm2pgene:Enhancer rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/bgw!CRMHS00000003515--doid!1682> .

crm2pgene:Gene rdf:type owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/bgw!crm_ID--hgncsymbol!9606/gene_sybmol> .

crm2phen:Disease rdf:type owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/bgw!crm_ID--doid!doid> .

### Properties ###
crm2pgene:hasTargetGene rdf:type owl:ObjectProperty ;
    rdfs:label "has target gene" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range crm2pgene:Gene ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/bgw!crm_ID--hgncsymbol!9606/gene_sybmol> .

crm2phen:associatedWithDisease rdf:type owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range crm2phen:Disease ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/bgw!crm_ID--doid!doid> .

crm2pgene:hasGenomicLocation rdf:type owl:DatatypeProperty ;
    rdfs:label "has genomic location" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range xsd:string .

crm2pgene:hasPMID rdf:type owl:DatatypeProperty ;
    rdfs:label "has PMID" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range pubmed: .

crm2pgene:hasMutation rdf:type owl:DatatypeProperty ;
    rdfs:label "has mutation" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range xsd:string .

### Individuals ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00027685825> rdf:type crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation "chr4:88037770-88039770" ;
    crm2pgene:hasTargetGene hgnc:PIGY ;
    crm2phen:associatedWithDisease doid:784 ;
    crm2pgene:hasPMID pubmed:29093029 ;
    crm2pgene:hasMutation "rs2725220" .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00027685608> rdf:type crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation "chr20:57108146-57109944" ;
    crm2pgene:hasTargetGene hgnc:BRIP1 ;
    crm2phen:associatedWithDisease doid:1612 ;
    crm2pgene:hasPMID pubmed:27723759 .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00027685975> rdf:type crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation "chr22:19755479-19757077" ;
    crm2pgene:hasTargetGene hgnc:TBX1 ;
    crm2phen:associatedWithDisease mesh:D006345 ;
    crm2pgene:hasPMID pubmed:25910213 .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00000005889> rdf:type crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation "chr18:48913832-48948630" ;
    crm2pgene:hasTargetGene hgnc:SMAD7 ;
    crm2phen:associatedWithDisease mesh:D015179 ;
    crm2pgene:hasPMID pubmed:25375357 ;
    crm2pgene:hasMutation "rs8085824" .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRMHS00027685533> rdf:type crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation "chr3:15558295-15558493" ;
    crm2pgene:hasTargetGene hgnc:BTD ;
    crm2phen:associatedWithDisease doid:0050939 ;
    crm2pgene:hasPMID pubmed:27869826 .