@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .

# Define the DiseaseEnhancer class
hcrm:DiseaseEnhancer rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000727 ;
    skos:definition "Enhancers associated with diseases in Homo sapiens" ;
    skos:prefLabel "Disease Enhancer" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ; # in taxon "human"
    dc:hasVersion assembly:GCF_000001405.26 ; # hg38 assembly as reference
    biolink:category biolink:RegulatoryRegion .

# Define properties for genomic coordinates
hcrm:hasGenomicCoordinate rdf:type owl:ObjectProperty ;
    rdfs:domain hcrm:DiseaseEnhancer ;
    rdfs:range nuccore:chr_ID ;
    skos:definition "Associates a Disease Enhancer with its genomic coordinates" .

# Define properties for experimental evidence
hcrm:hasExperimentalEvidence rdf:type owl:ObjectProperty ;
    rdfs:domain hcrm:DiseaseEnhancer ;
    rdfs:range obo:ECO_ID ;
    skos:definition "Associates a Disease Enhancer with its experimental evidence" .

# Define properties for cell line activity
hcrm:activeInCellLine rdf:type owl:ObjectProperty ;
    rdfs:domain hcrm:DiseaseEnhancer ;
    rdfs:range obo:CLO_ID ;
    skos:definition "Indicates the cell line in which the enhancer is active" .

# Define properties for target genes
hcrm:targetsGene rdf:type owl:ObjectProperty ;
    rdfs:domain hcrm:DiseaseEnhancer ;
    rdfs:range obo:SO_0000704 ; # Gene
    skos:definition "Associates a Disease Enhancer with its target gene" .

# Define properties for associated diseases
hcrm:associatedWithDisease rdf:type owl:ObjectProperty ;
    rdfs:domain hcrm:DiseaseEnhancer ;
    rdfs:range obo:NCIT_C2991 ; # Disease
    skos:definition "Associates a Disease Enhancer with a disease" .

# Define properties for interacting transcription factors
hcrm:interactsWithTranscriptionFactor rdf:type owl:ObjectProperty ;
    rdfs:domain hcrm:DiseaseEnhancer ;
    rdfs:range obo:SO_0000235 ; # Transcription Factor
    skos:definition "Associates a Disease Enhancer with interacting transcription factors" .