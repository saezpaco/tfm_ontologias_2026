@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://rdf.biogateway.eu/crm2phen/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2phen/bgw!CRMHS00000003515--doid!1682> .
@prefix hgene:   <http://purl.uniprot.org/uniprot/> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

# Classes
hcrm:Crm  a owl:Class ;
  rdfs:label "Crm" ;
  skos:exactMatch hcrm:Crm .

hcrm:Biosample  a owl:Class ;
  rdfs:label "Biosample" ;
  skos:closeMatch schema:Biosample .

hcrm:Disease  a owl:Class ;
  rdfs:label "Disease" ;
  skos:exactMatch obo:DOID .

# Properties
hcrm:hasCrmId  a rdf:Property ;
  rdfs:label "hasCrmId" ;
  skos:closeMatch schema:identifier .

hcrm:hasBiosampleName  a rdf:Property ;
  rdfs:label "hasBiosampleName" ;
  skos:exactMatch schema:name .

hcrm:hasDiseasePmid  a rdf:Property ;
  rdfs:label "hasDiseasePmid" ;
  skos:closeMatch pubmed:Pmid .

# Object Properties
hcrm:hasTargetGene  a rdf:Property ;
  rdfs:label "hasTargetGene" ;
  skos:exactMatch biolink:has_target .

hcrm:hasAssociatedDisease  a rdf:Property ;
  rdfs:label "hasAssociatedDisease" ;
  skos:closeMatch obo:DOID .

# Datatype Properties
hcrm:hasCrmIdValue  a rdf:Property ;
  rdfs:label "hasCrmIdValue" ;
  skos:exactMatch xsd:string .

hcrm:hasBiosampleNameValue  a rdf:Property ;
  rdfs:label "hasBiosampleNameValue" ;
  skos:closeMatch xsd:string .