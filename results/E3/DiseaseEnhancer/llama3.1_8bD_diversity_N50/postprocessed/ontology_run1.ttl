@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .

hcrm:crm_ID rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000727 ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" ;
    skos:prefLabel "crm/crm_ID" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ; #in taxon "human"
    dc:hasVersion assembly:GCF_000001405.26 ; #hg38 assembly as reference
    obo:BFO_0000050 nuccore:chr_ID ; #chromosome
    obo:GENO_0000895 "start_position"^^xsd:integer ;
    obo:GENO_0000894 "end_position"^^xsd:integer .

hcrm:enhancer rdf:type owl:Class ;
    rdfs:subClassOf hcrm:crm_ID ;
    skos:definition "Enhancer sequence associated with a disease" ;
    skos:prefLabel "enhancer" ;
    biolink:category biolink:RegulatoryRegion .

hcrm:disease rdf:type owl:Class ;
    rdfs:subClassOf obo:NCIT_C15426 ; #Database
    skos:definition "Disease associated with an enhancer sequence" ;
    skos:prefLabel "disease" ;
    biolink:category biolink:Disease .

hcrm:target_gene rdf:type owl:ObjectProperty ;
    rdfs:domain hcrm:enhancer ;
    rdfs:range obo:NCIT_ID ; #Gene

hcrm:associated_disease rdf:type owl:ObjectProperty ;
    rdfs:domain hcrm:disease ;
    rdfs:range skos:Concept .

hcrm:evidence rdf:type owl:ObjectProperty ;
    rdfs:domain hcrm:enhancer ;
    rdfs:range sio:SIO_000772 ; #Article

hcrm:cell_line_activity rdf:type owl:ObjectProperty ;
    rdfs:domain hcrm:enhancer ;
    rdfs:range obo:BTO_ID ; #Cell line, cell type or anatomical structure

hcrm:transcription_factor rdf:type owl:ObjectProperty ;
    rdfs:domain hcrm:enhancer ;
    rdfs:range obo:NCIT_ID ; #Transcription factor