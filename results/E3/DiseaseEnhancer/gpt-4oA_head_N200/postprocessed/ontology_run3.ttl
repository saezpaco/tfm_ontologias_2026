@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix hgnc:    <http://identifiers.org/hgnc/> .
@prefix doid:    <http://purl.obolibrary.org/obo/DOID_> .
@prefix omim:    <http://purl.obolibrary.org/obo/OMIM_> .
@prefix mesh:    <http://id.nlm.nih.gov/mesh/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> rdf:type owl:Ontology ;
    rdfs:label "Disease Enhancer Ontology" ;
    dc:description "Ontology for enhancers associated with diseases" .

### Classes ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch crm2pgene:Enhancer .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Disease> rdf:type owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch crm2phen:Disease .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Gene> rdf:type owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/TranscriptionFactor> rdf:type owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch obo:NCIT_C17207 .

### Properties ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/hasGenomicCoordinate> rdf:type owl:ObjectProperty ;
    rdfs:label "has genomic coordinate" ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:range xsd:string .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/associatedWithDisease> rdf:type owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:range <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Disease> ;
    skos:exactMatch crm2phen:associatedWithDisease .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/targetsGene> rdf:type owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:range <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Gene> ;
    skos:exactMatch crm2pgene:targetsGene .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/interactsWithTF> rdf:type owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:range <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/TranscriptionFactor> ;
    skos:exactMatch crm2pgene:interactsWithTF .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/hasPMID> rdf:type owl:DatatypeProperty ;
    rdfs:label "has PMID" ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:range xsd:string ;
    skos:exactMatch pubmed:hasPMID .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/hasRefSeqID> rdf:type owl:DatatypeProperty ;
    rdfs:label "has RefSeq ID" ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:range xsd:string .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/hasMutation> rdf:type owl:DatatypeProperty ;
    rdfs:label "has mutation" ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Enhancer> ;
    rdfs:range xsd:string .