@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix hgene:   <http://rdf.biogateway.eu/hgene/> .
@prefix assembly: <http://rdf.biogateway.eu/assembly/> .
@prefix nuccore: <http://rdf.biogateway.eu/nuccore/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix id_pubmed: <http://rdf.biogateway.eu/id_pubmed/> .
@prefix id_ncbigene: <http://rdf.biogateway.eu/id_ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> a owl:Ontology ;
    rdfs:label "DiseaseEnhancer" ;
    dc:description "Enhancers asociados a enfermedades" ;
    dc:source <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> .

### Classes ###
<http://rdf.biogateway.eu/crm2phen/Enhancer> a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch crm2phen:Enhancer .

<http://rdf.biogateway.eu/crm2phen/Disease> a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch crm2phen:Disease .

<http://rdf.biogateway.eu/crm2pgene/Gene> a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

### Properties ###
<http://rdf.biogateway.eu/crm2phen/hasTargetGene> a owl:ObjectProperty ;
    rdfs:label "has target gene" ;
    skos:exactMatch crm2pgene:hasTargetGene .

<http://rdf.biogateway.eu/crm2phen/associatedWithDisease> a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    skos:exactMatch crm2phen:associatedWithDisease .

<http://rdf.biogateway.eu/crm2phen/hasGenomicLocation> a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    skos:exactMatch crm2phen:hasGenomicLocation .

<http://rdf.biogateway.eu/crm2phen/hasPubMedID> a owl:DatatypeProperty ;
    rdfs:label "has PubMed ID" ;
    skos:exactMatch crm2phen:hasPubMedID ;
    rdfs:range xsd:string .

### Individuals ###
<http://rdf.biogateway.eu/crm2phen/CRMHS00000001594> a <http://rdf.biogateway.eu/crm2phen/Enhancer> ;
    rdfs:label "CRMHS00000001594" ;
    <http://rdf.biogateway.eu/crm2phen/hasGenomicLocation> [
        a assembly:GenomicLocation ;
        assembly:chromosome "chr5" ;
        assembly:start "125315470"^^xsd:integer ;
        assembly:end "125318494"^^xsd:integer ;
        assembly:assemblyVersion "hg38"
    ] ;
    <http://rdf.biogateway.eu/crm2phen/hasTargetGene> hgene:LMNB1 ;
    <http://rdf.biogateway.eu/crm2phen/associatedWithDisease> obo:OMIM_169500, obo:DOID_0060785 ;
    <http://rdf.biogateway.eu/crm2phen/hasPubMedID> "25701871" .

