@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix assembly:<https://www.ncbi.nlm.nih.gov/assembly/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed:<http://identifiers.org/pubmed/> .

# Define the DiseaseEnhancer class
hcrm:DiseaseEnhancer rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000727 ;
    skos:definition "Enhancers associated with diseases in Homo sapiens" ;
    skos:prefLabel "Disease Enhancer" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ; # in taxon "human"
    dc:hasVersion assembly:GCF_000001405.26 ; # hg38 assembly as reference
    skos:exactMatch hcrm:crm_ID .

# Define properties for DiseaseEnhancer
<http://rdf.biogateway.eu/crm/9606DiseaseEnhancer#database_name> rdf:type hcrm:DiseaseEnhancer ;
    skos:definition "Disease enhancer located in Homo sapiens according to database_name" ;
    skos:prefLabel "DiseaseEnhancer#database_name" ;
    obo:TXPO_0003500 obo:BTO_ID ; # Cell line, cell type or anatomical structure
    obo:TXPO_0003500 obo:CL_ID ; # Cell type
    obo:TXPO_0003500 obo:CLO_ID ; # Cell line
    obo:TXPO_0003500 obo:UBERON_ID ; # Anatomical structure
    schema:evidenceOrigin <original_URL_crossreference> ; # Crossreference
    rdfs:isDefinedBy obo:ECO_ID ; # Experimental evidence
    sio:SIO_000772 id_pubmed:pubmed_ID ; # Article
    sio:SIO_000253 <original_URL_database> . # Original Database

# Define the genomic location properties
nuccore:chr_ID rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000340 ;
    skos:prefLabel "chr_name" ;
    biolink:category biolink:GenomicSequenceLocalization ;
    skos:closeMatch obo:NCIT_ID .

# Define the assembly version
assembly:GCF_000001405.26 rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0001505 ;
    skos:prefLabel "GRCh38" ;
    skos:altLabel "hg38" ;
    biolink:category biolink:Genome .

# Define the organism taxon
obo:NCBITaxon_9606 biolink:category biolink:OrganismTaxon .

# Define the evidence type
obo:ECO_ID biolink:category biolink:EvidenceType .

# Define the article reference
id_pubmed:pubmed_ID skos:exactMatch pubmed:pubmed_ID .
pubmed:pubmed_ID biolink:category biolink:Article .

# Define the database reference
<original_URL_database> rdf:type owl:Class ;
    rdfs:subClassOf obo:NCIT_C15426 ;
    skos:prefLabel "database_name" ;
    biolink:category biolink:InformationResource .

# Define the database class
obo:NCIT_C15426 rdf:type owl:Class ;
    skos:prefLabel "Database" .