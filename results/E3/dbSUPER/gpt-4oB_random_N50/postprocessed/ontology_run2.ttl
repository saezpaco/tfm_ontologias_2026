@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://rdf.biogateway.eu/gene/9606/> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://asntech.org/dbsuper/> .

# Define the super-enhancer class
dbsuper:SuperEnhancer rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000727 ;
    skos:definition "Super-enhancer located in Homo sapiens genome" ;
    skos:prefLabel "Super-enhancer" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ;
    dc:hasVersion assembly:GCF_000001405.26 .

# Define instances for each super-enhancer in the sample
dbsuper:SE_01932 rdf:type dbsuper:SuperEnhancer ;
    obo:BFO_0000050 nuccore:chr16 ;
    obo:GENO_0000895 "72866815"^^xsd:integer ;
    obo:GENO_0000894 "72895386"^^xsd:integer ;
    skos:prefLabel "SE_01932" ;
    schema:evidenceOrigin <https://asntech.org/dbsuper/> ;
    obo:TXPO_0003500 <http://purl.obolibrary.org/obo/BTO_0000138> ; # Aorta
    sio:SIO_000772 id_pubmed:12345678 ; # Example PubMed ID
    sio:SIO_000253 <https://asntech.org/dbsuper/> .

# Define the gene association
<http://rdf.biogateway.eu/crm2pgene/bgw!SE_01932--hgncsymbol!9606/ZFHX3> rdf:type owl:Class ;
    rdfs:subClassOf rdf:Statement ;
    rdf:subject dbsuper:SE_01932 ;
    rdf:predicate obo:RO_0002429 ;
    rdf:object hgene:ZFHX3 ;
    skos:prefLabel "bgw!SE_01932--hgncsymbol!9606/ZFHX3" ;
    skos:definition "Association between super-enhancer SE_01932 and gene ZFHX3" .

# Define the gene
hgene:ZFHX3 skos:closeMatch id_ncbigene:12345 ; # Example Gene ID
    biolink:category biolink:Gene .

# Repeat similar blocks for other super-enhancers and their associated genes