@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://example.org/ontology/crm#> .
@prefix crm2pgene: <http://example.org/ontology/crm2pgene#> .
@prefix hgene:   <http://example.org/ontology/hgene#> .
@prefix assembly: <http://example.org/ontology/assembly#> .
@prefix nuccore: <http://example.org/ontology/nuccore#> .
@prefix pubmed:  <http://example.org/ontology/pubmed#> .
@prefix id_pubmed: <http://example.org/ontology/id_pubmed#> .
@prefix id_ncbigene: <http://example.org/ontology/id_ncbigene#> .
@prefix dbsuper: <http://asntech.org/dbsuper/> .

# Ontology definition
<http://example.org/ontology/dbSUPER> a owl:Ontology ;
    rdfs:label "dbSUPER Ontology" ;
    dc:description "Ontology for representing super-enhancers from the dbSUPER database." .

# Classes
hcrm:SuperEnhancer a owl:Class ;
    rdfs:label "Super Enhancer" ;
    skos:exactMatch obo:SO_0000165 .

hcrm:GenomicLocation a owl:Class ;
    rdfs:label "Genomic Location" .

hcrm:CellLine a owl:Class ;
    rdfs:label "Cell Line" ;
    skos:exactMatch biolink:CellLine .

hcrm:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch biolink:Gene .

hcrm:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch biolink:Disease .

hcrm:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch biolink:GeneProduct .

# Properties
hcrm:hasGenomicLocation a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    rdfs:domain hcrm:SuperEnhancer ;
    rdfs:range hcrm:GenomicLocation .

hcrm:activeInCellLine a owl:ObjectProperty ;
    rdfs:label "active in cell line" ;
    rdfs:domain hcrm:SuperEnhancer ;
    rdfs:range hcrm:CellLine .

hcrm:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain hcrm:SuperEnhancer ;
    rdfs:range hcrm:Gene .

hcrm:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain hcrm:SuperEnhancer ;
    rdfs:range hcrm:Disease .

hcrm:interactsWithTF a owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    rdfs:domain hcrm:SuperEnhancer ;
    rdfs:range hcrm:TranscriptionFactor .

hcrm:hasPMID a owl:DatatypeProperty ;
    rdfs:label "has PMID" ;
    rdfs:domain hcrm:SuperEnhancer ;
    rdfs:range xsd:string .

hcrm:hasScore a owl:DatatypeProperty ;
    rdfs:label "has score" ;
    rdfs:domain hcrm:SuperEnhancer ;
    rdfs:range xsd:float .

hcrm:hasMinimumRatio a owl:DatatypeProperty ;
    rdfs:label "has minimum ratio" ;
    rdfs:domain hcrm:SuperEnhancer ;
    rdfs:range xsd:float .

# Example individual
dbsuper:CRMHS00000005972 a hcrm:SuperEnhancer ;
    rdfs:label "Super Enhancer CRMHS00000005972" ;
    hcrm:hasGenomicLocation [
        a hcrm:GenomicLocation ;
        assembly:chromosome "chr3" ;
        assembly:start 187725358 ;
        assembly:end 187750675 ;
        assembly:assemblyVersion "hg38"
    ] ;
    hcrm:activeInCellLine [
        a hcrm:CellLine ;
        rdfs:label "Adipose Nuclei"
    ] ;
    hcrm:targetsGene [
        a hcrm:Gene ;
        hgene:symbol "BCL6"
    ] ;
    hcrm:hasPMID "24119843" ;
    hcrm:hasScore 1.0 ;
    hcrm:hasMinimumRatio 0.95 .