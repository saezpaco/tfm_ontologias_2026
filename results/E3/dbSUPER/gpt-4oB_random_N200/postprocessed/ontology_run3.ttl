@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2tfac: <http://rdf.biogateway.eu/crm2tfac/> .
@prefix dbsuper: <https://asntech.org/dbsuper/> .
@prefix pubmed:  <http://rdf.ncbi.nlm.nih.gov/pubmed/> .

<http://example.org/ontology/dbSUPER> a owl:Ontology ;
    rdfs:label "dbSUPER Ontology" ;
    dc:description "Ontology for representing super-enhancers from the dbSUPER database." .

### Classes ###
dbsuper:SuperEnhancer a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:subClassOf biolink:Enhancer ;
    skos:exactMatch crm2pgene:SuperEnhancer .

dbsuper:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

dbsuper:CellLine a owl:Class ;
    rdfs:label "Cell Line" ;
    skos:exactMatch biolink:CellLine .

dbsuper:GenomicLocation a owl:Class ;
    rdfs:label "Genomic Location" ;
    skos:exactMatch biolink:GenomicEntity .

### Properties ###
dbsuper:hasGenomicLocation a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:GenomicLocation ;
    skos:exactMatch biolink:has_location .

dbsuper:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:Gene ;
    skos:exactMatch crm2pgene:targetsGene .

dbsuper:activeInCellLine a owl:ObjectProperty ;
    rdfs:label "active in cell line" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:CellLine ;
    skos:exactMatch biolink:expressed_in .

dbsuper:hasPubMedID a owl:DatatypeProperty ;
    rdfs:label "has PubMed ID" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:string ;
    skos:exactMatch pubmed:PubMedID .

### Individuals ###
dbsuper:CRMHS00000021421 a dbsuper:SuperEnhancer ;
    rdfs:label "CRMHS00000021421" ;
    dbsuper:hasGenomicLocation [
        a dbsuper:GenomicLocation ;
        schema:chromosome "chr11" ;
        schema:startPosition 85525212 ;
        schema:endPosition 85543151 ;
        schema:genomeAssembly "hg38"
    ] ;
    dbsuper:targetsGene <http://identifiers.org/hgnc/DLG2> ;
    dbsuper:activeInCellLine <http://example.org/cellline/H1> ;
    dbsuper:hasPubMedID "24119843" .

# Additional individuals would be defined similarly...