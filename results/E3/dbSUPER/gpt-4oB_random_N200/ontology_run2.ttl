@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2tfac: <http://rdf.biogateway.eu/crm2tfac/> .
@prefix dbsuper: <https://asntech.org/dbsuper/> .
@prefix pubmed:  <https://pubmed.ncbi.nlm.nih.gov/> .

<http://example.org/dbSUPEROntology> a owl:Ontology ;
    rdfs:label "dbSUPER Ontology" ;
    dc:description "Ontology for representing super-enhancers from the dbSUPER database." .

### Classes ###
dbsuper:SuperEnhancer a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:subClassOf biolink:Enhancer ;
    skos:exactMatch crm2pgene:bgw!crm_ID--hgncsymbol!9606/gene_sybmol .

dbsuper:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:bgw!crm_ID--hgncsymbol!9606/gene_sybmol .

dbsuper:CellLine a owl:Class ;
    rdfs:label "Cell Line" .

dbsuper:GenomicCoordinate a owl:Class ;
    rdfs:label "Genomic Coordinate" .

### Properties ###
dbsuper:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:label "has genomic coordinate" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:GenomicCoordinate .

dbsuper:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:Gene ;
    skos:exactMatch crm2pgene:bgw!crm_ID--hgncsymbol!9606/gene_sybmol .

dbsuper:activeInCellLine a owl:ObjectProperty ;
    rdfs:label "active in cell line" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:CellLine .

dbsuper:hasPubMedID a owl:DatatypeProperty ;
    rdfs:label "has PubMed ID" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:string ;
    skos:exactMatch pubmed: .

dbsuper:hasScore a owl:DatatypeProperty ;
    rdfs:label "has score" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:float .

dbsuper:hasMinimumRatio a owl:DatatypeProperty ;
    rdfs:label "has minimum ratio" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:float .

### Instances ###
dbsuper:CRMHS00000021421 a dbsuper:SuperEnhancer ;
    rdfs:label "CRMHS00000021421" ;
    dbsuper:hasGenomicCoordinate [
        a dbsuper:GenomicCoordinate ;
        rdfs:label "chr11:85525212-85543151" ;
        sio:SIO_000300 "chr11" ;
        sio:SIO_000221 "85525212"^^xsd:integer ;
        sio:SIO_000221 "85543151"^^xsd:integer ;
        sio:SIO_000221 "hg38" ;
    ] ;
    dbsuper:targetsGene <http://rdf.biogateway.eu/crm2pgene/DLG2> ;
    dbsuper:activeInCellLine <http://example.org/cellline/H1> ;
    dbsuper:hasPubMedID "24119843" ;
    dbsuper:hasScore 1.0 ;
    dbsuper:hasMinimumRatio 0.95 .

# Additional instances would follow the same pattern as above