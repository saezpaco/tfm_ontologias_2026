@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2tfac: <http://rdf.biogateway.eu/crm2tfac/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix dbsuper: <https://asntech.org/dbsuper/> .
@prefix pubmed: <http://rdf.ncbi.nlm.nih.gov/pubmed/> .

<http://example.org/ontology/dbSUPER> a owl:Ontology ;
    rdfs:label "dbSUPER Ontology" ;
    dc:description "Ontology for representing super-enhancers from the dbSUPER database." .

### Classes
dbsuper:SuperEnhancer a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:subClassOf biolink:GenomicEntity ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/bgw!crm_ID--hgncsymbol!9606/gene_sybmol> .

dbsuper:GenomicCoordinate a owl:Class ;
    rdfs:label "Genomic Coordinate" ;
    rdfs:subClassOf biolink:GenomicEntity .

dbsuper:CellLine a owl:Class ;
    rdfs:label "Cell Line" ;
    rdfs:subClassOf biolink:BiologicalEntity .

dbsuper:Gene a owl:Class ;
    rdfs:label "Gene" ;
    rdfs:subClassOf biolink:Gene .

dbsuper:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    rdfs:subClassOf biolink:GeneProduct ;
    skos:exactMatch obo:NCIT_C17207 .

dbsuper:Disease a owl:Class ;
    rdfs:label "Disease" ;
    rdfs:subClassOf biolink:DiseaseOrPhenotypicFeature .

### Properties
dbsuper:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:label "has genomic coordinate" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:GenomicCoordinate .

dbsuper:activeInCellLine a owl:ObjectProperty ;
    rdfs:label "active in cell line" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:CellLine .

dbsuper:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:Gene ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/bgw!crm_ID--hgncsymbol!9606/gene_sybmol> .

dbsuper:interactsWithTF a owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:TranscriptionFactor ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2tfac/bgw!crm_ID--uniprot!uniprot_ID> .

dbsuper:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:Disease ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/bgw!CRMHS00000003515--doid!1682> .

### Data Properties
dbsuper:hasScore a owl:DatatypeProperty ;
    rdfs:label "has score" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:float .

dbsuper:hasMinimumRatio a owl:DatatypeProperty ;
    rdfs:label "has minimum ratio" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:float .

dbsuper:hasPMID a owl:DatatypeProperty ;
    rdfs:label "has PMID" ;
    rdfs:domain [ a owl:Class ] ;
    rdfs:range pubmed: .

dbsuper:hasOriginalID a owl:DatatypeProperty ;
    rdfs:label "has original ID" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:string .