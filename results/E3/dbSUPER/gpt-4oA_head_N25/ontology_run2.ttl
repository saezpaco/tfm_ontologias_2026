@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://rdf.biogateway.eu/gene/9606/> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://asntech.org/dbsuper/> .

dbsuper:SE_00001 rdf:type hcrm:crm_ID ;
    skos:prefLabel "SE_00001" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ;
    dc:hasVersion assembly:GCF_000001405.26 ;
    obo:BFO_0000050 nuccore:chr1 ;
    obo:GENO_0000895 "120485363"^^xsd:integer ;
    obo:GENO_0000894 "120615071"^^xsd:integer ;
    obo:RO_0002429 hgene:NOTCH2 ;
    obo:TXPO_0003500 obo:CLO_0000003 ; # Adipose Nuclei
    schema:evidenceOrigin <https://asntech.org/dbsuper/> .

crm2pgene:bgw!SE_00001--hgncsymbol!9606/NOTCH2 rdf:type owl:Class ;
    rdfs:subClassOf rdf:Statement ;
    rdf:subject dbsuper:SE_00001 ;
    rdf:predicate obo:RO_0002429 ;
    rdf:object hgene:NOTCH2 ;
    skos:prefLabel "bgw!SE_00001--hgncsymbol!9606/NOTCH2" ;
    skos:definition "Association between cis-regulatory module SE_00001 and gene NOTCH2 according to dbSUPER" ;
    obo:TXPO_0003500 obo:CLO_0000003 .

hgene:NOTCH2 skos:closeMatch id_ncbigene:4853 ;
    biolink:category biolink:Gene .

