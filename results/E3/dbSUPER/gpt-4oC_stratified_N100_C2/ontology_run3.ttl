@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix dbsuper: <https://asntech.org/dbsuper/> .
@prefix pubmed:  <https://pubmed.ncbi.nlm.nih.gov/> .

<http://example.org/ontology/dbSUPER>
    a owl:Ontology ;
    dc:title "dbSUPER Ontology" ;
    dc:description "Ontology for representing super-enhancers from the dbSUPER database." ;
    dc:source <https://asntech.org/dbsuper/> .

### Classes

dbsuper:SuperEnhancer
    a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:subClassOf biolink:GenomicEntity ;
    skos:exactMatch crm2pgene:SuperEnhancer .

dbsuper:GenomicCoordinate
    a owl:Class ;
    rdfs:label "Genomic Coordinate" ;
    rdfs:subClassOf biolink:GenomicEntity .

dbsuper:CellLine
    a owl:Class ;
    rdfs:label "Cell Line" ;
    rdfs:subClassOf biolink:BiologicalEntity .

dbsuper:Gene
    a owl:Class ;
    rdfs:label "Gene" ;
    rdfs:subClassOf biolink:Gene ;
    skos:exactMatch crm2pgene:Gene .

### Properties

dbsuper:hasGenomicCoordinate
    a owl:ObjectProperty ;
    rdfs:label "has genomic coordinate" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:GenomicCoordinate ;
    skos:exactMatch crm2pgene:hasGenomicCoordinate .

dbsuper:activeInCellLine
    a owl:ObjectProperty ;
    rdfs:label "active in cell line" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:CellLine ;
    skos:exactMatch crm2pgene:activeInCellLine .

dbsuper:targetsGene
    a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:Gene ;
    skos:exactMatch crm2pgene:targetsGene .

dbsuper:hasPubMedID
    a owl:DatatypeProperty ;
    rdfs:label "has PubMed ID" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:string ;
    skos:exactMatch pubmed:PubMedID .

### Instances

dbsuper:CRMHS00000035442
    a dbsuper:SuperEnhancer ;
    rdfs:label "CRMHS00000035442" ;
    dbsuper:hasGenomicCoordinate [
        a dbsuper:GenomicCoordinate ;
        rdfs:label "chr17:42271401-42290073" ;
    ] ;
    dbsuper:activeInCellLine [
        a dbsuper:CellLine ;
        rdfs:label "CD4 Memory Primary 8pool" ;
    ] ;
    dbsuper:targetsGene [
        a dbsuper:Gene ;
        rdfs:label "STAT5B" ;
    ] ;
    dbsuper:hasPubMedID "24119843" .

# Additional instances would follow the same pattern as above.