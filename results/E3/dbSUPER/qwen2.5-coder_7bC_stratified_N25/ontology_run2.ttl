@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://rdf.biogateway.eu/gene/9606> .
@prefix dbsuper: <https://asntech.org/dbsuper/> .

hcrm:super-enhancer rdf:type owl:Class ;
    rdfs:subClassOf hcrm:crm_ID ;
    skos:prefLabel "Super-Enhancer" ;
    skos:altLabel "enhancer" ;
    biolink:category biolink:RegulatoryRegion .

hcrm:cell_line rdf:type owl:Class ;
    rdfs:subClassOf obo:CL_ID ;
    skos:prefLabel "Cell Line" ;
    biolink:category biolink:CellLine .

hcrm:anatomical_structure rdf:type owl:Class ;
    rdfs:subClassOf obo:UBERON_ID ;
    skos:prefLabel "Anatomical Structure" ;
    biolink:category biolink:GrossAnatomicalStructure .

hcrm:evidence_type rdf:type owl:Class ;
    rdfs:subClassOf obo:ECO_ID ;
    skos:prefLabel "Evidence Type" ;
    biolink:category biolink:EvidenceType .

hcrm:pubmed_article rdf:type owl:Class ;
    rdfs:subClassOf pubmed:pubmed_ID ;
    skos:prefLabel "PubMed Article" ;
    biolink:category biolink:Article .

hcrm:database rdf:type owl:Class ;
    rdfs:subClassOf obo:NCIT_C15426 ;
    skos:prefLabel "Database" ;
    biolink:category biolink:InformationResource .

crm2pgene:bgw!super-enhancer--hgncsymbol!9606/gene_symbol rdf:type owl:Class ;
    rdfs:subClassOf rdf:Statement ;
    rdf:subject hcrm:super-enhancer ;
    rdf:predicate obo:RO_0002429 ;
    rdf:object hgene:gene_symbol ;
    skos:prefLabel "bgw!super-enhancer--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between super-enhancer and gene symbol" .

hcrm:super-enhancer obo:RO_0002429 hgene:gene_symbol .

hgene:gene_symbol skos:closeMatch id_ncbigene:GeneID ;
    biolink:category biolink:Gene .

crm2pgene:bgw!super-enhancer--hgncsymbol!9606/gene_symbol#database_name rdf:type crm2pgene:bgw!super-enhancer--hgncsymbol!9606/gene_symbol ;
    skos:prefLabel "bgw!super-enhancer--hgncsymbol!9606/gene_symbol#database_name" ;
    skos:definition "Association between super-enhancer and gene symbol according to database_name" ;
    obo:TXPO_0003500 obo:BTO_ID ;
    obo:TXPO_0003500 obo:CL_ID ;
    obo:TXPO_0003500 obo:CLO_ID ;
    obo:TXPO_0003500 obo:UBERON_ID ;
    sio:SIO_000772 id_pubmed:pubmed_ID ;
    sio:SIO_000253 dbsuper:db_url .