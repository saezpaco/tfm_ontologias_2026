# === COLUMN → ONTOLOGY CLASS MAPPINGS ===

# cisreg:Gene (hgene:HGNC)
<http://purl.obolibrary.org/obo/hgnc#HGNC> a rdfs:Class ;
    skos:exactMatch <http://www.ncbi.nlm.nih.gov/gene/> .

# cisreg:Transcript (hcrm:HGNC_transcript)
<http://purl.obolibrary.org/obo/crm2pgene#PGN_T000001> a rdfs:Class ;
    skos:closeMatch <http://identifiers.org/ncbigene/> .

# cisreg:Protein (assembly:UniProtKB)
<http://www.uniprot.org/uniprot/> a rdfs:Class ;
    skos:exactMatch <http://purl.obolibrary.org/obo/hgnc#HGNC> .

# cisreg:RegulatoryElement (hcrm:HGNC_regulatory_element)
<http://purl.obolibrary.org/obo/crm2pgene#PGN_R000001> a rdfs:Class ;
    skos:closeMatch <http://identifiers.org/pubmed/> .

# cisreg:TranscriptionFactor (hgene:TF)
<http://purl.obolibrary.org/obo/hgnc#HGNC_TF> a rdfs:Class ;
    skos:exactMatch <http://www.ncbi.nlm.nih.gov/gene/> .

# cisreg:RegulatoryRegion (assembly:RegulatoryRegion)
<http://purl.uniprot.org/regulatoryregion/> a rdfs:Class ;
    skos:closeMatch <http://identifiers.org/ncbigene/> .

# cisreg:TranscriptionFactorBindingSite (hcrm:HGNC_transcription_factor_binding_site)
<http://purl.obolibrary.org/obo/crm2pgene#PGN_TBS000001> a rdfs:Class ;
    skos:closeMatch <http://identifiers.org/pubmed/> .

# cisreg:RegulatoryRegion (assembly:RegulatoryRegion)
<http://purl.uniprot.org/regulatoryregion/> a rdfs:Class ;
    skos:closeMatch <http://identifiers.org/ncbigene/> .