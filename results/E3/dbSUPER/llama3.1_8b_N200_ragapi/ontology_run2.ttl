@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://purl.obolibrary.org/obo/hgnc#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgnc#> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://purl.uniprot.org/databases/> .

# === RECOMMENDED ONTOLOGIES (semantic search) ===
#   • ontology=crm_example  file=crm_example.ttl  score=0.631
#   • ontology=crm  file=crm.ttl  score=0.618
#   • ontology=crm2tfac  file=crm2tfac.ttl  score=0.611
#   • ontology=crm2tfac_example  file=crm2tfac_example.ttl  score=0.606
#   • ontology=crm2phen  file=crm2phen.ttl  score=0.606

# === COLUMN → ONTOLOGY CLASS MAPPINGS ===

# Gene
hgene:HGNC:12345 rdf:type biolink:Gene ;
    rdfs:label "Gene Name" .

# Protein
hgene:HGNC:12345 crm2pgene:P00001 rdf:type biolink:Protein ;
    rdfs:label "Protein Name" .

# Gene Expression
nuccore:1234567890 rdf:type biolink:GeneExpression ;
    rdfs:label "Gene Expression" ;
    skos:exactMatch <http://identifiers.org/ncbigene/HGNC:12345> .

# PubMed Article
pubmed:12345678 rdf:type biolink:Publication ;
    rdfs:label "PubMed Article Title" ;
    skos:closeMatch <http://identifiers.org/pubmed/12345678> .

# Gene Ontology Term
obo:GO:0001234 rdf:type biolink:OntologyClass ;
    rdfs:label "Gene Ontology Term Name" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/GO:0001234> .