@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://purl.obolibrary.org/obo/hgnc#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgnc#> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://purl.uniprot.org/databases/> .

# === RECOMMENDED ONTOLOGIES (semantic search) ===
#   • ontology=crm_example  file=crm_example.ttl  score=0.631
#   • ontology=crm  file=crm.ttl  score=0.618
#   • ontology=crm2tfac  file=crm2tfac.ttl  score=0.611
#   • ontology=crm2tfac_example  file=crm2tfac_example.ttl  score=0.606
#   • ontology=crm2phen  file=crm2phen.ttl  score=0.606

# === COLUMN → ONTOLOGY CLASS MAPPINGS ===

# Define classes and properties from cisreg reference ontology
hcrm:Gene a rdfs:Class ;
    rdfs:label "Gene" .

crm2pgene:Transcript a rdfs:Class ;
    rdfs:label "Transcript" .

hgene:HGNC_ID a rdf:Property ;
    rdfs:label "HGNC ID" .

assembly:Assembly a rdfs:Class ;
    rdfs:label "Assembly" .

nuccore:NucleotideSequence a rdfs:Class ;
    rdfs:label "Nucleotide Sequence" .

pubmed:PubMedID a rdf:Property ;
    rdfs:label "PubMed ID" .

id_pubmed:PubmedID a rdf:Property ;
    rdfs:label "Pubmed ID" .

id_ncbigene:NCGeneID a rdf:Property ;
    rdfs:label "NCB Gene ID" .

dbsuper:Databases a rdfs:Class ;
    rdfs:label "Databases" .

# Define alignments with cisreg URIs
hcrm:Gene skos:exactMatch <http://purl.obolibrary.org/obo/hgnc#0000011> .
crm2pgene:Transcript skos:closeMatch <http://purl.obolibrary.org/obo/crm2pgene#0000012> .

# Define new classes and properties
cisreg:Gene a rdfs:Class ;
    rdfs:label "Cisreg Gene" .

cisreg:Transcript a rdfs:Class ;
    rdfs:label "Cisreg Transcript" .

cisreg:HGNC_ID a rdf:Property ;
    rdfs:label "HGNC ID (Cisreg)" .

# Define data
<http://example.org/gene1> a hcrm:Gene ;
    hgene:HGNC_ID "HGNC:1234"^^xsd:string .

<http://example.org/transcript1> a crm2pgene:Transcript ;
    id_ncbigene:NCGeneID "NCB:5678"^^xsd:string .