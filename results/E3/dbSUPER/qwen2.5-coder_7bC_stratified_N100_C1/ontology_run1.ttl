@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm2pgene/hcrm!> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/bgw!> .
@prefix hgene:   <http://rdf.biogateway.eu/crm2pgene/hgene!> .
@prefix assembly:<http://purl.obolibrary.org/obo/GENO_0000847> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix pubmed:  <http://purl.org/net/pmid#> .
@prefix id_pubmed:<http://rdf.biogateway.eu/crm2pgene/id_pubmed!> .
@prefix id_ncbigene:<http://rdf.biogateway.eu/crm2pgene/id_ncbigene!> .
@prefix dbsuper: <https://dbsuper.org/ontology/> .

# Example of a resource
<http://example.com/resource1>
    rdf:type hcrm:CRM ;
    rdfs:label "Example CRM" ;
    crm2pgene:hgnc_symbol_target_genes <http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> ;
    assembly:assembly_version "GRCh38" ;
    dbsuper:database_name "dbsuper_example" .

# Example of a skos:exactMatch
<http://example.com/resource2>
    rdf:type hcrm:CRM ;
    rdfs:label "Example CRM" ;
    crm2pgene:hgnc_symbol_target_genes <http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> ;
    assembly:assembly_version "GRCh38" ;
    dbsuper:database_name "dbsuper_example" ;
    skos:exactMatch <http://example.com/resource2_exact_match> .

# Example of a skos:closeMatch
<http://example.com/resource3>
    rdf:type hcrm:CRM ;
    rdfs:label "Example CRM" ;
    crm2pgene:hgnc_symbol_target_genes <http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> ;
    assembly:assembly_version "GRCh38" ;
    dbsuper:database_name "dbsuper_example" ;
    skos:closeMatch <http://example.com/resource3_close_match> .