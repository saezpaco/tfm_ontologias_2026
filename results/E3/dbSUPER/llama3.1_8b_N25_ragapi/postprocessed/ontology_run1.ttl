@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://purl.obolibrary.org/obo/hcrm#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <https://asntech.org/dbsuper/> .

# Classes
hcrm:CisRegulatoryModule a owl:Class ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:exactMatch hcrm:Crm .

dbsuper:SuperEnhancer a owl:Class ;
    rdfs:label "Super Enhancer" ;
    skos:closeMatch crm2pgene:Crm .

hgene:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch obo:GENE .

assembly:Chromosome a owl:Class ;
    rdfs:label "Chromosome" ;
    skos:exactMatch assembly:chromosome .

# Properties
dbsuper:start a rdf:Property ;
    rdfs:label "Start Coordinate" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:int .

dbsuper:stop a rdf:Property ;
    rdfs:label "Stop Coordinate" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:int .

hcrm:hasTargetGene a rdf:Property ;
    rdfs:label "Has Target Gene" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range hgene:Gene .

# Individuals
SE_00001 a dbsuper:SuperEnhancer ;
    dbsuper:start 120485363 ;
    dbsuper:stop 120615071 ;
    hcrm:hasTargetGene NOTCH2 .

SE_00002 a dbsuper:SuperEnhancer ;
    dbsuper:start 110838836 ;
    dbsuper:stop 111112228 ;
    hcrm:hasTargetGene COL4A2 .