@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://purl.obolibrary.org/obo/hgnc#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgene#> .
@prefix assembly: <http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore: <http://purl.obolibrary.org/obo/nuccore#> .
@prefix pubmed:  <http://purl.obolibrary.org/obo/pubmed#> .
@prefix id_pubmed: <http://purl.obolibrary.org/obo/id_pubmed#> .
@prefix id_ncbigene: <http://purl.obolibrary.org/obo/id_ncbigene#> .
@prefix dbsuper: <http://purl.obolibrary.org/obo/dbsuper#> .

# Classes
owl:Class(
  <http://example.org/CisReg_Chr>
  rdfs:label "CisReg Chr"
)
owl:Class(
  <http://example.org/CisReg_Gene>
  rdfs:label "CisReg Gene"
)
owl:Class(
  <http://example.org/CisReg_Transcript>
  rdfs:label "CisReg Transcript"
)

# Properties
owl:ObjectProperty(
  <http://example.org/predicates/hasChr>
  rdfs:label "has Chr"
  rdfs:domain <http://example.org/CisReg_Chr>
  rdfs:range <http://example.org/CisReg_Gene>
)
owl:ObjectProperty(
  <http://example.org/predicates/hasGene>
  rdfs:label "has Gene"
  rdfs:domain <http://example.org/CisReg_Transcript>
  rdfs:range <http://example.org/CisReg_Gene>
)

# Individuals
<http://example.org/CisReg_Chr1> rdf:type <http://example.org/CisReg_Chr> .
<http://example.org/CisReg_Gene1> rdf:type <http://example.org/CisReg_Gene> .
<http://example.org/CisReg_Transcript1> rdf:type <http://example.org/CisReg_Transcript> .

# Alignments
skos:exactMatch <http://purl.obolibrary.org/obo/hgnc#Chr> <http://example.org/CisReg_Chr> .
skos:closeMatch <http://purl.obolibrary.org/obo/crm2pgene#Gene> <http://example.org/CisReg_Gene> .
skos:exactMatch <http://purl.obolibrary.org/obo/hgene#Transcript> <http://example.org/CisReg_Transcript> .

# New classes and properties
owl:Class(
  <http://example.org/Dbsuper_Chr>
  rdfs:label "Dbsuper Chr"
)
owl:ObjectProperty(
  <http://example.org/predicates/hasDbsuperChr>
  rdfs:label "has Dbsuper Chr"
  rdfs:domain <http://example.org/CisReg_Transcript>
  rdfs:range <http://example.org/Dbsuper_Chr>
)