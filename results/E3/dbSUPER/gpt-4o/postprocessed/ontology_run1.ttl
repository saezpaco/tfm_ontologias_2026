@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://rdf.biogateway.eu/gene/9606/> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <https://asntech.org/dbsuper/> .

# Define the CRM class
hcrm:CRMHS00000005972 rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000727 ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr3 between 187725358 and 187750675" ;
    skos:prefLabel "CRMHS00000005972" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ;
    dc:hasVersion assembly:GCF_000001405.26 ;
    obo:BFO_0000050 nuccore:chr3 ;
    obo:GENO_0000895 "187725358"^^xsd:integer ;
    obo:GENO_0000894 "187750675"^^xsd:integer .

# Define the CRM to Gene association
<http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000005972--BCL6> rdf:type owl:Class ;
    rdfs:subClassOf rdf:Statement ;
    rdf:subject hcrm:CRMHS00000005972 ;
    rdf:predicate obo:RO_0002429 ;
    rdf:object hgene:BCL6 ;
    skos:prefLabel "bgw!CRMHS00000005972--BCL6" ;
    skos:definition "Association between cis-regulatory module CRMHS00000005972 and gene BCL6" .

# Define the Gene class
hgene:BCL6 skos:closeMatch id_ncbigene:GeneID ;
    biolink:category biolink:Gene .

# Define the CRM instance with database-specific information
<http://rdf.biogateway.eu/crm/9606/CRMHS00000005972#dbSUPER> rdf:type hcrm:CRMHS00000005972 ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr3 between 187725358 and 187750675 according to dbSUPER" ;
    skos:prefLabel "CRMHS00000005972#dbSUPER" ;
    obo:TXPO_0003500 obo:CLO_0000003 ; # Adipose Nuclei
    schema:evidenceOrigin <https://asntech.org/dbsuper/details.php?se_id=SE_00148> ;
    rdfs:isDefinedBy obo:ECO_0000203 ; # H3K27ac evidence
    sio:SIO_000772 id_pubmed:24119843 ;
    sio:SIO_000253 dbsuper: .

# Repeat similar definitions for other CRM entries and their associations