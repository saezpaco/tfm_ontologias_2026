@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://rdf.biogateway.eu/gene/9606/> .
@prefix assembly:<http://purl.obolibrary.org/obo/SO_0001505> .
@prefix nuccore: <http://purl.obolibrary.org/obo/SO_0000340> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed:<http://identifiers.org/pubmed/> .

hcrm:crm_ID rdf:type owl:Class ;
    skos:prefLabel "crm/crm_ID" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ;
    dc:hasVersion assembly:GCF_000001405.26 ;
    obo:BFO_0000050 nuccore:chr_ID ;
    obo:GENO_0000895 "start_position"^^xsd:integer ;
    obo:GENO_0000894 "end_position"^^xsd:integer .

hcrm:crm_ID#database_name rdf:type hcrm:crm_ID ;
    skos:prefLabel "crm#crm_ID#database_name" ;
    obo:TXPO_0003500 obo:BTO_ID ;
    obo:TXPO_0003500 obo:CL_ID ;
    obo:TXPO_0003500 obo:CLO_ID ;
    obo:TXPO_0003500 obo:UBERON_ID ;
    schema:evidenceOrigin <original_URL_crossreference> ;
    rdfs:isDefinedBy obo:ECO_ID ;
    sio:SIO_000772 id_pubmed:pubmed_ID ;
    sio:SIO_000253 <original_URL_database> .

crm2pgene:bgw!crm_ID--hgncsymbol!9606/gene_symbol rdf:type owl:Class ;
    rdfs:subClassOf rdf:Statement ;
    rdf:subject hcrm:crm_ID ;
    rdf:predicate obo:RO_0002429 ;
    rdf:object hgene:gene_sybmol ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" ;
    skos:definition "Association between cis-regulatory module CRMHS00000003515 and gene TBX5" .

hcrm:crm_ID obo:RO_0002429 hgene:gene_sybmol .

hgene:gene_symbol skos:closeMatch id_ncbigene:GeneID ;
    biolink:category biolink:Gene .