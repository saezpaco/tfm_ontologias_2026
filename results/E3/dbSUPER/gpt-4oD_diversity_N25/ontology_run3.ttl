dbsuper:SE_16035 rdf:type hcrm:crm_ID ;
    skos:prefLabel "SE_16035" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ;
    dc:hasVersion assembly:GCF_000001405.26 ;
    obo:BFO_0000050 nuccore:chr16 ;
    obo:GENO_0000895 "29754409"^^xsd:integer ;
    obo:GENO_0000894 "29758833"^^xsd:integer ;
    obo:RO_0002429 hgene:C16orf54 ;
    schema:evidenceOrigin <https://asntech.org/dbsuper/> ;
    skos:exactMatch hcrm:crm_ID#dbSUPER .

hgene:C16orf54 rdf:type biolink:Gene ;
    skos:prefLabel "C16orf54" ;
    skos:closeMatch id_ncbigene:GeneID .

crm2pgene:bgw!SE_16035--hgncsymbol!9606/C16orf54 rdf:type owl:Class ;
    rdfs:subClassOf rdf:Statement ;
    rdf:subject dbsuper:SE_16035 ;
    rdf:predicate obo:RO_0002429 ;
    rdf:object hgene:C16orf54 ;
    skos:prefLabel "bgw!SE_16035--hgncsymbol!9606/C16orf54" ;
    skos:definition "Association between cis-regulatory module SE_16035 and gene C16orf54 according to dbSUPER" ;
