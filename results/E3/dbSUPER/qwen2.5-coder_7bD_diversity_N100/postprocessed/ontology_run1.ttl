@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm2tfac/hcrm!> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/bgw!> .
@prefix hgene:   <http://rdf.biogateway.eu/crm2pgene/hgene!> .
@prefix assembly:<http://rdf.biogateway.eu/assembly/bgw!> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix pubmed:  <http://purl.org/net/pmid#> .
@prefix id_pubmed:<http://identifiers.org/pubmed/> .
@prefix id_ncbigene:<http://identifiers.org/ncbigene/> .
@prefix dbsuper: <https://dbsuper.com/super/> .

# Example of how to reuse cisreg URIs with skos:exactMatch
<http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> a obo:SO_0001487 ;
    skos:exactMatch hgene:TBX5 .

# Example of how to reuse cisreg URIs with skos:closeMatch
<http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> a obo:SO_0001487 ;
    skos:closeMatch hgene:TBX5 .

# Example of how to add new terms where cisreg doesn't cover the concept
<http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> a obo:SO_0001487 ;
    rdfs:label "Transcription Factor" .

# Example of how to use cisreg URIs for aligned terms
<http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> a obo:SO_0001487 ;
    skos:exactMatch hgene:TBX5 .

# Example of how to use cisreg URIs for aligned terms
<http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> a obo:SO_0001487 ;
    skos:closeMatch hgene:TBX5 .

# Example of how to use cisreg URIs for aligned terms
<http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> a obo:SO_0001487 ;
    rdfs:label "Transcription Factor" .