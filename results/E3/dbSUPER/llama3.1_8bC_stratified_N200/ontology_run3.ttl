@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://rdf.biogateway.eu/crm2gene/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://purl.obolibrary.org/obo/HGNC_> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <https://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <https://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_ncbigene: <https://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

# === RECOMMENDED ONTOLOGIES (semantic search) ===
hcrm:crm2gene a owl:Ontology ;
  rdfs:label "CRM2Gene Ontology" ;
  skos:prefLabel "CRM2Gene Ontology" .
crm2pgene:crm2pgene_example a owl:Ontology ;
  rdfs:label "CRM2Phen Example Ontology" ;
  skos:prefLabel "CRM2Phen Example Ontology" .

# === COLUMN → ONTOLOGY CLASS MAPPINGS ===
hcrm:crm_ID a rdf:Property ;
  rdfs:label "CRM ID" ;
  skos:prefLabel "CRM ID" .
crm2pgene:bgw!crm_ID--uniprot!uniprot_ID a rdf:Property ;
  rdfs:label "bgw!crm_ID--uniprot!uniprot_ID" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" .

hgene:HgncSymbol a owl:Class ;
  rdfs:label "Hgnc Symbol" ;
  skos:prefLabel "Hgnc Symbol" .
crm2pgene:bgw!CRMHS00000003515--hgncsymbol!9606/TBX5 a rdf:Property ;
  rdfs:label "bgw!CRMHS00000003515--hgncsymbol!9606/TBX5" ;
  skos:prefLabel "bgw!CRMHS00000003515--hgncsymbol!9606/TBX5" .

