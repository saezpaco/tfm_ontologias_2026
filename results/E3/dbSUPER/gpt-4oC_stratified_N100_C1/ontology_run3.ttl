@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix dbsuper: <https://asntech.org/dbsuper/> .
@prefix pubmed:  <https://pubmed.ncbi.nlm.nih.gov/> .

# Ontology definition
<http://example.org/dbSUPER_ontology> a owl:Ontology ;
    rdfs:label "dbSUPER Ontology" ;
    dc:description "Ontology for representing super-enhancers from the dbSUPER database." .

# Classes
dbsuper:SuperEnhancer a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:subClassOf biolink:Enhancer ;
    skos:exactMatch crm2pgene:SuperEnhancer .

dbsuper:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

dbsuper:CellLine a owl:Class ;
    rdfs:label "Cell Line" ;
    skos:exactMatch biolink:CellLine .

dbsuper:GenomicCoordinate a owl:Class ;
    rdfs:label "Genomic Coordinate" ;
    skos:exactMatch biolink:GenomicEntity .

# Properties
dbsuper:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:label "has genomic coordinate" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:GenomicCoordinate ;
    skos:exactMatch biolink:has_location .

dbsuper:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:Gene ;
    skos:exactMatch crm2pgene:targetsGene .

dbsuper:activeInCellLine a owl:ObjectProperty ;
    rdfs:label "active in cell line" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:CellLine ;
    skos:exactMatch biolink:expressed_in .

dbsuper:hasPubMedID a owl:DatatypeProperty ;
    rdfs:label "has PubMed ID" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:string ;
    skos:exactMatch pubmed:PubMedID .

# Individuals (Example)
dbsuper:CRMHS00000035442 a dbsuper:SuperEnhancer ;
    rdfs:label "CRMHS00000035442" ;
    dbsuper:hasGenomicCoordinate [
        a dbsuper:GenomicCoordinate ;
        rdfs:label "chr17:42271401-42290073" ;
        biolink:chromosome "chr17" ;
        biolink:start_position "42271401"^^xsd:integer ;
        biolink:end_position "42290073"^^xsd:integer ;
        biolink:genome_assembly "hg38"
    ] ;
    dbsuper:targetsGene <http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000035442--hgncsymbol!9606/STAT5B> ;
    dbsuper:activeInCellLine <http://example.org/cellline/CD4_Memory_Primary_8pool> ;
    dbsuper:hasPubMedID "24119843" .

<http://example.org/cellline/CD4_Memory_Primary_8pool> a dbsuper:CellLine ;
    rdfs:label "CD4 Memory Primary 8pool" .