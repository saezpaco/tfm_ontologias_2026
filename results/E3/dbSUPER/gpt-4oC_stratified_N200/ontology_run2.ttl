@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2tfac: <http://rdf.biogateway.eu/crm2tfac/> .
@prefix dbsuper: <https://asntech.org/dbsuper/> .
@prefix pubmed:  <http://rdf.ncbi.nlm.nih.gov/pubmed/> .

<http://example.org/dbSUPER> a owl:Ontology ;
    rdfs:label "dbSUPER Ontology" ;
    dc:description "Ontology for super-enhancers with genomic coordinates, cell lines, and target genes" ;
    dc:source <https://asntech.org/dbsuper/> .

### Classes
dbsuper:SuperEnhancer a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:subClassOf biolink:GenomicEntity ;
    skos:exactMatch crm2tfac:SuperEnhancer .

dbsuper:GenomicCoordinate a owl:Class ;
    rdfs:label "Genomic Coordinate" ;
    rdfs:subClassOf biolink:GenomicEntity .

dbsuper:CellLine a owl:Class ;
    rdfs:label "Cell Line" ;
    rdfs:subClassOf biolink:BiologicalEntity .

dbsuper:Gene a owl:Class ;
    rdfs:label "Gene" ;
    rdfs:subClassOf biolink:Gene ;
    skos:exactMatch crm2pgene:Gene .

### Properties
dbsuper:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:label "has genomic coordinate" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:GenomicCoordinate ;
    skos:exactMatch crm2tfac:hasGenomicCoordinate .

dbsuper:activeInCellLine a owl:ObjectProperty ;
    rdfs:label "active in cell line" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:CellLine ;
    skos:exactMatch crm2tfac:activeInCellLine .

dbsuper:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:Gene ;
    skos:exactMatch crm2pgene:targetsGene .

dbsuper:hasPMID a owl:DatatypeProperty ;
    rdfs:label "has PMID" ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:string ;
    skos:exactMatch pubmed:PMID .

### Instances
dbsuper:CRMHS00000009489 a dbsuper:SuperEnhancer ;
    rdfs:label "CRMHS00000009489" ;
    dbsuper:hasGenomicCoordinate [ a dbsuper:GenomicCoordinate ;
                                   rdfs:label "chr1:198619325-198685385" ] ;
    dbsuper:activeInCellLine [ a dbsuper:CellLine ;
                               rdfs:label "Ly3" ] ;
    dbsuper:targetsGene [ a dbsuper:Gene ;
                          rdfs:label "PTPRC" ;
                          skos:exactMatch crm2pgene:PTPRC ] ;
    dbsuper:hasPMID "24332044" .

dbsuper:CRMHS00000069381 a dbsuper:SuperEnhancer ;
    rdfs:label "CRMHS00000069381" ;
    dbsuper:hasGenomicCoordinate [ a dbsuper:GenomicCoordinate ;
                                   rdfs:label "chr8:127850511-127876411" ] ;
    dbsuper:activeInCellLine [ a dbsuper:CellLine ;
                               rdfs:label "HMEC" ] ;
    dbsuper:targetsGene [ a dbsuper:Gene ;
                          rdfs:label "MIR1204" ;
                          skos:exactMatch crm2pgene:MIR1204 ] ;
    dbsuper:hasPMID "24119843" .

# Additional instances would follow the same pattern