@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://purl.obolibrary.org/obo/hgnc#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgene#> .
@prefix assembly: <http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore:  <http://purl.obolibrary.org/obo/nuccore#> .
@prefix pubmed:   <http://purl.obolibrary.org/obo/pubmed#> .
@prefix id_pubmed: <http://purl.obolibrary.org/obo/id_pubmed#> .
@prefix id_ncbigene: <http://purl.obolibrary.org/obo/id_ncbigene#> .
@prefix dbsuper:  <http://purl.obolibrary.org/obo/dbsuper#> .

# Reuse cisreg classes and properties where semantically appropriate
[ a owl:Ontology ;
  rdfs:label "CISREG Ontology" ;
] .

# Define new classes and properties as needed

# Class definitions
hcrm:CisRegRegion rdf:type owl:Class ;
  rdfs:label "Cis-regulatory region" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/hgnc#CISREG_REGION> .

assembly:Assembly rdf:type owl:Class ;
  rdfs:label "Genomic assembly" ;
  skos:closeMatch <http://purl.obolibrary.org/obo/assembly#ASSEMBLY> .

hgene:Gene rdf:type owl:Class ;
  rdfs:label "Gene" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/hgene#GENE> .

nuccore:NucleotideSequence rdf:type owl:Class ;
  rdfs:label "Nucleotide sequence" ;
  skos:closeMatch <http://purl.obolibrary.org/obo/nuccore#NUCSEQUENCE> .

pubmed:Publication rdf:type owl:Class ;
  rdfs:label "Scientific publication" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/pubmed#PUBLICATION> .

id_pubmed:PubMedID rdf:type owl:DatatypeProperty ;
  rdfs:label "PubMed ID" ;
  skos:closeMatch <http://purl.obolibrary.org/obo/id_pubmed#PUBMED_ID> .

id_ncbigene:NCBIGeneID rdf:type owl:DatatypeProperty ;
  rdfs:label "NCBI Gene ID" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/id_ncbigene#GENE_ID> .

dbsuper:DbsuperRegion rdf:type owl:Class ;
  rdfs:label "Dbsuper region" ;
  skos:closeMatch <http://purl.obolibrary.org/obo/dbsuper#REGION> .

# Property definitions
crm2pgene:CisRegRegionToGene rdf:type owl:ObjectProperty ;
  rdfs:label "Cis-regulatory region to gene association" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/crm2pgene#CRISREG_REGION_TO_GENE> .

hcrm:CisRegRegionHasAssembly rdf:type owl:ObjectProperty ;
  rdfs:label "Cis-regulatory region has assembly" ;
  skos:closeMatch <http://purl.obolibrary.org/obo/hgnc#CISREG_REGION_HAS_ASSEMBLY> .

hgene:GeneHasTranscript rdf:type owl:ObjectProperty ;
  rdfs:label "Gene has transcript" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/hgene#GENE_HAS_TRANSCRIPT> .