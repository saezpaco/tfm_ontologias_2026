@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://purl.obolibrary.org/obo/hgnc#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgnc#> .
@prefix assembly: <http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore: <http://purl.obolibrary.org/obo/nuccore#> .
@prefix pubmed:  <http://purl.obolibrary.org/obo/pubmed#> .
@prefix id_pubmed: <http://purl.obolibrary.org/obo/id_pubmed#> .
@prefix id_ncbigene: <http://purl.obolibrary.org/obo/id_ncbigene#> .
@prefix dbsuper: <http://purl.obolibrary.org/obo/dbsuper#> .

# Classes
owl:Class(crm:CisRegElement)
owl:Class(crm:CisRegRegion)
owl:Class(assembly:Assembly)
owl:Class(nuccore:NucleotideSequence)

# Properties
owl:ObjectProperty(crm:hasCisRegElement)
owl:ObjectProperty(crm:hasCisRegRegion)
owl:ObjectProperty(assembly:hasAssembly)
owl:ObjectProperty(nuccore:hasNucleotideSequence)

# Alignments with cisreg reference ontology
skos:exactMatch(
  <http://purl.obolibrary.org/obo/hgnc#gene> 
  <http://purl.obolibrary.org/obo/crm2pgene#crm2pgene>
)
skos:closeMatch(
  <http://purl.obolibrary.org/obo/dbsuper#dbsuper> 
  <http://purl.obolibrary.org/obo/hgnc#gene>
)

# New classes and properties
owl:Class(dbsuper:DbsuperElement)
owl:ObjectProperty(dbsuper:hasDbsuperElement)

# Example instances
crm:CisRegElement rdf:type owl:Thing;
  crm2pgene:crm2pgene <http://purl.obolibrary.org/obo/hgnc#gene> ;
  dbsuper:dbsuper <http://purl.obolibrary.org/obo/dbsuper#dbsuper> .