@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://purl.obolibrary.org/obo/human-crm#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/human-gene#> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <https://identifiers.org/dbsuper/> .

# Classes
hcrm:Crm  a owl:Class ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/human-crm#Crm> .
crm2pgene:Pgene  a owl:Class ;
    rdfs:label "Protein-Coding Gene" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/crm2pgene#Pgene> .

hgene:Hgene  a owl:Class ;
    rdfs:label "Human Gene" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/human-gene#Hgene> .
assembly:Assembly  a owl:Class ;
    rdfs:label "Genomic Assembly" ;
    skos:closeMatch <http://purl.uniprot.org/assembly/> .

nuccore:Nuccore  a owl:Class ;
    rdfs:label "NCBI Nucleotide Sequence Database" ;
    skos:exactMatch <http://www.ncbi.nlm.nih.gov/nucleotide/> .
pubmed:Pubmed  a owl:Class ;
    rdfs:label "PubMed Article" ;
    skos:closeMatch <http://www.ncbi.nlm.nih.gov/pubmed/> .

id_pubmed:Id_pubmed  a owl:Class ;
    rdfs:label "PubMed Identifier" ;
    skos:exactMatch <http://identifiers.org/pubmed/> .
id_ncbigene:Id_ncbigene  a owl:Class ;
    rdfs:label "NCBI Gene Identifier" ;
    skos:closeMatch <http://identifiers.org/ncbigene/> .

dbsuper:Dbsuper  a owl:Class ;
    rdfs:label "Databases of Super-Enhancers" ;
    skos:exactMatch <https://identifiers.org/dbsuper/> .

# Properties
hcrm:Crm_has_component  a owl:ObjectProperty ;
    rdfs:domain hcrm:Crm ;
    rdfs:range crm2pgene:Pgene .
crm2pgene:Pgene_has_cisregulatory_module  a owl:ObjectProperty ;
    rdfs:domain crm2pgene:Pgene ;
    rdfs:range hcrm:Crm .

hgene:Hgene_is_expressed_in  a owl:ObjectProperty ;
    rdfs:domain hgene:Hgene ;
    rdfs:range assembly:Assembly .
assembly:Assembly_has_sequence  a owl:ObjectProperty ;
    rdfs:domain assembly:Assembly ;
    rdfs:range nuccore:Nuccore .

nuccore:Nuccore_is_linked_to  a owl:ObjectProperty ;
    rdfs:domain nuccore:Nuccore ;
    rdfs:range pubmed:Pubmed .
pubmed:Pubmed_has_identifier  a owl:ObjectProperty ;
    rdfs:domain pubmed:Pubmed ;
    rdfs:range id_pubmed:Id_pubmed .

id_pubmed:Id_pubmed_is_linked_to  a owl:ObjectProperty ;
    rdfs:domain id_pubmed:Id_pubmed ;
    rdfs:range id_ncbigene:Id_ncbigene .
id_ncbigene:Id_ncbigene_has_gene  a owl:ObjectProperty ;
    rdfs:domain id_ncbigene:Id_ncbigene ;
    rdfs:range hgene:Hgene .

dbsuper:Dbsuper_has_superenhancer  a owl:ObjectProperty ;
    rdfs:domain dbsuper:Dbsuper ;
    rdfs:range crm2pgene:Pgene .