@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://purl.obolibrary.org/obo/hgnc#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgene#> .
@prefix assembly: <http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore: <http://purl.obolibrary.org/obo/nuccore#> .
@prefix pubmed:  <http://purl.obolibrary.org/obo/pubmed#> .
@prefix id_pubmed: <http://purl.obolibrary.org/obo/id_pubmed#> .
@prefix id_ncbigene: <http://purl.obolibrary.org/obo/id_ncbigene#> .
@prefix dbsuper: <http://purl.obolibrary.org/obo/dbsuper#> .

# Reuse cisreg classes and properties where semantically appropriate
<http://example.org/Crm> a owl:Ontology ;
  rdfs:label "Crm Ontology" .

# Main concepts/classes in the data
<http://example.org/Crm#Crm> a biolink:NamedThing ;
  rdfs:label "Crm" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/crm#crm> .

<http://example.org/Crm#Gene> a biolink:NamedThing ;
  rdfs:label "Gene" ;
  skos:closeMatch <http://purl.obolibrary.org/obo/hgene#HGNC_000001> .

<http://example.org/Crm#Transcript> a biolink:NamedThing ;
  rdfs:label "Transcript" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/nuccore#transcript> .

# Column → Ontology Class Mappings
<http://example.org/Crm#Crm> owl:equivalentClass [
  rdf:type biolink:NamedThing ;
  rdfs:label "Crm" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/crm#crm>
] .

<http://example.org/Crm#Gene> owl:equivalentClass [
  rdf:type biolink:NamedThing ;
  rdfs:label "Gene" ;
  skos:closeMatch <http://purl.obolibrary.org/obo/hgene#HGNC_000001>
] .

<http://example.org/Crm#Transcript> owl:equivalentClass [
  rdf:type biolink:NamedThing ;
  rdfs:label "Transcript" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/nuccore#transcript>
] .

# New classes/properties only where cisreg doesn't cover the concept
<http://example.org/Crm#CrmAssembly> a biolink:NamedThing ;
  rdfs:label "Crm Assembly" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/assembly#assembly> .

<http://example.org/Crm#CrmPubmed> a biolink:NamedThing ;
  rdfs:label "Crm Pubmed" ;
  skos:closeMatch <http://purl.obolibrary.org/obo/pubmed#pubmed> .