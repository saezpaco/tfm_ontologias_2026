@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://example.org/ontology/crm#> .
@prefix crm2pgene: <http://example.org/ontology/crm2pgene#> .
@prefix hgene:   <http://example.org/ontology/hgene#> .
@prefix assembly: <http://example.org/ontology/assembly#> .
@prefix nuccore: <http://example.org/ontology/nuccore#> .
@prefix pubmed:  <http://example.org/ontology/pubmed#> .
@prefix id_pubmed: <http://example.org/ontology/id_pubmed#> .
@prefix id_ncbigene: <http://example.org/ontology/id_ncbigene#> .
@prefix dbsuper: <http://example.org/ontology/dbsuper#> .

dbsuper:SuperEnhancer rdf:type owl:Class ;
    rdfs:subClassOf hcrm:CisRegulatoryModule ;
    rdfs:label "Super Enhancer"@en ;
    skos:exactMatch crm2pgene:SuperEnhancer .

dbsuper:hasGenomicCoordinate rdf:type owl:ObjectProperty ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range assembly:GenomicCoordinate ;
    rdfs:label "has genomic coordinate"@en ;
    skos:exactMatch crm2pgene:hasGenomicCoordinate .

dbsuper:hasStart rdf:type owl:DatatypeProperty ;
    rdfs:domain assembly:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "has start position"@en ;
    skos:exactMatch crm2pgene:hasStart .

dbsuper:hasEnd rdf:type owl:DatatypeProperty ;
    rdfs:domain assembly:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "has end position"@en ;
    skos:exactMatch crm2pgene:hasEnd .

dbsuper:hasChromosome rdf:type owl:DatatypeProperty ;
    rdfs:domain assembly:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "has chromosome"@en ;
    skos:exactMatch crm2pgene:hasChromosome .

dbsuper:hasTargetGene rdf:type owl:ObjectProperty ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range hgene:Gene ;
    rdfs:label "has target gene"@en ;
    skos:exactMatch crm2pgene:hasTargetGene .

dbsuper:hasCellLineActivity rdf:type owl:DatatypeProperty ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:string ;
    rdfs:label "has cell line activity"@en ;
    skos:exactMatch crm2pgene:hasCellLineActivity .

dbsuper:hasRank rdf:type owl:DatatypeProperty ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:integer ;
    rdfs:label "has rank"@en ;
    skos:exactMatch crm2pgene:hasRank .

dbsuper:SE_00001 rdf:type dbsuper:SuperEnhancer ;
    dbsuper:hasGenomicCoordinate [
        rdf:type assembly:GenomicCoordinate ;
        dbsuper:hasChromosome "chr1" ;
        dbsuper:hasStart 120485363 ;
        dbsuper:hasEnd 120615071
    ] ;
    dbsuper:hasTargetGene hgene:NOTCH2 ;
    dbsuper:hasCellLineActivity "Adipose Nuclei" ;
    dbsuper:hasRank 1 .

# Additional instances would follow the same pattern as SE_00001