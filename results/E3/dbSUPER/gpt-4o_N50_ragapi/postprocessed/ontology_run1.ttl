@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://example.org/ontology/crm#> .
@prefix crm2pgene: <http://example.org/ontology/crm2pgene#> .
@prefix hgene:   <http://example.org/ontology/hgene#> .
@prefix assembly: <http://example.org/ontology/assembly#> .
@prefix nuccore: <http://example.org/ontology/nuccore#> .
@prefix pubmed:  <http://example.org/ontology/pubmed#> .
@prefix id_pubmed: <http://example.org/ontology/id_pubmed#> .
@prefix id_ncbigene: <http://example.org/ontology/id_ncbigene#> .
@prefix dbsuper: <http://asntech.org/dbsuper/> .

# Ontology definition
<http://asntech.org/dbsuper/ontology> a owl:Ontology ;
    dc:title "dbSUPER Ontology" ;
    dc:description "Ontology for representing super-enhancers from the dbSUPER database." ;
    dc:source <https://asntech.org/dbsuper/> .

# Classes
dbsuper:SuperEnhancer a owl:Class ;
    rdfs:subClassOf hcrm:CisRegulatoryModule ;
    skos:exactMatch hcrm:SuperEnhancer ;
    rdfs:label "Super Enhancer" .

dbsuper:Gene a owl:Class ;
    rdfs:subClassOf hgene:Gene ;
    skos:exactMatch hgene:Gene ;
    rdfs:label "Gene" .

dbsuper:CellLine a owl:Class ;
    rdfs:label "Cell Line" .

# Properties
dbsuper:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range assembly:GenomicCoordinate ;
    rdfs:label "has genomic coordinate" .

dbsuper:targetsGene a owl:ObjectProperty ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:Gene ;
    skos:exactMatch crm2pgene:targetsGene ;
    rdfs:label "targets gene" .

dbsuper:activeInCellLine a owl:ObjectProperty ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range dbsuper:CellLine ;
    rdfs:label "active in cell line" .

dbsuper:hasRank a owl:DatatypeProperty ;
    rdfs:domain dbsuper:SuperEnhancer ;
    rdfs:range xsd:integer ;
    rdfs:label "has rank" .

# Individuals (Sample Data)
dbsuper:SE_00001 a dbsuper:SuperEnhancer ;
    dbsuper:hasGenomicCoordinate [ a assembly:GenomicCoordinate ;
                                   assembly:chromosome "chr1" ;
                                   assembly:start 120485363 ;
                                   assembly:stop 120615071 ] ;
    dbsuper:targetsGene dbsuper:NOTCH2 ;
    dbsuper:activeInCellLine dbsuper:AdiposeNuclei ;
    dbsuper:hasRank 1 .

dbsuper:NOTCH2 a dbsuper:Gene ;
    rdfs:label "NOTCH2" ;
    skos:exactMatch id_ncbigene:4851 .

dbsuper:AdiposeNuclei a dbsuper:CellLine ;
    rdfs:label "Adipose Nuclei" .

# Repeat similar blocks for other super-enhancers and genes in the sample