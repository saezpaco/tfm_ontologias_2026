@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm:     <http://rdf.biogateway.eu/crm/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .

<http://example.org/ontology/FANTOM5> a owl:Ontology ;
    dc:title "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 project." ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

### Classes ###
crm:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch biolink:Enhancer .

crm:GenomicRegion a owl:Class ;
    rdfs:label "Genomic Region" ;
    skos:exactMatch biolink:GenomicRegion .

crm:Chromosome a owl:Class ;
    rdfs:label "Chromosome" ;
    skos:exactMatch biolink:Chromosome .

### Properties ###
crm:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:label "has genomic coordinate" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:GenomicRegion ;
    skos:exactMatch biolink:has_genomic_coordinate .

crm:locatedOnChromosome a owl:ObjectProperty ;
    rdfs:label "located on chromosome" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:Chromosome ;
    skos:exactMatch biolink:located_on_chromosome .

crm:hasActivityScore a owl:DatatypeProperty ;
    rdfs:label "has activity score" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer ;
    skos:exactMatch biolink:activity_score .

crm:hasExpressionLevel a owl:DatatypeProperty ;
    rdfs:label "has expression level" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:decimal ;
    skos:exactMatch biolink:expression_level .

### Instances ###
<http://example.org/ontology/FANTOM5/Enhancer1> a crm:Enhancer ;
    crm:hasGenomicCoordinate <http://example.org/ontology/FANTOM5/GenomicRegion1> ;
    crm:locatedOnChromosome <http://example.org/ontology/FANTOM5/Chromosome1> ;
    crm:hasActivityScore 24 ;
    crm:hasExpressionLevel 0.73 .

<http://example.org/ontology/FANTOM5/GenomicRegion1> a crm:GenomicRegion ;
    rdfs:label "chr1:839741-840250" .

<http://example.org/ontology/FANTOM5/Chromosome1> a crm:Chromosome ;
    rdfs:label "Chromosome 1" ;
    skos:exactMatch assembly:GCF_000001405.26 .