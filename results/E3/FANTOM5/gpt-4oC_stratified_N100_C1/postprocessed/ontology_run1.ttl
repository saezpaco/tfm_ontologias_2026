@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix pubmed:  <http://rdf.ncbi.nlm.nih.gov/pubmed/> .
@prefix hgnc:    <http://identifiers.org/hgnc/> .
@prefix assembly: <http://rdf.ebi.ac.uk/resource/ensemblassembly/> .

<http://rdf.biogateway.eu/crm2pgene/FANTOM5> a owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 database" ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

### Classes ###
crm2pgene:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/Enhancer> .

crm2pgene:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/Gene> .

crm2pgene:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/TranscriptionFactor> .

crm2pgene:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/Disease> .

### Properties ###
crm2pgene:hasGenomicLocation a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasGenomicLocation> .

crm2pgene:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/targetsGene> .

crm2pgene:interactsWithTF a owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/interactsWithTF> .

crm2pgene:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/associatedWithDisease> .

crm2pgene:hasEvidence a owl:DatatypeProperty ;
    rdfs:label "has evidence" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasEvidence> .

crm2pgene:hasScore a owl:DatatypeProperty ;
    rdfs:label "has score" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasScore> .

crm2pgene:hasAssembly a owl:ObjectProperty ;
    rdfs:label "has assembly" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasAssembly> .

### Individuals ###
<http://rdf.biogateway.eu/crm2pgene/CRMHS00000094290> a crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation [
        a assembly:GRCh38 ;
        assembly:chromosome "chr15" ;
        assembly:start 26619732 ;
        assembly:end 26619795
    ] ;
    crm2pgene:hasScore 1 ;
    crm2pgene:hasEvidence pubmed:24670763 .

<http://rdf.biogateway.eu/crm2pgene/CRMHS00000122781> a crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation [
        a assembly:GRCh38 ;
        assembly:chromosome "chr5" ;
        assembly:start 149212232 ;
        assembly:end 149212474
    ] ;
    crm2pgene:targetsGene hgnc:ABLIM3 ;
    crm2pgene:hasScore 1 ;
    crm2pgene:hasEvidence pubmed:24670763 .

<http://rdf.biogateway.eu/crm2pgene/CRMHS00000120537> a crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation [
        a assembly:GRCh38 ;
        assembly:chromosome "chr4" ;
        assembly:start 3835041 ;
        assembly:end 3835716
    ] ;
    crm2pgene:hasScore 1 ;
    crm2pgene:hasEvidence pubmed:24670763 .

# Additional individuals would follow the same pattern...