@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606crm_ID> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/9606crm2pgene_ID> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .

# Classes
hcrm:CisRegulatoryModule a owl:Class ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:exactMatch hcrm:Crm_ID .

crm2pgene:CisRegulatoryModuleToGeneAssociation a owl:Class ;
    rdfs:label "Cis-Regulatory Module to Gene Association" ;
    skos:closeMatch crm2pgene:Crm2pgene_ID .

# Properties
hcrm:hasGenomicCoordinates a rdf:Property ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range xsd:string .

hcrm:hasEnhancerSequence a rdf:Property ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range xsd:string .

hcrm:hasTargetGene a rdf:Property ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range crm2pgene:CisRegulatoryModuleToGeneAssociation .

hcrm:hasAssociatedDisease a rdf:Property ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range obo:Disease .

hcrm:hasInteractingTranscriptionFactor a rdf:Property ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range obo:TranscriptionFactor .

# Individuals
<http://example.org/enhancer1> a hcrm:CisRegulatoryModule ;
    hcrm:hasGenomicCoordinates "chr1:839741-840250" ;
    hcrm:hasEnhancerSequence "ATCG..." ;
    hcrm:hasTargetGene <http://example.org/target_gene1> .

<http://example.org/enhancer2> a hcrm:CisRegulatoryModule ;
    hcrm:hasGenomicCoordinates "chr1:840753-841210" ;
    hcrm:hasEnhancerSequence "ATCG..." ;
    hcrm:hasTargetGene <http://example.org/target_gene2> .

# Alignments
hcrm:Crm_ID skos:exactMatch nuccore:NC_000012.12 .