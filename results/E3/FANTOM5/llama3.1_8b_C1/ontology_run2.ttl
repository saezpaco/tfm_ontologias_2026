@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://purl.obolibrary.org/obo/hcrm#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgene#> .
@prefix assembly: <http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore: <http://purl.obolibrary.org/obo/nuccore#> .
@prefix pubmed:  <http://purl.obolibrary.org/obo/pubmed#> .
@prefix id_pubmed: <http://purl.obolibrary.org/obo/id_pubmed#> .
@prefix id_ncbigene: <http://purl.obolibrary.org/obo/id_ncbigene#> .
@prefix dbsuper: <http://purl.obolibrary.org/obo/dbsuper#> .

crm a owl:Class ;
    rdfs:label "cis-regulatory module" ;
    skos:exactMatch hcrm:CIS_REGULATORY_MODULE .

enhancer a owl:Class ;
    rdfs:label "enhancer sequence" ;
    skos:closeMatch crm2pgene:ENHANCER_SEQUENCE .

target_gene a owl:Class ;
    rdfs:label "target gene" ;
    skos:exactMatch hgene:HGNC_SYMBOL_TARGET_GENES .

transcription_factor a owl:Class ;
    rdfs:label "transcription factor" ;
    skos:closeMatch crm2pgene:TRANSCRIPTION_FACTOR .

disease a owl:Class ;
    rdfs:label "disease" ;
    skos:exactMatch dbsuper:DISEASE .

enhancer_sequence a owl:ObjectProperty ;
    rdfs:label "enhancer sequence" ;
    skos:closeMatch crm2pgene:ENHANCER_SEQUENCE .

target_gene_of a owl:ObjectProperty ;
    rdfs:label "target gene of" ;
    skos:exactMatch hgene:HGNC_SYMBOL_TARGET_GENES .

transcription_factor_interacts_with a owl:ObjectProperty ;
    rdfs:label "transcription factor interacts with" ;
    skos:closeMatch crm2pgene:TRANSCRIPTION_FACTOR_INTERACTS_WITH .

disease_associated_with a owl:ObjectProperty ;
    rdfs:label "disease associated with" ;
    skos:exactMatch dbsuper:DISEASE_ASSOCIATED_WITH .

enhancer_sequence_has_genomic_coordinates a owl:ObjectProperty ;
    rdfs:label "enhancer sequence has genomic coordinates" ;
    skos:closeMatch assembly:GENOMIC_COORDINATES .

enhancer_sequence_is_active_in a owl:ObjectProperty ;
    rdfs:label "enhancer sequence is active in" ;
    skos:exactMatch nuccore:ENHANCER_SEQUENCE_ACTIVE_IN .

enhancer_sequence_has_evidence a owl:ObjectProperty ;
    rdfs:label "enhancer sequence has evidence" ;
    skos:closeMatch pubmed:EVIDENCE_FOR_ENHANCER_SEQUENCE .