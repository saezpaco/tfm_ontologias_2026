@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://identifiers.org/hgnc/> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

# Classes
hcrm:CisRegulatoryModule a owl:Class ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:exactMatch hcrm:Crm2pgene_Crm .

hcrm:EnhancerSequence a owl:Class ;
    rdfs:label "Enhancer Sequence" ;
    skos:closeMatch crm2pgene:Enhancer .

hcrm:TargetGene a owl:Class ;
    rdfs:label "Target Gene" ;
    skos:exactMatch hgene:HgncSymbol .

# Properties
hcrm:hasGenomicCoordinates a rdf:Property ;
    rdfs:label "Has Genomic Coordinates" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range assembly:Assembly .

hcrm:hasExperimentalEvidence a rdf:Property ;
    rdfs:label "Has Experimental Evidence" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range pubmed:PubmedId .

hcrm:hasCellLineActivity a rdf:Property ;
    rdfs:label "Has Cell Line Activity" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range nuccore:NuccoreId .

hcrm:hasTargetGene a rdf:Property ;
    rdfs:label "Has Target Gene" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range hgene:HgncSymbol .

hcrm:hasAssociatedDisease a rdf:Property ;
    rdfs:label "Has Associated Disease" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range id_pubmed:PubmedId .

hcrm:hasInteractingTranscriptionFactor a rdf:Property ;
    rdfs:label "Has Interacting Transcription Factor" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range hgene:HgncSymbol .