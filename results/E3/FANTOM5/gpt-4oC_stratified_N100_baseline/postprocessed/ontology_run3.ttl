@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix hgnc:    <http://identifiers.org/hgnc/> .
@prefix assembly: <http://rdf.biogateway.eu/assembly/> .

<http://rdf.biogateway.eu/crm2phen/FANTOM5> a owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 database." ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

### Classes ###
crm2pgene:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000165> ;
    rdfs:comment "A DNA sequence that can increase the transcription of genes." .

crm2pgene:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch biolink:Gene ;
    rdfs:comment "A sequence of DNA that contains the necessary information to produce a functional product, typically a protein." .

crm2phen:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch biolink:Disease ;
    rdfs:comment "A disorder or abnormal condition affecting an organism." .

### Properties ###
crm2pgene:hasGenomicLocation a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range assembly:GenomicLocation ;
    rdfs:comment "Relates an enhancer to its genomic location." .

crm2pgene:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range crm2pgene:Gene ;
    skos:exactMatch biolink:regulates_expression_of ;
    rdfs:comment "Relates an enhancer to the gene it regulates." .

crm2phen:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range crm2phen:Disease ;
    skos:exactMatch biolink:associated_with_condition ;
    rdfs:comment "Relates an enhancer to a disease it is associated with." .

crm2pgene:hasEvidence a owl:DatatypeProperty ;
    rdfs:label "has evidence" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range xsd:string ;
    rdfs:comment "Provides evidence supporting the enhancer's activity." .

crm2pgene:hasPMID a owl:DatatypeProperty ;
    rdfs:label "has PMID" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range pubmed:PMID ;
    rdfs:comment "Links to a PubMed ID providing evidence for the enhancer." .

### Individuals ###
<http://rdf.biogateway.eu/crm2phen/CRMHS00000094290> a crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation [ a assembly:GenomicLocation ;
        assembly:chromosome "chr15" ;
        assembly:start 26619732 ;
        assembly:end 26619795 ;
        assembly:assemblyVersion "hg38" ] ;
    crm2pgene:hasEvidence "CAGE" ;
    crm2pgene:hasPMID pubmed:24670763 .

<http://rdf.biogateway.eu/crm2phen/CRMHS00000122781> a crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation [ a assembly:GenomicLocation ;
        assembly:chromosome "chr5" ;
        assembly:start 149212232 ;
        assembly:end 149212474 ;
        assembly:assemblyVersion "hg38" ] ;
    crm2pgene:targetsGene hgnc:ABLIM3 ;
    crm2pgene:hasEvidence "expression correlation" ;
    crm2pgene:hasPMID pubmed:24670763 .

<http://rdf.biogateway.eu/crm2phen/CRMHS00000120537> a crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation [ a assembly:GenomicLocation ;
        assembly:chromosome "chr4" ;
        assembly:start 3835041 ;
        assembly:end 3835716 ;
        assembly:assemblyVersion "hg38" ] ;
    crm2pgene:hasEvidence "CAGE" ;
    crm2pgene:hasPMID pubmed:24670763 .

# Additional individuals would follow the same pattern