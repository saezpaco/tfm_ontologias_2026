@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm2phen/bgw!crm_ID--doid!doid> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .

<http://rdf.biogateway.eu/crm2phen/FANTOM5> a owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 database" ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

### Classes ###
crm2pgene:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000165> ;
    rdfs:subClassOf biolink:GenomicEntity .

crm2pgene:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000704> ;
    rdfs:subClassOf biolink:Gene .

crm2phen:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/DOID_4> ;
    rdfs:subClassOf biolink:Disease .

### Properties ###
crm2pgene:hasGenomicLocation a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range biolink:GenomicEntity .

crm2pgene:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range crm2pgene:Gene ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002436> .

crm2phen:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range crm2phen:Disease ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0004020> .

crm2pgene:hasEvidence a owl:DatatypeProperty ;
    rdfs:label "has evidence" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range xsd:string .

crm2pgene:hasScore a owl:DatatypeProperty ;
    rdfs:label "has score" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range xsd:float .

crm2pgene:hasPMID a owl:DatatypeProperty ;
    rdfs:label "has PMID" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range pubmed:PMID .

### Individuals ###
<http://rdf.biogateway.eu/crm2phen/CRMHS00000094290> a crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation [
        a biolink:GenomicEntity ;
        biolink:chromosome "chr15" ;
        biolink:startPosition 26619732 ;
        biolink:endPosition 26619795 ;
        biolink:assembly "hg38"
    ] ;
    crm2pgene:hasScore 1.0 ;
    crm2pgene:hasEvidence "CAGE" ;
    crm2pgene:hasPMID pubmed:24670763 .

<http://rdf.biogateway.eu/crm2phen/CRMHS00000122781> a crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation [
        a biolink:GenomicEntity ;
        biolink:chromosome "chr5" ;
        biolink:startPosition 149212232 ;
        biolink:endPosition 149212474 ;
        biolink:assembly "hg38"
    ] ;
    crm2pgene:targetsGene <http://rdf.biogateway.eu/crm2pgene/ABLIM3> ;
    crm2pgene:hasScore 1.0 ;
    crm2pgene:hasEvidence "CAGE" ;
    crm2pgene:hasPMID pubmed:24670763 .

<http://rdf.biogateway.eu/crm2pgene/ABLIM3> a crm2pgene:Gene ;
    rdfs:label "ABLIM3" .

<http://rdf.biogateway.eu/crm2phen/CRMHS00000120537> a crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation [
        a biolink:GenomicEntity ;
        biolink:chromosome "chr4" ;
        biolink:startPosition 3835041 ;
        biolink:endPosition 3835716 ;
        biolink:assembly "hg38"
    ] ;
    crm2pgene:hasScore 1.0 ;
    crm2pgene:hasEvidence "CAGE" ;
    crm2pgene:hasPMID pubmed:24670763 .