@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm:     <http://rdf.biogateway.eu/crm/> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .

<http://example.org/ontology/FANTOM5> a owl:Ontology ;
    dc:title "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 project" ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

crm:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch crm:9606crm_ID .

crm:GenomicLocation a owl:Class ;
    rdfs:label "Genomic Location" .

crm:hasGenomicLocation a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:GenomicLocation .

crm:Chromosome a owl:Class ;
    rdfs:label "Chromosome" ;
    skos:exactMatch nuccore:chr_ID .

crm:hasChromosome a owl:ObjectProperty ;
    rdfs:label "has chromosome" ;
    rdfs:domain crm:GenomicLocation ;
    rdfs:range crm:Chromosome .

crm:startPosition a owl:DatatypeProperty ;
    rdfs:label "start position" ;
    rdfs:domain crm:GenomicLocation ;
    rdfs:range xsd:integer .

crm:endPosition a owl:DatatypeProperty ;
    rdfs:label "end position" ;
    rdfs:domain crm:GenomicLocation ;
    rdfs:range xsd:integer .

crm:activityScore a owl:DatatypeProperty ;
    rdfs:label "activity score" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer .

crm:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range biolink:EvidenceType .

crm:CellLine a owl:Class ;
    rdfs:label "Cell Line" .

crm:activeInCellLine a owl:ObjectProperty ;
    rdfs:label "active in cell line" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:CellLine .

crm:TargetGene a owl:Class ;
    rdfs:label "Target Gene" ;
    skos:exactMatch biolink:Gene .

crm:regulatesGene a owl:ObjectProperty ;
    rdfs:label "regulates gene" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:TargetGene .

crm:AssociatedDisease a owl:Class ;
    rdfs:label "Associated Disease" ;
    skos:exactMatch biolink:Disease .

crm:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:AssociatedDisease .

crm:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch biolink:GeneProduct .

crm:interactsWithTranscriptionFactor a owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:TranscriptionFactor .