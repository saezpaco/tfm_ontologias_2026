@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm2gene/bgw!> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/bgw!> .
@prefix hgene:   <http://rdf.biogateway.eu/hgene/bgw!> .
@prefix assembly:<http://rdf.biogateway.eu/assembly/bgw!> .
@prefix nuccore: <http://rdf.ncbi.nlm.nih.gov/nuccore/> .
@prefix pubmed:  <http://purl.org/net/pmid#> .
@prefix id_pubmed:<http://identifiers.org/pubmed/> .
@prefix id_ncbigene:<http://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/bgw!> .

crm_ID rdf:type owl:Class ;
    rdfs:label "CISREG ID" ;
    skos:exactMatch hcrm:crm_ID .

hgnc_symbol_target_genes rdf:type owl:Class ;
    rdfs:label "HGNC Symbol Target Genes" ;
    skos:exactMatch crm2pgene:crm_ID--hgncsymbol!9606/gene_sybmol .

orig_end rdf:type owl:Class ;
    rdfs:label "Original End" ;
    skos:exactMatch assembly:ENdb .

current_end rdf:type owl:Class ;
    rdfs:label "Current End" ;
    skos:exactMatch assembly:ENdb .

disease_PMID rdf:type owl:Class ;
    rdfs:label "Disease PubMed ID" ;
    skos:exactMatch pubmed:pubmed_id .

refsnp_ID rdf:type owl:Class ;
    rdfs:label "RefSNP ID" ;
    skos:exactMatch dbsuper:RefSNP_ID .