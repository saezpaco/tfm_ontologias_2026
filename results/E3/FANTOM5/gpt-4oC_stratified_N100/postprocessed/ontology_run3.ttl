@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm2phen/bgw!crm_ID--doid!doid> .
@prefix hgene:   <http://rdf.biogateway.eu/crm2pgene/bgw!crm_ID--hgncsymbol!9606/gene_sybmol> .
@prefix assembly: <http://rdf.biogateway.eu/assembly/> .
@prefix nuccore: <http://rdf.biogateway.eu/nuccore/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix id_pubmed: <http://rdf.biogateway.eu/id_pubmed/> .
@prefix id_ncbigene: <http://rdf.biogateway.eu/id_ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

<http://rdf.biogateway.eu/crm2phen/FANTOM5> a owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 database" ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

### Classes ###
biolink:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch crm2pgene:Enhancer .

biolink:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

biolink:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch obo:NCIT_C17207 .

biolink:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch crm2phen:Disease .

### Properties ###
biolink:hasGenomicLocation a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    skos:exactMatch crm2pgene:hasGenomicLocation .

biolink:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    skos:exactMatch crm2pgene:targetsGene .

biolink:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    skos:exactMatch crm2phen:associatedWithDisease .

biolink:interactsWithTF a owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    skos:exactMatch crm2pgene:interactsWithTF .

### Individuals ###
<http://rdf.biogateway.eu/crm2phen/CRMHS00000094290> a biolink:Enhancer ;
    rdfs:label "CRMHS00000094290" ;
    biolink:hasGenomicLocation [
        a biolink:GenomicLocation ;
        assembly:chromosome "chr15" ;
        assembly:start "26619732"^^xsd:integer ;
        assembly:end "26619795"^^xsd:integer ;
        assembly:assemblyVersion "hg38"
    ] ;
    biolink:targetsGene hgene:ABLIM3 ;
    biolink:associatedWithDisease [] ;
    biolink:interactsWithTF [] .

<http://rdf.biogateway.eu/crm2phen/CRMHS00000122781> a biolink:Enhancer ;
    rdfs:label "CRMHS00000122781" ;
    biolink:hasGenomicLocation [
        a biolink:GenomicLocation ;
        assembly:chromosome "chr5" ;
        assembly:start "149212232"^^xsd:integer ;
        assembly:end "149212474"^^xsd:integer ;
        assembly:assemblyVersion "hg38"
    ] ;
    biolink:targetsGene hgene:ABLIM3 ;
    biolink:associatedWithDisease [] ;
    biolink:interactsWithTF [] .

# Additional individuals would be defined similarly...