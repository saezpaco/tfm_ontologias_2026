<http://rdf.biogateway.eu/crm2phen/bgw!CRMHS00000094290> a crm2phen:Enhancer ;
    rdfs:label "CRMHS00000094290" ;
    crm2phen:hasGenomicLocation [
        a crm2phen:GenomicLocation ;
        crm2phen:chromosome "chr15" ;
        crm2phen:start 26619732 ;
        crm2phen:end 26619795 ;
        crm2phen:assembly "hg38"
    ] ;
    crm2phen:hasOriginalGenomicLocation [
        a crm2phen:GenomicLocation ;
        crm2phen:chromosome "chr15" ;
        crm2phen:start 26864879 ;
        crm2phen:end 26864942 ;
        crm2phen:assembly "hg19"
    ] ;
    crm2phen:hasMinimumRatio 0.95 ;
    crm2phen:hasScore 1 ;
    crm2phen:hasExperimentalMethod "CAGE" ;
    crm2phen:hasSource "FANTOM5" ;
    crm2phen:hasPublication <http://rdf.biogateway.eu/pubmed/24670763> .

<http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000122781> a crm2pgene:Enhancer ;
    rdfs:label "CRMHS00000122781" ;
