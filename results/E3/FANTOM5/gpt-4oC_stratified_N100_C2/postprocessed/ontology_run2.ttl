@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://rdf.biogateway.eu/hgene/> .
@prefix assembly: <http://rdf.biogateway.eu/assembly/> .
@prefix nuccore: <http://rdf.biogateway.eu/nuccore/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix id_pubmed: <http://rdf.biogateway.eu/id_pubmed/> .
@prefix id_ncbigene: <http://rdf.biogateway.eu/id_ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

<http://rdf.biogateway.eu/crm2pgene/FANTOM5> a owl:Ontology ;
    dc:title "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 project" ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

### Classes ###
crm2pgene:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/Enhancer> .

crm2pgene:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/Gene> .

crm2pgene:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/TranscriptionFactor> .

crm2pgene:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/Disease> .

crm2pgene:GenomicLocation a owl:Class ;
    rdfs:label "Genomic Location" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/GenomicLocation> .

### Properties ###
crm2pgene:hasGenomicLocation a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasGenomicLocation> .

crm2pgene:targetsGene a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/targetsGene> .

crm2pgene:interactsWithTF a owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/interactsWithTF> .

crm2pgene:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/associatedWithDisease> .

crm2pgene:hasAssembly a owl:DatatypeProperty ;
    rdfs:label "has assembly" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasAssembly> .

crm2pgene:hasStart a owl:DatatypeProperty ;
    rdfs:label "has start" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasStart> .

crm2pgene:hasEnd a owl:DatatypeProperty ;
    rdfs:label "has end" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasEnd> .

crm2pgene:hasChromosome a owl:DatatypeProperty ;
    rdfs:label "has chromosome" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasChromosome> .

### Individuals ###
crm2pgene:CRMHS00000094290 a crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation [
        a crm2pgene:GenomicLocation ;
        crm2pgene:hasChromosome "chr15" ;
        crm2pgene:hasStart "26619732"^^xsd:integer ;
        crm2pgene:hasEnd "26619795"^^xsd:integer ;
        crm2pgene:hasAssembly "hg38"
    ] ;
    crm2pgene:associatedWithDisease [] ;
    crm2pgene:targetsGene [] ;
    crm2pgene:interactsWithTF [] .

crm2pgene:CRMHS00000122781 a crm2pgene:Enhancer ;
    crm2pgene:hasGenomicLocation [
        a crm2pgene:GenomicLocation ;
        crm2pgene:hasChromosome "chr5" ;
        crm2pgene:hasStart "149212232"^^xsd:integer ;
        crm2pgene:hasEnd "149212474"^^xsd:integer ;
        crm2pgene:hasAssembly "hg38"
    ] ;
    crm2pgene:targetsGene hgene:ABLIM3 ;
    crm2pgene:associatedWithDisease [] ;
    crm2pgene:interactsWithTF [] .

hgene:ABLIM3 a crm2pgene:Gene ;
    rdfs:label "ABLIM3" ;
    skos:exactMatch <http://rdf.biogateway.eu/hgene/ABLIM3> .

# Additional individuals and properties would be defined similarly for other entries in the dataset.