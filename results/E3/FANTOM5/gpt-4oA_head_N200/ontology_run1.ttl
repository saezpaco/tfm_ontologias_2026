@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix hgnc:    <http://identifiers.org/hgnc/> .
@prefix assembly: <http://rdf.biogateway.eu/assembly/> .

<http://rdf.biogateway.eu/fantom5> a owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 project" ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

### Classes ###
crm2pgene:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2gene/Enhancer> .

crm2pgene:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/Gene> .

crm2phen:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/Disease> .

### Properties ###
crm2pgene:hasTargetGene a owl:ObjectProperty ;
    rdfs:label "has target gene" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range crm2pgene:Gene ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasTargetGene> .

crm2phen:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range crm2phen:Disease ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/associatedWithDisease> .

crm2pgene:hasGenomicLocation a owl:DatatypeProperty ;
    rdfs:label "has genomic location" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range xsd:string ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasGenomicLocation> .

crm2pgene:hasExperimentalEvidence a owl:DatatypeProperty ;
    rdfs:label "has experimental evidence" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range xsd:string ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasExperimentalEvidence> .

crm2pgene:hasPMID a owl:DatatypeProperty ;
    rdfs:label "has PMID" ;
    rdfs:domain crm2pgene:Enhancer ;
    rdfs:range pubmed:PMID ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/hasPMID> .

