@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm2phen/bgw!> .
@prefix pubmed:  <http://rdf.ncbi.nlm.nih.gov/pubmed/> .
@prefix hgene:   <http://rdf.biogateway.eu/crm2pgene/bgw!crm_ID--hgncsymbol!9606/> .

<http://example.org/ontology/FANTOM5> a owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 project" ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

### Classes ###
biolink:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch crm2pgene:Enhancer .

biolink:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

biolink:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch obo:NCIT_C17207 .

biolink:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch crm2phen:Disease .

### Properties ###
biolink:hasGenomicLocation a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    skos:closeMatch crm2pgene:hasGenomicLocation .

biolink:hasTargetGene a owl:ObjectProperty ;
    rdfs:label "has target gene" ;
    skos:exactMatch crm2pgene:hasTargetGene .

biolink:hasTranscriptionFactor a owl:ObjectProperty ;
    rdfs:label "has transcription factor" ;
    skos:exactMatch crm2pgene:hasTranscriptionFactor .

biolink:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    skos:exactMatch crm2phen:associatedWithDisease .

biolink:hasPubMedID a owl:DatatypeProperty ;
    rdfs:label "has PubMed ID" ;
    skos:closeMatch pubmed:hasPubMedID .

### Individuals ###
<http://example.org/ontology/FANTOM5/CRMHS00000081908> a biolink:Enhancer ;
    rdfs:label "CRMHS00000081908" ;
    biolink:hasGenomicLocation [
        a sio:SIO_000984 ;
        sio:SIO_000300 "chr10:18142022-18142352"^^xsd:string ;
        sio:SIO_000221 "hg38"^^xsd:string
    ] ;
    biolink:hasTargetGene hgene:CACNB2 ;
    biolink:hasPubMedID "24670763"^^xsd:string .

hgene:CACNB2 a biolink:Gene ;
    rdfs:label "CACNB2" .

<http://example.org/ontology/FANTOM5/CRMHS00000128885> a biolink:Enhancer ;
    rdfs:label "CRMHS00000128885" ;
    biolink:hasGenomicLocation [
        a sio:SIO_000984 ;
        sio:SIO_000300 "chr6:60353611-60353968"^^xsd:string ;
        sio:SIO_000221 "hg38"^^xsd:string
    ] ;
    biolink:hasPubMedID "24670763"^^xsd:string .

# Additional individuals and properties would be defined similarly