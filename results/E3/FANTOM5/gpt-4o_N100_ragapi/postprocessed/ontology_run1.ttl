@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm:     <http://rdf.biogateway.eu/crm/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2tfac: <http://rdf.biogateway.eu/crm2tfac/> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .

<http://example.org/ontology/FANTOM5> a owl:Ontology ;
    dc:title "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 project" ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

### Classes ###
crm:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch crm:9606CRMHS00000003515 ;
    rdfs:subClassOf biolink:GenomicEntity .

crm:GenomicCoordinate a owl:Class ;
    rdfs:label "Genomic Coordinate" ;
    rdfs:subClassOf biolink:GenomicEntity .

### Properties ###
crm:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:label "has genomic coordinate" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:GenomicCoordinate ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> .

crm:hasChromosome a owl:DatatypeProperty ;
    rdfs:label "has chromosome" ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:string ;
    skos:exactMatch assembly:GCF_000001405.26 .

crm:hasStartPosition a owl:DatatypeProperty ;
    rdfs:label "has start position" ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer .

crm:hasEndPosition a owl:DatatypeProperty ;
    rdfs:label "has end position" ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer .

crm:hasActivityScore a owl:DatatypeProperty ;
    rdfs:label "has activity score" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer .

crm:hasExpressionLevel a owl:DatatypeProperty ;
    rdfs:label "has expression level" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float .

### Individuals ###
<http://example.org/ontology/FANTOM5/Enhancer1> a crm:Enhancer ;
    crm:hasGenomicCoordinate <http://example.org/ontology/FANTOM5/GenomicCoordinate1> ;
    crm:hasActivityScore 24 ;
    crm:hasExpressionLevel 0.73 .

<http://example.org/ontology/FANTOM5/GenomicCoordinate1> a crm:GenomicCoordinate ;
    crm:hasChromosome "chr1" ;
    crm:hasStartPosition 839741 ;
    crm:hasEndPosition 840250 .