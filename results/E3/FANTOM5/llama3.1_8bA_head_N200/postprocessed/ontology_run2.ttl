@dbsuper: <http://identifiers.org/dbsuper/> .

# === RECOMMENDED ONTOLOGIES (semantic search) ===
crm2gene  a owl:Ontology ;
          rdfs:label "CRM2Gene Ontology" ;
          skos:prefLabel "CRM2Gene Ontology" .
crm2phen_example  a owl:Ontology ;
                   rdfs:label "CRM2Phen Example Ontology" ;
                   skos:prefLabel "CRM2Phen Example Ontology" .

# === COLUMN → ONTOLOGY CLASS MAPPINGS ===
hcrm:CRMHS00000003515  a hcrm:CRM ;
                        rdfs:label "CRMHS00000003515" ;
                        skos:prefLabel "CRMHS00000003515" .
<http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/gene_sybmol>  a crm2pgene:PGene ;
                                                               rdfs:label "bgw!CRMHS00000003515--hgncsymbol!9606/gene_sybmol" ;
                                                               skos:prefLabel "bgw!CRMHS00000003515--hgncsymbol!9606/gene_sybmol" .