@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://rdf.biogateway.eu/hgene/> .
@prefix assembly: <http://rdf.biogateway.eu/assembly/> .
@prefix nuccore: <http://rdf.biogateway.eu/nuccore/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix id_pubmed: <http://rdf.biogateway.eu/id_pubmed/> .
@prefix id_ncbigene: <http://rdf.biogateway.eu/id_ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

# === RECOMMENDED ONTOLOGIES (semantic search) ===
crm2gene  a owl:Ontology ;
          rdfs:label "crm2gene" ;
          skos:closeMatch <http://rdf.biogateway.eu/crm2pgene/bgw!crm_ID--hgncsymbol!9606/gene_sybmol> .

crm2gene_example  a owl:Ontology ;
                   rdfs:label "crm2gene_example" ;
                   skos:closeMatch <http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> .

# === COLUMN → ONTOLOGY CLASS MAPPINGS ===
crm_ID  a rdfs:Class ;
        rdfs:label "database_name" ;
        skos:closeMatch <http://rdf.biogateway.eu/crm2pgene/bgw!crm_ID--hgncsymbol!9606/gene_sybmol> .

hgnc_symbol_target_genes  a rdfs:Class ;
                           rdfs:label "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" ;
                           skos:closeMatch <http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> .

orig_end  a rdfs:Class ;
           rdfs:label "ENdb" ;
           skos:closeMatch <http://www.licpathway.net/ENdb/> .

current_end  a rdfs:Class ;
              rdfs:label "ENdb" ;
              skos:closeMatch <http://www.licpathway.net/ENdb/> .