@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .

hcrm:crm_ID rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000727 ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" ;
    skos:prefLabel "crm/crm_ID" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ; #in taxon "human"
    dc:hasVersion assembly:GCF_000001405.26 ; #hg38 assembly as reference
    obo:BFO_0000050 nuccore:chr_ID ; #chromosome
    obo:GENO_0000895 "start_position"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    obo:GENO_0000894 "end_position"^^<http://www.w3.org/2001/XMLSchema#integer> .

<http://rdf.biogateway.eu/crm/9606crm_ID#database_name> rdf:type hcrm:crm_ID ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position according to database_name" ;
    skos:prefLabel "crm#crm_ID#database_name" ;
    obo:TXPO_0003500 obo:BTO_ID ; #Cell line, cell type or anatomical structure
    obo:TXPO_0003500 obo:CL_ID ; #Cell type
    obo:TXPO_0003500 obo:CLO_ID ; #Cell line
    obo:TXPO_0003500 obo:UBERON_ID ; #Anatomical structure
    schema:evidenceOrigin <original_URL_crossreference> ; #Crossreference
    rdfs:isDefinedBy obo:ECO_ID ; #Experimental evidence
    sio:SIO_000772 id_pubmed:pubmed_ID ; #Article
    sio:SIO_000253 <original_URL_database> . #Original Database

# New classes and properties for the given data
hcrm:CrmData rdf:type owl:Class ;
    rdfs:subClassOf hcrm:crm_ID ;
    skos:prefLabel "CrmData" .

<http://rdf.biogateway.eu/crm/9606CrmData#chr_name> rdf:type obo:NCBITaxon_9606 ;
    rdfs:subPropertyOf obo:BFO_0000050 ;
    skos:prefLabel "chr_name" .

<http://rdf.biogateway.eu/crm/9606CrmData#start_position> rdf:type xsd:integer ;
    rdfs:subPropertyOf obo:GENO_0000895 ;
    skos:prefLabel "start_position" .

<http://rdf.biogateway.eu/crm/9606CrmData#end_position> rdf:type xsd:integer ;
    rdfs:subPropertyOf obo:GENO_0000894 ;
    skos:prefLabel "end_position" .

# Example instances of the new classes and properties
hcrm:CrmData1 rdf:type hcrm:CrmData ;
    <http://rdf.biogateway.eu/crm/9606CrmData#chr_name> nuccore:chr_ID1 ;
    <http://rdf.biogateway.eu/crm/9606CrmData#start_position> 100 ;
    <http://rdf.biogateway.eu/crm/9606CrmData#end_position> 200 .

hcrm:CrmData2 rdf:type hcrm:CrmData ;
    <http://rdf.biogateway.eu/crm/9606CrmData#chr_name> nuccore:chr_ID2 ;
    <http://rdf.biogateway.eu/crm/9606CrmData#start_position> 300 ;
    <http://rdf.biogateway.eu/crm/9606CrmData#end_position> 400 .
