@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2phen: <http://rdf.biogateway.eu/crm2phen/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm2phen/bgw!> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .

# Ontology definition
<http://example.org/ontology/fantom5> a owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 project" ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

# Classes
<http://example.org/ontology/fantom5/CisRegulatoryModule> a owl:Class ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:exactMatch crm2pgene:CisRegulatoryModule .

<http://example.org/ontology/fantom5/Enhancer> a owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:subClassOf <http://example.org/ontology/fantom5/CisRegulatoryModule> ;
    skos:exactMatch crm2pgene:Enhancer .

<http://example.org/ontology/fantom5/Gene> a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

<http://example.org/ontology/fantom5/TranscriptionFactor> a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch obo:NCIT_C17207 .

<http://example.org/ontology/fantom5/Disease> a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch crm2phen:Disease .

# Properties
<http://example.org/ontology/fantom5/hasGenomicCoordinate> a owl:ObjectProperty ;
    rdfs:label "has genomic coordinate" ;
    rdfs:domain <http://example.org/ontology/fantom5/Enhancer> ;
    rdfs:range <http://example.org/ontology/fantom5/GenomicCoordinate> .

<http://example.org/ontology/fantom5/targetsGene> a owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain <http://example.org/ontology/fantom5/Enhancer> ;
    rdfs:range <http://example.org/ontology/fantom5/Gene> ;
    skos:exactMatch crm2pgene:targetsGene .

<http://example.org/ontology/fantom5/associatedWithDisease> a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain <http://example.org/ontology/fantom5/Enhancer> ;
    rdfs:range <http://example.org/ontology/fantom5/Disease> ;
    skos:exactMatch crm2phen:associatedWithDisease .

<http://example.org/ontology/fantom5/interactsWithTF> a owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    rdfs:domain <http://example.org/ontology/fantom5/Enhancer> ;
    rdfs:range <http://example.org/ontology/fantom5/TranscriptionFactor> ;
    skos:exactMatch crm2pgene:interactsWithTF .

<http://example.org/ontology/fantom5/hasPMID> a owl:DatatypeProperty ;
    rdfs:label "has PMID" ;
    rdfs:domain <http://example.org/ontology/fantom5/Enhancer> ;
    rdfs:range xsd:string ;
    skos:exactMatch pubmed:PMID .

# Individuals (Sample Data)
<http://example.org/ontology/fantom5/CRMHS00000100704> a <http://example.org/ontology/fantom5/Enhancer> ;
    rdfs:label "CRMHS00000100704" ;
    <http://example.org/ontology/fantom5/hasGenomicCoordinate> [
        a <http://example.org/ontology/fantom5/GenomicCoordinate> ;
        rdfs:label "chr17:76252141-76252493" ;
        schema:chromosome "chr17" ;
        schema:startPosition "76252141"^^xsd:integer ;
        schema:endPosition "76252493"^^xsd:integer ;
        schema:genomeAssembly "hg38"
    ] ;
    <http://example.org/ontology/fantom5/targetsGene> <http://example.org/ontology/fantom5/ST6GALNAC2> ;
    <http://example.org/ontology/fantom5/hasPMID> "24670763" .

<http://example.org/ontology/fantom5/ST6GALNAC2> a <http://example.org/ontology/fantom5/Gene> ;
    rdfs:label "ST6GALNAC2" .

# Additional individuals and properties can be added similarly