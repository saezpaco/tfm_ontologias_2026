@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://purl.obolibrary.org/obo/hgnc#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgnc#> .
@prefix assembly: <http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore: <http://purl.obolibrary.org/obo/nuccore#> .
@prefix pubmed:  <http://purl.obolibrary.org/obo/pubmed#> .
@prefix id_pubmed: <http://purl.obolibrary.org/obo/id_pubmed#> .
@prefix id_ncbigene: <http://purl.obolibrary.org/obo/id_ncbigene#> .
@prefix dbsuper: <http://purl.obolibrary.org/obo/dbsuper#> .

crm:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch <https://www.ebi.ac.uk/ols/ontologies/crm/terms?iri=http://purl.obolibrary.org/obo/CRM000001> .

crm:CAGESeq a owl:Class ;
    rdfs:label "CAGE-Seq" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/NuclAc_000002> .

crm:EnhancerSequence a owl:Class ;
    rdfs:label "Enhancer Sequence" ;
    rdfs:subClassOf crm:Enhancer .

crm:TargetGene a owl:Class ;
    rdfs:label "Target Gene" ;
    skos:exactMatch <https://www.ebi.ac.uk/ols/ontologies/crm/terms?iri=http://purl.obolibrary.org/obo/CRM000003> .

crm:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/SIO_010001> .

crm:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch <https://www.ebi.ac.uk/ols/ontologies/crm/terms?iri=http://purl.obolibrary.org/obo/CRM000004> .

crm:EnhancerSequence_has_TargetGene a owl:ObjectProperty ;
    rdfs:label "has Target Gene" ;
    rdfs:domain crm:EnhancerSequence ;
    rdfs:range crm:TargetGene .

crm:EnhancerSequence_has_TranscriptionFactor a owl:ObjectProperty ;
    rdfs:label "has Transcription Factor" ;
    rdfs:domain crm:EnhancerSequence ;
    rdfs:range crm:TranscriptionFactor .

crm:EnhancerSequence_has_Disease a owl:ObjectProperty ;
    rdfs:label "has Disease" ;
    rdfs:domain crm:EnhancerSequence ;
    rdfs:range crm:Disease .