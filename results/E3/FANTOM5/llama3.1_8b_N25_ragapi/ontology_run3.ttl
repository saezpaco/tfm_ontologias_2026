@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .

# Classes
hcrm:CisRegulatoryModule a owl:Class ;
  rdfs:label "Cis-Regulatory Module" .

hcrm:EnhancerSequence a owl:Class ;
  rdfs:label "Enhancer Sequence" ;
  rdfs:subClassOf hcrm:CisRegulatoryModule .

hcrm:GenomicCoordinate a owl:Class ;
  rdfs:label "Genomic Coordinate" .

hcrm:TargetGene a owl:Class ;
  rdfs:label "Target Gene" .

# Properties
hcrm:hasEnhancerSequence a rdf:Property ;
  rdfs:label "Has Enhancer Sequence" ;
  rdfs:domain hcrm:CisRegulatoryModule ;
  rdfs:range hcrm:EnhancerSequence .

hcrm:hasGenomicCoordinate a rdf:Property ;
  rdfs:label "Has Genomic Coordinate" ;
  rdfs:domain hcrm:CisRegulatoryModule ;
  rdfs:range hcrm:GenomicCoordinate .

hcrm:targets a rdf:Property ;
  rdfs:label "Targets" ;
  rdfs:domain hcrm:CisRegulatoryModule ;
  rdfs:range hcrm:TargetGene .

# Alignments
skos:exactMatch <http://rdf.biogateway.eu/crm/9606CRMHS00000003515> .
skos:closeMatch <https://www.ncbi.nlm.nih.gov/assembly/GCF_000001405.26> .

# New classes and properties
hcrm:CisRegulatoryModuleEnhancerSequence a owl:Class ;
  rdfs:label "Cis-Regulatory Module Enhancer Sequence" ;
  rdfs:subClassOf hcrm:EnhancerSequence .

hcrm:CisRegulatoryModuleGenomicCoordinate a owl:Class ;
  rdfs:label "Cis-Regulatory Module Genomic Coordinate" ;
  rdfs:subClassOf hcrm:GenomicCoordinate .