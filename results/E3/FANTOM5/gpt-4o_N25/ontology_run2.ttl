@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix crm:     <http://rdf.biogateway.eu/crm/> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .

<http://example.org/ontology/FANTOM5> a owl:Ontology ;
    dc:title "FANTOM5 Enhancer Ontology" ;
    dc:description "Ontology for enhancers identified by CAGE-seq in the FANTOM5 project." ;
    dc:source <https://fantom.gsc.riken.jp/5/> .

crm:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm/9606crm_ID> ;
    rdfs:subClassOf biolink:GenomicEntity .

crm:hasGenomicLocation a owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range nuccore:chr_ID ;
    skos:exactMatch <https://www.ncbi.nlm.nih.gov/nuccore/chr_ID> .

crm:hasStartPosition a owl:DatatypeProperty ;
    rdfs:label "has start position" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer .

crm:hasEndPosition a owl:DatatypeProperty ;
    rdfs:label "has end position" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer .

crm:hasActivityScore a owl:DatatypeProperty ;
    rdfs:label "has activity score" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float .

crm:hasExpressionLevel a owl:DatatypeProperty ;
    rdfs:label "has expression level" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:float .

<http://example.org/ontology/FANTOM5/Enhancer1> a crm:Enhancer ;
    crm:hasGenomicLocation "chr1:839741-840250" ;
    crm:hasStartPosition 839741 ;
    crm:hasEndPosition 840250 ;
    crm:hasActivityScore 24 ;
    crm:hasExpressionLevel 0.73 .

<http://example.org/ontology/FANTOM5/Enhancer2> a crm:Enhancer ;
    crm:hasGenomicLocation "chr1:840753-841210" ;
    crm:hasStartPosition 840753 ;
    crm:hasEndPosition 841210 ;
    crm:hasActivityScore 32 ;
    crm:hasExpressionLevel 0.110 .

# Additional enhancer instances would follow the same pattern...