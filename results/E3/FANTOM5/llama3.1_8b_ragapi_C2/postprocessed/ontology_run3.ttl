@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://identifiers.org/human_cis_regulatory_module/> .
@prefix crm2pgene: <http://identifiers.org/crm2pgene/> .
@prefix hgene:   <http://identifiers.org/human_gene/> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore:  <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pmid/> .
@prefix id_ncbigene: <http://identifiers.org/ncbi_gene/> .
@prefix dbsuper: <http://identifiers.org/dbsuper/> .

# Classes
hcrm:CisRegulatoryModule a owl:Class ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:definition "A region of DNA that regulates gene expression.".

hcrm:Enhancer a hcrm:CisRegulatoryModule ;
    rdfs:subClassOf hcrm:CisRegulatoryModule .

hgene:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:definition "A unit of heredity that is passed from one generation to the next.".

# Properties
hcrm:hasTargetGene a rdf:Property ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range hgene:Gene .

hcrm:hasEnhancerSequence a rdf:Property ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range nuccore:NucleotideSequence .

hcrm:hasExperimentalEvidence a rdf:Property ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range pubmed:PubMedArticle .

# Alignments
hcrm:CisRegulatoryModule skos:exactMatch obo:GO_0003677 .
hcrm:Enhancer skos:closeMatch crm2pgene:CRM .
hgene:Gene skos:exactMatch obo:NCBITaxon_9606 .