@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://identifiers.org/human_cis_regulatory_module/> .
@prefix crm2pgene: <http://identifiers.org/crm2pgene/> .
@prefix hgene:   <http://identifiers.org/human_gene/> .
@prefix assembly: <http://identifiers.org/assembly/> .
@prefix nuccore: <http://identifiers.org/nuccore/> .
@prefix pubmed:  <http://identifiers.org/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/id_pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/id_ncbigene/> .
@prefix dbsuper: <http://identifiers.org/dbsuper/> .

crm: a owl:Ontology ;
    rdfs:label "cis-regulatory module ontology" .

EnhancerSequence: a crm2pgene:CisRegulatoryModule ;
    rdfs:label "enhancer sequence" ;
    skos:exactMatch <http://identifiers.org/human_cis_regulatory_module/CRMHS00000005752> .

GenomicCoordinate: a biolink:NamedThing ;
    rdfs:label "genomic coordinate" ;
    crm2pgene:hasGenomicCoordinate [
        rdf:type biolink:NamedThing ;
        crm2pgene:start <http://identifiers.org/nuccore/16366462> ;
        crm2pgene:end <http://identifiers.org/nuccore/16366839>
    ] .

TranscriptionFactor: a hgene:GeneProduct ;
    rdfs:label "transcription factor" ;
    skos:exactMatch <http://identifiers.org/human_gene/TAGAP> .

TargetGene: a hgene:GeneProduct ;
    rdfs:label "target gene" ;
    crm2pgene:hasTarget [
        rdf:type biolink:NamedThing ;
        crm2pgene:hasTarget [
            rdf:type biolink:NamedThing ;
            skos:exactMatch <http://identifiers.org/human_gene/FAM131C>
        ]
    ] .

Disease: a biolink:Disease ;
    rdfs:label "disease" ;
    crm2pgene:hasAssociation [
        rdf:type biolink:NamedThing ;
        crm2pgene:hasAssociation [
            rdf:type biolink:NamedThing ;
            skos:exactMatch <http://identifiers.org/pubmed/24670763>
        ]
    ] .

EnhancerSequence × TranscriptionFactor → TargetGene
EnhancerSequence × Disease → Association

crm2pgene:CisRegulatoryModule rdfs:subClassOf crm2pgene:GenomicRegion .
crm2pgene:GenomicCoordinate rdf:type biolink:NamedThing .
hgene:GeneProduct rdfs:subClassOf biolink:NamedThing .
crm2pgene:Target rdfs:subClassOf biolink:NamedThing .
biolink:Disease rdfs:subClassOf biolink:NamedThing .

crm2pgene:CisRegulatoryModule owl:equivalentClass <http://identifiers.org/human_cis_regulatory_module/CRM> .
hgene:GeneProduct owl:sameAs <http://identifiers.org/human_gene/> .