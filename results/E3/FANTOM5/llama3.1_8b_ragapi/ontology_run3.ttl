@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://identifiers.org/human_cis_regulatory_module/> .
@prefix crm2pgene: <http://identifiers.org/crm2pgene/> .
@prefix hgene:   <http://identifiers.org/human_gene/> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbi_gene/> .
@prefix dbsuper: <http://identifiers.org/dbsuper/> .

# Classes
hcrm:CisRegulatoryModule a owl:Class ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:definition "A region of DNA that regulates gene expression.".

hcrm:Enhancer a owl:Class ;
    rdfs:subClassOf hcrm:CisRegulatoryModule ;
    rdfs:label "Enhancer" ;
    skos:definition "A type of cis-regulatory module that increases transcription.".

hgene:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:definition "A unit of heredity that is passed from one generation to the next.".

crm2pgene:CisRegulatoryModuleToGeneAssociation a owl:Class ;
    rdfs:subClassOf biolink:Association ;
    rdfs:label "Cis-Regulatory Module to Gene Association" ;
    skos:definition "An association between a cis-regulatory module and a gene.".

# Properties
hcrm:hasEnhancerSequence a owl:ObjectProperty ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range nuccore:NucleotideSequence ;
    rdfs:label "Has Enhancer Sequence" ;
    skos:definition "The nucleotide sequence of an enhancer.".

hcrm:hasTargetGene a owl:ObjectProperty ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range crm2pgene:CisRegulatoryModuleToGeneAssociation ;
    rdfs:label "Has Target Gene" ;
    skos:definition "The gene that is regulated by an enhancer.".

hgene:hasTranscript a owl:ObjectProperty ;
    rdfs:domain hgene:Gene ;
    rdfs:range nuccore:NucleotideSequence ;
    rdfs:label "Has Transcript" ;
    skos:definition "The nucleotide sequence of a gene's transcript.".

# Individuals
CRMHS00000005752 a hcrm:CisRegulatoryModule ;
    hcrm:hasEnhancerSequence <http://identifiers.org/nuccore/NM_00112345> ;
    hcrm:hasTargetGene crm2pgene:Crm2pGeneAssociation1 .

CRMHS00000005753 a hcrm:CisRegulatoryModule ;
    hcrm:hasEnhancerSequence <http://identifiers.org/nuccore/NM_00112346> ;
    hcrm:hasTargetGene crm2pgene:Crm2pGeneAssociation2 .