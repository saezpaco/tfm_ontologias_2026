@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .

<http://example.org/chromosome> a rdfs:Class ;
  rdfs:label "Chromosome" ;
  skos:exactMatch hcrm:9606CRMHS00000003515 .

<http://example.org/gene> a rdfs:Class ;
  rdfs:label "Gene" ;
  skos:closeMatch crm2pgene:bgw!CRMHS00000003515--hgncsymbol!9606/TBX5 .

<http://example.org/region> a rdfs:Class ;
  rdfs:label "Genomic Region" ;
  owl:somePropertyOf <http://example.org/chromosome> .

<http://example.org/transcript> a rdfs:Class ;
  rdfs:label "Transcript" ;
  skos:closeMatch crm2pgene:bgw!CRMHS00000003515--hgncsymbol!9606/TBX5 .

<http://example.org/protein> a rdfs:Class ;
  rdfs:label "Protein" ;
  owl:somePropertyOf <http://example.org/transcript> .