@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://rdf.biogateway.eu/crm2gene#> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene#> .
@prefix hgene:   <http://purl.uniprot.org/uniprot/> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper#> .

<http://example.org/crm2gene_example>
  a owl:Ontology ;
  rdfs:label "crm2gene example" .

<http://example.org/crm_ID>
  a hcrm:CrmId ;
  rdfs:label "Crm ID" ;
  skos:exactMatch <http://rdf.biogateway.eu/crm2tfac/bgw!crm_ID--uniprot!uniprot_ID> .

<http://example.org/hgnc_symbol_target_genes>
  a crm2pgene:HgncSymbolTargetGene ;
  rdfs:label "Hgnc Symbol Target Gene" ;
  skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/bgw!crm_ID--hgncsymbol!9606/gene_sybmol> .

<http://example.org/orig_end>
  a nuccore:NucleotideSequence ;
  rdfs:label "Nucleotide Sequence" ;
  skos:exactMatch <http://www.licpathway.net/ENdb/> .

<http://example.org/current_end>
  a nuccore:NucleotideSequence ;
  rdfs:label "Nucleotide Sequence" ;
  skos:exactMatch <http://www.licpathway.net/ENdb/> .

<http://example.org/disease_PMID>
  a obo:Disease ;
  rdfs:label "Disease" ;
  skos:exactMatch <http://rdf.biogateway.eu/crm2phen/bgw!CRMHS00000003515--doid!1682> .

<http://example.org/original_ID>
  a hcrm:CrmId ;
  rdfs:label "Crm ID" ;
  skos:exactMatch <http://rdf.biogateway.eu/crm2tfac/bgw!crm_ID--uniprot!uniprot_ID> .

<http://example.org/refsnp_ID>
  a obo:Disease ;
  rdfs:label "Disease" ;
  skos:exactMatch <http://rdf.biogateway.eu/crm2phen/bgw!CRMHS00000003515--doid!1682> .