@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://rdf.biogateway.eu/hgene/> .
@prefix assembly: <http://rdf.biogateway.eu/assembly/> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix pubmed:  <https://pubmed.ncbi.nlm.nih.gov/> .
@prefix id_pubmed: <http://rdf.biogateway.eu/id_pubmed/> .
@prefix id_ncbigene: <http://rdf.biogateway.eu/id_ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

# Ontology definition
<http://bioinfo.vanderbilt.edu/AE/HACER/> rdf:type owl:Ontology ;
    rdfs:label "Human Active Cis-regulatory Elements database" .

# Classes
obo:SO_0000727 rdf:type owl:Class ;
    rdfs:label "Cis-regulatory module" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000727> .

biolink:Gene rdf:type owl:Class ;
    rdfs:label "Gene" .

biolink:Disease rdf:type owl:Class ;
    rdfs:label "Disease" .

biolink:GenomicEntity rdf:type owl:Class ;
    rdfs:label "Genomic Entity" .

# Properties
biolink:has_gene_target rdf:type owl:ObjectProperty ;
    rdfs:label "has gene target" ;
    rdfs:domain obo:SO_0000727 ;
    rdfs:range biolink:Gene ;
    skos:exactMatch crm2pgene:has_gene_target .

biolink:has_disease_association rdf:type owl:ObjectProperty ;
    rdfs:label "has disease association" ;
    rdfs:domain obo:SO_0000727 ;
    rdfs:range biolink:Disease ;
    skos:exactMatch crm2pgene:has_disease_association .

biolink:located_in rdf:type owl:ObjectProperty ;
    rdfs:label "located in" ;
    rdfs:domain obo:SO_0000727 ;
    rdfs:range biolink:GenomicEntity ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/located_in> .

# Example instances
hcrm:CRMHS00000078104 rdf:type obo:SO_0000727 ;
    rdfs:label "CRMHS00000078104" ;
    biolink:located_in [
        rdf:type biolink:GenomicEntity ;
        nuccore:chr1 ;
        assembly:hg38 ;
        sio:SIO_000300 "230113600"^^xsd:integer ;
        sio:SIO_000301 "230114260"^^xsd:integer
    ] ;
    biolink:has_gene_target hgene:GALNT2 ;
    dc:source <http://bioinfo.vanderbilt.edu/AE/HACER/> ;
    pubmed:30247654 .

hgene:GALNT2 rdf:type biolink:Gene ;
    rdfs:label "GALNT2" ;
    skos:exactMatch id_ncbigene:2583 .

# Additional instances and properties can be added similarly