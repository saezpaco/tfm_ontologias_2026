@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://www.licpathway.net/ENdb/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/bgw!> .
@prefix hgene:   <http://rdf.biogateway.eu/hgene/bgw!> .
@prefix assembly:<http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix pubmed:  <http://purl.obolibrary.org/obo/PUBMED_> .
@prefix id_pubmed:<http://identifiers.org/pubmed/> .
@prefix id_ncbigene:<http://identifiers.org/ncbi-gene/> .
@prefix dbsuper: <http://purl.obolibrary.org/obo/SO_0001217> .

# Example of how to reuse cisreg URIs with skos:exactMatch
crm_ID rdfs:label "CRM" ;
        skos:exactMatch obo:SO_0000727 .

orig_end rdfs:label "ENdb" ;
         skos:closeMatch hcrm:ENdb .

current_end rdfs:label "ENdb" ;
            skos:closeMatch hcrm:ENdb .

hgnc_symbol_target_genes <http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> rdfs:label "bgw!CRMHS00000003515--hgncsymbol!9606/TBX5" ;
                          skos:exactMatch obo:NCIT_C17207 .

biosample_name <https://www.ncbi.nlm.nih.gov/nuccore/chr_ID> rdfs:label "chr_name" ;
               skos:closeMatch assembly:chromosome .

disease_PMID <http://rdf.biogateway.eu/crm2phen/bgw!CRMHS00000003515--doid!1682> rdfs:label "bgw!CRMHS00000003515--doid!1682" ;
             skos:closeMatch pubmed:PUBMED_1682 .

orig_chr <https://www.ncbi.nlm.nih.gov/nuccore/chr_ID> rdfs:label "chr_name" ;
         skos:exactMatch assembly:chromosome .

current_chr <https://www.ncbi.nlm.nih.gov/nuccore/chr_ID> rdfs:label "chr_name" ;
            skos:exactMatch assembly:chromosome .