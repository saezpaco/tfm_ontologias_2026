@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm2tfac/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://rdf.biogateway.eu/crm2phen/> .
@prefix assembly: <http://www.licpathway.net/ENdb/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix id_pubmed: <http://rdf.biogateway.eu/id_pubmed/> .
@prefix id_ncbigene: <http://rdf.biogateway.eu/id_ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

<http://bioinfo.vanderbilt.edu/AE/HACER/> rdf:type owl:Ontology ;
    rdfs:label "Human Active Cis-regulatory Elements database" .

### Classes
<http://bioinfo.vanderbilt.edu/AE/HACER/CisRegulatoryModule> rdf:type owl:Class ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/CRMHS00000003515--hgncsymbol!9606/TBX5> .

<http://bioinfo.vanderbilt.edu/AE/HACER/Enhancer> rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/CRMHS00000003515--hgncsymbol!9606/TBX5> .

<http://bioinfo.vanderbilt.edu/AE/HACER/TranscriptionFactor> rdf:type owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch obo:NCIT_C17207 .

<http://bioinfo.vanderbilt.edu/AE/HACER/Gene> rdf:type owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/CRMHS00000003515--hgncsymbol!9606/TBX5> .

<http://bioinfo.vanderbilt.edu/AE/HACER/Disease> rdf:type owl:Class ;
    rdfs:label "Disease" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/CRMHS00000003515--doid!1682> .

### Properties
<http://bioinfo.vanderbilt.edu/AE/HACER/hasGenomicCoordinate> rdf:type owl:ObjectProperty ;
    rdfs:label "has Genomic Coordinate" ;
    skos:closeMatch assembly:ENdb .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasTargetGene> rdf:type owl:ObjectProperty ;
    rdfs:label "has Target Gene" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/CRMHS00000003515--hgncsymbol!9606/TBX5> .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasTranscriptionFactor> rdf:type owl:ObjectProperty ;
    rdfs:label "has Transcription Factor" ;
    skos:exactMatch obo:NCIT_C17207 .

<http://bioinfo.vanderbilt.edu/AE/HACER/associatedWithDisease> rdf:type owl:ObjectProperty ;
    rdfs:label "associated with Disease" ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/CRMHS00000003515--doid!1682> .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasExperimentalEvidence> rdf:type owl:DatatypeProperty ;
    rdfs:label "has Experimental Evidence" ;
    rdfs:range xsd:string .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasCellLineActivity> rdf:type owl:DatatypeProperty ;
    rdfs:label "has Cell Line Activity" ;
    rdfs:range xsd:string .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasPMID> rdf:type owl:DatatypeProperty ;
    rdfs:label "has PMID" ;
    rdfs:range xsd:string ;
    skos:exactMatch pubmed:30247654 .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasSNP> rdf:type owl:DatatypeProperty ;
    rdfs:label "has SNP" ;
    rdfs:range xsd:string ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2tfac/CRMHS00000003515--uniprot!uniprot_ID> .