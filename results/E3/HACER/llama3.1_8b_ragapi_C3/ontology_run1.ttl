@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://bioinfo.vanderbilt.edu/AE/HACER#> .
@prefix crm2pgene: <http://bioinfo.vanderbilt.edu/AE/crm2pgene#> .
@prefix hgene:   <http://bioinfo.vanderbilt.edu/AE/hgene#> .
@prefix assembly: <http://bioinfo.vanderbilt.edu/AE/assembly#> .
@prefix nuccore:  <http://bioinfo.vanderbilt.edu/AE/nuccore#> .
@prefix pubmed:   <http://bioinfo.vanderbilt.edu/AE/pubmed#> .
@prefix id_pubmed: <http://bioinfo.vanderbilt.edu/AE/id_pubmed#> .
@prefix id_ncbigene: <http://bioinfo.vanderbilt.edu/AE/id_ncbigene#> .
@prefix dbsuper:  <http://bioinfo.vanderbilt.edu/AE/dbsuper#> .

crm a owl:Class ;
    rdfs:label "cis-regulatory module" ;
    skos:definition "a region of DNA that regulates gene expression" .

enhancer a crm ;
    rdfs:label "enhancer sequence" ;
    skos:definition "a specific type of cis-regulatory module that activates transcription" .

target_gene a owl:Class ;
    rdfs:label "target gene" ;
    skos:definition "a gene whose expression is regulated by an enhancer" .

transcription_factor a owl:Class ;
    rdfs:label "transcription factor" ;
    skos:definition "a protein that binds to DNA and regulates transcription" .

cell_line a owl:Class ;
    rdfs:label "cell line" ;
    skos:definition "a population of cells grown in culture" .

disease a owl:Class ;
    rdfs:label "disease" ;
    skos:definition "a medical condition caused by genetic or environmental factors" .

enhancer_sequence a crm ;
    rdfs:label "enhancer sequence" ;
    skos:definition "a specific type of cis-regulatory module that activates transcription" .

genomic_coordinate a owl:Class ;
    rdfs:label "genomic coordinate" ;
    skos:definition "a location on the genome where an enhancer is found" .

assembly_version a owl:Class ;
    rdfs:label "assembly version" ;
    skos:definition "the version of the genome assembly used to map an enhancer" .

enhancer_PMID a rdf:Property ;
    rdfs:label "PMID of enhancer publication" ;
    skos:definition "the PubMed ID of the publication describing the enhancer" .

biosample_name a rdf:Property ;
    rdfs:label "name of biosample" ;
    skos:definition "the name of the biosample used to map an enhancer" .

enh_method a rdf:Property ;
    rdfs:label "method of enhancer identification" ;
    skos:definition "the method used to identify the enhancer sequence" .

crm2pgene:has_target_gene a rdf:Property ;
    rdfs:label "target gene of enhancer" ;
    skos:definition "the target gene regulated by an enhancer" .

hgene:has_transcription_factor a rdf:Property ;
    rdfs:label "transcription factor associated with enhancer" ;
    skos:definition "the transcription factor that binds to the enhancer sequence" .