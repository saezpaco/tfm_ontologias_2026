@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix pubmed:  <https://pubmed.ncbi.nlm.nih.gov/> .

# Ontology definition
<http://bioinfo.vanderbilt.edu/AE/HACER/> rdf:type owl:Ontology ;
    rdfs:label "Human Active Cis-regulatory Elements database" .

# Classes
obo:SO_0000727 rdf:type owl:Class ;
    rdfs:label "Cis-regulatory module" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000727> .

biolink:Gene rdf:type owl:Class ;
    rdfs:label "Gene" .

biolink:Disease rdf:type owl:Class ;
    rdfs:label "Disease" .

biolink:GenomicEntity rdf:type owl:Class ;
    rdfs:label "Genomic Entity" .

# Properties
biolink:has_genomic_location rdf:type owl:ObjectProperty ;
    rdfs:label "has genomic location" ;
    rdfs:domain obo:SO_0000727 ;
    rdfs:range biolink:GenomicEntity .

biolink:regulates_expression_of rdf:type owl:ObjectProperty ;
    rdfs:label "regulates expression of" ;
    rdfs:domain obo:SO_0000727 ;
    rdfs:range biolink:Gene ;
    skos:exactMatch crm2pgene:bgw!crm_ID--hgncsymbol!9606/gene_sybmol .

biolink:associated_with rdf:type owl:ObjectProperty ;
    rdfs:label "associated with" ;
    rdfs:domain obo:SO_0000727 ;
    rdfs:range biolink:Disease ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2phen/bgw!crm_ID--doid!doid> .

biolink:has_evidence rdf:type owl:ObjectProperty ;
    rdfs:label "has evidence" ;
    rdfs:domain obo:SO_0000727 ;
    rdfs:range pubmed: .

biolink:has_snp_association rdf:type owl:ObjectProperty ;
    rdfs:label "has SNP association" ;
    rdfs:domain obo:SO_0000727 ;
    rdfs:range nuccore: .

# Example instance
hcrm:CRMHS00000078104 rdf:type obo:SO_0000727 ;
    rdfs:label "CRMHS00000078104" ;
    biolink:has_genomic_location [
        rdf:type biolink:GenomicEntity ;
        nuccore:chr1 "230113600-230114260"^^xsd:string ;
        schema:assembly "hg38"^^xsd:string
    ] ;
    biolink:regulates_expression_of <http://rdf.biogateway.eu/crm2pgene/bgw!CRMHS00000078104--hgncsymbol!9606/GALNT2> ;
    biolink:has_evidence pubmed:30247654 ;
    biolink:has_snp_association nuccore:rs34631471 .