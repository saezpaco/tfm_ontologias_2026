@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://rdf.biogateway.eu/crm2gene/hcrm#> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/bgw#> .
@prefix hgene:   <http://rdf.biogateway.eu/crm2pgene/hgene#> .
@prefix assembly: <http://rdf.biogateway.eu/assembly/> .
@prefix nuccore: <http://rdf.biogateway.eu/nuccore/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix id_pubmed: <http://rdf.biogateway.eu/id_pubmed/> .
@prefix id_ncbigene: <http://rdf.biogateway.eu/id_ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

# === RECOMMENDED ONTOLOGIES (semantic search) ===
hcrm:crm2gene_example a biolink:Ontology ;
    rdfs:label "crm2gene_example" ;
    skos:exactMatch <https://example.com/crm2gene_example> .
hcrm:crm2gene a biolink:Ontology ;
    rdfs:label "crm2gene" ;
    skos:closeMatch <https://example.com/crm2gene> .
hcrm:crm2phen_example a biolink:Ontology ;
    rdfs:label "crm2phen_example" ;
    skos:exactMatch <https://example.com/crm2phen_example> .
hcrm:crm2tfac_example a biolink:Ontology ;
    rdfs:label "crm2tfac_example" ;
    skos:closeMatch <https://example.com/crm2tfac_example> .

# === COLUMN → ONTOLOGY CLASS MAPPINGS ===
hcrm:orig_end a obo:ENdb ;
    rdfs:label "ENdb" .
hcrm:current_end a obo:ENdb ;
    rdfs:label "ENdb" .
hcrm:hgnc_symbol_target_genes a <http://rdf.biogateway.eu/crm2pgene/bgw#bgw!CRMHS00000003515--hgncsymbol!9606/TBX5> ;
    rdfs:label "bgw!CRMHS00000003515--hgncsymbol!9606/TBX5" .
hcrm:crm_ID a <http://rdf.biogateway.eu/crm2pgene/hgene#bgw!crm_ID--uniprot!uniprot_ID> ;
    rdfs:label "bgw!crm_ID--uniprot!uniprot_ID" .