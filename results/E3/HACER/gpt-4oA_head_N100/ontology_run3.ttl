@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix pubmed:  <https://pubmed.ncbi.nlm.nih.gov/> .

<http://bioinfo.vanderbilt.edu/AE/HACER/> a owl:Ontology ;
    rdfs:label "Human Active Cis-regulatory Elements database" .

# Classes
obo:SO_0000727 a owl:Class ;
    rdfs:label "Cis-regulatory module" ;
    skos:exactMatch hcrm:CRM .

biolink:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:exactMatch crm2pgene:Gene .

biolink:Disease a owl:Class ;
    rdfs:label "Disease" .

biolink:CellLine a owl:Class ;
    rdfs:label "Cell Line" .

biolink:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:exactMatch obo:NCIT_C17207 .

# Properties
biolink:has_sequence_location a owl:ObjectProperty ;
    rdfs:label "has sequence location" ;
    skos:exactMatch nuccore:chr_name .

biolink:has_target_gene a owl:ObjectProperty ;
    rdfs:label "has target gene" ;
    skos:exactMatch crm2pgene:has_target_gene .

biolink:has_associated_disease a owl:ObjectProperty ;
    rdfs:label "has associated disease" .

biolink:expressed_in a owl:ObjectProperty ;
    rdfs:label "expressed in" ;
    skos:exactMatch biolink:expressed_in .

biolink:has_transcription_factor a owl:ObjectProperty ;
    rdfs:label "has transcription factor" ;
    skos:exactMatch obo:NCIT_C17207 .

# Example Individuals
hcrm:CRMHS00000005752 a obo:SO_0000727 ;
    biolink:has_sequence_location [
        a biolink:GenomicSequenceLocation ;
        nuccore:chr_name "chr1" ;
        biolink:start_position "16039967"^^xsd:integer ;
        biolink:end_position "16040344"^^xsd:integer ;
        biolink:genome_assembly "hg38"
    ] ;
    biolink:expressed_in [
        a biolink:CellLine ;
        rdfs:label "MS-1"
    ] ;
    biolink:has_target_gene [
        a biolink:Gene ;
        rdfs:label "FAM131C"
    ] ;
    biolink:has_transcription_factor [
        a biolink:TranscriptionFactor ;
        rdfs:label "ZBTB17"
    ] ;
    biolink:has_associated_disease [
        a biolink:Disease ;
        rdfs:label "Disease Name" ;
        dc:identifier pubmed:30247654
    ] .

# Additional individuals and properties can be added similarly based on the data sample.