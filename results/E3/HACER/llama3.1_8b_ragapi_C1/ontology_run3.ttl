@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://purl.obolibrary.org/obo/hcrm#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgene#> .
@prefix assembly: <http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore: <http://purl.obolibrary.org/obo/nuccore#> .
@prefix pubmed:  <http://purl.obolibrary.org/obo/pubmed#> .
@prefix id_pubmed: <http://purl.obolibrary.org/obo/id_pubmed#> .
@prefix id_ncbigene: <http://purl.obolibrary.org/obo/id_ncbigene#> .
@prefix dbsuper: <http://purl.obolibrary.org/obo/dbsuper#> .

crm: a owl:Ontology ;
    rdfs:label "cis-regulatory module ontology" .

CisRegModule: a crm2pgene:Crm ;
    rdfs:label "cis-regulatory module" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/hcrm#0000011> .

EnhancerSequence: a CisRegModule ;
    rdfs:label "enhancer sequence" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/crm2pgene#0000023> .

GenomicCoordinate: a assembly:AssemblyLocation ;
    rdfs:label "genomic coordinate" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/assembly#0000011> .

TranscriptionFactor: a hgene:GeneProduct ;
    rdfs:label "transcription factor" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/hgene#0000023> .

TargetGene: a crm2pgene:CrmTarget ;
    rdfs:label "target gene" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/crm2pgene#0000011> .

Disease: a dbsuper:Disease ;
    rdfs:label "disease" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/dbsuper#0000023> .

crm:CisRegModule rdfs:subClassOf crm2pgene:Crm .
crm:EnhancerSequence rdfs:subClassOf crm:CisRegModule .
crm:GenomicCoordinate rdfs:subClassOf assembly:AssemblyLocation .
crm:TranscriptionFactor rdfs:subClassOf hgene:GeneProduct .
crm:TargetGene rdfs:subClassOf crm2pgene:CrmTarget .
crm:Disease rdfs:subClassOf dbsuper:Disease .

crm:CisRegModule biolink:has_target crm:TargetGene .
crm:CisRegModule biolink:regulates crm:TranscriptionFactor .
crm:CisRegModule biolink:located_in crm:GenomicCoordinate .
crm:CisRegModule biolink:associated_with crm:Disease .

crm:EnhancerSequence biolink:has_sequence crm:GenomicCoordinate .
crm:TargetGene biolink:has_gene_product crm:TranscriptionFactor .
crm:Disease biolink:has_disease crm:CisRegModule .