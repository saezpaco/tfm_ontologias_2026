@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://rdf.biogateway.eu/hgene/> .
@prefix assembly: <http://rdf.biogateway.eu/assembly/> .
@prefix nuccore: <http://rdf.biogateway.eu/nuccore/> .
@prefix pubmed:  <http://rdf.biogateway.eu/pubmed/> .
@prefix id_pubmed: <http://rdf.biogateway.eu/id_pubmed/> .
@prefix id_ncbigene: <http://rdf.biogateway.eu/id_ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .

# Ontology definition
<http://bioinfo.vanderbilt.edu/AE/HACER/> rdf:type owl:Ontology ;
    rdfs:label "Human Active Cis-regulatory Elements database" ;
    dc:source <http://bioinfo.vanderbilt.edu/AE/HACER/> .

# Classes
hcrm:CisRegulatoryModule rdf:type owl:Class ;
    rdfs:label "Cis-regulatory Module" ;
    skos:exactMatch crm2pgene:CRMHS00000003515 .

hgene:Gene rdf:type owl:Class ;
    rdfs:label "Gene" .

hgene:TranscriptionFactor rdf:type owl:Class ;
    rdfs:label "Transcription Factor" .

# Properties
hcrm:hasGenomicCoordinate rdf:type owl:ObjectProperty ;
    rdfs:label "has genomic coordinate" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range assembly:GenomicCoordinate .

hcrm:targetsGene rdf:type owl:ObjectProperty ;
    rdfs:label "targets gene" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range hgene:Gene ;
    skos:exactMatch <http://rdf.biogateway.eu/crm2pgene/bgw!crm_ID--hgncsymbol!9606/gene_sybmol> .

hcrm:hasTranscriptionFactor rdf:type owl:ObjectProperty ;
    rdfs:label "has transcription factor" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range hgene:TranscriptionFactor .

hcrm:hasBiosample rdf:type owl:ObjectProperty ;
    rdfs:label "has biosample" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range schema:BioSample .

hcrm:hasExperimentalMethod rdf:type owl:DatatypeProperty ;
    rdfs:label "has experimental method" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range xsd:string .

hcrm:hasDiseaseAssociation rdf:type owl:ObjectProperty ;
    rdfs:label "has disease association" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range obo:DOID_4 .

# Example instance
<http://bioinfo.vanderbilt.edu/AE/HACER/CRMHS00000079551> rdf:type hcrm:CisRegulatoryModule ;
    hcrm:hasGenomicCoordinate [
        rdf:type assembly:GenomicCoordinate ;
        assembly:chromosome "chr1" ;
        assembly:start 51622556 ;
        assembly:end 51623091 ;
        assembly:assemblyVersion "hg38"
    ] ;
    hcrm:targetsGene hgene:OSBPL9 ;
    hcrm:hasBiosample <http://bioinfo.vanderbilt.edu/AE/HACER/EBC-1> ;
    hcrm:hasExperimentalMethod "CAGE" ;
    hcrm:hasDiseaseAssociation obo:DOID_4 .

# Additional instances and properties can be added similarly