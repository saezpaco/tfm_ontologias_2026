@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://purl.obolibrary.org/obo/hcrm#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgene#> .
@prefix assembly: <http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore: <http://purl.obolibrary.org/obo/nuccore#> .
@prefix pubmed:  <http://purl.obolibrary.org/obo/pubmed#> .
@prefix id_pubmed: <http://purl.obolibrary.org/obo/id_pubmed#> .
@prefix id_ncbigene: <http://purl.obolibrary.org/obo/id_ncbigene#> .
@prefix dbsuper: <http://purl.obolibrary.org/obo/dbsuper#> .

hcrm:CisRegulatoryModule a owl:Class ;
    rdfs:label "Cis-regulatory module" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/crm#0000013> .

hcrm:CisRegulatoryModule_has_target_gene a owl:ObjectProperty ;
    rdfs:label "has target gene" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/biolink/P000010> .

hcrm:CisRegulatoryModule_has_transcription_factor a owl:ObjectProperty ;
    rdfs:label "has transcription factor" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/crm2tfac#0000013> .

hcrm:CisRegulatoryModule_has_disease_association a owl:ObjectProperty ;
    rdfs:label "has disease association" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/dbsuper#0000021> .

hcrm:CisRegulatoryModule_has_genomic_coordinates a owl:ObjectProperty ;
    rdfs:label "has genomic coordinates" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/crm#0000014> .

hcrm:CisRegulatoryModule_has_evidence a owl:ObjectProperty ;
    rdfs:label "has evidence" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/biolink/P000011> .

hcrm:CisRegulatoryModule_has_cell_line_activity a owl:ObjectProperty ;
    rdfs:label "has cell line activity" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/crm#0000015> .

hcrm:CisRegulatoryModule_has_expression_correlation a owl:ObjectProperty ;
    rdfs:label "has expression correlation" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/biolink/P000012> .