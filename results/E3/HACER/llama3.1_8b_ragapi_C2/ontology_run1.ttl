@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://purl.obolibrary.org/obo/hgnc#> .
@prefix crm2pgene: <http://purl.obolibrary.org/obo/crm2pgene#> .
@prefix hgene:   <http://purl.obolibrary.org/obo/hgnc#> .
@prefix assembly: <http://purl.obolibrary.org/obo/assembly#> .
@prefix nuccore: <http://purl.obolibrary.org/obo/nuccore#> .
@prefix pubmed:  <http://purl.obolibrary.org/obo/pubmed#> .
@prefix id_pubmed: <http://purl.obolibrary.org/obo/id_pubmed#> .
@prefix id_ncbigene: <http://purl.obolibrary.org/obo/id_ncbigene#> .
@prefix dbsuper: <http://purl.obolibrary.org/obo/dbsuper#> .

crm:crm_ID rdf:type owl:Class ;
           rdfs:label "cis-regulatory module ID" ;
           skos:exactMatch <http://purl.obolibrary.org/obo/crm_id#> .

crm:orig_chr rdf:type owl:DatatypeProperty ;
              rdfs:label "original chromosome" ;
              skos:closeMatch <http://purl.obolibrary.org/obo/hgnc#chromosome_location> .

crm:orig_start rdf:type owl:DatatypeProperty ;
                rdfs:label "original start position" ;
                skos:closeMatch <http://purl.obolibrary.org/obo/assembly#start_position> .

crm:orig_end rdf:type owl:DatatypeProperty ;
              rdfs:label "original end position" ;
              skos:closeMatch <http://purl.obolibrary.org/obo/assembly#end_position> .

crm:current_chr rdf:type owl:DatatypeProperty ;
                 rdfs:label "current chromosome" ;
                 skos:closeMatch <http://purl.obolibrary.org/obo/hgnc#chromosome_location> .

crm:current_start rdf:type owl:DatatypeProperty ;
                   rdfs:label "current start position" ;
                   skos:closeMatch <http://purl.obolibrary.org/obo/assembly#start_position> .

crm:current_end rdf:type owl:DatatypeProperty ;
                 rdfs:label "current end position" ;
                 skos:closeMatch <http://purl.obolibrary.org/obo/assembly#end_position> .

crm:assembly rdf:type owl:ObjectProperty ;
              rdfs:label "assembly" ;
              skos:closeMatch <http://purl.obolibrary.org/obo/assembly#assembly> .

crm:nuccore rdf:type owl:ObjectProperty ;
             rdfs:label "nuccore accession" ;
             skos:closeMatch <http://purl.obolibrary.org/obo/nuccore#accesion> .

crm:pubmed rdf:type owl:ObjectProperty ;
            rdfs:label "PubMed ID" ;
            skos:closeMatch <http://purl.obolibrary.org/obo/pubmed#id_pubmed> .

crm:id_ncbigene rdf:type owl:ObjectProperty ;
                 rdfs:label "NCBI Gene ID" ;
                 skos:closeMatch <http://purl.obolibrary.org/obo/id_ncbigene#accesion> .

crm:dbsuper rdf:type owl:ObjectProperty ;
             rdfs:label "dbsuper accession" ;
             skos:closeMatch <http://purl.obolibrary.org/obo/dbsuper#accesion> .

crm:hgnc_symbol rdf:type owl:ObjectProperty ;
                 rdfs:label "HGNC symbol" ;
                 skos:closeMatch <http://purl.obolibrary.org/obo/hgnc#symbol> .

crm:crm2pgene rdf:type owl:ObjectProperty ;
              rdfs:label "cis-regulatory module to gene association" ;
              skos:closeMatch <http://purl.obolibrary.org/obo/crm2pgene#accesion> .