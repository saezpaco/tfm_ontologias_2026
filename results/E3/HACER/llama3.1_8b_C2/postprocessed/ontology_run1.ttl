@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://rdf.biogateway.eu/crm2pgene/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://purl.uniprot.org/uniprot/> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://rdf.biogateway.eu/dbsuper/> .
@prefix crm2tfac: <http://rdf.biogateway.eu/crm2tfac/> .

# Classes
hcrm:CisRegulatoryModule a owl:Class ;
    rdfs:label "Cis-regulatory module" ;
    skos:exactMatch hcrm:Crm2pgene_Crm .

hcrm:EnhancerSequence a owl:Class ;
    rdfs:label "Enhancer sequence" ;
    skos:closeMatch crm2pgene:EnhancerSequence .

hcrm:TargetGene a owl:Class ;
    rdfs:label "Target gene" ;
    skos:exactMatch hgene:Gene .

hcrm:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription factor" ;
    skos:closeMatch crm2tfac:TranscriptionFactor .

# Properties
hcrm:hasEnhancerSequence a rdf:Property ;
    rdfs:label "Has enhancer sequence" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range hcrm:EnhancerSequence .

hcrm:hasTargetGene a rdf:Property ;
    rdfs:label "Has target gene" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range hcrm:TargetGene .

hcrm:hasTranscriptionFactor a rdf:Property ;
    rdfs:label "Has transcription factor" ;
    rdfs:domain hcrm:CisRegulatoryModule ;
    rdfs:range hcrm:TranscriptionFactor .

# Individuals
hcrm:Crmhs00000003515 a hcrm:CisRegulatoryModule ;
    hcrm:hasEnhancerSequence <http://rdf.biogateway.eu/crm2pgene/CRMHS00000003515-EnhancerSequence> ;
    hcrm:hasTargetGene <http://purl.uniprot.org/uniprot/TBX5> .

hcrm:Crmhs00000003516 a hcrm:CisRegulatoryModule ;
    hcrm:hasEnhancerSequence <http://rdf.biogateway.eu/crm2pgene/CRMHS00000003516-EnhancerSequence> ;
    hcrm:hasTargetGene <http://purl.uniprot.org/uniprot/TBX6> .
