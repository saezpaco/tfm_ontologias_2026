@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .

@prefix hcrm:    <http://bioinfo.vanderbilt.edu/AE/HACER/> .
@prefix crm2pgene: <https://rdf.biogateway.eu/crm2pgene/> .
@prefix hgene:   <http://identifiers.org/hgnc/> .
@prefix assembly: <http://purl.uniprot.org/assembly/> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nucleotide/> .
@prefix pubmed:  <https://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .
@prefix id_ncbigene: <http://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://purl.uniprot.org/databases/> .

# Classes
hcrm:CisRegulatoryModule a owl:Class ;
  rdfs:label "Cis-regulatory module" ;
  skos:exactMatch crm2pgene:Crm .

hcrm:Biosample a owl:Class ;
  rdfs:label "Biosample" ;
  skos:closeMatch schema:Sample .

hcrm:TranscriptionFactor a owl:Class ;
  rdfs:label "Transcription factor" ;
  skos:exactMatch biolink:Protein .

hcrm:Disease a owl:Class ;
  rdfs:label "Disease" ;
  skos:closeMatch obo:DOID .

# Properties
hcrm:hasCisRegulatoryModule a rdf:Property ;
  rdfs:domain hcrm:Biosample ;
  rdfs:range hcrm:CisRegulatoryModule ;
  skos:exactMatch crm2pgene:has_crm .

hcrm:hasTranscriptionFactor a rdf:Property ;
  rdfs:domain hcrm:CisRegulatoryModule ;
  rdfs:range hcrm:TranscriptionFactor ;
  skos:closeMatch biolink:has_protein .

hcrm:hasDisease a rdf:Property ;
  rdfs:domain hcrm:Biosample ;
  rdfs:range hcrm:Disease ;
  skos:exactMatch obo:has_disease .

# Individuals
hcrm:Crm001 a hcrm:CisRegulatoryModule ;
  hcrm:hasCisRegulatoryModule hcrm:Biosample001 ;
  hcrm:hasTranscriptionFactor hcrm:TF001 .

hcrm:Biosample001 a hcrm:Biosample ;
  hcrm:hasDisease hcrm:Disease001 .

hcrm:Disease001 a hcrm:Disease ;
  skos:closeMatch obo:DOID:1234 .