@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://rdf.biogateway.eu/crm/9606> .
@prefix nuccore: <https://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix assembly: <https://www.ncbi.nlm.nih.gov/assembly/> .
@prefix pubmed:  <http://www.ncbi.nlm.nih.gov/pubmed/> .
@prefix id_pubmed: <http://identifiers.org/pubmed/> .

hcrm:crm_ID rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000727 ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" ;
    skos:prefLabel "crm/crm_ID" ;
    obo:RO_0002162 obo:NCBITaxon_9606 ; #in taxon "human"
    dc:hasVersion assembly:GCF_000001405.26 ; #hg38 assembly as reference
    obo:BFO_0000050 nuccore:chr_ID ; #chromosome
    obo:GENO_0000895 "start_position"^^xsd:integer ;
    obo:GENO_0000894 "end_position"^^xsd:integer .

hcrm:enhancer_sequence rdf:type owl:Class ;
    rdfs:subClassOf hcrm:crm_ID ;
    skos:prefLabel "Enhancer sequence" ;
    biolink:category biolink:RegulatoryRegion .

hcrm:target_gene rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000704 ;
    skos:prefLabel "Target gene" ;
    biolink:category biolink:Gene .

hcrm:disease rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000705 ;
    skos:prefLabel "Disease" ;
    biolink:category biolink:Disease .

hcrm:transcription_factor rdf:type owl:Class ;
    rdfs:subClassOf obo:SO_0000706 ;
    skos:prefLabel "Transcription factor" ;
    biolink:category biolink:Protein .

hcrm:cell_line_activity rdf:type owl:Class ;
    rdfs:subClassOf obo:TXPO_0003500 ;
    skos:prefLabel "Cell line activity" ;
    biolink:category biolink:CellLine .

hcrm:evidence rdf:type owl:Class ;
    rdfs:subClassOf sio:SIO_000772 ;
    skos:prefLabel "Evidence" ;
    schema:evidenceOrigin <original_URL_crossreference> ;
    rdfs:isDefinedBy obo:ECO_ID ; #Experimental evidence
    sio:SIO_000253 <original_URL_database> . #Original Database

hcrm:database_name rdf:type owl:Class ;
    rdfs:subClassOf hcrm:enhancer_sequence ;
    skos:prefLabel "Database name" ;
    biolink:category biolink:InformationResource .

id_pubmed:pubmed_ID skos:exactMatch pubmed:pubmed_ID .