@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix schema:  <http://schema.org/> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix hcrm:    <http://www.licpathway.net/ENdb/> .
@prefix crm2pgene: <http://rdf.biogateway.eu/crm2pgene/bgw!> .
@prefix hgene:   <http://rdf.biogateway.eu/hgene/> .
@prefix assembly:<http://purl.obolibrary.org/obo/RO_0002134> .
@prefix nuccore: <http://www.ncbi.nlm.nih.gov/nuccore/> .
@prefix pubmed:  <http://purl.org/net/pmid#> .
@prefix id_pubmed:<http://identifiers.org/pubmed/> .
@prefix id_ncbigene:<http://identifiers.org/ncbigene/> .
@prefix dbsuper: <http://www.ontobee.org/ontology/DBSUPER.owl#> .

# Example mapping
crm2pgene:bgw!CRMHS00000003515--hgncsymbol!9606/TBX5 skos:exactMatch hgene:TBX5 .
crm2pgene:bgw!crm_ID--hgncsymbol!9606/gene_sybmol skos:closeMatch hgene:GENE_SYBMOL .

# Additional mappings can be added here following the same pattern