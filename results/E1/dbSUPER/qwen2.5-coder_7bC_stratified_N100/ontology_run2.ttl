@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "CRM Enhancer Ontology" ;
    rdfs:comment "An ontology for representing CRM enhancers and their properties." ;
}

crm:Enhancer a owl:Class ;
    skos:prefLabel "CRM Enhancer" ;
    skos:definition "A genomic region that enhances the transcription of a gene or set of genes." ;
    obo:IAO_0000115 "http://purl.obolibrary.org/obo/SO_0001764" .

crm:GenomicCoordinate a owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A coordinate within the genome that specifies a location of interest." ;
    obo:IAO_0000115 "http://purl.obolibrary.org/obo/SO_0000761" .

crm:StartCoordinate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Coordinate" ;
    skos:definition "The starting position of the genomic coordinate." ;
    obo:IAO_0000115 "http://purl.obolibrary.org/obo/SO_0000762" .

crm:EndCoordinate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Coordinate" ;
    skos:definition "The ending position of the genomic coordinate." ;
    obo:IAO_0000115 "http://purl.obolibrary.org/obo/SO_0000763" .

crm:Evidence a owl:Class ;
    skos:prefLabel "Evidence" ;
    skos:definition "Information or data supporting the existence of an enhancer." ;
    obo:IAO_0000115 "http://purl.obolibrary.org/obo/SIO_000628" .

crm:Supports a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range crm:Enhancer ;
    skos:prefLabel "Supports" ;
    skos:definition "Indicates that the evidence supports the enhancer." ;
    obo:IAO_0000115 "http://purl.obolibrary.org/obo/SIO_000629" .

crm:GenomicRegion a owl:Class ;
    skos:prefLabel "Genomic Region" ;
    skos:definition "A contiguous segment of DNA." ;
    obo:IAO_0000115 "http://purl.obolibrary.org/obo/SO_0000761" .

crm:HasGenomicRegion a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:GenomicRegion ;
    skos:prefLabel "Has Genomic Region" ;
    skos:definition "Indicates that the enhancer is located within a genomic region." ;
    obo:IAO_0000115 "http://purl.obolibrary.org/obo/SIO_000630" .

crm:TranscriptionEnhancement a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003723 ;
    skos:prefLabel "Transcription Enhancement" ;
    skos:definition "Indicates that the enhancer enhances transcription." ;
    obo:IAO_0000115 "http://purl.obolibrary.org/obo/SIO_000631" .

crm:EnhancesGene a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0000782 ;
    skos:prefLabel "Enhances Gene" ;
    skos:definition "Indicates that the enhancer enhances the expression of a gene." ;
    obo:IAO_0000115 "http://purl.obolibrary.org/obo/SIO_000632" .