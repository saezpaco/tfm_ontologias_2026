@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/CRM/enhancer>
  a owl:Class ;
  rdfs:label "Chromatin Regulatory Module (CRM) Enhancer"^^xsd:string ;
  skos:prefLabel "Enhancer" ;
  skos:definition "A region of DNA that is bound by transcription factors and other regulatory proteins to enhance the expression of nearby genes." .

<http://example.org/CRM/enhancer#hasGenomicCoordinate>
  a owl:ObjectProperty ;
  rdfs:label "Has Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "The location of the CRM enhancer on the genome." .

<http://example.org/CRM/enhancer#hasEvidence>
  a owl:ObjectProperty ;
  rdfs:label "Has Evidence"^^xsd:string ;
  skos:prefLabel "Evidence" ;
  skos:definition "The source of information supporting the existence of the CRM enhancer." .

<http://example.org/CRM/enhancer#isLocatedAt>
  a owl:ObjectProperty ;
  rdfs:label "Is Located At"^^xsd:string ;
  skos:prefLabel "Location" ;
  skos:definition "The location of the CRM enhancer on the genome." .

<http://example.org/CRM/enhancer#hasTranscriptionFactorBinding>
  a owl:ObjectProperty ;
  rdfs:label "Has Transcription Factor Binding"^^xsd:string ;
  skos:prefLabel "Transcription Factor Binding" ;
  skos:definition "The binding of transcription factors to the CRM enhancer." .

<http://example.org/CRM/enhancer#hasRegulatoryProteinBinding>
  a owl:ObjectProperty ;
  rdfs:label "Has Regulatory Protein Binding"^^xsd:string ;
  skos:prefLabel "Regulatory Protein Binding" ;
  skos:definition "The binding of regulatory proteins to the CRM enhancer." .

<http://example.org/CRM/enhancer#hasGeneExpression>
  a owl:ObjectProperty ;
  rdfs:label "Has Gene Expression"^^xsd:string ;
  skos:prefLabel "Gene Expression" ;
  skos:definition "The expression of genes regulated by the CRM enhancer." .

<http://example.org/CRM/enhancer#hasGenomicCoordinate>
  a owl:ObjectProperty ;
  rdfs:label "Has Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "The location of the CRM enhancer on the genome." .

<http://example.org/CRM/enhancer#hasEvidence>
  a owl:ObjectProperty ;
  rdfs:label "Has Evidence"^^xsd:string ;
  skos:prefLabel "Evidence" ;
  skos:definition "The source of information supporting the existence of the CRM enhancer." .

<http://example.org/GenomicCoordinate>
  a owl:Class ;
  rdfs:label "Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "A location on the genome." .

<http://example.org/Evidence>
  a owl:Class ;
  rdfs:label "Evidence"^^xsd:string ;
  skos:prefLabel "Evidence" ;
  skos:definition "The source of information supporting the existence of the CRM enhancer." .

<http://example.org/TranscriptionFactorBinding>
  a owl:Class ;
  rdfs:label "Transcription Factor Binding"^^xsd:string ;
  skos:prefLabel "Transcription Factor Binding" ;
  skos:definition "The binding of transcription factors to the CRM enhancer." .

<http://example.org/RegulatoryProteinBinding>
  a owl:Class ;
  rdfs:label "Regulatory Protein Binding"^^xsd:string ;
  skos:prefLabel "Regulatory Protein Binding" ;
  skos:definition "The binding of regulatory proteins to the CRM enhancer." .

<http://example.org/GeneExpression>
  a owl:Class ;
  rdfs:label "Gene Expression"^^xsd:string ;
  skos:prefLabel "Gene Expression" ;
  skos:definition "The expression of genes regulated by the CRM enhancer." .