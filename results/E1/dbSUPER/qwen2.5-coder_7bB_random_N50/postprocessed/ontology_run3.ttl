@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://rdf.biogateway.eu/crm/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "dbSUPER Ontology" ;
    rdfs:comment "An ontology for cis-regulatory modules (CRM) specifically enhancer sequences in the human genome." ;
}

crm:Enhancer a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-regulatory module that modulates the transcription rate of target genes in the human genome." ;
    rdfs:subClassOf obo:SO_0001765 ;  # Transcriptional regulation

crm:GenomicCoordinates a owl:Class ;
    skos:prefLabel "Genomic Coordinates" ;
    skos:definition "The chromosomal location of an enhancer sequence." ;

crm:Chromosome a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinates ;
    rdfs:range xsd:string ;
    skos:prefLabel "Chromosome" ;
    skos:definition "The chromosome on which the enhancer is located." ;
    skos:exactMatch obo:SO_0001217 .  # Chromosome

crm:Start a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinates ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start" ;
    skos:definition "The starting position of the enhancer on the chromosome." ;
    skos:exactMatch obo:SO_0001218 .  # Start

crm:Stop a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinates ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Stop" ;
    skos:definition "The ending position of the enhancer on the chromosome." ;
    skos:exactMatch obo:SO_0001219 .  # Stop

crm:Evidence a owl:Class ;
    skos:prefLabel "Evidence" ;
    skos:definition "Experimental evidence supporting the presence and function of an enhancer." ;

crm:CellLineActivity a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:CellLine ;
    skos:prefLabel "Cell Line Activity" ;
    skos:definition "The cell line in which the enhancer is active." ;

crm:TargetGene a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003824 ;  # Gene
    skos:prefLabel "Target Gene" ;
    skos:definition "The gene that is regulated by the enhancer." ;

crm:AssociatedDisease a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:DOID_0050124 ;  # Disease
    skos:prefLabel "Associated Disease" ;
    skos:definition "A disease associated with the enhancer." ;

crm:InteractingTranscriptionFactor a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003824 ;  # Transcription factor
    skos:prefLabel "Interacting Transcription Factor" ;
    skos:definition "A transcription factor that interacts with the enhancer." ;

crm:CellLine a owl:Class ;
    skos:prefLabel "Cell Line" ;
    skos:definition "A cell line used in experimental studies." ;

crm:Rank a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Rank" ;
    skos:definition "The rank of the enhancer based on some criteria." ;

# Example instances
ex:SE_01932 a crm:Enhancer ;
    crm:GenomicCoordinates [ crm:Chromosome "chr16" ; crm:Start 72866815 ; crm:Stop 72895386 ] ;
    crm:Evidence ex:Evidence_01932 ;
    crm:CellLineActivity ex:Aorta ;
    crm:TargetGene obo:GO_0004878 ;  # ZFHX3
    crm:Rank 400 .

ex:Evidence_01932 a crm:Evidence ;
    skos:prefLabel "Experimental Evidence for SE_01932" ;
    skos:definition "Evidence supporting the presence and function of enhancer SE_01932." ;

ex:Aorta a crm:CellLine ;
    skos:prefLabel "Aorta Cell Line" ;
    skos:definition "A cell line derived from the aorta." ;
