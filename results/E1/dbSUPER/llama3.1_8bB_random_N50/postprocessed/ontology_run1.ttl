<http://example.org/dbSUPER#enhancer_has_id>
  a owl:DatatypeProperty ;
  rdfs:label "has ID"^^xsd:string ;
  skos:prefLabel "has ID"@en ;
  skos:definition "Associates an enhancer with its unique identifier."@en .

