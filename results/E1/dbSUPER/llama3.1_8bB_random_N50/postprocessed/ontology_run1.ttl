  rdfs:label "has Start Coordinate"^^xsd:string ;
  skos:prefLabel "has Start Coordinate"@en ;
  skos:definition "Associates an enhancer with its start coordinate."@en .

<http://example.org/dbSUPER#enhancer_has_stop>
