@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/CRM/enhancer>
  a owl:Class ;
  rdfs:label "Chromatin Regulatory Module (CRM) Enhancer"^^xsd:string ;
  skos:prefLabel "Enhancer" ;
  skos:definition "A region of DNA that can be bound by transcription factors and other regulatory proteins to enhance the expression of nearby genes." .

<http://example.org/CRM/enhancer#hasGenomicCoordinate>
  a owl:ObjectProperty ;
  rdfs:label "Has Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "The location of the CRM enhancer on the genome." .

<http://example.org/CRM/enhancer#hasEvidence>
  a owl:ObjectProperty ;
  rdfs:label "Has Evidence"^^xsd:string ;
  skos:prefLabel "Evidence" ;
  skos:definition "The source of information supporting the existence of the CRM enhancer." .

<http://example.org/CRM/enhancer#isLocatedAt>
  a owl:ObjectProperty ;
  rdfs:label "Is Located At"^^xsd:string ;
  skos:prefLabel "Location" ;
  skos:definition "The location of the CRM enhancer on the genome." .

<http://example.org/CRM/enhancer#hasTranscriptionFactorBindingSite>
  a owl:ObjectProperty ;
  rdfs:label "Has Transcription Factor Binding Site"^^xsd:string ;
  skos:prefLabel "Transcription Factor Binding Site" ;
  skos:definition "A region of the CRM enhancer where transcription factors can bind." .

<http://example.org/CRM/enhancer#hasRegulatoryProteinBindingSite>
  a owl:ObjectProperty ;
  rdfs:label "Has Regulatory Protein Binding Site"^^xsd:string ;
  skos:prefLabel "Regulatory Protein Binding Site" ;
  skos:definition "A region of the CRM enhancer where regulatory proteins can bind." .

<http://example.org/CRM/enhancer#hasGeneExpressionEnhancement>
  a owl:ObjectProperty ;
  rdfs:label "Has Gene Expression Enhancement"^^xsd:string ;
  skos:prefLabel "Gene Expression Enhancement" ;
  skos:definition "The effect of the CRM enhancer on gene expression." .

<http://example.org/CRM/enhancer#hasChromatinStructure>
  a owl:ObjectProperty ;
  rdfs:label "Has Chromatin Structure"^^xsd:string ;
  skos:prefLabel "Chromatin Structure" ;
  skos:definition "The structure of the chromatin at the CRM enhancer." .

<http://example.org/CRM/enhancer#hasEpigeneticModification>
  a owl:ObjectProperty ;
  rdfs:label "Has Epigenetic Modification"^^xsd:string ;
  skos:prefLabel "Epigenetic Modification" ;
  skos:definition "The epigenetic modifications at the CRM enhancer." .

<http://example.org/CRM/enhancer#hasTranscriptionFactor>
  a owl:ObjectProperty ;
  rdfs:label "Has Transcription Factor"^^xsd:string ;
  skos:prefLabel "Transcription Factor" ;
  skos:definition "A protein that binds to the CRM enhancer." .

<http://example.org/CRM/enhancer#hasRegulatoryProtein>
