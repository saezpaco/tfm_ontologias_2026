@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "CRM Enhancer Ontology" ;
    skos:prefLabel "CRM Enhancer Ontology" ;
    skos:definition "An ontology for representing CRM enhancers and their properties." ;
}

crm:Enhancer a owl:Class ;
    rdfs:subClassOf obo:SO_0001217 ;
    skos:prefLabel "CRM Enhancer" ;
    skos:definition "A genomic region that enhances the transcription of a CRM gene." .

crm:GenomicCoordinate a owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A coordinate within a genome, typically represented as chromosome and position." .

crm:StartCoordinate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "Start Coordinate" ;
    skos:definition "The starting position of the enhancer within the genome." .

crm:EndCoordinate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "End Coordinate" ;
    skos:definition "The ending position of the enhancer within the genome." .

crm:Evidence a owl:Class ;
    skos:prefLabel "Evidence" ;
    skos:definition "Information supporting the existence or properties of an enhancer." .

crm:SupportingEvidence a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:Evidence ;
    skos:prefLabel "Supporting Evidence" ;
    skos:definition "Evidence that supports the enhancer's function or properties." .

crm:Gene a owl:Class ;
    rdfs:subClassOf obo:SO_0001217 ;
    skos:prefLabel "Gene" ;
    skos:definition "A segment of DNA that codes for a protein or functional RNA molecule." .

crm:TranscriptionEnhancement a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:Gene ;
    skos:prefLabel "Transcription Enhancement" ;
    skos:definition "The enhancement of the transcription of a gene by an enhancer." .

crm:Chromosome a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:string ;
    skos:prefLabel "Chromosome" ;
    skos:definition "A linear molecule of DNA that contains genes and other genetic material." .

crm:Position a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:string ;
    skos:prefLabel "Position" ;
    skos:definition "The specific location of a coordinate within a chromosome." .