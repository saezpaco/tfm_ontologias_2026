@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "CRM Enhancer Ontology" ;
    skos:prefLabel "CRM Enhancer Ontology" ;
    skos:definition "An ontology for representing CRM enhancers and their relationships with genomic coordinates, evidence, and biological concepts." ;
}

owl:Class {
    rdf:type owl:Class ;
    rdfs:label "CRM Enhancer" ;
    skos:prefLabel "CRM Enhancer" ;
    skos:definition "A region of DNA that enhances the transcription of a gene or other genetic element." ;
    skos:exactMatch obo:SO_0001765 ;
}

owl:Class {
    rdf:type owl:Class ;
    rdfs:label "Genomic Coordinate" ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location on a chromosome." ;
    skos:exactMatch obo:SO_0001427 ;
}

owl:Class {
    rdf:type owl:Class ;
    rdfs:label "Evidence" ;
    skos:prefLabel "Evidence" ;
    skos:definition "Information or data supporting the existence of a CRM enhancer." ;
}

owl:ObjectProperty {
    rdf:type owl:ObjectProperty ;
    rdfs:label "located at" ;
    skos:prefLabel "Located At" ;
    skos:definition "The relationship between a CRM enhancer and its genomic coordinate." ;
    rdfs:domain CRM Enhancer ;
    rdfs:range Genomic Coordinate ;
}

owl:ObjectProperty {
    rdf:type owl:ObjectProperty ;
    rdfs:label "supports" ;
    skos:prefLabel "Supports" ;
    skos:definition "The relationship between a CRM enhancer and the evidence that supports it." ;
    rdfs:domain CRM Enhancer ;
    rdfs:range Evidence ;
}

owl:DatatypeProperty {
    rdf:type owl:DatatypeProperty ;
    rdfs:label "start position" ;
    skos:prefLabel "Start Position" ;
    skos:definition "The starting position of the genomic coordinate." ;
    rdfs:domain Genomic Coordinate ;
    rdfs:range xsd:integer ;
}

owl:DatatypeProperty {
    rdf:type owl:DatatypeProperty ;
    rdfs:label "end position" ;
    skos:prefLabel "End Position" ;
    skos:definition "The ending position of the genomic coordinate." ;
    rdfs:domain Genomic Coordinate ;
    rdfs:range xsd:integer ;
}

owl:DatatypeProperty {
    rdf:type owl:DatatypeProperty ;
    rdfs:label "evidence type" ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of evidence supporting the CRM enhancer." ;
    rdfs:domain Evidence ;
    rdfs:range xsd:string ;
}