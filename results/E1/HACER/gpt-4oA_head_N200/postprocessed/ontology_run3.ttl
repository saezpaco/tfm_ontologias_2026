@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
obo:SO_0000165 a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "A region of DNA that regulates the expression of genes." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000165> .

obo:SO_0000167 a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-acting sequence that increases the utilization of some eukaryotic promoters." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000167> .

obo:CL_0000000 a owl:Class ;
    skos:prefLabel "Cell line" ;
    skos:definition "A cell culture developed from a single cell and therefore consisting of cells with a uniform genetic makeup." .

obo:GENE_0000000 a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, typically a protein." .

obo:DISEASE_0000000 a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms or that affects a specific location." .

obo:TF_0000000 a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that controls the rate of transcription of genetic information from DNA to messenger RNA, by binding to a specific DNA sequence." .

# Object Properties
obo:RO_0002205 a owl:ObjectProperty ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates a cis-regulatory module to its target gene." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range obo:GENE_0000000 ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002205> .

obo:RO_0002434 a owl:ObjectProperty ;
    skos:prefLabel "active in cell line" ;
    skos:definition "Relates a cis-regulatory module to the cell line in which it is active." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range obo:CL_0000000 .

obo:RO_0002435 a owl:ObjectProperty ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Relates a cis-regulatory module to a disease it is associated with." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range obo:DISEASE_0000000 .

obo:RO_0002436 a owl:ObjectProperty ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Relates a cis-regulatory module to a transcription factor it interacts with." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range obo:TF_0000000 .

# Datatype Properties
obo:SO_0000165_start a owl:DatatypeProperty ;
    skos:prefLabel "start coordinate" ;
    skos:definition "The start position of the cis-regulatory module on the chromosome." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:integer .

obo:SO_0000165_end a owl:DatatypeProperty ;
    skos:prefLabel "end coordinate" ;
    skos:definition "The end position of the cis-regulatory module on the chromosome." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:integer .

obo:SO_0000165_score a owl:DatatypeProperty ;
    skos:prefLabel "score" ;
    skos:definition "A score representing the confidence or strength of the cis-regulatory module." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:float .

obo:SO_0000165_evidence a owl:DatatypeProperty ;
    skos:prefLabel "evidence method" ;
    skos:definition "The method used to determine the activity of the cis-regulatory module." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:string .