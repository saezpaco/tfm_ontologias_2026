@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/CRM>
  a owl:Class ;
  rdfs:label "Chromatin Regulatory Module"^^xsd:string ;
  skos:prefLabel "CRM" ;
  skos:definition "A chromatin regulatory module is a functional unit of chromatin that regulates gene expression."^^xsd:string .

<http://example.org/Enhancer>
  a owl:Class ;
  rdfs:label "Enhancer"^^xsd:string ;
  skos:prefLabel "Enhancer" ;
  skos:definition "A region of DNA that increases the transcription of a particular gene or set of genes."^^xsd:string .

<http://example.org/GenomicCoordinate>
  a owl:Class ;
  rdfs:label "Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "A specific location on the genome, typically represented as a pair of integers (chromosome and position)."^^xsd:string .

<http://example.org/Evidence>
  a owl:Class ;
  rdfs:label "Evidence"^^xsd:string ;
  skos:prefLabel "Evidence" ;
  skos:definition "A statement or observation that supports the existence or function of a CRM or enhancer."^^xsd:string .

<http://example.org/hasGenomicCoordinate>
  a owl:ObjectProperty ;
  rdfs:label "Has Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Has Genomic Coordinate" ;
  skos:definition "A relationship between a CRM/enhancer and its genomic location."^^xsd:string .

<http://example.org/isEvidenceFor>
  a owl:ObjectProperty ;
  rdfs:label "Is Evidence For"^^xsd:string ;
  skos:prefLabel "Is Evidence For" ;
  skos:definition "A relationship between an evidence statement and the CRM/enhancer it supports."^^xsd:string .

<http://example.org/genomicCoordinate>
  a owl:DatatypeProperty ;
  rdfs:label "Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Genomic Coordinate" ;
  skos:definition "The specific location on the genome, typically represented as a pair of integers (chromosome and position)."^^xsd:string .

<http://example.org/evidenceType>
  a owl:DatatypeProperty ;
  rdfs:label "Evidence Type"^^xsd:string ;
  skos:prefLabel "Evidence Type" ;
  skos:definition "The type of evidence supporting the existence or function of a CRM/enhancer."^^xsd:string .

<http://example.org/evidenceSource>
  a owl:DatatypeProperty ;
  rdfs:label "Evidence Source"^^xsd:string ;
  skos:prefLabel "Evidence Source" ;
  skos:definition "The source of the evidence supporting the existence or function of a CRM/enhancer."^^xsd:string .

