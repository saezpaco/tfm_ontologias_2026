@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://bioinfo.vanderbilt.edu/AE/HACER/> rdf:type owl:Ontology .

### Classes
<http://bioinfo.vanderbilt.edu/AE/HACER/CRM> rdf:type owl:Class ;
    skos:prefLabel "Cis-regulatory Module" ;
    skos:definition "A genomic region that regulates the expression of genes, such as enhancers." ;
    skos:exactMatch obo:SO_0000165 .

<http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate> rdf:type owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location on a chromosome defined by a start and end position." .

<http://bioinfo.vanderbilt.edu/AE/HACER/Evidence> rdf:type owl:Class ;
    skos:prefLabel "Evidence" ;
    skos:definition "Information supporting the existence or function of a biological entity." .

<http://bioinfo.vanderbilt.edu/AE/HACER/CellLine> rdf:type owl:Class ;
    skos:prefLabel "Cell Line" ;
    skos:definition "A cell culture developed from a single cell and therefore consisting of cells with a uniform genetic makeup." .

<http://bioinfo.vanderbilt.edu/AE/HACER/Gene> rdf:type owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, usually a protein." ;
    skos:exactMatch obo:SO_0000704 .

<http://bioinfo.vanderbilt.edu/AE/HACER/Disease> rdf:type owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms." .

<http://bioinfo.vanderbilt.edu/AE/HACER/TranscriptionFactor> rdf:type owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that controls the rate of transcription of genetic information from DNA to messenger RNA." .

### Object Properties
<http://bioinfo.vanderbilt.edu/AE/HACER/hasGenomicCoordinate> rdf:type owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate> ;
    skos:prefLabel "has genomic coordinate" ;
    skos:definition "Associates a CRM with its genomic coordinates." .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasEvidence> rdf:type owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/Evidence> ;
    skos:prefLabel "has evidence" ;
    skos:definition "Associates a CRM with evidence supporting its function." .

<http://bioinfo.vanderbilt.edu/AE/HACER/activeInCellLine> rdf:type owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/CellLine> ;
    skos:prefLabel "active in cell line" ;
    skos:definition "Indicates the cell line in which a CRM is active." .

<http://bioinfo.vanderbilt.edu/AE/HACER/targetsGene> rdf:type owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/Gene> ;
    skos:prefLabel "targets gene" ;
    skos:definition "Indicates the gene targeted by a CRM." .

<http://bioinfo.vanderbilt.edu/AE/HACER/associatedWithDisease> rdf:type owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/Disease> ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Indicates a disease associated with a CRM." .

<http://bioinfo.vanderbilt.edu/AE/HACER/interactsWithTF> rdf:type owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/TranscriptionFactor> ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Indicates a transcription factor that interacts with a CRM." .

### Datatype Properties
<http://bioinfo.vanderbilt.edu/AE/HACER/hasChromosome> rdf:type owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate> ;
    rdfs:range xsd:string ;
    skos:prefLabel "has chromosome" ;
    skos:definition "Specifies the chromosome on which the genomic coordinate is located." .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasStartPosition> rdf:type owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has start position" ;
    skos:definition "Specifies the start position of the genomic coordinate." .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasEndPosition> rdf:type owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has end position" ;
    skos:definition "Specifies the end position of the genomic coordinate." .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasAssembly> rdf:type owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/GenomicCoordinate> ;
    rdfs:range xsd:string ;
    skos:prefLabel "has assembly" ;
    skos:definition "Specifies the genome assembly version of the genomic coordinate." .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasScore> rdf:type owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/Evidence> ;
    rdfs:range xsd:float ;
    skos:prefLabel "has score" ;
    skos:definition "Specifies the score associated with the evidence of a CRM." .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasPMID> rdf:type owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/Evidence> ;
    rdfs:range xsd:string ;
    skos:prefLabel "has PMID" ;
    skos:definition "Specifies the PubMed ID associated with the evidence of a CRM." .