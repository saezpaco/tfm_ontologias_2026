@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
obo:SO_0000165 a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "A region of DNA that regulates the expression of genes." ;
    skos:exactMatch obo:SO_0000165 .

obo:SO_0000167 a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-acting sequence that increases the utilization of some eukaryotic promoters." ;
    skos:exactMatch obo:SO_0000167 .

obo:CL_0000000 a owl:Class ;
    skos:prefLabel "Cell line" ;
    skos:definition "A cell culture developed from a single cell and therefore consisting of cells with a uniform genetic makeup." ;
    skos:exactMatch obo:CL_0000000 .

obo:GENE_0000000 a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of nucleotides that encodes a protein or functional RNA." ;
    skos:exactMatch obo:SO_0000704 .

obo:DISEASE_0000000 a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms." ;
    skos:exactMatch obo:DOID_4 .

# Object Properties
obo:RO_0002205 a owl:ObjectProperty ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates a regulatory element to its target gene." ;
    skos:exactMatch obo:RO_0002205 ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range obo:GENE_0000000 .

obo:RO_0002434 a owl:ObjectProperty ;
    skos:prefLabel "active in cell line" ;
    skos:definition "Indicates the cell line in which a regulatory element is active." ;
    skos:exactMatch obo:RO_0002434 ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range obo:CL_0000000 .

obo:RO_0002606 a owl:ObjectProperty ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Relates a regulatory element to a disease it is associated with." ;
    skos:exactMatch obo:RO_0002606 ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range obo:DISEASE_0000000 .

# Datatype Properties
obo:GENO_0000001 a owl:DatatypeProperty ;
    skos:prefLabel "has genomic start" ;
    skos:definition "The start position of a genomic feature on a chromosome." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:integer .

obo:GENO_0000002 a owl:DatatypeProperty ;
    skos:prefLabel "has genomic end" ;
    skos:definition "The end position of a genomic feature on a chromosome." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:integer .

obo:GENO_0000003 a owl:DatatypeProperty ;
    skos:prefLabel "has chromosome" ;
    skos:definition "The chromosome on which a genomic feature is located." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:string .

obo:GENO_0000004 a owl:DatatypeProperty ;
    skos:prefLabel "has assembly" ;
    skos:definition "The genome assembly version used for the genomic coordinates." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:string .

obo:EVID_0000001 a owl:DatatypeProperty ;
    skos:prefLabel "has evidence method" ;
    skos:definition "The method used to determine the activity of a regulatory element." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:string .