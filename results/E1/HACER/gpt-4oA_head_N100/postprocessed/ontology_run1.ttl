@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
obo:SO_0000165 a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "A region of DNA that regulates the expression of genes." ;
    skos:exactMatch obo:SO_0000165 .

obo:SO_0000167 a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-acting sequence that increases the utilization of some eukaryotic promoters." ;
    skos:exactMatch obo:SO_0000167 .

obo:CL_0000000 a owl:Class ;
    skos:prefLabel "Cell line" ;
    skos:definition "A cell culture developed from a single cell and therefore consisting of cells with a uniform genetic makeup." ;
    skos:exactMatch obo:CL_0000000 .

obo:GENE a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of nucleotides that encodes a protein or functional RNA." ;
    skos:exactMatch obo:SO_0000704 .

obo:DISEASE a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms." ;
    skos:exactMatch obo:DOID_4 .

# Object Properties
obo:has_target_gene a owl:ObjectProperty ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates a cis-regulatory module to its target gene." ;
    skos:exactMatch obo:RO_0002436 .

obo:active_in_cell_line a owl:ObjectProperty ;
    skos:prefLabel "active in cell line" ;
    skos:definition "Indicates the cell line in which the enhancer is active." ;
    skos:exactMatch obo:RO_0002434 .

obo:associated_with_disease a owl:ObjectProperty ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Relates a cis-regulatory module to a disease it is associated with." ;
    skos:exactMatch obo:RO_0002452 .

# Datatype Properties
obo:has_genomic_coordinate a owl:DatatypeProperty ;
    skos:prefLabel "has genomic coordinate" ;
    skos:definition "Specifies the genomic coordinates of a cis-regulatory module." ;
    rdfs:range xsd:string .

obo:has_experimental_evidence a owl:DatatypeProperty ;
    skos:prefLabel "has experimental evidence" ;
    skos:definition "Indicates the type of experimental evidence supporting the activity of the enhancer." ;
    rdfs:range xsd:string .

obo:has_score a owl:DatatypeProperty ;
    skos:prefLabel "has score" ;
    skos:definition "Represents the score associated with the enhancer's activity." ;
    rdfs:range xsd:float .