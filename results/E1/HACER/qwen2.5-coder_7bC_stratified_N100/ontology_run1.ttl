@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "CRM Enhancer Ontology" ;
    skos:prefLabel "CRM Enhancer Ontology" ;
    skos:definition "An ontology for representing CRM enhancers and their properties." ;
}

crm:Enhancer a owl:Class ;
    rdfs:subClassOf obo:SO_0001765 ;
    skos:prefLabel "CRM Enhancer" ;
    skos:definition "A region of DNA that enhances the transcription of a gene or other RNA molecule." ;
    skos:exactMatch obo:SO_0001765 .

crm:GenomicCoordinate a owl:Class ;
    rdfs:subClassOf obo:SO_0000707 ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A coordinate that specifies a location within the genome." ;
    skos:exactMatch obo:SO_0000707 .

crm:StartCoordinate a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Coordinate" ;
    skos:definition "The starting position of the genomic coordinate." ;
    skos:exactMatch obo:SO_0001217 .

crm:EndCoordinate a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Coordinate" ;
    skos:definition "The ending position of the genomic coordinate." ;
    skos:exactMatch obo:SO_0001218 .

crm:Evidence a owl:Class ;
    rdfs:subClassOf obo:GO_0003674 ;
    skos:prefLabel "Evidence" ;
    skos:definition "Information or data that supports the existence of an enhancer." ;
    skos:exactMatch obo:GO_0003674 .

crm:Supports a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:Evidence ;
    skos:prefLabel "Supports" ;
    skos:definition "Indicates that the evidence supports the enhancer." ;
    skos:exactMatch obo:GO_0003674 .

crm:LocatedIn a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:GenomicCoordinate ;
    skos:prefLabel "Located In" ;
    skos:definition "Indicates the genomic location of the enhancer." ;
    skos:exactMatch obo:SO_0001765 .