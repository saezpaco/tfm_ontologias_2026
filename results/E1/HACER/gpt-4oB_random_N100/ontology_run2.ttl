@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
obo:SO_0000165 a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "A region of DNA that regulates the expression of genes." ;
    skos:exactMatch obo:SO_0000165 .

obo:SO_0000167 a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-acting sequence that increases the utilization of some eukaryotic promoters." ;
    skos:exactMatch obo:SO_0000167 .

obo:GENE a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, typically a protein." .

obo:DISEASE a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms." .

obo:TRANSCRIPTION_FACTOR a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that controls the rate of transcription of genetic information from DNA to messenger RNA." .

# Object Properties
obo:hasTargetGene a owl:ObjectProperty ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates a cis-regulatory module to its target gene." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range obo:GENE .

obo:associatedWithDisease a owl:ObjectProperty ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Relates a cis-regulatory module to a disease it is associated with." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range obo:DISEASE .

obo:interactsWithTF a owl:ObjectProperty ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Relates a cis-regulatory module to a transcription factor it interacts with." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range obo:TRANSCRIPTION_FACTOR .

# Datatype Properties
obo:hasGenomicCoordinate a owl:DatatypeProperty ;
    skos:prefLabel "has genomic coordinate" ;
    skos:definition "Specifies the genomic coordinates of a cis-regulatory module." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:string .

obo:hasExperimentalEvidence a owl:DatatypeProperty ;
    skos:prefLabel "has experimental evidence" ;
    skos:definition "Specifies the type of experimental evidence supporting the cis-regulatory module." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:string .

obo:hasCellLineActivity a owl:DatatypeProperty ;
    skos:prefLabel "has cell line activity" ;
    skos:definition "Specifies the cell line in which the cis-regulatory module is active." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:string .

obo:hasScore a owl:DatatypeProperty ;
    skos:prefLabel "has score" ;
    skos:definition "Specifies the score associated with the cis-regulatory module." ;
    rdfs:domain obo:SO_0000165 ;
    rdfs:range xsd:float .