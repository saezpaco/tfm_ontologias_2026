@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://rdf.biogateway.eu/crm/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "CRM Enhancer Ontology" ;
    skos:prefLabel "CRM Enhancer Ontology" ;
    skos:definition "An ontology for representing CRM enhancers and their properties." ;
}

crm:Enhancer a owl:Class ;
    rdfs:subClassOf obo:SO_0001217 ;
    skos:prefLabel "CRM Enhancer" ;
    skos:definition "A region of DNA that enhances the transcription of adjacent genes in the context of chromatin remodeling." .

crm:GenomicCoordinate a owl:Class ;
    rdfs:subClassOf obo:SO_0001217 ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location within a genome, defined by chromosome and position." .

crm:start a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Position" ;
    skos:definition "The starting position of the genomic coordinate on the chromosome." .

crm:end a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Position" ;
    skos:definition "The ending position of the genomic coordinate on the chromosome." .

crm:evidence a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0008279 ;
    skos:prefLabel "Evidence" ;
    skos:definition "The biological evidence supporting the existence of the CRM enhancer." .

crm:evidenceType a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range obo:GO_0008279 ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of biological evidence used to support the CRM enhancer." .

crm:evidenceSource a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Source" ;
    skos:definition "The source of the biological evidence supporting the CRM enhancer." .
