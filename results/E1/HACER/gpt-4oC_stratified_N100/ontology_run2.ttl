@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
obo:SO_0000165 a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "A region of DNA that regulates the expression of genes located on the same chromosome." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000165> .

obo:SO_0000167 a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-acting sequence that increases the utilization of some eukaryotic promoters and can function in either orientation and in any location relative to the promoter." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000167> .

obo:NCBITaxon_9606 a owl:Class ;
    skos:prefLabel "Homo sapiens" ;
    skos:definition "The species of bipedal primates to which modern humans belong." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCBITaxon_9606> .

# Object Properties
obo:RO_0002205 a owl:ObjectProperty ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates a regulatory region to its target gene." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002205> .

obo:RO_0002436 a owl:ObjectProperty ;
    skos:prefLabel "has evidence" ;
    skos:definition "Relates an entity to the evidence supporting its existence or function." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002436> .

# Datatype Properties
obo:SO_0000704 a owl:DatatypeProperty ;
    skos:prefLabel "genomic start" ;
    skos:definition "The starting position of a genomic feature on a chromosome." ;
    rdfs:range xsd:integer .

obo:SO_0000705 a owl:DatatypeProperty ;
    skos:prefLabel "genomic end" ;
    skos:definition "The ending position of a genomic feature on a chromosome." ;
    rdfs:range xsd:integer .

obo:SO_0000706 a owl:DatatypeProperty ;
    skos:prefLabel "chromosome" ;
    skos:definition "The chromosome on which a genomic feature is located." ;
    rdfs:range xsd:string .

obo:SO_0000707 a owl:DatatypeProperty ;
    skos:prefLabel "genomic assembly" ;
    skos:definition "The reference genome assembly version used for genomic coordinates." ;
    rdfs:range xsd:string .

obo:IAO_0000115 a owl:DatatypeProperty ;
    skos:prefLabel "evidence method" ;
    skos:definition "The method used to obtain evidence for a genomic feature." ;
    rdfs:range xsd:string .

obo:IAO_0000116 a owl:DatatypeProperty ;
    skos:prefLabel "evidence PMID" ;
    skos:definition "The PubMed ID of the publication providing evidence for a genomic feature." ;
    rdfs:range xsd:string .