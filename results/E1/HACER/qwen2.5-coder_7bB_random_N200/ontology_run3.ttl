@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "CRM Enhancer Ontology" ;
    rdfs:comment "An ontology for representing CRM enhancers and their properties." ;
}

crm:Enhancer a owl:Class ;
    skos:prefLabel "CRM Enhancer" ;
    skos:definition "A genomic region that enhances the transcription of a target gene in a cell-specific manner." ;
    rdfs:subClassOf obo:SO_0001765 ;  # Transcriptional enhancer

crm:GenomicCoordinate a owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location on a chromosome." ;

crm:start a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Position" ;
    skos:definition "The starting position of the genomic coordinate." ;

crm:end a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Position" ;
    skos:definition "The ending position of the genomic coordinate." ;

crm:evidence a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:Evidence ;
    skos:prefLabel "Evidence" ;
    skos:definition "Supporting evidence for the enhancer's function or presence." ;

crm:Evidence a owl:Class ;
    skos:prefLabel "Evidence" ;
    skos:definition "Information that supports or confirms the existence of an enhancer." ;

crm:evidenceType a owl:DatatypeProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of evidence supporting the enhancer's function or presence." ;

crm:evidenceSource a owl:DatatypeProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Source" ;
    skos:definition "The source of the evidence, such as experimental data or literature references." ;

crm:targetGene a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001217 ;  # Gene
    skos:prefLabel "Target Gene" ;
    skos:definition "The gene that is being enhanced by the enhancer." ;

crm:cellType a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001217 ;  # Cell type
    skos:prefLabel "Cell Type" ;
    skos:definition "The specific cell type in which the enhancer functions." ;

crm:function a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "Function" ;
    skos:definition "The biological function of the enhancer, such as transcriptional regulation." ;

crm:expressionCorrelation a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:SO_0001217 ;  # Gene
    skos:prefLabel "Expression Correlation" ;
    skos:definition "A gene that is correlated with the expression of the enhancer." ;

crm:distance a owl:DatatypeProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Distance" ;
    skos:definition "The distance between the enhancer and the target gene or other genomic feature." ;

crm:overlap a owl:ObjectProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range crm:GenomicCoordinate ;
    skos:prefLabel "Overlap" ;
    skos:definition "A relationship indicating that two genomic coordinates overlap." ;

crm:exactMatch obo:SO_0001765 ;
    skos:prefLabel "Exact Match" ;
    skos:definition "An exact match to a term in the Sequence Ontology (SO)." ;

crm:closeMatch obo:GO_0003824 ;
    skos:prefLabel "Close Match" ;
    skos:definition "A close match to a term in the Gene Ontology (GO)." ;
}