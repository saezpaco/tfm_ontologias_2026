@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "CRM Enhancer Ontology" ;
    rdfs:comment "A formal representation of CRM enhancers and their properties." ;
}

crm:Enhancer a owl:Class ;
    skos:prefLabel "CRM Enhancer" ;
    skos:definition "A genomic region that enhances the transcriptional activity of a gene or set of genes." ;
    obo:IAO_0000115 "Genomic feature that increases the expression of one or more genes." ;

crm:GenomicCoordinate a owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location on a chromosome." ;
    obo:SO_0000707 "Chromosome region." ;

crm:start a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start" ;
    skos:definition "The starting position of the genomic coordinate on the chromosome." ;
    obo:SO_0001217 "Chromosome start position." ;

crm:end a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End" ;
    skos:definition "The ending position of the genomic coordinate on the chromosome." ;
    obo:SO_0001218 "Chromosome end position." ;

crm:evidence a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:Evidence ;
    skos:prefLabel "Evidence" ;
    skos:definition "Supporting information for the enhancer's function or location." ;
    obo:IAO_0000136 "Supporting evidence for a biological entity or process." ;

crm:Evidence a owl:Class ;
    skos:prefLabel "Evidence" ;
    skos:definition "Information that supports the validity of an enhancer's properties." ;
    obo:IAO_0000115 "Supporting information for a biological entity or process." ;

crm:evidenceType a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of evidence supporting the enhancer's properties." ;
    obo:IAO_0000136 "Supporting evidence for a biological entity or process." ;

crm:evidenceSource a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Source" ;
    skos:definition "The source of the evidence supporting the enhancer's properties." ;
    obo:IAO_0000136 "Supporting evidence for a biological entity or process." ;

crm:evidenceDate a owl:DatatypeProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:date ;
    skos:prefLabel "Evidence Date" ;
    skos:definition "The date when the evidence was collected or reported." ;
    obo:IAO_0000136 "Supporting evidence for a biological entity or process." ;

crm:evidenceDescription a owl:DatatypeProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Description" ;
    skos:definition "A detailed description of the evidence supporting the enhancer's properties." ;
    obo:IAO_0000136 "Supporting evidence for a biological entity or process." ;

