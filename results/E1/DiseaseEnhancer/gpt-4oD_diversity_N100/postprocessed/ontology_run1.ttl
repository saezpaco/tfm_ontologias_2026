@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix : <http://example.org/ontology/> .

<http://example.org/DiseaseEnhancerOntology> rdf:type owl:Ontology .

### Classes
:CRM rdf:type owl:Class ;
    skos:prefLabel "Cis-Regulatory Module" ;
    skos:definition "A genomic region that regulates the expression of target genes, often associated with enhancers." ;
    skos:exactMatch obo:SO_0000165 .

:Gene rdf:type owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, typically a protein." ;
    skos:exactMatch obo:SO_0000704 .

:Disease rdf:type owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder or dysfunction in a biological system, often associated with specific genetic variations." ;
    skos:exactMatch obo:DOID_4 .

:TranscriptionFactor rdf:type owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that binds to specific DNA sequences to regulate the transcription of genetic information." ;
    skos:exactMatch obo:GO_0003700 .

### Object Properties
:hasTargetGene rdf:type owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :Gene ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates a cis-regulatory module to its target gene." .

:associatedWithDisease rdf:type owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :Disease ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Indicates a relationship between a cis-regulatory module and a disease." .

:interactsWithTF rdf:type owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :TranscriptionFactor ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Relates a cis-regulatory module to a transcription factor that interacts with it." .

### Datatype Properties
:hasGenomicStart rdf:type owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has genomic start" ;
    skos:definition "The starting coordinate of the genomic region of the cis-regulatory module." .

:hasGenomicEnd rdf:type owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has genomic end" ;
    skos:definition "The ending coordinate of the genomic region of the cis-regulatory module." .

:hasGenomicAssembly rdf:type owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "has genomic assembly" ;
    skos:definition "The reference genome assembly version for the genomic coordinates." .

:hasEvidenceScore rdf:type owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:float ;
    skos:prefLabel "has evidence score" ;
    skos:definition "A score representing the strength of evidence for the cis-regulatory module's activity." .

:hasPMID rdf:type owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "has PMID" ;
    skos:definition "The PubMed ID of the publication providing evidence for the cis-regulatory module." .
