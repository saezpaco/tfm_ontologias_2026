@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/DiseaseEnhancer> a owl:Ontology .

### Classes
<http://example.org/ontology/CRM> a owl:Class ;
    skos:prefLabel "Cis-Regulatory Module" ;
    skos:definition "A genomic region that regulates the expression of target genes, often associated with enhancers." ;
    skos:exactMatch obo:SO_0000165 .

<http://example.org/ontology/Enhancer> a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A type of cis-regulatory module that increases the transcription of target genes." ;
    skos:exactMatch obo:SO_0000165 .

<http://example.org/ontology/Gene> a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, typically a protein." ;
    skos:exactMatch obo:SO_0000704 .

<http://example.org/ontology/Disease> a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder or dysfunction in a biological system, often associated with specific genetic variations." ;
    skos:exactMatch obo:DOID_4 .

### Object Properties
<http://example.org/ontology/hasTargetGene> a owl:ObjectProperty ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates an enhancer to its target gene." ;
    rdfs:domain <http://example.org/ontology/Enhancer> ;
    rdfs:range <http://example.org/ontology/Gene> .

<http://example.org/ontology/associatedWithDisease> a owl:ObjectProperty ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Relates an enhancer to a disease it is associated with." ;
    rdfs:domain <http://example.org/ontology/Enhancer> ;
    rdfs:range <http://example.org/ontology/Disease> .

### Datatype Properties
<http://example.org/ontology/hasGenomicCoordinate> a owl:DatatypeProperty ;
    skos:prefLabel "has genomic coordinate" ;
    skos:definition "Specifies the genomic coordinates of an enhancer." ;
    rdfs:domain <http://example.org/ontology/Enhancer> ;
    rdfs:range xsd:string .

<http://example.org/ontology/hasEvidenceScore> a owl:DatatypeProperty ;
    skos:prefLabel "has evidence score" ;
    skos:definition "Indicates the confidence score of the enhancer's activity based on experimental evidence." ;
    rdfs:domain <http://example.org/ontology/Enhancer> ;
    rdfs:range xsd:float .

<http://example.org/ontology/hasPMID> a owl:DatatypeProperty ;
    skos:prefLabel "has PMID" ;
    skos:definition "Links to the PubMed ID of the publication providing evidence for the enhancer's activity." ;
    rdfs:domain <http://example.org/ontology/Enhancer> ;
    rdfs:range xsd:string .