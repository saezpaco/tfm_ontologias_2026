@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/CRM> a owl:Class ;
  rdfs:label "Conserved Regulatory Module"^^xsd:string ;
  skos:prefLabel "CRM"@en ;
  skos:definition "A conserved regulatory module is a region of DNA that has been conserved across multiple species and is involved in regulating gene expression."@en .

<http://example.org/Enhancer> a owl:Class ;
  rdfs:label "Enhancer"^^xsd:string ;
  skos:prefLabel "Enhancer"@en ;
  skos:definition "An enhancer is a region of DNA that increases the transcription rate of a gene."@en .

<http://example.org/GenomicCoordinate> a owl:Class ;
  rdfs:label "Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Genomic Coordinate"@en ;
  skos:definition "A genomic coordinate is a specific location on the genome, typically represented as a pair of integers (chromosome and position)."@en .

<http://example.org/Evidence> a owl:Class ;
  rdfs:label "Evidence"^^xsd:string ;
  skos:prefLabel "Evidence"@en ;
  skos:definition "Evidence is any information that supports or refutes the existence of a CRM or enhancer."@en .

<http://example.org/hasGenomicCoordinate> a owl:ObjectProperty ;
  rdfs:label "Has Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Has Genomic Coordinate"@en ;
  skos:definition "This property indicates that a CRM or enhancer is located at a specific genomic coordinate."@en .

<http://example.org/isEvidenceFor> a owl:ObjectProperty ;
  rdfs:label "Is Evidence For"^^xsd:string ;
  skos:prefLabel "Is Evidence For"@en ;
  skos:definition "This property indicates that an evidence supports the existence of a CRM or enhancer."@en .

<http://example.org/hasEvidence> a owl:ObjectProperty ;
  rdfs:label "Has Evidence"^^xsd:string ;
  skos:prefLabel "Has Evidence"@en ;
  skos:definition "This property indicates that a CRM or enhancer has evidence supporting its existence."@en .

<http://example.org/chromosome> a owl:DatatypeProperty ;
  rdfs:label "Chromosome"^^xsd:string ;
  skos:prefLabel "Chromosome"@en ;
  skos:definition "The chromosome on which the genomic coordinate is located."@en .

<http://example.org/position> a owl:DatatypeProperty ;
  rdfs:label "Position"^^xsd:string ;
  skos:prefLabel "Position"@en ;
  skos:definition "The position of the genomic coordinate on its chromosome."@en .

<http://example.org/evidenceType> a owl:DatatypeProperty ;
  rdfs:label "Evidence Type"^^xsd:string ;
  skos:prefLabel "Evidence Type"@en ;
  skos:definition "The type of evidence supporting the existence of a CRM or enhancer."@en .

<http://example.org/evidenceSource> a owl:DatatypeProperty ;
  rdfs:label "Evidence Source"^^xsd:string ;
  skos:prefLabel "Evidence Source"@en ;
  skos:definition "The source of the evidence supporting the existence of a CRM or enhancer."@en .

