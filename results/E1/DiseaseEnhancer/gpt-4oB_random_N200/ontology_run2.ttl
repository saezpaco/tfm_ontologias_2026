@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
obo:CRM a owl:Class ;
    skos:prefLabel "Cis-Regulatory Module" ;
    skos:definition "A genomic region that regulates the expression of target genes, often acting as an enhancer." ;
    skos:exactMatch obo:SO_0000165 .

obo:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, typically a protein." ;
    skos:exactMatch obo:SO_0000704 .

obo:Disease a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder or dysfunction in a biological system, often associated with specific symptoms and signs." ;
    skos:exactMatch obo:DOID_4 .

obo:TranscriptionFactor a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that binds to specific DNA sequences, thereby controlling the rate of transcription of genetic information." ;
    skos:exactMatch obo:GO_0003700 .

# Object Properties
obo:hasTargetGene a owl:ObjectProperty ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates a CRM to its target gene." ;
    rdfs:domain obo:CRM ;
    rdfs:range obo:Gene .

obo:associatedWithDisease a owl:ObjectProperty ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Relates a CRM to a disease it is associated with." ;
    rdfs:domain obo:CRM ;
    rdfs:range obo:Disease .

obo:interactsWithTF a owl:ObjectProperty ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Relates a CRM to a transcription factor that interacts with it." ;
    rdfs:domain obo:CRM ;
    rdfs:range obo:TranscriptionFactor .

# Datatype Properties
obo:genomicStart a owl:DatatypeProperty ;
    skos:prefLabel "genomic start" ;
    skos:definition "The starting coordinate of a genomic feature on a chromosome." ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:integer .

obo:genomicEnd a owl:DatatypeProperty ;
    skos:prefLabel "genomic end" ;
    skos:definition "The ending coordinate of a genomic feature on a chromosome." ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:integer .

obo:genomicAssembly a owl:DatatypeProperty ;
    skos:prefLabel "genomic assembly" ;
    skos:definition "The reference genome assembly version used for the genomic coordinates." ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:string .

obo:evidencePMID a owl:DatatypeProperty ;
    skos:prefLabel "evidence PMID" ;
    skos:definition "The PubMed ID of the publication providing evidence for the CRM." ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:string .