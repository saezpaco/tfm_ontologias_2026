@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/CRMEnhancer>
  a owl:Class ;
  rdfs:label "CRM Enhancer"^^xsd:string ;
  skos:prefLabel "CRM Enhancer"@en ;
  skos:definition "A regulatory element that regulates gene expression."@en .

<http://example.org/GenomicCoordinate>
  a owl:DatatypeProperty ;
  rdfs:label "Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Genomic Coordinate"@en ;
  skos:definition "The location of a genomic feature on the chromosome."@en .

<http://example.org/Evidence>
  a owl:ObjectProperty ;
  rdfs:label "Evidence"^^xsd:string ;
  skos:prefLabel "Evidence"@en ;
  skos:definition "A statement that supports or refutes a claim."@en .

<http://example.org/hasGenomicCoordinate>
  a owl:ObjectProperty ;
  rdfs:label "Has Genomic Coordinate"^^xsd:string ;
  skos:prefLabel "Has Genomic Coordinate"@en ;
  skos:definition "A CRM enhancer is located at this genomic coordinate."@en .

<http://example.org/isEvidenceFor>
  a owl:ObjectProperty ;
  rdfs:label "Is Evidence For"^^xsd:string ;
  skos:prefLabel "Is Evidence For"@en ;
  skos:definition "This evidence supports the existence of a CRM enhancer."@en .

<http://example.org/hasCRMEnhancer>
  a owl:ObjectProperty ;
  rdfs:label "Has CRM Enhancer"^^xsd:string ;
  skos:prefLabel "Has CRM Enhancer"@en ;
  skos:definition "This genomic region contains a CRM enhancer."@en .

<http://example.org/CRMEnhancer>
  rdfs:subClassOf <obo:GO_0003674> ;

<http://example.org/GenomicCoordinate>
  rdfs:domain <http://example.org/CRMEnhancer> ;
  rdfs:range xsd:string ;

<http://example.org/Evidence>
  rdfs:domain <http://example.org/CRMEnhancer> ;
  rdfs:range <obo:BFO_0000050> ;

<http://example.org/hasGenomicCoordinate>
  rdfs:domain <http://example.org/CRMEnhancer> ;
  rdfs:range <http://example.org/GenomicCoordinate> ;

<http://example.org/isEvidenceFor>
  rdfs:domain <http://example.org/Evidence> ;
  rdfs:range <http://example.org/CRMEnhancer> ;

<http://example.org/hasCRMEnhancer>
  rdfs:domain <http://example.org/GenomicRegion> ;
  rdfs:range <http://example.org/CRMEnhancer> .