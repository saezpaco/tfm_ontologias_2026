@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
:Enhancer a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-regulatory module that increases the transcription of a target gene." ;
    skos:exactMatch obo:SO_0000165 .

:GenomicCoordinate a owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location on a chromosome, defined by a start and end position." .

:ExperimentalEvidence a owl:Class ;
    skos:prefLabel "Experimental Evidence" ;
    skos:definition "Evidence obtained from experimental methods supporting the function of an enhancer." .

:CellLine a owl:Class ;
    skos:prefLabel "Cell Line" ;
    skos:definition "A cell culture developed from a single cell and therefore consisting of cells with a uniform genetic makeup." .

:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, usually a protein." ;
    skos:exactMatch obo:SO_0000704 .

:Disease a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms." ;
    skos:exactMatch obo:DOID_4 .

:TranscriptionFactor a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that binds to specific DNA sequences, thereby controlling the rate of transcription of genetic information." ;
    skos:exactMatch obo:GO_0003700 .

# Object Properties
:hasGenomicCoordinate a owl:ObjectProperty ;
    skos:prefLabel "has genomic coordinate" ;
    skos:definition "Relates an enhancer to its genomic coordinate." ;
    rdfs:domain :Enhancer ;
    rdfs:range :GenomicCoordinate .

:hasEvidence a owl:ObjectProperty ;
    skos:prefLabel "has evidence" ;
    skos:definition "Relates an enhancer to the experimental evidence supporting its function." ;
    rdfs:domain :Enhancer ;
    rdfs:range :ExperimentalEvidence .

:isActiveInCellLine a owl:ObjectProperty ;
    skos:prefLabel "is active in cell line" ;
    skos:definition "Indicates the cell line in which an enhancer is active." ;
    rdfs:domain :Enhancer ;
    rdfs:range :CellLine .

:targetsGene a owl:ObjectProperty ;
    skos:prefLabel "targets gene" ;
    skos:definition "Indicates the gene that is regulated by the enhancer." ;
    rdfs:domain :Enhancer ;
    rdfs:range :Gene .

:associatedWithDisease a owl:ObjectProperty ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Indicates the disease associated with the enhancer." ;
    rdfs:domain :Enhancer ;
    rdfs:range :Disease .

:interactsWithTranscriptionFactor a owl:ObjectProperty ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Indicates the transcription factor that interacts with the enhancer." ;
    rdfs:domain :Enhancer ;
    rdfs:range :TranscriptionFactor .

# Datatype Properties
:startPosition a owl:DatatypeProperty ;
    skos:prefLabel "start position" ;
    skos:definition "The start position of the genomic coordinate on the chromosome." ;
    rdfs:domain :GenomicCoordinate ;
    rdfs:range xsd:integer .

:endPosition a owl:DatatypeProperty ;
    skos:prefLabel "end position" ;
    skos:definition "The end position of the genomic coordinate on the chromosome." ;
    rdfs:domain :GenomicCoordinate ;
    rdfs:range xsd:integer .

:chromosome a owl:DatatypeProperty ;
    skos:prefLabel "chromosome" ;
    skos:definition "The chromosome on which the genomic coordinate is located." ;
    rdfs:domain :GenomicCoordinate ;
    rdfs:range xsd:string .

:evidenceType a owl:DatatypeProperty ;
    skos:prefLabel "evidence type" ;
    skos:definition "The type of experimental evidence supporting the enhancer's function." ;
    rdfs:domain :ExperimentalEvidence ;
    rdfs:range xsd:string .