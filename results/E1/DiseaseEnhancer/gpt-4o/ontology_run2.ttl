@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
obo:CRM a owl:Class ;
    skos:prefLabel "Cis-Regulatory Module" ;
    skos:definition "A genomic region that regulates the expression of genes, often containing enhancers." ;
    skos:exactMatch obo:SO_0000165 .

obo:Enhancer a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A short region of DNA that can increase transcription of genes." ;
    skos:exactMatch obo:SO_0000165 .

obo:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, usually a protein." ;
    skos:exactMatch obo:SO_0000704 .

obo:Disease a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms." ;
    skos:exactMatch obo:DOID_4 .

# Object Properties
obo:hasTargetGene a owl:ObjectProperty ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates an enhancer to its target gene." ;
    rdfs:domain obo:Enhancer ;
    rdfs:range obo:Gene .

obo:associatedWithDisease a owl:ObjectProperty ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Relates an enhancer to a disease it is associated with." ;
    rdfs:domain obo:Enhancer ;
    rdfs:range obo:Disease .

# Datatype Properties
obo:hasGenomicCoordinate a owl:DatatypeProperty ;
    skos:prefLabel "has genomic coordinate" ;
    skos:definition "Specifies the genomic coordinates of an enhancer." ;
    rdfs:domain obo:Enhancer ;
    rdfs:range xsd:string .

obo:hasEvidencePMID a owl:DatatypeProperty ;
    skos:prefLabel "has evidence PMID" ;
    skos:definition "Specifies the PubMed ID for the evidence supporting the enhancer's function." ;
    rdfs:domain obo:Enhancer ;
    rdfs:range xsd:string .

obo:hasScore a owl:DatatypeProperty ;
    skos:prefLabel "has score" ;
    skos:definition "Specifies the score indicating the confidence or strength of the enhancer's activity." ;
    rdfs:domain obo:Enhancer ;
    rdfs:range xsd:float .