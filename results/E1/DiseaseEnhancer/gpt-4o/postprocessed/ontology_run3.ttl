@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/DiseaseEnhancer> a owl:Ontology .

### Classes
<http://example.org/ontology/CRM> a owl:Class ;
    skos:prefLabel "Cis-Regulatory Module" ;
    skos:definition "A genomic region that regulates the expression of target genes, often acting as an enhancer." ;
    skos:exactMatch obo:SO_0000165 .

<http://example.org/ontology/GenomicCoordinate> a owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location on a chromosome, defined by a start and end position." .

<http://example.org/ontology/Disease> a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder or dysfunction in a biological system, often associated with specific genetic markers." ;
    skos:exactMatch obo:DOID_4 .

<http://example.org/ontology/Gene> a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, typically a protein." ;
    skos:exactMatch obo:SO_0000704 .

<http://example.org/ontology/TranscriptionFactor> a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that binds to specific DNA sequences, thereby controlling the rate of transcription of genetic information." ;
    skos:exactMatch obo:GO_0003700 .

### Object Properties
<http://example.org/ontology/hasGenomicCoordinate> a owl:ObjectProperty ;
    skos:prefLabel "has genomic coordinate" ;
    skos:definition "Associates a CRM with its genomic coordinates." ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/GenomicCoordinate> .

<http://example.org/ontology/targetsGene> a owl:ObjectProperty ;
    skos:prefLabel "targets gene" ;
    skos:definition "Indicates the gene that is regulated by the CRM." ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Gene> .

<http://example.org/ontology/associatedWithDisease> a owl:ObjectProperty ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Links a CRM to a disease it is associated with." ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Disease> .

<http://example.org/ontology/interactsWithTF> a owl:ObjectProperty ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Indicates the transcription factors that interact with the CRM." ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/TranscriptionFactor> .

### Datatype Properties
<http://example.org/ontology/chromosome> a owl:DatatypeProperty ;
    skos:prefLabel "chromosome" ;
    skos:definition "The chromosome on which the genomic coordinate is located." ;
    rdfs:domain <http://example.org/ontology/GenomicCoordinate> ;
    rdfs:range xsd:string .

<http://example.org/ontology/startPosition> a owl:DatatypeProperty ;
    skos:prefLabel "start position" ;
    skos:definition "The starting position of the genomic coordinate on the chromosome." ;
    rdfs:domain <http://example.org/ontology/GenomicCoordinate> ;
    rdfs:range xsd:integer .

<http://example.org/ontology/endPosition> a owl:DatatypeProperty ;
    skos:prefLabel "end position" ;
    skos:definition "The ending position of the genomic coordinate on the chromosome." ;
    rdfs:domain <http://example.org/ontology/GenomicCoordinate> ;
    rdfs:range xsd:integer .

<http://example.org/ontology/assembly> a owl:DatatypeProperty ;
    skos:prefLabel "assembly" ;
    skos:definition "The genome assembly version used for the genomic coordinate." ;
    rdfs:domain <http://example.org/ontology/GenomicCoordinate> ;
    rdfs:range xsd:string .

<http://example.org/ontology/evidenceScore> a owl:DatatypeProperty ;
    skos:prefLabel "evidence score" ;
    skos:definition "A score representing the strength of evidence for the CRM's function." ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:float .