    rdfs:range obo:GO_0003725 ;  # GO term for expression regulation intensity
    skos:prefLabel "Enhancer Expression Regulation Intensity" ;
    skos:definition "The degree or magnitude of the regulation of enhancer expression." ;

crm:enhancerExpressionRegulationSite a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;  # GO term for expression regulation site
    skos:prefLabel "Enhancer Expression Regulation Site" ;
    skos:definition "The specific cellular or tissue sites where the regulation of enhancer expression occurs." ;

