@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://rdf.biogateway.eu/crm/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "CRM Enhancer Ontology" ;
    skos:prefLabel "CRM Enhancer Ontology" ;
    skos:definition "An ontology for representing CRM enhancers and their properties." ;
}

crm:Enhancer a owl:Class ;
    rdfs:subClassOf obo:SO_0001765 ;
    skos:prefLabel "CRM Enhancer" ;
    skos:definition "A genomic region that enhances the transcription of a CRM (Core Regulatory Module)." ;

crm:GenomicCoordinate a owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A coordinate within a genome." ;

crm:start a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start" ;
    skos:definition "The starting position of the genomic coordinate." ;

crm:end a owl:DatatypeProperty ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End" ;
    skos:definition "The ending position of the genomic coordinate." ;

crm:evidence a owl:ObjectProperty ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0008279 ;
    skos:prefLabel "Evidence" ;
    skos:definition "Supporting evidence for the enhancer function of a CRM." ;

crm:evidenceType a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range obo:GO_0008279 ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of evidence supporting the enhancer function of a CRM." ;

crm:evidenceSource a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Source" ;
    skos:definition "The source of the evidence for the enhancer function of a CRM." ;

crm:evidenceDate a owl:DatatypeProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:date ;
    skos:prefLabel "Evidence Date" ;
    skos:definition "The date when the evidence was collected or reported." ;

crm:evidenceConfidence a owl:DatatypeProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Confidence" ;
    skos:definition "The level of confidence in the evidence supporting the enhancer function of a CRM." ;

crm:evidenceSupports a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range crm:Enhancer ;
    skos:prefLabel "Supports" ;
    skos:definition "Indicates that the evidence supports the enhancer function of a CRM." ;

crm:evidenceContradicts a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range crm:Enhancer ;
    skos:prefLabel "Contradicts" ;
    skos:definition "Indicates that the evidence contradicts the enhancer function of a CRM." ;

crm:evidenceConflictsWith a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range crm:Enhancer ;
    skos:prefLabel "Conflicts With" ;
    skos:definition "Indicates that the evidence conflicts with the enhancer function of a CRM." ;

crm:evidenceComplements a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range crm:Enhancer ;
    skos:prefLabel "Complements" ;
    skos:definition "Indicates that the evidence complements the enhancer function of a CRM." ;

crm:evidenceSupersedes a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range crm:Enhancer ;
    skos:prefLabel "Supersedes" ;
    skos:definition "Indicates that the evidence supersedes previous evidence for the enhancer function of a CRM." ;

crm:evidenceReplaces a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range crm:Enhancer ;
    skos:prefLabel "Replaces" ;
    skos:definition "Indicates that the evidence replaces previous evidence for the enhancer function of a CRM." ;

crm:evidenceIsPartOf a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range crm:Enhancer ;
    skos:prefLabel "Is Part Of" ;
    skos:definition "Indicates that the evidence is part of a larger set of evidence for the enhancer function of a CRM." ;

crm:evidenceIsDerivedFrom a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range crm:Enhancer ;
    skos:prefLabel "Is Derived From" ;
    skos:definition "Indicates that the evidence is derived from previous evidence for the enhancer function of a CRM." ;

crm:evidenceIsBasedOn a owl:ObjectProperty ;
    rdfs:domain crm:Evidence ;
    rdfs:range crm:Enhancer ;
    skos:prefLabel "Is Based On" ;
    skos:definition "Indicates that the evidence is based on previous evidence for the enhancer function of a CRM." ;

crm:evidenceIsSupportedBy a owl:ObjectProperty ;
