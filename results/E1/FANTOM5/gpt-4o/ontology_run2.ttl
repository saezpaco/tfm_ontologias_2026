@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
obo:SO_0000165 a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "A region of DNA that regulates the expression of genes." ;
    skos:exactMatch obo:SO_0000165 .

obo:SO_0000167 a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-regulatory module that increases the transcription of a gene." ;
    skos:exactMatch obo:SO_0000167 .

# Object Properties
obo:RO_0002205 a owl:ObjectProperty ;
    skos:prefLabel "regulates expression of" ;
    skos:definition "A relationship between a regulatory element and a gene it regulates." ;
    skos:exactMatch obo:RO_0002205 ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range obo:SO_0000704 .

# Datatype Properties
obo:GENO_0000891 a owl:DatatypeProperty ;
    skos:prefLabel "has genomic start position" ;
    skos:definition "The start position of a genomic feature on a chromosome." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:integer .

obo:GENO_0000892 a owl:DatatypeProperty ;
    skos:prefLabel "has genomic end position" ;
    skos:definition "The end position of a genomic feature on a chromosome." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:integer .

obo:GENO_0000893 a owl:DatatypeProperty ;
    skos:prefLabel "has chromosome" ;
    skos:definition "The chromosome on which a genomic feature is located." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:string .

obo:GENO_0000894 a owl:DatatypeProperty ;
    skos:prefLabel "has genome assembly" ;
    skos:definition "The genome assembly version used for the genomic coordinates." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:string .

obo:ECO_0000218 a owl:DatatypeProperty ;
    skos:prefLabel "has evidence" ;
    skos:definition "The evidence supporting the existence of a genomic feature." ;
    skos:exactMatch obo:ECO_0000218 ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:string .

obo:GENO_0000895 a owl:DatatypeProperty ;
    skos:prefLabel "has minimum ratio" ;
    skos:definition "The minimum ratio of expression change associated with the enhancer." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:float .

obo:GENO_0000896 a owl:DatatypeProperty ;
    skos:prefLabel "has score" ;
    skos:definition "The score indicating the confidence or strength of the enhancer activity." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:float .