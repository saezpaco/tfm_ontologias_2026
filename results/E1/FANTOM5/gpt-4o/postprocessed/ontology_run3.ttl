@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix : <http://example.org/ontology/> .

<http://example.org/ontology/FANTOM5> a owl:Ontology .

### Classes

:CRM a owl:Class ;
    skos:prefLabel "Cis-Regulatory Module" ;
    skos:definition "A genomic region that regulates the expression of target genes, identified as an enhancer in the FANTOM5 database." ;
    skos:exactMatch obo:SO_0000165 .

:GenomicCoordinate a owl:Class ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location on a chromosome, defined by a start and end position." .

:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, typically a protein." ;
    skos:exactMatch obo:SO_0000704 .

:TranscriptionFactor a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that binds to specific DNA sequences, thereby controlling the rate of transcription of genetic information." ;
    skos:exactMatch obo:GO_0003700 .

:Evidence a owl:Class ;
    skos:prefLabel "Evidence" ;
    skos:definition "Information or data that supports the identification or characterization of a biological entity." .

### Object Properties

:hasGenomicCoordinate a owl:ObjectProperty ;
    skos:prefLabel "has genomic coordinate" ;
    skos:definition "Relates a CRM to its genomic coordinates." ;
    rdfs:domain :CRM ;
    rdfs:range :GenomicCoordinate .

:targetsGene a owl:ObjectProperty ;
    skos:prefLabel "targets gene" ;
    skos:definition "Relates a CRM to a gene that it regulates." ;
    rdfs:domain :CRM ;
    rdfs:range :Gene .

:hasEvidence a owl:ObjectProperty ;
    skos:prefLabel "has evidence" ;
    skos:definition "Relates a CRM to the evidence supporting its identification." ;
    rdfs:domain :CRM ;
    rdfs:range :Evidence .

### Datatype Properties

:chromosome a owl:DatatypeProperty ;
    skos:prefLabel "chromosome" ;
    skos:definition "The chromosome on which the genomic coordinate is located." ;
    rdfs:domain :GenomicCoordinate ;
    rdfs:range xsd:string .

:startPosition a owl:DatatypeProperty ;
    skos:prefLabel "start position" ;
    skos:definition "The start position of the genomic coordinate on the chromosome." ;
    rdfs:domain :GenomicCoordinate ;
    rdfs:range xsd:integer .

:endPosition a owl:DatatypeProperty ;
    skos:prefLabel "end position" ;
    skos:definition "The end position of the genomic coordinate on the chromosome." ;
    rdfs:domain :GenomicCoordinate ;
    rdfs:range xsd:integer .

:assemblyVersion a owl:DatatypeProperty ;
    skos:prefLabel "assembly version" ;
    skos:definition "The genome assembly version used for the genomic coordinates." ;
    rdfs:domain :GenomicCoordinate ;
    rdfs:range xsd:string .

:minimumRatio a owl:DatatypeProperty ;
    skos:prefLabel "minimum ratio" ;
    skos:definition "The minimum ratio of enhancer activity observed." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:float .

:score a owl:DatatypeProperty ;
    skos:prefLabel "score" ;
    skos:definition "The score representing the confidence or strength of the enhancer activity." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:float .

:method a owl:DatatypeProperty ;
    skos:prefLabel "method" ;
    skos:definition "The method used to identify or validate the enhancer." ;
    rdfs:domain :Evidence ;
    rdfs:range xsd:string .

:PMID a owl:DatatypeProperty ;
    skos:prefLabel "PubMed ID" ;
    skos:definition "The PubMed ID of the publication providing evidence for the enhancer." ;
    rdfs:domain :Evidence ;
    rdfs:range xsd:string .
