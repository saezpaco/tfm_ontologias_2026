@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
obo:SO_0000165 a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "A region of DNA that regulates the expression of genes." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000165> .

obo:SO_0000167 a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-acting sequence that increases the utilization of some eukaryotic promoters." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000167> .

# Object Properties
obo:RO_0002205 a owl:ObjectProperty ;
    skos:prefLabel "regulates expression of" ;
    skos:definition "A relationship between a regulatory element and a gene it regulates." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002205> .

# Datatype Properties
obo:GENO_0000890 a owl:DatatypeProperty ;
    skos:prefLabel "has genomic start" ;
    skos:definition "The start position of a genomic feature." ;
    rdfs:range xsd:integer .

obo:GENO_0000891 a owl:DatatypeProperty ;
    skos:prefLabel "has genomic end" ;
    skos:definition "The end position of a genomic feature." ;
    rdfs:range xsd:integer .

obo:GENO_0000892 a owl:DatatypeProperty ;
    skos:prefLabel "has chromosome" ;
    skos:definition "The chromosome on which a genomic feature is located." ;
    rdfs:range xsd:string .

obo:GENO_0000893 a owl:DatatypeProperty ;
    skos:prefLabel "has assembly" ;
    skos:definition "The genome assembly version for a genomic feature." ;
    rdfs:range xsd:string .

obo:ECO_0000353 a owl:DatatypeProperty ;
    skos:prefLabel "has evidence" ;
    skos:definition "The evidence supporting the existence of a genomic feature." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/ECO_0000353> ;
    rdfs:range xsd:string .

obo:GENO_0000894 a owl:DatatypeProperty ;
    skos:prefLabel "has minimum ratio" ;
    skos:definition "The minimum ratio of expression correlation for an enhancer." ;
    rdfs:range xsd:float .

obo:GENO_0000895 a owl:DatatypeProperty ;
    skos:prefLabel "has score" ;
    skos:definition "The score assigned to a genomic feature based on its activity." ;
    rdfs:range xsd:integer .