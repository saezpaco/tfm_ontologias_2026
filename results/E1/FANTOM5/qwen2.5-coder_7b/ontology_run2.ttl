@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    skos:prefLabel "FANTOM5 Enhancer Ontology" ;
    skos:definition "An ontology representing enhancers identified by CAGE-seq in the human genome." ;
}

crm:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-acting DNA sequence that increases transcription of a target gene, often located upstream of the gene." ;
    skos:exactMatch obo:SIO_010246 .

crm:GenomicCoordinate a owl:Class ;
    rdfs:label "Genomic Coordinate" ;
    skos:prefLabel "Genomic Coordinate" ;
    skos:definition "A specific location on the genome." ;

crm:startCoordinate a owl:DatatypeProperty ;
    rdfs:label "Start Coordinate" ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Coordinate" ;
    skos:definition "The starting position of the genomic coordinate." ;

crm:endCoordinate a owl:DatatypeProperty ;
    rdfs:label "End Coordinate" ;
    rdfs:domain crm:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Coordinate" ;
    skos:definition "The ending position of the genomic coordinate." ;

crm:evidence a owl:ObjectProperty ;
    rdfs:label "Evidence" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range rdf:Resource ;
    skos:prefLabel "Evidence" ;
    skos:definition "Supporting evidence for the enhancer's function or location." ;

crm:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:label "Has Genomic Coordinate" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:GenomicCoordinate ;
    skos:prefLabel "Has Genomic Coordinate" ;
    skos:definition "The genomic coordinate associated with the enhancer." ;

crm:enhances a owl:ObjectProperty ;
    rdfs:label "Enhances" ;
    rdfs:domain crm:Enhancer ;
    rdfs:range obo:GO_0003725 ;
    skos:prefLabel "Enhances" ;
    skos:definition "The gene or process that the enhancer increases transcription of." ;

crm:evidenceType a owl:ObjectProperty ;
    rdfs:label "Evidence Type" ;
    rdfs:domain crm:Evidence ;
    rdfs:range obo:GO_0008150 ;
    skos:prefLabel "Evidence Type" ;
    skos:definition "The type of evidence supporting the enhancer's function or location." ;

crm:evidenceSource a owl:ObjectProperty ;
    rdfs:label "Evidence Source" ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Source" ;
    skos:definition "The source of the evidence supporting the enhancer's function or location." ;

crm:evidenceDate a owl:DatatypeProperty ;
    rdfs:label "Evidence Date" ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:date ;
    skos:prefLabel "Evidence Date" ;
    skos:definition "The date when the evidence was collected or reported." ;

crm:evidenceDescription a owl:DatatypeProperty ;
    rdfs:label "Evidence Description" ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Description" ;
    skos:definition "A description of the evidence supporting the enhancer's function or location." ;

crm:evidenceConfidence a owl:DatatypeProperty ;
    rdfs:label "Evidence Confidence" ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Confidence" ;
    skos:definition "The level of confidence in the evidence supporting the enhancer's function or location." ;

crm:evidenceSupports a owl:ObjectProperty ;
    rdfs:label "Supports" ;
    rdfs:domain crm:Evidence ;
    rdfs:range obo:GO_0003725 ;
    skos:prefLabel "Supports" ;
    skos:definition "The gene or process that the evidence supports." ;

crm:evidenceContradicts a owl:ObjectProperty ;
    rdfs:label "Contradicts" ;
    rdfs:domain crm:Evidence ;
    rdfs:range obo:GO_0003725 ;
    skos:prefLabel "Contradicts" ;
    skos:definition "The gene or process that the evidence contradicts." ;

crm:evidenceModifier a owl:ObjectProperty ;
    rdfs:label "Evidence Modifier" ;
    rdfs:domain crm:Evidence ;
    rdfs:range xsd:string ;
    skos:prefLabel "Evidence Modifier" ;
    skos:definition "A modifier or qualifier for the evidence supporting the enhancer's function or location." ;

