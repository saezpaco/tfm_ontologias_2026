@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

# Classes
obo:SO_0000165 a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "A region of DNA that regulates the expression of genes." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000165> .

obo:SO_0000167 a owl:Class ;
    skos:prefLabel "Enhancer" ;
    skos:definition "A cis-acting sequence that increases the utilization of some eukaryotic promoters." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000167> .

# Object Properties
obo:RO_0002205 a owl:ObjectProperty ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates a regulatory region to its target gene." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002205> ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range obo:SO_0000704 .

# Datatype Properties
obo:GENO_0000001 a owl:DatatypeProperty ;
    skos:prefLabel "has genomic start" ;
    skos:definition "The start position of a genomic feature." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:integer .

obo:GENO_0000002 a owl:DatatypeProperty ;
    skos:prefLabel "has genomic end" ;
    skos:definition "The end position of a genomic feature." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:integer .

obo:GENO_0000003 a owl:DatatypeProperty ;
    skos:prefLabel "has chromosome" ;
    skos:definition "The chromosome on which a genomic feature is located." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:string .

obo:GENO_0000004 a owl:DatatypeProperty ;
    skos:prefLabel "has assembly version" ;
    skos:definition "The genome assembly version used for the genomic coordinates." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:string .

obo:ECO_0000006 a owl:DatatypeProperty ;
    skos:prefLabel "has evidence" ;
    skos:definition "The type of evidence supporting the existence of the enhancer." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:string .

obo:GENO_0000005 a owl:DatatypeProperty ;
    skos:prefLabel "has score" ;
    skos:definition "A score representing the confidence or strength of the enhancer activity." ;
    rdfs:domain obo:SO_0000167 ;
    rdfs:range xsd:float .