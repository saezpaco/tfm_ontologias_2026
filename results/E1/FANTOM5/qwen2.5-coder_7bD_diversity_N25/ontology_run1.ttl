@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology {
    rdf:type owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    rdfs:comment "An ontology for enhancers identified by CAGE-seq in FANTOM5 dataset." ;
}

crm:Enhancer a owl:Class ;
    skos:prefLabel "Cis-Regulatory Module (CRM)" ;
    skos:definition "A cis-regulatory module that modulates the transcription rate of target genes." ;
    rdfs:subClassOf obo:SIO_010245 ;  # Biological Region

crm:hasGenomicCoordinates a owl:ObjectProperty ;
    skos:prefLabel "Has Genomic Coordinates" ;
    skos:definition "The genomic coordinates of the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range crm:GenomicCoordinates .

crm:GenomicCoordinates a owl:Class ;
    skos:prefLabel "Genomic Coordinates" ;
    skos:definition "A class representing genomic coordinates." ;

crm:chromosome a owl:DatatypeProperty ;
    skos:prefLabel "Chromosome" ;
    skos:definition "The chromosome number where the enhancer is located." ;
    rdfs:domain crm:GenomicCoordinates ;
    rdfs:range xsd:string .

crm:start a owl:DatatypeProperty ;
    skos:prefLabel "Start" ;
    skos:definition "The start position of the enhancer on the chromosome." ;
    rdfs:domain crm:GenomicCoordinates ;
    rdfs:range xsd:integer .

crm:end a owl:DatatypeProperty ;
    skos:prefLabel "End" ;
    skos:definition "The end position of the enhancer on the chromosome." ;
    rdfs:domain crm:GenomicCoordinates ;
    rdfs:range xsd:integer .

crm:name a owl:DatatypeProperty ;
    skos:prefLabel "Name" ;
    skos:definition "A unique name for the enhancer." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:string .

crm:score a owl:DatatypeProperty ;
    skos:prefLabel "Score" ;
    skos:definition "The score of the enhancer based on experimental evidence." ;
    rdfs:domain crm:Enhancer ;
    rdfs:range xsd:integer .

crm:strand a owl:DatatypeProperty ;
    skos:prefLabel "Strand" ;
    skos:definition "The strand (positive or negative) where the enhancer is located." ;
    rdfs:domain crm:GenomicCoordinates ;
    rdfs:range xsd:string .