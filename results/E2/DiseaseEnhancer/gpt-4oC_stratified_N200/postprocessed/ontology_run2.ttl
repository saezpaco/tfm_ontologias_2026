@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> a owl:Ontology ;
    skos:prefLabel "DiseaseEnhancer" ;
    skos:definition "Enhancers asociados a enfermedades" .

### Classes ###
obo:CRM a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

obo:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A gene that is a target of a cis-regulatory module" .

obo:Disease a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disease associated with a cis-regulatory module" .

obo:TranscriptionFactor a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A transcription factor interacting with a cis-regulatory module" .

### Object Properties ###
obo:hasTargetGene a owl:ObjectProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range obo:Gene ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol" .

obo:associatedWithDisease a owl:ObjectProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range obo:Disease ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid" .

obo:interactsWithTF a owl:ObjectProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range obo:TranscriptionFactor ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID" .

### Datatype Properties ###
obo:hasGenomicCoordinates a owl:DatatypeProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "Genomic Coordinates" ;
    skos:definition "Genomic coordinates of the cis-regulatory module" .

obo:hasScore a owl:DatatypeProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:float ;
    skos:prefLabel "Score" ;
    skos:definition "Score indicating the confidence of the enhancer activity" .

obo:hasPMID a owl:DatatypeProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "PMID" ;
    skos:definition "PubMed ID associated with the enhancer evidence" .

obo:hasMutationID a owl:DatatypeProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "Mutation ID" ;
    skos:definition "Mutation ID associated with the enhancer" .