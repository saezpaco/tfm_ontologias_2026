@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> a owl:Ontology ;
    rdfs:label "DiseaseEnhancer Ontology" ;
    rdfs:comment "Ontology for enhancers associated with diseases in the DiseaseEnhancer database." .

### Classes ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRM> a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Gene> a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A gene that is a target of a cis-regulatory module." .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Disease> a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disease associated with a cis-regulatory module." .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/TranscriptionFactor> a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A transcription factor interacting with a cis-regulatory module." .

### Object Properties ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/hasTargetGene> a owl:ObjectProperty ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRM> ;
    rdfs:range <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Gene> ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name" .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/associatedWithDisease> a owl:ObjectProperty ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRM> ;
    rdfs:range <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/Disease> ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid" .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/interactsWithTF> a owl:ObjectProperty ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRM> ;
    rdfs:range <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/TranscriptionFactor> ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID" .

### Datatype Properties ###
<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/hasGenomicCoordinates> a owl:DatatypeProperty ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "Genomic Coordinates" ;
    skos:definition "Genomic coordinates of the cis-regulatory module in GRCh38 assembly." .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/hasScore> a owl:DatatypeProperty ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRM> ;
    rdfs:range xsd:float ;
    skos:prefLabel "Score" ;
    skos:definition "Score representing the confidence or strength of the cis-regulatory module." .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/hasPMID> a owl:DatatypeProperty ;
    rdfs:domain <http://biocc.hrbmu.edu.cn/DiseaseEnhancer/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "PMID" ;
    skos:definition "PubMed ID associated with the evidence for the cis-regulatory module." .