@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> rdf:type owl:Ontology .

### Classes
obo:CRM rdf:type owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

obo:Gene rdf:type owl:Class ;
    skos:prefLabel "Gene" .

obo:Disease rdf:type owl:Class ;
    skos:prefLabel "Disease" .

obo:TranscriptionFactor rdf:type owl:Class ;
    skos:prefLabel "Transcription Factor" .

### Object Properties
obo:hasTargetGene rdf:type owl:ObjectProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range obo:Gene ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name" .

obo:associatedWithDisease rdf:type owl:ObjectProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range obo:Disease ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid according to database_name" .

obo:interactsWithTF rdf:type owl:ObjectProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range obo:TranscriptionFactor ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID according to database_name" .

### Datatype Properties
obo:hasGenomicCoordinates rdf:type owl:DatatypeProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "Genomic Coordinates" ;
    skos:definition "Genomic coordinates of the cis-regulatory module in the human genome" .

obo:hasScore rdf:type owl:DatatypeProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:float ;
    skos:prefLabel "Score" ;
    skos:definition "Score representing the confidence or strength of the enhancer activity" .

obo:hasPMID rdf:type owl:DatatypeProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "PubMed ID" ;
    skos:definition "PubMed ID of the publication providing evidence for the enhancer activity" .

obo:hasMutationID rdf:type owl:DatatypeProperty ;
    rdfs:domain obo:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "Mutation ID" ;
    skos:definition "Identifier for mutations associated with the enhancer" .