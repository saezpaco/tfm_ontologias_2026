@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> rdf:type owl:Ontology ;
    skos:prefLabel "DiseaseEnhancer Database" ;
    skos:definition "Database of enhancers associated with diseases" .

### Classes ###
:CRM rdf:type owl:Class ;
    skos:prefLabel "Cis-regulatory Module" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

:Gene rdf:type owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A gene that is a target of a cis-regulatory module" .

:Disease rdf:type owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disease associated with a cis-regulatory module" .

:TranscriptionFactor rdf:type owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A transcription factor interacting with a cis-regulatory module" .

### Object Properties ###
:hasTargetGene rdf:type owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :Gene ;
    skos:prefLabel "has target gene" ;
    skos:definition "Association between cis-regulatory module and its target gene" ;
    skos:exactMatch :bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name .

:associatedWithDisease rdf:type owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :Disease ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Association between cis-regulatory module and disease" ;
    skos:exactMatch :bgw!crm_ID--doid!doid#database_name .

:interactsWithTF rdf:type owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :TranscriptionFactor ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Association between cis-regulatory module and transcription factor" ;
    skos:exactMatch :bgw!crm_ID--uniprot!uniprot_ID#database_name .

### Datatype Properties ###
:hasGenomicCoordinates rdf:type owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "has genomic coordinates" ;
    skos:definition "Genomic coordinates of the cis-regulatory module" .

:hasScore rdf:type owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:float ;
    skos:prefLabel "has score" ;
    skos:definition "Score indicating the strength of the cis-regulatory module" .

:hasPMID rdf:type owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "has PMID" ;
    skos:definition "PubMed ID associated with the cis-regulatory module" .