@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> rdf:type owl:Ontology .

### Classes
<CRM> rdf:type owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

<Gene> rdf:type owl:Class ;
    skos:prefLabel "Gene" .

<Disease> rdf:type owl:Class ;
    skos:prefLabel "Disease" .

<TranscriptionFactor> rdf:type owl:Class ;
    skos:prefLabel "Transcription Factor" .

### Object Properties
<crmToGene> rdf:type owl:ObjectProperty ;
    rdfs:domain <CRM> ;
    rdfs:range <Gene> ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name" .

<crmToDisease> rdf:type owl:ObjectProperty ;
    rdfs:domain <CRM> ;
    rdfs:range <Disease> ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid" .

<crmToTF> rdf:type owl:ObjectProperty ;
    rdfs:domain <CRM> ;
    rdfs:range <TranscriptionFactor> ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID" .

### Datatype Properties
<hasChrName> rdf:type owl:DatatypeProperty ;
    rdfs:domain <CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "chr_name" .

<hasStartPosition> rdf:type owl:DatatypeProperty ;
    rdfs:domain <CRM> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "start_position" .

<hasEndPosition> rdf:type owl:DatatypeProperty ;
    rdfs:domain <CRM> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "end_position" .

<hasDatabaseName> rdf:type owl:DatatypeProperty ;
    rdfs:domain <CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "database_name" .

<hasHGNCsymbol> rdf:type owl:DatatypeProperty ;
    rdfs:domain <Gene> ;
    rdfs:range xsd:string ;
    skos:prefLabel "hgnc_symbol" .

<hasDOID> rdf:type owl:DatatypeProperty ;
    rdfs:domain <Disease> ;
    rdfs:range xsd:string ;
    skos:prefLabel "doid" .

<hasUniProtID> rdf:type owl:DatatypeProperty ;
    rdfs:domain <TranscriptionFactor> ;
    rdfs:range xsd:string ;
    skos:prefLabel "uniprot_ID" .