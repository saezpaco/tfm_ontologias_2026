@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix hacer: <http://bioinfo.vanderbilt.edu/AE/HACER/> .

hacer:CisRegulatoryModule a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

hacer:Chromosome a owl:Class ;
    skos:prefLabel "chr_name" .

hacer:Gene a owl:Class ;
    skos:prefLabel "Gene" .

hacer:Disease a owl:Class ;
    skos:prefLabel "Disease" .

hacer:TranscriptionFactor a owl:Class ;
    skos:prefLabel "Transcription Factor" .

hacer:hasChromosome a owl:ObjectProperty ;
    rdfs:domain hacer:CisRegulatoryModule ;
    rdfs:range hacer:Chromosome ;
    skos:prefLabel "has chromosome" .

hacer:hasStartPosition a owl:DatatypeProperty ;
    rdfs:domain hacer:CisRegulatoryModule ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has start position" .

hacer:hasEndPosition a owl:DatatypeProperty ;
    rdfs:domain hacer:CisRegulatoryModule ;
    rdfs:range xsd:integer ;
    skos:prefLabel "has end position" .

hacer:hasGeneTarget a owl:ObjectProperty ;
    rdfs:domain hacer:CisRegulatoryModule ;
    rdfs:range hacer:Gene ;
    skos:prefLabel "has gene target" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name" .

hacer:associatedWithDisease a owl:ObjectProperty ;
    rdfs:domain hacer:CisRegulatoryModule ;
    rdfs:range hacer:Disease ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid according to database_name" .

hacer:interactsWithTF a owl:ObjectProperty ;
    rdfs:domain hacer:CisRegulatoryModule ;
    rdfs:range hacer:TranscriptionFactor ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID according to database_name" .

hacer:hasScore a owl:DatatypeProperty ;
    rdfs:domain hacer:CisRegulatoryModule ;
    rdfs:range xsd:float ;
    skos:prefLabel "has score" .

hacer:hasMinimumRatio a owl:DatatypeProperty ;
    rdfs:domain hacer:CisRegulatoryModule ;
    rdfs:range xsd:float ;
    skos:prefLabel "has minimum ratio" .

hacer:hasBiosampleName a owl:DatatypeProperty ;
    rdfs:domain hacer:CisRegulatoryModule ;
    rdfs:range xsd:string ;
    skos:prefLabel "has biosample name" .

hacer:hasReferenceSNP a owl:DatatypeProperty ;
    rdfs:domain hacer:CisRegulatoryModule ;
    rdfs:range xsd:string ;
    skos:prefLabel "has reference SNP" .