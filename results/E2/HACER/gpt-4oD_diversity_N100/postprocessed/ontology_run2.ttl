@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://bioinfo.vanderbilt.edu/AE/HACER/> a owl:Ontology ;
    rdfs:label "HACER Ontology" ;
    skos:prefLabel "HACER" ;
    skos:definition "Human Active Cis-regulatory Elements database" .

### Classes ###
<http://bioinfo.vanderbilt.edu/AE/HACER/CRM> a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens" .

<http://bioinfo.vanderbilt.edu/AE/HACER/Chromosome> a owl:Class ;
    skos:prefLabel "chr_name" ;
    skos:definition "Chromosome in Homo sapiens" .

<http://bioinfo.vanderbilt.edu/AE/HACER/Gene> a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "Gene targeted by cis-regulatory module" .

<http://bioinfo.vanderbilt.edu/AE/HACER/Disease> a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "Disease associated with cis-regulatory module" .

<http://bioinfo.vanderbilt.edu/AE/HACER/TranscriptionFactor> a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "Transcription factor interacting with cis-regulatory module" .

### Object Properties ###
<http://bioinfo.vanderbilt.edu/AE/HACER/hasTargetGene> a owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/Gene> ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module and gene" .

<http://bioinfo.vanderbilt.edu/AE/HACER/associatedWithDisease> a owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/Disease> ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module and disease" .

<http://bioinfo.vanderbilt.edu/AE/HACER/interactsWithTF> a owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/TranscriptionFactor> ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module and transcription factor" .

### Datatype Properties ###
<http://bioinfo.vanderbilt.edu/AE/HACER/hasGenomicCoordinates> a owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "Genomic Coordinates" ;
    skos:definition "Genomic coordinates of the cis-regulatory module" .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasScore> a owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range xsd:float ;
    skos:prefLabel "Score" ;
    skos:definition "Score of the cis-regulatory module" .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasBiosampleName> a owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "Biosample Name" ;
    skos:definition "Name of the biosample where the CRM is active" .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasPMID> a owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "PMID" ;
    skos:definition "PubMed ID associated with the CRM" .