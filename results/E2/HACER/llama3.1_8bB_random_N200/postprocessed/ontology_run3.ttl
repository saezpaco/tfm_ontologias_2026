@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/crm>
  a owl:Class ;
  rdfs:label "Cis-regulatory module" ;
  skos:prefLabel "crm/crm_ID" ;
  skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

<http://example.org/chr>
  a owl:Class ;
  rdfs:label "Chromosome" ;
  skos:prefLabel "chr_name" ;
  skos:definition "A chromosome is a thread-like structure that carries hereditary information in the nucleus of living cells." .

<http://example.org/database>
  a owl:Class ;
  rdfs:label "Database" ;
  skos:prefLabel "database_name" ;
  skos:definition "A database is an organized collection of data that is stored in a computer system." .

<http://example.org/gene>
  a owl:Class ;
  rdfs:label "Gene" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" ;
  skos:definition "A gene is a unit of heredity that is passed from one generation to the next." .

<http://example.org/association>
  a owl:ObjectProperty ;
  rdfs:label "Association" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" ;
  skos:definition "An association between two entities, such as a cis-regulatory module and a gene." .

<http://example.org/crm#crm_ID>
  a owl:ObjectProperty ;
  rdfs:label "Cis-regulatory module ID" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol#database_name" ;
  skos:definition "The unique identifier for a cis-regulatory module." .

<http://example.org/crm#start_position>
  a owl:ObjectProperty ;
  rdfs:label "Start position" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol#database_name" ;
  skos:definition "The starting position of the cis-regulatory module on the chromosome." .

<http://example.org/crm#end_position>
  a owl:ObjectProperty ;
  rdfs:label "End position" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol#database_name" ;
  skos:definition "The ending position of the cis-regulatory module on the chromosome." .

<http://example.org/crm#chr_name>
  a owl:ObjectProperty ;
  rdfs:label "Chromosome name" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol#database_name" ;
  skos:definition "The name of the chromosome where the cis-regulatory module is located." .

<http://example.org/crm#database_name>
  a owl:ObjectProperty ;
  rdfs:label "Database name" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol#database_name" ;
  skos:definition "The name of the database where the cis-regulatory module is stored." .

<http://example.org/crm#gene_symbol>
  a owl:ObjectProperty ;
  rdfs:label "Gene symbol" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol#database_name" ;
  skos:definition "The symbol for the gene associated with the cis-regulatory module." .

<http://example.org/crm#disease>
  a owl:ObjectProperty ;
  rdfs:label "Disease" ;
  skos:prefLabel "bgw!crm_ID--doid!doid" ;
  skos:definition "A disease or disorder associated with the cis-regulatory module." .

<http://example.org/crm#transcription_factor>
  a owl:ObjectProperty ;
  rdfs:label "Transcription factor" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
  skos:definition "A transcription factor associated with the cis-regulatory module." .

<http://example.org/crm#transcription_factor_name>
  a owl:ObjectProperty ;
  rdfs:label "Transcription factor name" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID#database_name" ;
  skos:definition "The name of the transcription factor associated with the cis-regulatory module." .

<http://example.org/crm#transcription_factor_id>
  a owl:ObjectProperty ;
  rdfs:label "Transcription factor ID" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID#database_name" ;
  skos:definition "The unique identifier for the transcription factor associated with the cis-regulatory module." .

<http://example.org/crm#transcription_factor_database>
  a owl:ObjectProperty ;
  rdfs:label "Transcription factor database" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID#database_name" ;
  skos:definition "The name of the database where the transcription factor associated with the cis-regulatory module is stored." .

<http://example.org/crm#transcription_factor_symbol>
