@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/crm>
  a owl:Class ;
  rdfs:label "crm" ;
  skos:prefLabel "CRM" ;
  skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

<http://example.org/crm_ID>
  a owl:DatatypeProperty ;
  rdfs:label "crm ID" ;
  skos:prefLabel "crm#crm_ID" ;
  skos:definition "Unique identifier for the cis-regulatory module" .

<http://example.org/chr_name>
  a owl:Class ;
  rdfs:label "chromosome name" ;
  skos:prefLabel "chr_name" ;
  skos:definition "Name of the chromosome where the cis-regulatory module is located" .

<http://example.org/start_position>
  a owl:DatatypeProperty ;
  rdfs:label "start position" ;
  skos:prefLabel "start_position" ;
  skos:definition "Start position of the cis-regulatory module on the chromosome" ;
  rdfs:range xsd:int .

<http://example.org/end_position>
  a owl:DatatypeProperty ;
  rdfs:label "end position" ;
  skos:prefLabel "end_position" ;
  skos:definition "End position of the cis-regulatory module on the chromosome" ;
  rdfs:range xsd:int .

<http://example.org/database_name>
  a owl:Class ;
  rdfs:label "database name" ;
  skos:prefLabel "Database" ;
  skos:definition "Name of the database where the cis-regulatory module is stored" .

<http://example.org/association>
  a owl:ObjectProperty ;
  rdfs:label "cis-regulatory module-gene association" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" ;
  skos:definition "Association between a cis-regulatory module and a gene according to a database" .

<http://example.org/association>
  rdfs:domain <http://example.org/crm> ;
  rdfs:range <http://example.org/gene> .

<http://example.org/transcription_factor>
  a owl:Class ;
  rdfs:label "transcription factor" ;
  skos:prefLabel "Transcription Factor" ;
  skos:definition "Protein that binds to the cis-regulatory module and regulates gene expression" .

<http://example.org/association>
  rdfs:domain <http://example.org/crm> ;
  rdfs:range <http://example.org/transcription_factor> .

<http://example.org/disease>
  a owl:Class ;
  rdfs:label "disease" ;
  skos:prefLabel "Disease" ;
  skos:definition "Condition that is associated with the cis-regulatory module" .

<http://example.org/association>
  rdfs:domain <http://example.org/crm> ;
  rdfs:range <http://example.org/disease> .