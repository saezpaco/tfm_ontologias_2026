@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://bioinfo.vanderbilt.edu/AE/HACER/> rdf:type owl:Ontology .

### Classes
<http://bioinfo.vanderbilt.edu/AE/HACER/CRM> rdf:type owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

<http://bioinfo.vanderbilt.edu/AE/HACER/Database> rdf:type owl:Class ;
    skos:prefLabel "Database" .

<http://bioinfo.vanderbilt.edu/AE/HACER/TranscriptionFactor> rdf:type owl:Class ;
    skos:prefLabel "Transcription Factor" .

<http://bioinfo.vanderbilt.edu/AE/HACER/Gene> rdf:type owl:Class ;
    skos:prefLabel "Gene" .

<http://bioinfo.vanderbilt.edu/AE/HACER/Disease> rdf:type owl:Class ;
    skos:prefLabel "Disease" .

### Object Properties
<http://bioinfo.vanderbilt.edu/AE/HACER/hasTargetGene> rdf:type owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/Gene> ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol" .

<http://bioinfo.vanderbilt.edu/AE/HACER/associatedWithDisease> rdf:type owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/Disease> ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid" .

<http://bioinfo.vanderbilt.edu/AE/HACER/interactsWithTF> rdf:type owl:ObjectProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range <http://bioinfo.vanderbilt.edu/AE/HACER/TranscriptionFactor> ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID" .

### Datatype Properties
<http://bioinfo.vanderbilt.edu/AE/HACER/hasGenomicCoordinates> rdf:type owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "Genomic Coordinates" ;
    skos:definition "Genomic coordinates of the cis-regulatory module" .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasExperimentalEvidence> rdf:type owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "Experimental Evidence" ;
    skos:definition "Experimental evidence supporting the activity of the cis-regulatory module" .

<http://bioinfo.vanderbilt.edu/AE/HACER/activeInCellLine> rdf:type owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "Cell Line Activity" ;
    skos:definition "Cell line in which the cis-regulatory module is active" .

<http://bioinfo.vanderbilt.edu/AE/HACER/hasScore> rdf:type owl:DatatypeProperty ;
    rdfs:domain <http://bioinfo.vanderbilt.edu/AE/HACER/CRM> ;
    rdfs:range xsd:float ;
    skos:prefLabel "Score" ;
    skos:definition "Score representing the confidence or activity level of the cis-regulatory module" .