@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology#CRM> a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

<http://example.org/ontology#Database> a owl:Class ;
    skos:prefLabel "Database" .

<http://example.org/ontology#TranscriptionFactor> a owl:Class ;
    skos:prefLabel "Transcription Factor" .

<http://example.org/ontology#Gene> a owl:Class ;
    skos:prefLabel "Gene" .

<http://example.org/ontology#Disease> a owl:Class ;
    skos:prefLabel "Disease" .

<http://example.org/ontology#hasGenomicCoordinate> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology#CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "has genomic coordinate" ;
    skos:definition "The genomic coordinate of the CRM in the human genome" .

<http://example.org/ontology#hasTargetGene> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology#CRM> ;
    rdfs:range <http://example.org/ontology#Gene> ;
    skos:prefLabel "has target gene" ;
    skos:definition "Association between cis-regulatory module and its target gene" ;
    skos:exactMatch <http://example.org/ontology#bgw!crm_ID--hgncsymbol!9606/gene_symbol> .

<http://example.org/ontology#hasAssociatedDisease> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology#CRM> ;
    rdfs:range <http://example.org/ontology#Disease> ;
    skos:prefLabel "has associated disease" ;
    skos:definition "Association between cis-regulatory module and disease" ;
    skos:exactMatch <http://example.org/ontology#bgw!crm_ID--doid!doid> .

<http://example.org/ontology#interactsWithTF> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology#CRM> ;
    rdfs:range <http://example.org/ontology#TranscriptionFactor> ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Association between cis-regulatory module and transcription factor" ;
    skos:exactMatch <http://example.org/ontology#bgw!crm_ID--uniprot!uniprot_ID> .

<http://example.org/ontology#identifiedByMethod> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology#CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "identified by method" ;
    skos:definition "The method used to identify the CRM" .

<http://example.org/ontology#hasDatabaseSource> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology#CRM> ;
    rdfs:range <http://example.org/ontology#Database> ;
    skos:prefLabel "has database source" ;
    skos:definition "The database from which the CRM information is sourced" ;
    skos:exactMatch <http://example.org/ontology#crm#crm_ID#database_name> .