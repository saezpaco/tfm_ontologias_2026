@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/FANTOM5> a owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    rdfs:comment "Ontology for enhancers identified by CAGE-seq in the FANTOM5 database." .

### Classes
<http://example.org/ontology/CRM> a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

<http://example.org/ontology/Chromosome> a owl:Class ;
    skos:prefLabel "chr_name" ;
    skos:definition "Chromosome in the human genome" .

<http://example.org/ontology/Database> a owl:Class ;
    skos:prefLabel "Database" ;
    skos:definition "Database containing enhancer information" .

<http://example.org/ontology/TranscriptionFactor> a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "Protein that binds to specific DNA sequences to regulate transcription" .

<http://example.org/ontology/Gene> a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "Functional unit of heredity" .

<http://example.org/ontology/Disease> a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "Disorder or abnormal condition affecting an organism" .

### Object Properties
<http://example.org/ontology/hasTargetGene> a owl:ObjectProperty ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Gene> .

<http://example.org/ontology/associatedWithDisease> a owl:ObjectProperty ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Disease> .

<http://example.org/ontology/interactsWithTF> a owl:ObjectProperty ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/TranscriptionFactor> .

### Datatype Properties
<http://example.org/ontology/hasGenomicCoordinates> a owl:DatatypeProperty ;
    skos:prefLabel "Genomic Coordinates" ;
    skos:definition "Genomic coordinates of the enhancer" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string .

<http://example.org/ontology/hasScore> a owl:DatatypeProperty ;
    skos:prefLabel "Score" ;
    skos:definition "Score indicating the activity level of the enhancer" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:float .

<http://example.org/ontology/hasPMID> a owl:DatatypeProperty ;
    skos:prefLabel "PMID" ;
    skos:definition "PubMed ID for the reference publication" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string .

<http://example.org/ontology/hasMethod> a owl:DatatypeProperty ;
    skos:prefLabel "Method" ;
    skos:definition "Method used to identify the enhancer" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string .

<http://example.org/ontology/hasDatabase> a owl:DatatypeProperty ;
    skos:prefLabel "database_name" ;
    skos:definition "Name of the database containing the enhancer information" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string .