@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/FANTOM5> a owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    rdfs:comment "Ontology for enhancers identified by CAGE-seq in the FANTOM5 database." .

### Classes ###
:CRM a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" ;
    skos:exactMatch <http://example.org/vocab/crm/crm_ID> .

:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A gene that is a target of a cis-regulatory module." .

:TranscriptionFactor a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A transcription factor that interacts with a cis-regulatory module." .

:Disease a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disease associated with a cis-regulatory module." .

### Object Properties ###
:hasTargetGene a owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :Gene ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name" .

:interactsWithTF a owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :TranscriptionFactor ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID" .

:associatedWithDisease a owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :Disease ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid" .

### Datatype Properties ###
:chrName a owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "chr_name" ;
    skos:definition "Chromosome name where the cis-regulatory module is located." .

:startPosition a owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:integer ;
    skos:prefLabel "start_position" ;
    skos:definition "Start position of the cis-regulatory module on the chromosome." .

:endPosition a owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:integer ;
    skos:prefLabel "end_position" ;
    skos:definition "End position of the cis-regulatory module on the chromosome." .

:assemblyVersion a owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "GRCh38" ;
    skos:definition "Genome assembly version used for the coordinates of the cis-regulatory module." .

:databaseName a owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "database_name" ;
    skos:definition "Name of the database where the cis-regulatory module information is sourced from." .