@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/FANTOM5> a owl:Ontology ;
    rdfs:label "FANTOM5 Enhancer Ontology" ;
    rdfs:comment "Ontology for enhancers identified by CAGE-seq in the FANTOM5 database." .

### Classes ###
<http://example.org/ontology/FANTOM5#CisRegulatoryModule> a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

<http://example.org/ontology/FANTOM5#Chromosome> a owl:Class ;
    skos:prefLabel "chr_name" .

<http://example.org/ontology/FANTOM5#Database> a owl:Class ;
    skos:prefLabel "Database" .

### Object Properties ###
<http://example.org/ontology/FANTOM5#hasChromosome> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/FANTOM5#CisRegulatoryModule> ;
    rdfs:range <http://example.org/ontology/FANTOM5#Chromosome> ;
    skos:prefLabel "has chromosome" ;
    skos:definition "Association between a cis-regulatory module and a chromosome" .

<http://example.org/ontology/FANTOM5#isIdentifiedIn> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/FANTOM5#CisRegulatoryModule> ;
    rdfs:range <http://example.org/ontology/FANTOM5#Database> ;
    skos:prefLabel "is identified in" ;
    skos:definition "Association between a cis-regulatory module and the database it is identified in" .

### Datatype Properties ###
<http://example.org/ontology/FANTOM5#startPosition> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/FANTOM5#CisRegulatoryModule> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "start position" ;
    skos:definition "The start position of the cis-regulatory module on the chromosome" .

<http://example.org/ontology/FANTOM5#endPosition> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/FANTOM5#CisRegulatoryModule> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "end position" ;
    skos:definition "The end position of the cis-regulatory module on the chromosome" .

<http://example.org/ontology/FANTOM5#score> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/FANTOM5#CisRegulatoryModule> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "score" ;
    skos:definition "The score of the cis-regulatory module" .

<http://example.org/ontology/FANTOM5#strand> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/FANTOM5#CisRegulatoryModule> ;
    rdfs:range xsd:string ;
    skos:prefLabel "strand" ;
    skos:definition "The strand of the cis-regulatory module" .