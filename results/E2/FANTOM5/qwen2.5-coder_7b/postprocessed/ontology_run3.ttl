@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://rdf.biogateway.eu/crm/> .

crm:Transcription_Factor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:definition "A protein that binds to DNA and regulates the transcription of genes." .

crm:Cis_Regulatory_Module a owl:Class ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:definition "A cis-regulatory module located in Homo sapiens chr_name between start_position and end_position." ;

crm:Database a owl:Class ;
    rdfs:label "Database" ;
    skos:definition "A collection of data organized for easy access and retrieval." .

crm:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:definition "A segment of DNA that codes for a protein or RNA molecule." ;

crm:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:definition "An abnormal condition affecting the structure or function of an organism." .

crm:Transcription_Factor_to_Gene a owl:ObjectProperty ;
    rdfs:label "Transcription Factor to Gene Association" ;
    skos:definition "Association between cis-regulatory module CRMHS00000003515 and gene TBX5." ;

crm:Cis_Regulatory_Module_to_Transcription_Factor a owl:ObjectProperty ;
    rdfs:label "Cis-Regulatory Module to Transcription Factor Association" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID." ;

crm:Cis_Regulatory_Module_to_Gene a owl:ObjectProperty ;
    rdfs:label "Cis-Regulatory Module to Gene Association" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name." ;

crm:Cis_Regulatory_Module_to_Disease a owl:ObjectProperty ;
    rdfs:label "Cis-Regulatory Module to Disease Association" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid." ;

crm:Cis_Regulatory_Module_to_Gene_in_Database a owl:ObjectProperty ;
    rdfs:label "Cis-Regulatory Module to Gene in Database Association" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name." ;

