@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/dbSUPER> a owl:Ontology ;
    skos:prefLabel "dbSUPER Ontology" ;
    skos:definition "Ontology for representing super-enhancers from the dbSUPER database." .

### Classes ###
<http://example.org/ontology/CRM> a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

<http://example.org/ontology/CellLine> a owl:Class ;
    skos:prefLabel "Cell Line" ;
    skos:definition "A specific cell line where the super-enhancer is active." .

<http://example.org/ontology/Gene> a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A gene that is targeted by the super-enhancer." .

### Object Properties ###
<http://example.org/ontology/hasTargetGene> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Gene> ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name" .

<http://example.org/ontology/activeInCellLine> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/CellLine> ;
    skos:prefLabel "Active in Cell Line" ;
    skos:definition "The cell line in which the super-enhancer is active." .

### Datatype Properties ###
<http://example.org/ontology/hasChromosome> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "chr_name" ;
    skos:definition "Chromosome name where the super-enhancer is located." .

<http://example.org/ontology/hasStartPosition> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Position" ;
    skos:definition "Start position of the super-enhancer on the chromosome." .

<http://example.org/ontology/hasEndPosition> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Position" ;
    skos:definition "End position of the super-enhancer on the chromosome." .

<http://example.org/ontology/hasRank> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Rank" ;
    skos:definition "Rank of the super-enhancer based on its activity or significance." .

### Instances ###
<http://example.org/ontology/SE_16035> a <http://example.org/ontology/CRM> ;
    skos:prefLabel "SE_16035" ;
    <http://example.org/ontology/hasChromosome> "chr16" ;
    <http://example.org/ontology/hasStartPosition> 29754409 ;
    <http://example.org/ontology/hasEndPosition> 29758833 ;
    <http://example.org/ontology/hasRank> 237 ;
    <http://example.org/ontology/hasTargetGene> <http://example.org/ontology/C16orf54> ;
    <http://example.org/ontology/activeInCellLine> <http://example.org/ontology/CD4_Naive_Primary_7pool> .

<http://example.org/ontology/C16orf54> a <http://example.org/ontology/Gene> ;
    skos:prefLabel "C16orf54" .

<http://example.org/ontology/CD4_Naive_Primary_7pool> a <http://example.org/ontology/CellLine> ;
    skos:prefLabel "CD4 Naive Primary 7pool" .