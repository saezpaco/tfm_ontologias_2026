@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/dbSUPER> a owl:Ontology ;
    skos:prefLabel "dbSUPER Ontology" ;
    skos:definition "Ontology for representing super-enhancers from the dbSUPER database." .

### Classes ###
<http://example.org/ontology/CRM> a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens." .

<http://example.org/ontology/Chromosome> a owl:Class ;
    skos:prefLabel "chr_name" ;
    skos:definition "Chromosome name in Homo sapiens." .

<http://example.org/ontology/CellLine> a owl:Class ;
    skos:prefLabel "Cell Line" ;
    skos:definition "Cell line in which the super-enhancer is active." .

<http://example.org/ontology/Gene> a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "Gene targeted by the super-enhancer." .

### Object Properties ###
<http://example.org/ontology/hasTargetGene> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Gene> ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module and gene." .

<http://example.org/ontology/activeInCellLine> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/CellLine> ;
    skos:prefLabel "Active in Cell Line" ;
    skos:definition "The cell line in which the CRM is active." .

### Datatype Properties ###
<http://example.org/ontology/hasChromosome> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Chromosome> ;
    skos:prefLabel "Chromosome" ;
    skos:definition "Chromosome where the CRM is located." .

<http://example.org/ontology/hasStartPosition> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Position" ;
    skos:definition "Start position of the CRM on the chromosome." .

<http://example.org/ontology/hasEndPosition> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Position" ;
    skos:definition "End position of the CRM on the chromosome." .

<http://example.org/ontology/hasRank> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Rank" ;
    skos:definition "Rank of the super-enhancer in the dataset." .

<http://example.org/ontology/hasDatabaseID> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "Database ID" ;
    skos:definition "Unique identifier for the CRM in the dbSUPER database." .