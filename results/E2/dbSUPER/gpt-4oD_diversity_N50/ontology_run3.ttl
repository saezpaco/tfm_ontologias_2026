@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/dbSUPER> a owl:Ontology ;
    rdfs:label "dbSUPER Ontology" ;
    skos:definition "Ontology for representing super-enhancers and their associations in the dbSUPER database." .

### Classes ###
:CRM a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A gene that is a target of a cis-regulatory module." .

:Disease a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disease associated with a cis-regulatory module." .

:TranscriptionFactor a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A transcription factor that interacts with a cis-regulatory module." .

:CellLine a owl:Class ;
    skos:prefLabel "Cell Line" ;
    skos:definition "A cell line in which a cis-regulatory module is active." .

### Object Properties ###
:hasTargetGene a owl:ObjectProperty ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol" ;
    rdfs:domain :CRM ;
    rdfs:range :Gene .

:associatedWithDisease a owl:ObjectProperty ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid" ;
    rdfs:domain :CRM ;
    rdfs:range :Disease .

:interactsWithTF a owl:ObjectProperty ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID" ;
    rdfs:domain :CRM ;
    rdfs:range :TranscriptionFactor .

:activeInCellLine a owl:ObjectProperty ;
    skos:prefLabel "Active in Cell Line" ;
    skos:definition "The cell line in which a cis-regulatory module is active." ;
    rdfs:domain :CRM ;
    rdfs:range :CellLine .

### Datatype Properties ###
:hasGenomicCoordinates a owl:DatatypeProperty ;
    skos:prefLabel "Genomic Coordinates" ;
    skos:definition "The genomic coordinates of a cis-regulatory module." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string .

:hasDatabaseSource a owl:DatatypeProperty ;
    skos:prefLabel "database_name" ;
    skos:definition "The source database of the cis-regulatory module information." ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string .