@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/dbSUPER> a owl:Ontology ;
    skos:prefLabel "dbSUPER Ontology" ;
    skos:definition "Ontology for representing super-enhancers from the dbSUPER database." .

### Classes ###
<http://example.org/ontology/dbSUPER#CisRegulatoryModule> a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "A module that regulates the transcription of target genes." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000835> .

<http://example.org/ontology/dbSUPER#Gene> a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A gene that is a target of a cis-regulatory module." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000704> .

<http://example.org/ontology/dbSUPER#TranscriptionFactor> a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that binds to specific DNA sequences to regulate transcription." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/GO_0003700> .

<http://example.org/ontology/dbSUPER#Disease> a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disease associated with a cis-regulatory module." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/DOID_4> .

### Object Properties ###
<http://example.org/ontology/dbSUPER#hasTargetGene> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/dbSUPER#CisRegulatoryModule> ;
    rdfs:range <http://example.org/ontology/dbSUPER#Gene> ;
    skos:prefLabel "has target gene" ;
    skos:definition "Relates a cis-regulatory module to its target gene." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002436> .

<http://example.org/ontology/dbSUPER#associatedWithDisease> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/dbSUPER#CisRegulatoryModule> ;
    rdfs:range <http://example.org/ontology/dbSUPER#Disease> ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Relates a cis-regulatory module to an associated disease." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002458> .

<http://example.org/ontology/dbSUPER#interactsWithTF> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/dbSUPER#CisRegulatoryModule> ;
    rdfs:range <http://example.org/ontology/dbSUPER#TranscriptionFactor> ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Relates a cis-regulatory module to an interacting transcription factor." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002437> .

### Datatype Properties ###
<http://example.org/ontology/dbSUPER#hasGenomicCoordinates> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/dbSUPER#CisRegulatoryModule> ;
    rdfs:range xsd:string ;
    skos:prefLabel "has genomic coordinates" ;
    skos:definition "Specifies the genomic coordinates of a cis-regulatory module." .

<http://example.org/ontology/dbSUPER#hasBiosampleName> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/dbSUPER#CisRegulatoryModule> ;
    rdfs:range xsd:string ;
    skos:prefLabel "has biosample name" ;
    skos:definition "Specifies the biosample name where the cis-regulatory module is active." .

<http://example.org/ontology/dbSUPER#hasExperimentalMethod> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/dbSUPER#CisRegulatoryModule> ;
    rdfs:range xsd:string ;
    skos:prefLabel "has experimental method" ;
    skos:definition "Specifies the experimental method used to identify the cis-regulatory module." .

<http://example.org/ontology/dbSUPER#hasScore> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/dbSUPER#CisRegulatoryModule> ;
    rdfs:range xsd:float ;
    skos:prefLabel "has score" ;
    skos:definition "Specifies the score of the cis-regulatory module." .