@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/dbSUPER> a owl:Ontology ;
    skos:prefLabel "dbSUPER Ontology" ;
    skos:definition "Ontology for representing super-enhancers from the dbSUPER database." .

### Classes ###
<http://example.org/ontology/CRM> a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000165> .

<http://example.org/ontology/Database> a owl:Class ;
    skos:prefLabel "Database" ;
    skos:definition "A biological database containing information about super-enhancers." .

<http://example.org/ontology/TranscriptionFactor> a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that binds to specific DNA sequences, thereby controlling the rate of transcription of genetic information." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/GO_0003700> .

<http://example.org/ontology/Disease> a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder or incorrect function of the body or mind." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/DOID_4> .

<http://example.org/ontology/Gene> a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A sequence of DNA that contains the necessary information to produce a functional product, usually a protein." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/SO_0000704> .

### Object Properties ###
<http://example.org/ontology/hasTargetGene> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Gene> ;
    skos:prefLabel "has target gene" ;
    skos:definition "Association between cis-regulatory module and its target gene." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002413> .

<http://example.org/ontology/associatedWithDisease> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Disease> ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Association between cis-regulatory module and a disease." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002454> .

<http://example.org/ontology/interactsWithTF> a owl:ObjectProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/TranscriptionFactor> ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Association between cis-regulatory module and a transcription factor." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/RO_0002436> .

### Datatype Properties ###
<http://example.org/ontology/hasGenomicCoordinates> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "has genomic coordinates" ;
    skos:definition "The genomic coordinates of the cis-regulatory module." .

<http://example.org/ontology/hasScore> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:float ;
    skos:prefLabel "has score" ;
    skos:definition "The score associated with the cis-regulatory module." .

<http://example.org/ontology/hasBiosampleName> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "has biosample name" ;
    skos:definition "The name of the biosample in which the cis-regulatory module is active." .

<http://example.org/ontology/hasMethod> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string ;
    skos:prefLabel "has method" ;
    skos:definition "The experimental method used to identify the cis-regulatory module." .

<http://example.org/ontology/hasCrossReference> a owl:DatatypeProperty ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:anyURI ;
    skos:prefLabel "has cross-reference" ;
    skos:definition "A cross-reference link to additional information about the cis-regulatory module." .