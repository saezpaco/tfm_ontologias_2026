@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/ontology/dbSUPER> a owl:Ontology ;
    rdfs:label "dbSUPER Ontology" ;
    skos:definition "Ontology for representing super-enhancers from the dbSUPER database." .

### Classes ###
<http://example.org/ontology/CRM> a owl:Class ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

<http://example.org/ontology/CellLine> a owl:Class ;
    rdfs:label "Cell Line" ;
    skos:prefLabel "Cell Line" ;
    skos:definition "A cell line in which the enhancer activity is observed." .

<http://example.org/ontology/Gene> a owl:Class ;
    rdfs:label "Gene" ;
    skos:prefLabel "Gene" ;
    skos:definition "A gene that is a target of the cis-regulatory module." .

<http://example.org/ontology/TranscriptionFactor> a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A transcription factor that interacts with the cis-regulatory module." .

<http://example.org/ontology/Disease> a owl:Class ;
    rdfs:label "Disease" ;
    skos:prefLabel "Disease" ;
    skos:definition "A disease associated with the cis-regulatory module." .

### Object Properties ###
<http://example.org/ontology/hasTargetGene> a owl:ObjectProperty ;
    rdfs:label "has target gene" ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Gene> .

<http://example.org/ontology/activeInCellLine> a owl:ObjectProperty ;
    rdfs:label "active in cell line" ;
    skos:prefLabel "active in cell line" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/CellLine> .

<http://example.org/ontology/associatedWithDisease> a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/Disease> .

<http://example.org/ontology/interactsWithTF> a owl:ObjectProperty ;
    rdfs:label "interacts with transcription factor" ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range <http://example.org/ontology/TranscriptionFactor> .

### Datatype Properties ###
<http://example.org/ontology/hasGenomicCoordinates> a owl:DatatypeProperty ;
    rdfs:label "has genomic coordinates" ;
    skos:prefLabel "has genomic coordinates" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string .

<http://example.org/ontology/hasScore> a owl:DatatypeProperty ;
    rdfs:label "has score" ;
    skos:prefLabel "has score" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:float .

<http://example.org/ontology/hasMinimumRatio> a owl:DatatypeProperty ;
    rdfs:label "has minimum ratio" ;
    skos:prefLabel "has minimum ratio" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:float .

<http://example.org/ontology/hasPMID> a owl:DatatypeProperty ;
    rdfs:label "has PMID" ;
    skos:prefLabel "has PMID" ;
    rdfs:domain <http://example.org/ontology/CRM> ;
    rdfs:range xsd:string .