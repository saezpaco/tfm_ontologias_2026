@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix : <http://example.org/ontology/> .

<http://example.org/ontology/dbSUPER> a owl:Ontology ;
    rdfs:label "dbSUPER Ontology" ;
    skos:definition "Ontology for representing super-enhancers from the dbSUPER database." .

### Classes ###
:SuperEnhancer a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" ;
    skos:exactMatch <http://example.org/controlled-vocabulary/crm> .

:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A gene that is a target of a super-enhancer." .

:CellLine a owl:Class ;
    skos:prefLabel "Cell Line" ;
    skos:definition "A cell line in which the super-enhancer is active." .

### Object Properties ###
:hasTargetGene a owl:ObjectProperty ;
    rdfs:domain :SuperEnhancer ;
    rdfs:range :Gene ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name" .

:activeInCellLine a owl:ObjectProperty ;
    rdfs:domain :SuperEnhancer ;
    rdfs:range :CellLine ;
    skos:prefLabel "Active in Cell Line" ;
    skos:definition "The cell line in which the super-enhancer is active." .

### Datatype Properties ###
:chromosome a owl:DatatypeProperty ;
    rdfs:domain :SuperEnhancer ;
    rdfs:range xsd:string ;
    skos:prefLabel "chr_name" ;
    skos:definition "Chromosome where the super-enhancer is located." .

:startPosition a owl:DatatypeProperty ;
    rdfs:domain :SuperEnhancer ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Position" ;
    skos:definition "Start position of the super-enhancer on the chromosome." .

:endPosition a owl:DatatypeProperty ;
    rdfs:domain :SuperEnhancer ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Position" ;
    skos:definition "End position of the super-enhancer on the chromosome." .

:rank a owl:DatatypeProperty ;
    rdfs:domain :SuperEnhancer ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Rank" ;
    skos:definition "Rank of the super-enhancer based on its activity." .

### Instances ###
:SE_00001 a :SuperEnhancer ;
    :chromosome "chr1" ;
    :startPosition 120485363 ;
    :endPosition 120615071 ;
    :rank 1 ;
    :hasTargetGene :NOTCH2 ;
    :activeInCellLine :AdiposeNuclei .

:NOTCH2 a :Gene ;
    skos:prefLabel "NOTCH2" .

:AdiposeNuclei a :CellLine ;
    skos:prefLabel "Adipose Nuclei" .
