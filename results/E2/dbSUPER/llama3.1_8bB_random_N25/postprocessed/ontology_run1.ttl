@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix : <http://example.org/ontology/> .

<http://example.org/dbSUPER>
  a owl:Ontology ;
  rdfs:label "dbSUPER" ;
  skos:prefLabel "dbSUPER" ;
  skos:definition "Super-enhancers con coordenadas, líneas celulares y genes diana" .

:crm a owl:Class ;
  rdfs:label "CRM" ;
  skos:prefLabel "CRM" ;
  skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

<http://example.org/dbSUPER#crm_ID> a owl:ObjectProperty ;
  rdfs:label "crm/crm_ID" ;
  skos:prefLabel "crm/crm_ID" ;
  skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position according to database_name" .

<http://example.org/dbSUPER#chr_name> a owl:ObjectProperty ;
  rdfs:label "chr_name" ;
  skos:prefLabel "chr_name" ;
  skos:definition "Chromosome name" .

<http://example.org/dbSUPER#start_position> a owl:DatatypeProperty ;
  rdfs:label "start_position" ;
  skos:prefLabel "start_position" ;
  skos:definition "Start position of the cis-regulatory module" ;
  rdfs:range xsd:int .

<http://example.org/dbSUPER#end_position> a owl:DatatypeProperty ;
  rdfs:label "end_position" ;
  skos:prefLabel "end_position" ;
  skos:definition "End position of the cis-regulatory module" ;
  rdfs:range xsd:int .

:crm_ID a owl:ObjectProperty ;
  rdfs:label "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" ;
  skos:definition "Association between cis-regulatory module CRMHS00000003515 and gene TBX5" .

:gene_symbol a owl:ObjectProperty ;
  rdfs:label "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" ;
  skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name" .

:disease a owl:ObjectProperty ;
  rdfs:label "bgw!crm_ID--doid!doid" ;
  skos:prefLabel "bgw!crm_ID--doid!doid#database_name" ;
  skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid according to database_name" .

:transcription_factor a owl:ObjectProperty ;
  rdfs:label "bgw!crm_ID--uniprot!uniprot_ID" ;
  skos:prefLabel "Transcription Factor" ;
  skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID" .

:cell_line a owl:ObjectProperty ;
  rdfs:label "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" ;
  skos:definition "Association between cis-regulatory module crm_ID and cell line gene_symbol according to database_name" .

<http://example.org/dbSUPER#rank> a owl:DatatypeProperty ;
  rdfs:label "rank" ;
  skos:prefLabel "rank" ;
  skos:definition "Rank of the cis-regulatory module" ;
  rdfs:range xsd:int .