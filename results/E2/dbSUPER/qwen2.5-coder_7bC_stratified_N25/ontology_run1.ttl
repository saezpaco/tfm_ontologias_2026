@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

owl:Ontology rdf:about "http://example.com/dbSUPER" ;
    rdfs:label "dbSUPER Ontology" ;
    rdfs:comment "An ontology for dbSUPER database containing information about cis-regulatory modules, specifically enhancer sequences." ;

crm:CRM a owl:Class ;
    skos:prefLabel "Cis-Regulatory Module" ;
    skos:definition "A cis-regulatory module located in Homo sapiens chr_name between start_position and end_position." .

crm:Enhancer a owl:Class ;
    rdfs:subClassOf crm:CRM ;
    skos:prefLabel "Enhancer" ;
    skos:definition "An enhancer sequence that modulates the transcription rate of its target genes in the human genome." .

crm:Chromosome a owl:Class ;
    skos:prefLabel "Chromosome" ;
    skos:definition "A linear DNA molecule that contains genes and other genetic elements." ;

crm:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A segment of DNA that codes for a protein or RNA molecule." .

crm:CellLine a owl:Class ;
    skos:prefLabel "Cell Line" ;
    skos:definition "A population of cells derived from a single cell and maintained in culture." ;

crm:TranscriptionFactor a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that binds to specific DNA sequences and regulates the transcription of genes." .

crm:startPosition a owl:DatatypeProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Start Position" ;
    skos:definition "The starting position of the cis-regulatory module on the chromosome." ;

crm:endPosition a owl:DatatypeProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range xsd:integer ;
    skos:prefLabel "End Position" ;
    skos:definition "The ending position of the cis-regulatory module on the chromosome." ;

crm:chromosomeName a owl:DatatypeProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "Chromosome Name" ;
    skos:definition "The name of the chromosome where the cis-regulatory module is located." ;

crm:geneSymbol a owl:ObjectProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range crm:Gene ;
    skos:prefLabel "Gene Symbol" ;
    skos:definition "A short identifier for a gene." ;

crm:cellLineName a owl:ObjectProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range crm:CellLine ;
    skos:prefLabel "Cell Line Name" ;
    skos:definition "The name of the cell line associated with the cis-regulatory module." ;

crm:transcriptionFactor a owl:ObjectProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range crm:TranscriptionFactor ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A protein that binds to specific DNA sequences and regulates the transcription of genes." ;

crm:disease a owl:ObjectProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range obo:Disease ;
    skos:prefLabel "Disease" ;
    skos:definition "A disorder or condition affecting an organism." ;

crm:databaseName a owl:DatatypeProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "Database Name" ;
    skos:definition "The name of the database where the cis-regulatory module information is stored." ;

# Example instances
crm:SE_31797 a crm:Enhancer ;
    crm:startPosition 187454355 ;
    crm:endPosition 187468841 ;
    crm:chromosomeName "chr3" ;
    crm:geneSymbol crm:BCL6 ;
    crm:cellLineName crm:Gastric ;
    crm:disease obo:D002592 ; # Gastric cancer
    crm:databaseName "dbSUPER" .

crm:SE_15126 a crm:Enhancer ;
    crm:startPosition 49148 ;
    crm:endPosition 60599 ;
    crm:chromosomeName "chr4" ;
    crm:geneSymbol crm:ZNF718 ;
    crm:cellLineName crm:"CD4 Memory Primary 7pool" ;
    crm:disease obo:D002376 ; # Multiple sclerosis
    crm:databaseName "dbSUPER" .