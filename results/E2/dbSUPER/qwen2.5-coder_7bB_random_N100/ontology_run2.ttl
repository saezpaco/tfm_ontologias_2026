@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

crm:CRM a owl:Class ;
    rdfs:label "Cis-regulatory module" ;
    skos:prefLabel "crm/crm_ID" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" ;
    rdfs:subClassOf obo:SO_0001849 .

crm:Database a owl:Class ;
    rdfs:label "Database" ;
    skos:prefLabel "database_name" ;
    skos:definition "A database containing cis-regulatory modules" .

crm:CisRegulatoryModuleInDatabase a owl:ObjectProperty ;
    rdfs:label "located in database" ;
    rdfs:domain crm:CRM ;
    rdfs:range crm:Database ;
    skos:prefLabel "crm#crm_ID#database_name" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position according to database_name" .

crm:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:prefLabel "hgncsymbol!9606/gene_symbol" ;
    skos:definition "A gene in Homo sapiens" .

crm:CisRegulatoryModuleAssociatedWithGene a owl:ObjectProperty ;
    rdfs:label "associated with gene" ;
    rdfs:domain crm:CRM ;
    rdfs:range crm:Gene ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module CRMHS00000003515 and gene TBX5" .

crm:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:prefLabel "doid!doid" ;
    skos:definition "A disease in Homo sapiens" .

crm:CisRegulatoryModuleAssociatedWithDisease a owl:ObjectProperty ;
    rdfs:label "associated with disease" ;
    rdfs:domain crm:CRM ;
    rdfs:range crm:Disease ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid" .

crm:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:prefLabel "uniprot!uniprot_ID" ;
    skos:definition "A transcription factor in Homo sapiens" .

crm:CisRegulatoryModuleAssociatedWithTranscriptionFactor a owl:ObjectProperty ;
    rdfs:label "associated with transcription factor" ;
    rdfs:domain crm:CRM ;
    rdfs:range crm:TranscriptionFactor ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID" .