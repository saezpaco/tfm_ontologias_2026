@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://rdf.biogateway.eu/crm/> .

<http://example.org/dbSUPER>
  a owl:Ontology ;
  rdfs:label "dbSUPER" ;
  skos:prefLabel "dbSUPER" ;
  skos:definition "Super-enhancers con coordenadas, líneas celulares y genes diana" .

crm:CRM
  a owl:Class ;
  rdfs:label "Cis-regulatory module" ;
  skos:prefLabel "CRM" ;
  skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

crm:hasChrName
  a owl:ObjectProperty ;
  rdfs:label "Has chromosome name" ;
  skos:prefLabel "chr_name" ;
  obo:IAO_0000115 "has_part" .

crm:hasStartPosition
  a owl:DatatypeProperty ;
  rdfs:label "Has start position" ;
  skos:prefLabel "start_position" ;
  xsd:dataType xsd:int .

crm:hasEndPosition
  a owl:DatatypeProperty ;
  rdfs:label "Has end position" ;
  skos:prefLabel "end_position" ;
  xsd:dataType xsd:int .

crm:hasDatabaseName
  a owl:ObjectProperty ;
  rdfs:label "Has database name" ;
  skos:prefLabel "database_name" ;
  obo:IAO_0000115 "has_part" .

crm:hasGeneSymbol
  a owl:ObjectProperty ;
  rdfs:label "Has gene symbol" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" ;
  obo:IAO_0000115 "has_part" .

crm:hasCellName
  a owl:ObjectProperty ;
  rdfs:label "Has cell name" ;
  skos:prefLabel "cell_name" ;
  obo:IAO_0000115 "has_part" .

crm:hasRank
  a owl:DatatypeProperty ;
  rdfs:label "Has rank" ;
  skos:prefLabel "rank" ;
  xsd:dataType xsd:int .

crm:isAssociatedWithGene
  a owl:ObjectProperty ;
  rdfs:label "Is associated with gene" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" ;
  obo:IAO_0000115 "has_part" .

crm:isAssociatedWithDisease
  a owl:ObjectProperty ;
  rdfs:label "Is associated with disease" ;
  skos:prefLabel "bgw!crm_ID--doid!doid#database_name" ;
  obo:IAO_0000115 "has_part" .

crm:isAssociatedWithTranscriptionFactor
  a owl:ObjectProperty ;
  rdfs:label "Is associated with transcription factor" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID#database_name" ;
  obo:IAO_0000115 "has_part" .

dbSUPER:SuperEnhancer
  a crm:CRM ;
  rdfs:label "Super-enhancer" ;
  skos:prefLabel "Super-enhancer" ;
  crm:hasChrName ?chrName ;
  crm:hasStartPosition ?startPosition ;
  crm:hasEndPosition ?endPosition ;
  crm:hasDatabaseName "dbSUPER" ;
  crm:isAssociatedWithGene ?geneSymbol .

dbSUPER:Enhancer
  a crm:CRM ;
  rdfs:label "Enhancer" ;
  skos:prefLabel "Enhancer" ;
  crm:hasChrName ?chrName ;
  crm:hasStartPosition ?startPosition ;
  crm:hasEndPosition ?endPosition ;
  crm:isAssociatedWithGene ?geneSymbol .

dbSUPER:CellLine
  a owl:Class ;
  rdfs:label "Cell line" ;
  skos:prefLabel "cell_name" ;
  crm:hasName ?cellName .

dbSUPER:TranscriptionFactor
  a owl:Class ;
  rdfs:label "Transcription factor" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID#database_name" ;
  crm:isAssociatedWithCRM ?crmID .
