PMID
    a owl:DatatypeProperty ;
    rdfs:label "PMID" ;
    rdfs:comment "This is a PMID."@en ;
    skos:definition "A unique identifier for a publication in PubMed."@en ;
    range xsd:string .

Method
    a owl:Class ;
    rdfs:label "Method" ;
    rdfs:comment "This is a method."@en ;
    skos:definition "A procedure or technique used to achieve a particular result."@en .

Biosample
    a owl:Class ;
    rdfs:label "Biosample" ;
    rdfs:comment "This is a biosample."@en ;
    skos:definition "A sample of biological material, such as tissue or cells."@en .

ID
    a owl:Class ;
    rdfs:label "ID" ;
    rdfs:comment "This is an ID."@en ;
    skos:definition "A unique identifier for something."@en .

Reference
    a owl:Class ;
    rdfs:label "Reference" ;
    rdfs:comment "This is a reference."@en ;
    skos:definition "A citation or mention of another work."@en .

Assembly
    a owl:Class ;
    rdfs:label "Assembly" ;
    rdfs:comment "This is an assembly."@en ;
    skos:definition "A collection of genetic material, such as DNA or RNA."@en .

Chromosome
    a owl:Class ;
    rdfs:label "Chromosome" ;
    rdfs:comment "This is a chromosome."@en ;
    skos:definition "A thread-like structure in the nucleus of a cell that carries hereditary information."@en .

Disease
    a owl:Class ;
    rdfs:label "Disease" ;
    rdfs:comment "This is a disease."@en ;
    skos:definition "A condition that affects an organism's health."@en .

Ratio
    a owl:DatatypeProperty ;
    rdfs:label "Ratio" ;
    rdfs:comment "This is a ratio."@en ;
    skos:definition "The result of dividing one quantity by another."@en ;
    range xsd:string .