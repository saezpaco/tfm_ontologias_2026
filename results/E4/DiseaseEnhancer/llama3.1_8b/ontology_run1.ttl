@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/ontology>
    a owl:Ontology ;
    rdfs:label "Example Ontology" ;
    rdfs:comment "This is an example ontology.".

owl:DatatypeProperty
    a owl:ObjectProperty ;
    rdfs:subClassOf rdf:Property .

owl:ObjectProperty
    a owl:ObjectProperty ;
    rdfs:subClassOf rdf:Property .

owl:Class
    a owl:Class ;
    rdfs:subClassOf rdf:Resource .

class_entity
    a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "This is an entity."@en ;
    skos:definition "An entity is something that exists or has existence."@en ;
    owl:equivalentClass <http://example.org/ontology#entity> .

has_PMID
    a owl:ObjectProperty ;
    rdfs:label "Has PMID" ;
    rdfs:comment "This property represents the relationship between an entity and its PMID."@en ;
    skos:definition "The property that relates an entity to its PMID."@en ;
    domain class_entity ;
    range <http://example.org/ontology#PMID> .

has_method
    a owl:ObjectProperty ;
    rdfs:label "Has Method" ;
    rdfs:comment "This property represents the relationship between an entity and its method."@en ;
    skos:definition "The property that relates an entity to its method."@en ;
    domain class_entity ;
    range <http://example.org/ontology#Method> .

has_biosample
    a owl:ObjectProperty ;
    rdfs:label "Has Biosample" ;
    rdfs:comment "This property represents the relationship between an entity and its biosample."@en ;
    skos:definition "The property that relates an entity to its biosample."@en ;
    domain class_entity ;
    range <http://example.org/ontology#Biosample> .

has_crm_ID
    a owl:ObjectProperty ;
    rdfs:label "Has CRM ID" ;
    rdfs:comment "This property represents the relationship between an entity and its CRM ID."@en ;
    skos:definition "The property that relates an entity to its CRM ID."@en ;
    domain class_entity ;
    range <http://example.org/ontology#ID> .

has_crossref
    a owl:ObjectProperty ;
    rdfs:label "Has Cross Reference" ;
    rdfs:comment "This property represents the relationship between an entity and its cross reference."@en ;
    skos:definition "The property that relates an entity to its cross reference."@en ;
    domain class_entity ;
    range <http://example.org/ontology#Reference> .

has_current_assembly
    a owl:ObjectProperty ;
    rdfs:label "Has Current Assembly" ;
    rdfs:comment "This property represents the relationship between an entity and its current assembly."@en ;
    skos:definition "The property that relates an entity to its current assembly."@en ;
    domain class_entity ;
    range <http://example.org/ontology#Assembly> .

has_current_chr
    a owl:ObjectProperty ;
    rdfs:label "Has Current Chromosome" ;
    rdfs:comment "This property represents the relationship between an entity and its current chromosome."@en ;
    skos:definition "The property that relates an entity to its current chromosome."@en ;
    domain class_entity ;
    range <http://example.org/ontology#Chromosome> .

