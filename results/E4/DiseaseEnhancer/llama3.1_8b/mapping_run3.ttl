@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://www.sqlalchemy.org/engines/sqlite/> .

<#TriplesMapEntity> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "http://example.org/entity/{Entity1}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate <http://example.org/property>;
        rr:objectMap [
            rr:parentTriplesMap <#Property>
        ]
    ].

<#TriplesMapEntity2> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "http://example.org/entity/{Entity2}{FAIR_URI}";
    ].

