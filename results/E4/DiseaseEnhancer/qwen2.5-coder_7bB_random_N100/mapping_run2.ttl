```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix genreg: <https://genetic_regulatory_elements.com#> .

<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasScore;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement>;
            rml:reference "score";
        ]
    ] , [
        rr:predicate genreg:hasRatio;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement>;
            rml:reference "minimum_ratio";
        ]
    ] , [
        rr:predicate genreg:hasStartPosition;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement>;
            rml:reference "orig_start";
        ]
    ] , [
        rr:predicate genreg:hasEndPosition;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement>;
            rml:reference "orig_end";
        ]
    ] , [
        rr:predicate genreg:associatedWithDisease;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapDisease>;
            rml:reference "disease";
        ]
    ] , [
        rr:predicate genreg:hasPubMedID;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement>;
            rml:reference "TFs2enh_PMID";
        ]
    ] , [
        rr:predicate genreg:hasMethod;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement>;
            rml:reference "TFs2enh_method";
        ]
    ] , [
        rr:predicate genreg:hasChromosome;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement>;
            rml:reference "orig_chr";
        ]
    ] , [
        rr:predicate genreg:hasAssemblyVersion;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement>;
            rml:reference "current_assembly";
        ]
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapSuperEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{hgnc_symbol_TFs}}{FAIR_URI}";
    ].

<#TriplesMapGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{hgnc_symbol_target_genes}}{FAIR_URI}";
    ].

<#TriplesMapDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{disease}}{FAIR_URI}";
    ].
