```ttl
<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate greg:pmid;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPubMedArticle>;
        ]
    ],
    [
        rr:predicate greg:method;
        rr:objectMap [
            rml:reference "disease_method";
        ]
    ],
    [
        rr:predicate greg:assemblyVersion;
        rr:objectMap [
            rml:reference "current_assembly";
        ]
    ],
    [
        rr:predicate greg:chromosomeNumber;
        rr:objectMap [
            rml:reference "current_chr";
        ]
    ],
    [
        rr:predicate greg:start;
        rr:objectMap [
            rml:reference "current_start";
        ]
    ],
    [
        rr:predicate greg:end;
        rr:objectMap [
            rml:reference "current_end";
        ]
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:{{hgncSymbol}}_TF{FAIR_URI}";
    ].

