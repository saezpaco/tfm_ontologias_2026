<#TriplesMapMutation> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Mutation/{original_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate rdf:type;
        rr:objectMap [
