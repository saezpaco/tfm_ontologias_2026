        ]
    ].

<#TriplesMapGeneticElementBiosample> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/GeneticElement/{original_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasBiosample;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapBiosample>
        ]
    ].

<#TriplesMapGeneticElementDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/GeneticElement/{original_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:associatedWithDisease;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapDisease>
        ]
    ].

<#TriplesMapGeneticElementMethod> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/GeneticElement/{original_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:identifiedByMethod;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapMethod>
        ]
    ].

<#TriplesMapGeneticElementPublication> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/GeneticElement/{original_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:referencedInPublication;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPublication>
        ]
    ].

<#TriplesMapTranscriptionFactorTargetGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/TranscriptionFactor/{hgnc_symbol_TFs}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:regulates;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetGene>
        ]
    ].