        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:Mutation/{{mutation}}{FAIR_URI}";
    ].

<#TriplesMapTFs2enhInteraction> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:TFs2enhInteraction/{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMaphenh2geneInteraction> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:enh2geneInteraction/{{original_ID}}{FAIR_URI}";
