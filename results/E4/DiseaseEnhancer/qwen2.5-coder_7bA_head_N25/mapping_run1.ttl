```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gr: <https://genetic_regulatory_elements.com#> .

<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate gr:hasPubMedID;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPubMedArticle>;
        ]
    ],
    [
        rr:predicate gr:hasMethod;
        rr:objectMap [
            rml:reference "method";
        ]
    ],
    [
        rr:predicate gr:hasChromosomeNumber;
        rr:objectMap [
            rml:reference "current_chr";
        ]
    ],
    [
        rr:predicate gr:hasScore;
        rr:objectMap [
            rml:reference "score";
        ]
    ],
    [
        rr:predicate gr:hasAssemblyVersion;
        rr:objectMap [
            rml:reference "current_assembly";
        ]
    ],
    [
        rr:predicate gr:hasStartPosition;
        rr:objectMap [
            rml:reference "current_start";
        ]
    ],
    [
        rr:predicate gr:hasEndPosition;
        rr:objectMap [
            rml:reference "current_end";
        ]
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:TranscriptionFactor/{{hgnc_symbol_TFs}}{FAIR_URI}";
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:Enhancer/{{crm_ID}}{FAIR_URI}";
    ].

<#TriplesMapTargetGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:TargetGene/{{hgnc_symbol_target_genes}}{FAIR_URI}";
    ].

<#TriplesMapDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:Disease/{{disease}}{FAIR_URI}";
    ].

