```ttl
<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate greg:pmid;
        rr:objectMap [
            rml:reference "TFs2enh_PMID";
            rr:datatype xsd:int
        ]
    ],
    [
        rr:predicate greg:method;
        rr:objectMap [
            rml:reference "TFs2enh_method";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate greg:assemblyVersion;
        rr:objectMap [
            rml:reference "current_assembly";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate greg:chromosomeNumber;
        rr:objectMap [
            rml:reference "current_chr";
            rr:datatype xsd:int
        ]
    ],
    [
        rr:predicate greg:score;
        rr:objectMap [
            rml:reference "score";
            rr:datatype xsd:float
        ]
    ],
    [
        rr:predicate greg:startPosition;
        rr:objectMap [
            rml:reference "current_start";
            rr:datatype xsd:int
        ]
    ],
    [
        rr:predicate greg:endPosition;
        rr:objectMap [
            rml:reference "current_end";
            rr:datatype xsd:int
        ]
    ].

