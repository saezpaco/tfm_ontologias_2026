```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix genreg: <https://genetic_regulatory_elements.com#> .

<#TriplesMapTranscriptionFactorToEnhancerInteraction> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:TranscriptionFactorToEnhancerInteraction/{{TFs2enh_PMID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>;
        ]
    ],
    [
        rr:predicate genreg:hasEnhancer;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapEnhancer>;
        ]
    ],
    [
        rr:predicate genreg:method;
        rr:objectMap [
            rr:template "{{TFs2enh_method}}";
        ]
    ],
    [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:template "{{TFs2enh_PMID}}";
        ]
    ],
    [
        rr:predicate genreg:startPosition;
        rr:objectMap [
            rr:template "{{orig_start}}";
        ]
    ],
    [
        rr:predicate genreg:endPosition;
        rr:objectMap [
            rr:template "{{orig_end}}";
        ]
    ],
    [
        rr:predicate genreg:assemblyVersion;
        rr:objectMap [
            rr:template "{{current_assembly}}";
        ]
    ].

<#TriplesMapEnhancerToGeneInteraction> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:EnhancerToGeneInteraction/{{enh2gene_PMID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasEnhancer;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapEnhancer>;
        ]
    ],
    [
        rr:predicate genreg:hasTargetGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetGene>;
        ]
    ],
    [
        rr:predicate genreg:method;
        rr:objectMap [
            rr:template "{{enh2gene_method}}";
        ]
    ],
    [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:template "{{enh2gene_PMID}}";
        ]
    ],
    [
        rr:predicate genreg:startPosition;
        rr:objectMap [
            rr:template "{{orig_start}}";
        ]
    ],
    [
        rr:predicate genreg:endPosition;
        rr:objectMap [
            rr:template "{{orig_end}}";
        ]
    ],
    [
        rr:predicate genreg:assemblyVersion;
        rr:objectMap [
            rr:template "{{current_assembly}}";
        ]
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:TranscriptionFactor/{{FAIR_URI}}";
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:Enhancer/{{FAIR_URI}}";
    ].

<#TriplesMapTargetGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:TargetGene/{{FAIR_URI}}";
    ].

<#TriplesMapDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:Disease/{{FAIR_URI}}";
    ].

<#TriplesMapCellLineOrBiosample> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:CellLineOrBiosample/{{FAIR_URI}}";
    ].

<#TriplesMapPubMedArticle> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
