```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix genreg: <https://genetic_regulatory_elements.com#> .

<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPMID>;
        ]
    ],
    [
        rr:predicate genreg:method;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapMethod>;
        ]
    ],
    [
        rr:predicate genreg:chromosomeNumber;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapChromosomeNumber>;
        ]
    ],
    [
        rr:predicate genreg:scoreValue;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapScoreValue>;
        ]
    ],
    [
        rr:predicate genreg:assemblyVersion;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapAssemblyVersion>;
        ]
    ],
    [
        rr:predicate genreg:hgncSymbol;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapHGNCsymbol>;
        ]
    ],
    [
        rr:predicate genreg:refseqID;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapRefSeqID>;
        ]
    ],
    [
        rr:predicate genreg:originalID;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapOriginalID>;
        ]
    ].

<#TriplesMapPMID> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:constant xsd:string ;
            rr:termType rdf:Literal
        ]
    ].

<#TriplesMapMethod> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:method;
        rr:objectMap [
            rr:constant xsd:string ;
            rr:termType rdf:Literal
        ]
    ].

<#TriplesMapChromosomeNumber> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:chromosomeNumber;
        rr:objectMap [
            rr:constant xsd:int ;
            rr:termType rdf:Literal
        ]
    ].

<#TriplesMapScoreValue> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:scoreValue;
        rr:objectMap [
            rr:constant xsd:float ;
            rr:termType rdf:Literal
        ]
    ].

<#TriplesMapAssemblyVersion> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:assemblyVersion;
        rr:objectMap [
            rr:constant xsd:string ;
            rr:termType rdf:Literal
        ]
    ].

<#TriplesMapHGNCsymbol> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hgncSymbol;
        rr:objectMap [
            rr:constant xsd:string ;
            rr:termType rdf:Literal
        ]
    ].

<#TriplesMapRefSeqID> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:refseqID;
        rr:objectMap [
            rr:constant xsd:string ;
            rr:termType rdf:Literal
        ]
    ].

<#TriplesMapOriginalID> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ].
