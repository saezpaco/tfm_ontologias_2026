@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix genreg: <https://genetic_regulatory_elements.com#> .

owl:DatatypeProperty pmid
    a owl:DatatypeProperty ;
    rdfs:label "PubMed ID" ;
    rdfs:comment "A PubMed ID associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty method
    a owl:DatatypeProperty ;
    rdfs:label "Method" ;
    rdfs:comment "The method used in the genetic regulatory element relationship." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty chromosomeNumber
    a owl:DatatypeProperty ;
    rdfs:label "Chromosome Number" ;
    rdfs:comment "The chromosome number in the assembly version." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:DatatypeProperty scoreValue
    a owl:DatatypeProperty ;
    rdfs:label "Score Value" ;
    rdfs:comment "The score associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:float .

owl:ObjectProperty hasTranscriptionFactor
    a owl:ObjectProperty ;
    rdfs:label "Has Transcription Factor" ;
    rdfs:comment "The transcription factor involved in the genetic regulatory element relationship." ;
    rdfs:domain genreg:TranscriptionFactorToEnhancerRelationship ;
    rdfs:range genreg:TranscriptionFactor .

owl:ObjectProperty hasEnhancer
    a owl:ObjectProperty ;
    rdfs:label "Has Enhancer" ;
    rdfs:comment "The enhancer involved in the genetic regulatory element relationship." ;
    rdfs:domain genreg:TranscriptionFactorToEnhancerRelationship ;
    rdfs:range genreg:Enhancer .

owl:ObjectProperty hasTargetGene
    a owl:ObjectProperty ;
    rdfs:label "Has Target Gene" ;
    rdfs:comment "The target gene involved in the genetic regulatory element relationship." ;
    rdfs:domain genreg:EnhancerToGeneRelationship ;
    rdfs:range genreg:TargetGene .

owl:ObjectProperty associatedWithDisease
    a owl:ObjectProperty ;
    rdfs:label "Associated With Disease" ;
    rdfs:comment "The disease associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:Disease .

owl:ObjectProperty associatedWithMutation
    a owl:ObjectProperty ;
    rdfs:label "Associated With Mutation" ;
    rdfs:comment "The mutation associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:Mutation .

genreg:TranscriptionFactorToEnhancerRelationship
    a owl:Class ;
    rdfs:label "Transcription Factor to Enhancer Relationship" ;
    rdfs:comment "A relationship between a transcription factor and an enhancer." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

genreg:EnhancerToGeneRelationship
    a owl:Class ;
    rdfs:label "Enhancer to Gene Relationship" ;
    rdfs:comment "A relationship between an enhancer and a target gene." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

genreg:TranscriptionFactor
    a owl:Class ;
    rdfs:label "Transcription Factor" ;
    rdfs:comment "A protein that binds to DNA and regulates the transcription of genes." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .

genreg:Enhancer
    a owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "A region of DNA that increases the transcription of nearby genes." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .

genreg:SuperEnhancer
    a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:comment "A highly active enhancer that can drive the transcription of multiple genes." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:Enhancer ] .

genreg:TargetGene
    a owl:Class ;
    rdfs:label "Target Gene" ;
    rdfs:comment "A gene that is regulated by an enhancer." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .

genreg:Disease
    a owl:Class ;
    rdfs:label "Disease" ;
    rdfs:comment "A medical condition or disorder." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .

genreg:Mutation
    a owl:Class ;
    rdfs:label "Mutation" ;
    rdfs:comment "A change in the DNA sequence of an organism." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .

genreg:CellLineBiosample
    a owl:Class ;
    rdfs:label "Cell Line Biosample" ;
    rdfs:comment "A collection of cells that are maintained in culture." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .