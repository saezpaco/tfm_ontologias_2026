```ttl
<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPMID>;
        ]
    ],
    [
        rr:predicate genreg:method;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapMethod>;
        ]
    ],
    [
        rr:predicate genreg:chromosomeNumber;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapChromosomeNumber>;
        ]
    ],
    [
        rr:predicate genreg:scoreValue;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapScoreValue>;
        ]
    ].

<#TriplesMapTranscriptionFactorToEnhancerRelationship> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{TFs2enh_PMID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>;
        ]
    ],
    [
        rr:predicate genreg:hasEnhancer;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapEnhancer>;
        ]
    ].

<#TriplesMapEnhancerToGeneRelationship> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{enh2gene_PMID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasEnhancer;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapEnhancer>;
        ]
    ],
    [
        rr:predicate genreg:hasTargetGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetGene>;
        ]
    ].

