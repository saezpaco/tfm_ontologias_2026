```ttl
<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPubMedArticle>;
        ]
    ],
    [
        rr:predicate genreg:method;
        rr:objectMap [
            ql:reference "disease_method";
        ]
    ],
    [
        rr:predicate genreg:assemblyVersion;
        rr:objectMap [
            ql:reference "current_assembly";
        ]
    ],
    [
        rr:predicate genreg:chromosomeNumber;
        rr:objectMap [
            ql:reference "current_chr";
        ]
    ],
    [
        rr:predicate genreg:score;
        rr:objectMap [
            ql:reference "score";
        ]
    ],
    [
        rr:predicate genreg:startPosition;
        rr:objectMap [
            ql:reference "current_start";
        ]
    ],
    [
        rr:predicate genreg:endPosition;
        rr:objectMap [
            ql:reference "current_end";
        ]
    ].

