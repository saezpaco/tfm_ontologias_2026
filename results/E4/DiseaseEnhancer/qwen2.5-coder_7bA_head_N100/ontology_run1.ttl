@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix genreg: <https://genetic_regulatory_elements.com#> .

owl:DatatypeProperty pmid
    a owl:DatatypeProperty ;
    rdfs:label "PubMed ID" ;
    rdfs:comment "The PubMed ID associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:DatatypeProperty method
    a owl:DatatypeProperty ;
    rdfs:label "Method" ;
    rdfs:comment "The method used in the study of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty assemblyVersion
    a owl:DatatypeProperty ;
    rdfs:label "Assembly Version" ;
    rdfs:comment "The genomic assembly version of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty chromosomeNumber
    a owl:DatatypeProperty ;
    rdfs:label "Chromosome Number" ;
    rdfs:comment "The chromosome number of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:DatatypeProperty score
    a owl:DatatypeProperty ;
    rdfs:label "Score" ;
    rdfs:comment "The score associated with the interaction of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:float .

owl:DatatypeProperty ratio
    a owl:DatatypeProperty ;
    rdfs:label "Ratio" ;
    rdfs:comment "The minimum ratio of interaction for the genetic regulatory element." ;
    rdfs:domain genreg:TranscriptionFactorToEnhancerInteraction, genreg:EnhancerToGeneInteraction ;
    rdfs:range xsd:float .

owl:DatatypeProperty startPosition
    a owl:DatatypeProperty ;
    rdfs:label "Start Position" ;
    rdfs:comment "The start position of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:DatatypeProperty endPosition
    a owl:DatatypeProperty ;
    rdfs:label "End Position" ;
    rdfs:comment "The end position of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:ObjectProperty hasTranscriptionFactor
    a owl:ObjectProperty ;
    rdfs:label "Has Transcription Factor" ;
    rdfs:comment "The transcription factor involved in the interaction of the genetic regulatory element." ;
    rdfs:domain genreg:TranscriptionFactorToEnhancerInteraction ;
    rdfs:range genreg:TranscriptionFactor .

owl:ObjectProperty hasEnhancer
    a owl:ObjectProperty ;
    rdfs:label "Has Enhancer" ;
    rdfs:comment "The enhancer involved in the interaction of the genetic regulatory element." ;
    rdfs:domain genreg:TranscriptionFactorToEnhancerInteraction ;
    rdfs:range genreg:Enhancer .

owl:ObjectProperty hasTargetGene
    a owl:ObjectProperty ;
    rdfs:label "Has Target Gene" ;
    rdfs:comment "The target gene involved in the interaction of the genetic regulatory element." ;
    rdfs:domain genreg:EnhancerToGeneInteraction ;
    rdfs:range genreg:TargetGene .

owl:ObjectProperty associatedWithDisease
    a owl:ObjectProperty ;
    rdfs:label "Associated With Disease" ;
    rdfs:comment "The disease associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:Disease .

owl:ObjectProperty occursInCellLineOrBiosample
    a owl:ObjectProperty ;
    rdfs:label "Occurs In Cell Line Or Biosample" ;
    rdfs:comment "The cell line or biosample in which the genetic regulatory element occurs." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:CellLineOrBiosample .

owl:ObjectProperty involvesMutation
    a owl:ObjectProperty ;
    rdfs:label "Involves Mutation" ;
    rdfs:comment "The mutation involved in the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:Mutation .

owl:ObjectProperty hasPubMedArticle
    a owl:ObjectProperty ;
    rdfs:label "Has PubMed Article" ;
    rdfs:comment "The PubMed article associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:PubMedArticle .

owl:Class GeneticRegulatoryElement
    a owl:Class ;
    rdfs:label "Genetic Regulatory Element" ;
    rdfs:comment "A general class representing genetic regulatory elements such as enhancers and super-enhancers." ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:pmid ;
        owl:someValuesFrom xsd:int
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:method ;
        owl:someValuesFrom xsd:string
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:assemblyVersion ;
        owl:someValuesFrom xsd:string
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:chromosomeNumber ;
        owl:someValuesFrom xsd:int
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:score ;
        owl:someValuesFrom xsd:float
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:startPosition ;
        owl:someValuesFrom xsd:int
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:endPosition ;
        owl:someValuesFrom xsd:int
    ] .

owl:Class TranscriptionFactorToEnhancerInteraction
    a owl:Class ;
    rdfs:label "Transcription Factor To Enhancer Interaction" ;
    rdfs:comment "A specific type of genetic regulatory element representing the interaction between transcription factors and enhancers." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class EnhancerToGeneInteraction
    a owl:Class ;
    rdfs:label "Enhancer To Gene Interaction" ;
    rdfs:comment "A specific type of genetic regulatory element representing the interaction between enhancers and target genes." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class TranscriptionFactor
    a owl:Class ;
    rdfs:label "Transcription Factor" ;
    rdfs:comment "A class representing transcription factors involved in genetic regulatory elements." .

owl:Class Enhancer
    a owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "A class representing enhancers involved in genetic regulatory elements." .

owl:Class SuperEnhancer
    a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:comment "A subclass of enhancers with enhanced transcriptional activity." ;
    rdfs:subClassOf genreg:Enhancer .

owl:Class TargetGene
    a owl:Class ;
    rdfs:label "Target Gene" ;
    rdfs:comment "A class representing target genes involved in genetic regulatory elements." .

owl:Class Disease
    a owl:Class ;
    rdfs:label "Disease" ;
    rdfs:comment "A class representing diseases associated with genetic regulatory elements." .

owl:Class CellLineOrBiosample
    a owl:Class ;
    rdfs:label "Cell Line Or Biosample" ;
    rdfs:comment "A class representing cell lines or biosamples in which genetic regulatory elements occur." .

owl:Class Mutation
    a owl:Class ;
    rdfs:label "Mutation" ;
    rdfs:comment "A class representing mutations involved in genetic regulatory elements." .

owl:Class PubMedArticle
    a owl:Class ;
    rdfs:label "PubMed Article" ;
    rdfs:comment "A class representing PubMed articles associated with genetic regulatory elements." .