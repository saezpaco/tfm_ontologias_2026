@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix base: <https://base_ontology.com#> .

<https://base_ontology.com#> rdf:type owl:Ontology .

### Datatype Properties
base:TFs2enh_PMID rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "TFs2enh_PMID" ;
    skos:definition "PubMed ID for TFs to enhancer associations" .

base:TFs2enh_method rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "TFs2enh_method" ;
    skos:definition "Method used for TFs to enhancer associations" .

base:biosample_name rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Biosample ;
    rdfs:range xsd:string ;
    rdfs:label "biosample_name" ;
    skos:definition "Name of the biosample" .

base:crm_ID rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "crm_ID" ;
    skos:definition "ID of the cis-regulatory module" .

base:crossref rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "crossref" ;
    skos:definition "Cross-reference information" .

base:current_assembly rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "current_assembly" ;
    skos:definition "Current genome assembly version" .

base:current_chr rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "current_chr" ;
    skos:definition "Current chromosome" .

base:disease rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Disease ;
    rdfs:range xsd:string ;
    rdfs:label "disease" ;
    skos:definition "Disease associated with the data" .

base:disease_method rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Disease ;
    rdfs:range xsd:string ;
    rdfs:label "disease_method" ;
    skos:definition "Method used for disease association" .

base:enh2gene_PMID rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "enh2gene_PMID" ;
    skos:definition "PubMed ID for enhancer to gene associations" .

base:enh2gene_method rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "enh2gene_method" ;
    skos:definition "Method used for enhancer to gene associations" .

base:enh_method rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "enh_method" ;
    skos:definition "Method used for enhancer identification" .

base:hgnc_symbol_TFs rdf:type owl:DatatypeProperty ;
    rdfs:domain base:TranscriptionFactor ;
    rdfs:range xsd:string ;
    rdfs:label "hgnc_symbol_TFs" ;
    skos:definition "HGNC symbol for transcription factors" .

base:hgnc_symbol_target_genes rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Gene ;
    rdfs:range xsd:string ;
    rdfs:label "hgnc_symbol_target_genes" ;
    skos:definition "HGNC symbol for target genes" .

base:minimum_ratio rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:float ;
    rdfs:label "minimum_ratio" ;
    skos:definition "Minimum ratio value" .

base:mutation_PMID rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "mutation_PMID" ;
    skos:definition "PubMed ID for mutation information" .

base:mutation_method rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "mutation_method" ;
    skos:definition "Method used for mutation information" .

base:orig_assembly rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "orig_assembly" ;
    skos:definition "Original genome assembly version" .

base:orig_chr rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "orig_chr" ;
    skos:definition "Original chromosome" .

base:original_ID rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "original_ID" ;
    skos:definition "Original ID of the data" .

base:refseq_ID rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Gene ;
    rdfs:range xsd:string ;
    rdfs:label "refseq_ID" ;
    skos:definition "RefSeq ID" .

base:score rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:float ;
    rdfs:label "score" ;
    skos:definition "Score value" .

base:source rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "source" ;
    skos:definition "Source of the data" .

base:type rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "type" ;
    skos:definition "Type of the data" .

base:current_end rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "current_end" ;
    skos:definition "Current end position in the genome" .

base:current_start rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "current_start" ;
    skos:definition "Current start position in the genome" .

base:disease_PMID rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Disease ;
    rdfs:range xsd:integer ;
    rdfs:label "disease_PMID" ;
    skos:definition "PubMed ID for disease information" .

base:enh_PMID rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:integer ;
    rdfs:label "enh_PMID" ;
    skos:definition "PubMed ID for enhancer information" .

base:orig_end rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "orig_end" ;
    skos:definition "Original end position in the genome" .

base:orig_start rdf:type owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "orig_start" ;
    skos:definition "Original start position in the genome" .

### Object Properties
base:hasGenomicCoordinate rdf:type owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:GenomicCoordinate ;
    rdfs:label "hasGenomicCoordinate" ;
    skos:definition "Associates a genetic element with its genomic coordinate" .

base:associatedWithBiosample rdf:type owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Biosample ;
    rdfs:label "associatedWithBiosample" ;
    skos:definition "Associates a genetic element with a biosample" .

base:targetsGene rdf:type owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Gene ;
    rdfs:label "targetsGene" ;
    skos:definition "Associates a genetic element with a target gene" .

base:regulatedByTF rdf:type owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:TranscriptionFactor ;
    rdfs:label "regulatedByTF" ;
    skos:definition "Associates a genetic element with a transcription factor" .

base:associatedWithDisease rdf:type owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Disease ;
    rdfs:label "associatedWithDisease" ;
    skos:definition "Associates a genetic element with a disease" .

### Classes
base:GeneticElement rdf:type owl:Class ;
    rdfs:label "GeneticElement" ;
    skos:definition "A genetic element such as a gene, enhancer, or other regulatory element" ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty base:hasGenomicCoordinate ;
        owl:someValuesFrom base:GenomicCoordinate
    ], [
        rdf:type owl:Restriction ;
        owl:onProperty base:associatedWithBiosample ;
        owl:someValuesFrom base:Biosample
    ], [
        rdf:type owl:Restriction ;
        owl:onProperty base:targetsGene ;
        owl:someValuesFrom base:Gene
    ], [
        rdf:type owl:Restriction ;
        owl:onProperty base:regulatedByTF ;
        owl:someValuesFrom base:TranscriptionFactor
    ], [
        rdf:type owl:Restriction ;
        owl:onProperty base:associatedWithDisease ;
        owl:someValuesFrom base:Disease
    ] .

base:GenomicCoordinate rdf:type owl:Class ;
    rdfs:label "GenomicCoordinate" ;
    skos:definition "A genomic coordinate specifying a location in the genome" .

base:Biosample rdf:type owl:Class ;
    rdfs:label "Biosample" ;
    skos:definition "A biosample from which genetic data is derived" .

base:Gene rdf:type owl:Class ;
    rdfs:label "Gene" ;
    skos:definition "A gene that is targeted by genetic elements" .

base:TranscriptionFactor rdf:type owl:Class ;
    rdfs:label "TranscriptionFactor" ;
    skos:definition "A transcription factor that regulates genetic elements" .

base:Disease rdf:type owl:Class ;
    rdfs:label "Disease" ;
    skos:definition "A disease associated with genetic elements" .

base:Enhancer rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    skos:definition "A genetic element that enhances the transcription of a gene" ;
    rdfs:subClassOf base:GeneticElement .

base:SuperEnhancer rdf:type owl:Class ;
    rdfs:label "SuperEnhancer" ;
    skos:definition "A large cluster of enhancers that drive high levels of gene transcription" ;
    rdfs:subClassOf base:GeneticElement .