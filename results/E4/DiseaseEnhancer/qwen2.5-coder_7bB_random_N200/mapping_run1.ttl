<#TriplesMapEnhancerToGeneInteraction> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "DiseaseEnhancer.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:EnhancerToGeneInteraction/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate greg:hasEnhancer;
        rr:objectMap [
            rml:reference "crm_ID";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate greg:hasTargetGene;
        rr:objectMap [
            rml:reference "hgnc_symbol_TFs";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate greg:pmid;
        rr:objectMap [
            rml:reference "TFs2enh_PMID";
            rr:datatype xsd:int
        ]
    ],
    [
        rr:predicate greg:method;
        rr:objectMap [
            rml:reference "TFs2enh_method";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate greg:assemblyVersion;
        rr:objectMap [
            rml:reference "current_assembly";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate greg:chromosomeNumber;
        rr:objectMap [
            rml:reference "current_chr";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate greg:start;
        rr:objectMap [
            rml:reference "current_start";
            rr:datatype xsd:int
        ]
    ],
    [
        rr:predicate greg:end;
        rr:objectMap [
            rml:reference "current_end";
            rr:datatype xsd:int
        ]
    ].

