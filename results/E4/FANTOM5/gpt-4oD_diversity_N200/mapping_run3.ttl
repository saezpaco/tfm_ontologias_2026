        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Method/{TFs2enh_method}";
        rr:class base:Method
    ];
    rr:predicateObjectMap [
        rr:predicate base:TFs2enh_method;
        rr:objectMap [
            rml:reference "TFs2enh_method"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:disease_method;
        rr:objectMap [
            rml:reference "disease_method"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:enh2gene_method;
        rr:objectMap [
            rml:reference "enh2gene_method"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:enh_method;
        rr:objectMap [
            rml:reference "enh_method"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:mutation_method;
        rr:objectMap [
            rml:reference "mutation_method"
        ]
    ].

