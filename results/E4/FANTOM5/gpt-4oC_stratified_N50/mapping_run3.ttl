@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .

<#TriplesMapGenomicFeature> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GenomicFeature/{name}";
        rr:class base:GenomicFeature
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasChromosome;
        rr:objectMap [
            rr:column "chrom"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasStartPosition;
        rr:objectMap [
            rr:column "chromStart"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasEndPosition;
        rr:objectMap [
            rr:column "chromEnd"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasScore;
        rr:objectMap [
            rr:column "score"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasThickStart;
        rr:objectMap [
            rr:column "thickStart"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasThickEnd;
        rr:objectMap [
            rr:column "thickEnd"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasBlockCount;
        rr:objectMap [
            rr:column "blockCount"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasBlockSizes;
        rr:objectMap [
            rr:column "blockSizes"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasBlockStarts;
        rr:objectMap [
            rr:column "blockStarts"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasItemRgb;
        rr:objectMap [
            rr:column "itemRgb"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasName;
        rr:objectMap [
            rr:column "name"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasStrand;
        rr:objectMap [
            rr:column "strand"
        ]
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#Enhancer/{name}";
        rr:class base:Enhancer
    ].

