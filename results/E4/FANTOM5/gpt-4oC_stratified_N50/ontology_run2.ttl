@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

base:blockCount a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "block count" ;
    skos:definition "Number of blocks in the genomic feature" .

base:chromEnd a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "chromosome end" ;
    skos:definition "End position of the genomic feature on the chromosome" .

base:chromStart a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "chromosome start" ;
    skos:definition "Start position of the genomic feature on the chromosome" .

base:score a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "score" ;
    skos:definition "Score associated with the genomic feature" .

base:thickEnd a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "thick end" ;
    skos:definition "End position of the thick part of the feature" .

base:thickStart a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "thick start" ;
    skos:definition "Start position of the thick part of the feature" .

base:blockSizes a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "block sizes" ;
    skos:definition "Sizes of the blocks" .

base:blockStarts a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "block starts" ;
    skos:definition "Start positions of the blocks" .

base:chrom a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "chromosome" ;
    skos:definition "Chromosome on which the feature is located" .

base:itemRgb a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "item RGB" ;
    skos:definition "RGB value for the item" .

base:name a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "name" ;
    skos:definition "Name of the genomic feature" .

base:strand a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "strand" ;
    skos:definition "Strand of the genomic feature" .

base:hasChromosome a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:Chromosome ;
    rdfs:label "has chromosome" ;
    skos:definition "Chromosome associated with the genomic feature" .

base:hasStartPosition a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:StartPosition ;
    rdfs:label "has start position" ;
    skos:definition "Start position of the genomic feature" .

base:hasEndPosition a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:EndPosition ;
    rdfs:label "has end position" ;
    skos:definition "End position of the genomic feature" .

base:hasScore a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:Score ;
    rdfs:label "has score" ;
    skos:definition "Score associated with the genomic feature" .

base:hasThickStart a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:ThickStart ;
    rdfs:label "has thick start" ;
    skos:definition "Start position of the thick part of the feature" .

base:hasThickEnd a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:ThickEnd ;
    rdfs:label "has thick end" ;
    skos:definition "End position of the thick part of the feature" .

base:hasBlockCount a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:BlockCount ;
    rdfs:label "has block count" ;
    skos:definition "Number of blocks in the genomic feature" .

base:hasBlockSizes a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:BlockSizes ;
    rdfs:label "has block sizes" ;
    skos:definition "Sizes of the blocks" .

base:hasBlockStarts a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:BlockStarts ;
    rdfs:label "has block starts" ;
    skos:definition "Start positions of the blocks" .

base:hasItemRgb a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:ItemRgb ;
    rdfs:label "has item RGB" ;
    skos:definition "RGB value for the item" .

base:hasName a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:Name ;
    rdfs:label "has name" ;
    skos:definition "Name of the genomic feature" .

base:hasStrand a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:Strand ;
    rdfs:label "has strand" ;
    skos:definition "Strand of the genomic feature" .

base:GenomicFeature a owl:Class ;
    rdfs:label "Genomic Feature" ;
    skos:definition "A feature located on a genome" .

base:Enhancer a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "Enhancer" ;
    skos:definition "A subclass of GenomicFeature representing an enhancer" .

base:SuperEnhancer a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "Super Enhancer" ;
    skos:definition "A subclass of GenomicFeature representing a super enhancer" .

base:CellLine a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "Cell Line" ;
    skos:definition "A subclass of GenomicFeature representing a cell line" .

base:BioSample a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "Bio Sample" ;
    skos:definition "A subclass of GenomicFeature representing a biological sample" .

base:TargetGene a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "Target Gene" ;
    skos:definition "A subclass of GenomicFeature representing a target gene" .

base:TranscriptionFactor a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "Transcription Factor" ;
    skos:definition "A subclass of GenomicFeature representing a transcription factor" .

base:DiseaseAssociation a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "Disease Association" ;
    skos:definition "A subclass of GenomicFeature representing a disease association" .