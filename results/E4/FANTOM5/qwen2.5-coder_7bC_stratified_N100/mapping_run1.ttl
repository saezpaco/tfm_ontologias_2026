```ttl
<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate greg:hasPubMedID;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPubMedID>;
        ]
    ],
    [
        rr:predicate greg:usesMethod;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapUsesMethod>;
        ]
    ],
    [
        rr:predicate greg:hasAssemblyVersion;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapHasAssemblyVersion>;
        ]
    ],
    [
        rr:predicate greg:hasChromosomeNumber;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapHasChromosomeNumber>;
        ]
    ],
    [
        rr:predicate greg:hasScore;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapHasScore>;
        ]
    ],
    [
        rr:predicate greg:hasStartPosition;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapHasStartPosition>;
        ]
    ],
    [
        rr:predicate greg:hasEndPosition;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapHasEndPosition>;
        ]
    ].

