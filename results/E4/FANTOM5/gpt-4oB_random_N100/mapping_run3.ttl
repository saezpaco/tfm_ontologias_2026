@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .

<#TriplesMapGeneticElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/GeneticElement/{original_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:crm_ID;
        rr:objectMap [
            rml:reference "crm_ID";
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:minimum_ratio;
        rr:objectMap [
            rml:reference "minimum_ratio";
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:score;
        rr:objectMap [
            rml:reference "score";
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:source;
        rr:objectMap [
            rml:reference "source";
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:type;
        rr:objectMap [
            rml:reference "type";
        ]
    ].

<#TriplesMapGenomicCoordinate> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/GenomicCoordinate/{current_chr}_{current_start}_{current_end}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:current_chr;
        rr:objectMap [
            rml:reference "current_chr";
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:current_start;
        rr:objectMap [
            rml:reference "current_start";
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:current_end;
        rr:objectMap [
            rml:reference "current_end";
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:orig_chr;
        rr:objectMap [
            rml:reference "orig_chr";
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:orig_start;
        rr:objectMap [
            rml:reference "orig_start";
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:orig_end;
        rr:objectMap [
            rml:reference "orig_end";
        ]
    ].

