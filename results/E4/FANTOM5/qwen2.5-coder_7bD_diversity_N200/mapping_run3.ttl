```ttl
<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:{{type}}_{{identifier}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate greg:hasPubMedID;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPubMedID>;
        ]
    ],
    [
        rr:predicate greg:usesMethod;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapUsesMethod>;
        ]
    ],
    [
        rr:predicate greg:assemblyVersion;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapAssemblyVersion>;
        ]
    ],
    [
        rr:predicate greg:chromosomeNumber;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapChromosomeNumber>;
        ]
    ],
    [
        rr:predicate greg:startPosition;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapStartPosition>;
        ]
    ],
    [
        rr:predicate greg:endPosition;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapEndPosition>;
        ]
    ].

<#TriplesMapPubMedID> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:{{type}}_{{identifier}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate greg:hasPubMedID;
        rr:objectMap [
            rr:constant xsd:string ;
            rr:termType rr:Literal
        ]
    ].

