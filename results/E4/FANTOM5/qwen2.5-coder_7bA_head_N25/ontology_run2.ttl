@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix greg: <https://genetic_regulatory_elements.com#> .

greg:GeneticElement a owl:Class ;
    rdfs:label "Genetic Element" ;
    rdfs:comment "A generic class representing a genetic element." ;

greg:Enhancer a owl:Class ;
    rdfs:subClassOf greg:GeneticElement ;
    rdfs:label "Enhancer" ;
    rdfs:comment "A subclass of GeneticElement representing an enhancer." ;

greg:SuperEnhancer a owl:Class ;
    rdfs:subClassOf greg:Enhancer ;
    rdfs:label "Super Enhancer" ;
    rdfs:comment "A subclass of Enhancer representing a super enhancer." ;

greg:hasBlockCount a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Block Count" ;
    rdfs:comment "An object property that relates a GeneticElement to its block count." ;

greg:hasChromEnd a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Chrom End" ;
    rdfs:comment "An object property that relates a GeneticElement to its chromosome end position." ;

greg:hasChromStart a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Chrom Start" ;
    rdfs:comment "An object property that relates a GeneticElement to its chromosome start position." ;

greg:hasScore a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Score" ;
    rdfs:comment "An object property that relates a GeneticElement to its score." ;

greg:hasThickEnd a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Thick End" ;
    rdfs:comment "An object property that relates a GeneticElement to its thick region end position." ;

greg:hasThickStart a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Thick Start" ;
    rdfs:comment "An object property that relates a GeneticElement to its thick region start position." ;

greg:hasBlockSizes a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Block Sizes" ;
    rdfs:comment "An object property that relates a GeneticElement to its block sizes." ;

greg:hasBlockStarts a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Block Starts" ;
    rdfs:comment "An object property that relates a GeneticElement to its block starts." ;

greg:hasChrom a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Chrom" ;
    rdfs:comment "An object property that relates a GeneticElement to its chromosome name." ;

greg:hasItemRgb a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Item RGB" ;
    rdfs:comment "An object property that relates a GeneticElement to its item RGB color code." ;

greg:hasName a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Name" ;
    rdfs:comment "An object property that relates a GeneticElement to its name." ;

greg:hasStrand a owl:ObjectProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range greg:Enhancer ;
    rdfs:label "Has Strand" ;
    rdfs:comment "An object property that relates a GeneticElement to its strand orientation." ;

greg:blockCountValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:integer ;
    rdfs:label "Block Count Value" ;
    rdfs:comment "A datatype property that represents the block count value of a GeneticElement." ;

greg:chromEndValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:integer ;
    rdfs:label "Chrom End Value" ;
    rdfs:comment "A datatype property that represents the chromosome end position value of a GeneticElement." ;

greg:chromStartValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:integer ;
    rdfs:label "Chrom Start Value" ;
    rdfs:comment "A datatype property that represents the chromosome start position value of a GeneticElement." ;

greg:scoreValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:float ;
    rdfs:label "Score Value" ;
    rdfs:comment "A datatype property that represents the score value of a GeneticElement." ;

greg:thickEndValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:integer ;
    rdfs:label "Thick End Value" ;
    rdfs:comment "A datatype property that represents the thick region end position value of a GeneticElement." ;

greg:thickStartValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:integer ;
    rdfs:label "Thick Start Value" ;
    rdfs:comment "A datatype property that represents the thick region start position value of a GeneticElement." ;

greg:blockSizesValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Block Sizes Value" ;
    rdfs:comment "A datatype property that represents the block sizes value of a GeneticElement." ;

greg:blockStartsValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Block Starts Value" ;
    rdfs:comment "A datatype property that represents the block starts value of a GeneticElement." ;

greg:chromValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Chrom Value" ;
    rdfs:comment "A datatype property that represents the chromosome name value of a GeneticElement." ;

greg:itemRgbValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Item RGB Value" ;
    rdfs:comment "A datatype property that represents the item RGB color code value of a GeneticElement." ;

greg:nameValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Name Value" ;
    rdfs:comment "A datatype property that represents the name value of a GeneticElement." ;

greg:strandValue a owl:DatatypeProperty ;
    rdfs:domain greg:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Strand Value" ;
    rdfs:comment "A datatype property that represents the strand orientation value of a GeneticElement." ;