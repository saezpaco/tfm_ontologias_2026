@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

base:TFs2enh_PMID a owl:DatatypeProperty ;
    rdfs:domain base:Publication ;
    rdfs:range xsd:string ;
    rdfs:label "TFs2enh_PMID" ;
    skos:definition "PubMed ID for transcription factors to enhancer associations" .

base:TFs2enh_method a owl:DatatypeProperty ;
    rdfs:domain base:Method ;
    rdfs:range xsd:string ;
    rdfs:label "TFs2enh_method" ;
    skos:definition "Method used for transcription factors to enhancer associations" .

base:biosample a owl:DatatypeProperty ;
    rdfs:domain base:Biosample ;
    rdfs:range xsd:string ;
    rdfs:label "biosample" ;
    skos:definition "Biosample or cell line used in the study" .

base:crm_ID a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "crm_ID" ;
    skos:definition "Cis-regulatory module identifier" .

base:crossref a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "crossref" ;
    skos:definition "Cross-reference information" .

base:current_assembly a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "current_assembly" ;
    skos:definition "Current genome assembly version" .

base:current_chr a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "current_chr" ;
    skos:definition "Current chromosome" .

base:disease a owl:DatatypeProperty ;
    rdfs:domain base:Disease ;
    rdfs:range xsd:string ;
    rdfs:label "disease" ;
    skos:definition "Disease associated with the data" .

base:disease_PMID a owl:DatatypeProperty ;
    rdfs:domain base:Publication ;
    rdfs:range xsd:string ;
    rdfs:label "disease_PMID" ;
    skos:definition "PubMed ID for disease association" .

base:disease_method a owl:DatatypeProperty ;
    rdfs:domain base:Method ;
    rdfs:range xsd:string ;
    rdfs:label "disease_method" ;
    skos:definition "Method used for disease association" .

base:enh2gene_PMID a owl:DatatypeProperty ;
    rdfs:domain base:Publication ;
    rdfs:range xsd:string ;
    rdfs:label "enh2gene_PMID" ;
    skos:definition "PubMed ID for enhancer to gene associations" .

base:enh2gene_method a owl:DatatypeProperty ;
    rdfs:domain base:Method ;
    rdfs:range xsd:string ;
    rdfs:label "enh2gene_method" ;
    skos:definition "Method used for enhancer to gene associations" .

base:enh_PMID a owl:DatatypeProperty ;
    rdfs:domain base:Publication ;
    rdfs:range xsd:string ;
    rdfs:label "enh_PMID" ;
    skos:definition "PubMed ID for enhancer information" .

base:enh_method a owl:DatatypeProperty ;
    rdfs:domain base:Method ;
    rdfs:range xsd:string ;
    rdfs:label "enh_method" ;
    skos:definition "Method used for enhancer information" .

base:hgnc_symbol_TFs a owl:DatatypeProperty ;
    rdfs:domain base:TranscriptionFactor ;
    rdfs:range xsd:string ;
    rdfs:label "hgnc_symbol_TFs" ;
    skos:definition "HGNC symbol for transcription factors" .

base:hgnc_symbol_target_genes a owl:DatatypeProperty ;
    rdfs:domain base:TargetGene ;
    rdfs:range xsd:string ;
    rdfs:label "hgnc_symbol_target_genes" ;
    skos:definition "HGNC symbol for target genes" .

base:minimum_ratio a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:float ;
    rdfs:label "minimum_ratio" ;
    skos:definition "Minimum ratio value" .

base:mutation_PMID a owl:DatatypeProperty ;
    rdfs:domain base:Publication ;
    rdfs:range xsd:string ;
    rdfs:label "mutation_PMID" ;
    skos:definition "PubMed ID for mutation information" .

base:mutation_method a owl:DatatypeProperty ;
    rdfs:domain base:Method ;
    rdfs:range xsd:string ;
    rdfs:label "mutation_method" ;
    skos:definition "Method used for mutation information" .

base:orig_assembly a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "orig_assembly" ;
    skos:definition "Original genome assembly version" .

base:orig_chr a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "orig_chr" ;
    skos:definition "Original chromosome" .

base:original_ID a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "original_ID" ;
    skos:definition "Original identifier" .

base:refsnp_ID a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "refsnp_ID" ;
    skos:definition "Reference SNP ID" .

base:score a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:float ;
    rdfs:label "score" ;
    skos:definition "Score value" .

base:source a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "source" ;
    skos:definition "Source of the data" .

base:type a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "type" ;
    skos:definition "Type of data" .

base:current_end a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "current_end" ;
    skos:definition "Current end position in the genome" .

base:current_start a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "current_start" ;
    skos:definition "Current start position in the genome" .

base:orig_end a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "orig_end" ;
    skos:definition "Original end position in the genome" .

base:orig_start a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "orig_start" ;
    skos:definition "Original start position in the genome" .

base:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:GenomicCoordinate ;
    rdfs:label "hasGenomicCoordinate" ;
    skos:definition "Associates a genetic element with its genomic coordinate" .

base:hasBiosample a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Biosample ;
    rdfs:label "hasBiosample" ;
    skos:definition "Associates a genetic element with a biosample" .

base:associatedWithDisease a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Disease ;
    rdfs:label "associatedWithDisease" ;
    skos:definition "Associates a genetic element with a disease" .

base:hasPublication a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Publication ;
    rdfs:label "hasPublication" ;
    skos:definition "Associates a genetic element with a publication" .

base:usesMethod a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Method ;
    rdfs:label "usesMethod" ;
    skos:definition "Associates a genetic element with a method" .

base:regulates a owl:ObjectProperty ;
    rdfs:domain base:TranscriptionFactor ;
    rdfs:range base:TargetGene ;
    rdfs:label "regulates" ;
    skos:definition "Associates a transcription factor with a target gene" .

base:hasMutation a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Mutation ;
    rdfs:label "hasMutation" ;
    skos:definition "Associates a genetic element with a mutation" .

base:GeneticElement a owl:Class ;
    rdfs:label "GeneticElement" ;
    skos:definition "A genetic element such as a gene, enhancer, or other regulatory element" .

base:GenomicCoordinate a owl:Class ;
    rdfs:label "GenomicCoordinate" ;
    skos:definition "A genomic coordinate specifying a location in the genome" .

base:Biosample a owl:Class ;
    rdfs:label "Biosample" ;
    skos:definition "A biosample or cell line used in a study" .

base:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:definition "A disease associated with genetic data" .

base:Publication a owl:Class ;
    rdfs:label "Publication" ;
    skos:definition "A publication such as a research paper or article" .

base:Method a owl:Class ;
    rdfs:label "Method" ;
    skos:definition "A method used in a study" .

base:TranscriptionFactor a owl:Class ;
    rdfs:label "TranscriptionFactor" ;
    skos:definition "A transcription factor involved in gene regulation" .

base:TargetGene a owl:Class ;
    rdfs:label "TargetGene" ;
    skos:definition "A target gene regulated by a transcription factor" .

base:Mutation a owl:Class ;
    rdfs:label "Mutation" ;
    skos:definition "A mutation in a genetic element" .

base:Enhancer a owl:Class ;
    rdfs:subClassOf base:GeneticElement ;
    rdfs:label "Enhancer" ;
    skos:definition "An enhancer element that increases the transcription of a gene" .

base:SuperEnhancer a owl:Class ;
    rdfs:subClassOf base:GeneticElement ;
    rdfs:label "SuperEnhancer" ;
    skos:definition "A super enhancer element with a strong effect on gene transcription" .

base:GeneticElement rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:hasGenomicCoordinate ;
    owl:someValuesFrom base:GenomicCoordinate
] .

base:GeneticElement rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:hasBiosample ;
    owl:someValuesFrom base:Biosample
] .

base:GeneticElement rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:associatedWithDisease ;
    owl:someValuesFrom base:Disease
] .

base:GeneticElement rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:hasPublication ;
    owl:someValuesFrom base:Publication
] .

base:GeneticElement rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:usesMethod ;
    owl:someValuesFrom base:Method
] .

base:TranscriptionFactor rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:regulates ;
    owl:someValuesFrom base:TargetGene
] .

base:GeneticElement rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:hasMutation ;
    owl:someValuesFrom base:Mutation
] .