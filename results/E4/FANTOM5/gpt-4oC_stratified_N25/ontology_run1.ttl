@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

base:blockCount a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "blockCount" ;
    skos:definition "Number of blocks in the genomic feature" .

base:chromEnd a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "chromEnd" ;
    skos:definition "End position of the genomic feature on the chromosome" .

base:chromStart a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "chromStart" ;
    skos:definition "Start position of the genomic feature on the chromosome" .

base:score a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "score" ;
    skos:definition "Score associated with the genomic feature" .

base:thickEnd a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "thickEnd" ;
    skos:definition "End position of the thick part of the feature" .

base:thickStart a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "thickStart" ;
    skos:definition "Start position of the thick part of the feature" .

base:blockSizes a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "blockSizes" ;
    skos:definition "Sizes of the blocks" .

base:blockStarts a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "blockStarts" ;
    skos:definition "Start positions of the blocks" .

base:chrom a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "chrom" ;
    skos:definition "Chromosome on which the feature is located" .

base:itemRgb a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "itemRgb" ;
    skos:definition "RGB value for the item" .

base:name a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "name" ;
    skos:definition "Name of the genomic feature" .

base:strand a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "strand" ;
    skos:definition "Strand of the genomic feature" .

base:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:GenomicCoordinate ;
    rdfs:label "hasGenomicCoordinate" ;
    skos:definition "Relates a genomic feature to its genomic coordinate" .

base:hasCellLine a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:CellLine ;
    rdfs:label "hasCellLine" ;
    skos:definition "Relates a genomic feature to a cell line" .

base:hasBiosample a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:Biosample ;
    rdfs:label "hasBiosample" ;
    skos:definition "Relates a genomic feature to a biosample" .

base:targetsGene a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:TargetGene ;
    rdfs:label "targetsGene" ;
    skos:definition "Relates a genomic feature to a target gene" .

base:boundBy a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:TranscriptionFactor ;
    rdfs:label "boundBy" ;
    skos:definition "Relates a genomic feature to a transcription factor" .

base:associatedWith a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:DiseaseAssociation ;
    rdfs:label "associatedWith" ;
    skos:definition "Relates a genomic feature to a disease association" .

base:GenomicFeature a owl:Class ;
    rdfs:label "GenomicFeature" ;
    skos:definition "A feature in the genome" .

base:Enhancer a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "Enhancer" ;
    skos:definition "A genomic feature that enhances transcription" .

base:SuperEnhancer a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "SuperEnhancer" ;
    skos:definition "A large cluster of enhancers that drive high levels of transcription" .

base:CellLine a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "CellLine" ;
    skos:definition "A cell line associated with a genomic feature" .

base:Biosample a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "Biosample" ;
    skos:definition "A biosample associated with a genomic feature" .

base:TargetGene a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "TargetGene" ;
    skos:definition "A gene targeted by a genomic feature" .

base:TranscriptionFactor a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "TranscriptionFactor" ;
    skos:definition "A transcription factor associated with a genomic feature" .

base:DiseaseAssociation a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "DiseaseAssociation" ;
    skos:definition "A disease association related to a genomic feature" .