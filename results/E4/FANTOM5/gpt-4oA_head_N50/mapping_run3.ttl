@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .

<#TriplesMapGeneticElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GeneticElement/{name}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:blockCount;
        rr:objectMap [
            rml:reference "blockCount";
            rr:datatype xsd:float
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:score;
        rr:objectMap [
            rml:reference "score";
            rr:datatype xsd:float
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:blockSizes;
        rr:objectMap [
            rml:reference "blockSizes";
            rr:datatype xsd:string
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:blockStarts;
        rr:objectMap [
            rml:reference "blockStarts";
            rr:datatype xsd:string
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:itemRgb;
        rr:objectMap [
            rml:reference "itemRgb";
            rr:datatype xsd:string
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:name;
        rr:objectMap [
            rml:reference "name";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapGenomicCoordinate> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GenomicCoordinate/{chrom}_{chromStart}_{chromEnd}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:chromEnd;
        rr:objectMap [
            rml:reference "chromEnd";
            rr:datatype xsd:float
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:chromStart;
        rr:objectMap [
            rml:reference "chromStart";
            rr:datatype xsd:float
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:thickEnd;
        rr:objectMap [
            rml:reference "thickEnd";
            rr:datatype xsd:float
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:thickStart;
        rr:objectMap [
            rml:reference "thickStart";
            rr:datatype xsd:float
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:chrom;
        rr:objectMap [
            rml:reference "chrom";
            rr:datatype xsd:string
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:strand;
        rr:objectMap [
            rml:reference "strand";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapGeneticElementToGenomicCoordinate> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GeneticElement/{name}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasGenomicCoordinate;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGenomicCoordinate>;
        ]
    ].

