@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

base:blockCount a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:float ;
    rdfs:label "block count" ;
    skos:definition "Count of blocks" .

base:chromEnd a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:float ;
    rdfs:label "chromosome end" ;
    skos:definition "End position on chromosome" .

base:chromStart a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:float ;
    rdfs:label "chromosome start" ;
    skos:definition "Start position on chromosome" .

base:score a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:float ;
    rdfs:label "score" ;
    skos:definition "Score value" .

base:thickEnd a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:float ;
    rdfs:label "thick end" ;
    skos:definition "Thick end position on chromosome" .

base:thickStart a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:float ;
    rdfs:label "thick start" ;
    skos:definition "Thick start position on chromosome" .

base:blockSizes a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "block sizes" ;
    skos:definition "Sizes of blocks" .

base:blockStarts a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "block starts" ;
    skos:definition "Start positions of blocks" .

base:chrom a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "chromosome" ;
    skos:definition "Chromosome identifier" .

base:itemRgb a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "item RGB" ;
    skos:definition "RGB color value" .

base:name a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "name" ;
    skos:definition "Name identifier" .

base:strand a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "strand" ;
    skos:definition "DNA strand" .

base:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:GenomicCoordinate ;
    rdfs:label "has genomic coordinate" ;
    skos:definition "Associates a genetic element with a genomic coordinate" .

base:associatedWithCellLine a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:CellLine ;
    rdfs:label "associated with cell line" ;
    skos:definition "Associates a genetic element with a cell line" .

base:associatedWithBiosample a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Biosample ;
    rdfs:label "associated with biosample" ;
    skos:definition "Associates a genetic element with a biosample" .

base:targetsGene a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:TargetGene ;
    rdfs:label "targets gene" ;
    skos:definition "Associates a genetic element with a target gene" .

base:boundByTranscriptionFactor a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:TranscriptionFactor ;
    rdfs:label "bound by transcription factor" ;
    skos:definition "Associates a genetic element with a transcription factor" .

base:associatedWithDisease a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Disease ;
    rdfs:label "associated with disease" ;
    skos:definition "Associates a genetic element with a disease" .

base:GeneticElement a owl:Class ;
    rdfs:label "Genetic Element" ;
    skos:definition "A genetic element" ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty base:hasGenomicCoordinate ;
        owl:someValuesFrom base:GenomicCoordinate
    ], [
        a owl:Restriction ;
        owl:onProperty base:associatedWithCellLine ;
        owl:someValuesFrom base:CellLine
    ], [
        a owl:Restriction ;
        owl:onProperty base:associatedWithBiosample ;
        owl:someValuesFrom base:Biosample
    ], [
        a owl:Restriction ;
        owl:onProperty base:targetsGene ;
        owl:someValuesFrom base:TargetGene
    ], [
        a owl:Restriction ;
        owl:onProperty base:boundByTranscriptionFactor ;
        owl:someValuesFrom base:TranscriptionFactor
    ], [
        a owl:Restriction ;
        owl:onProperty base:associatedWithDisease ;
        owl:someValuesFrom base:Disease
    ] .

base:GenomicCoordinate a owl:Class ;
    rdfs:label "Genomic Coordinate" ;
    skos:definition "A genomic coordinate" .

base:CellLine a owl:Class ;
    rdfs:label "Cell Line" ;
    skos:definition "A cell line" .

base:Biosample a owl:Class ;
    rdfs:label "Biosample" ;
    skos:definition "A biosample" .

base:TargetGene a owl:Class ;
    rdfs:label "Target Gene" ;
    skos:definition "A target gene" .

base:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:definition "A transcription factor" .

base:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:definition "A disease" .

base:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:definition "An enhancer" ;
    rdfs:subClassOf base:GeneticElement .

base:SuperEnhancer a owl:Class ;
    rdfs:label "Super Enhancer" ;
    skos:definition "A super enhancer" ;
    rdfs:subClassOf base:GeneticElement .