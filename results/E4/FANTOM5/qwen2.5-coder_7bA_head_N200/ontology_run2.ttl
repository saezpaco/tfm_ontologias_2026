@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix greg: <https://genetic_regulatory_elements.com#> .

owl:DatatypeProperty pmidValue rdf:type owl:DatatypeProperty ;
    rdfs:label "PubMed ID" ;
    rdfs:comment "The PubMed ID associated with a genetic regulatory element." ;
    rdfs:domain greg:PubMedArticle ;
    rdfs:range xsd:string .

owl:DatatypeProperty methodType rdf:type owl:DatatypeProperty ;
    rdfs:label "Method Type" ;
    rdfs:comment "The type of method used in the study of a genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty hgncSymbol rdf:type owl:DatatypeProperty ;
    rdfs:label "HGNC Symbol" ;
    rdfs:comment "The HGNC symbol of a genetic regulatory element." ;
    rdfs:domain greg:TranscriptionFactor, greg:TargetGene, greg:Disease, greg:CellLine, greg:Mutation, greg:Chromosome, greg:ClusterRegionModule, greg:AssemblyVersion, greg:PubMedArticle, greg:GeneticRegulatoryElement, greg:EnhancerToGeneInteraction, greg:TranscriptionFactorToEnhancerInteraction ;
    rdfs:range xsd:string .

owl:DatatypeProperty scoreValue rdf:type owl:DatatypeProperty ;
    rdfs:label "Score Value" ;
    rdfs:comment "The score value associated with a genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:float .

owl:DatatypeProperty ratioValue rdf:type owl:DatatypeProperty ;
    rdfs:label "Ratio Value" ;
    rdfs:comment "The ratio value associated with a genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:float .

owl:DatatypeProperty chromosomeNumber rdf:type owl:DatatypeProperty ;
    rdfs:label "Chromosome Number" ;
    rdfs:comment "The chromosome number associated with a genetic regulatory element." ;
    rdfs:domain greg:Chromosome ;
    rdfs:range xsd:int .

owl:DatatypeProperty startPosition rdf:type owl:DatatypeProperty ;
    rdfs:label "Start Position" ;
    rdfs:comment "The start position of a genetic regulatory element in the assembly." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:DatatypeProperty endPosition rdf:type owl:DatatypeProperty ;
    rdfs:label "End Position" ;
    rdfs:comment "The end position of a genetic regulatory element in the assembly." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:ObjectProperty hasTranscriptionFactor rdf:type owl:ObjectProperty ;
    rdfs:label "Has Transcription Factor" ;
    rdfs:comment "The transcription factor involved in a transcription factor to enhancer interaction." ;
    rdfs:domain greg:TranscriptionFactorToEnhancerInteraction ;
    rdfs:range greg:TranscriptionFactor .

owl:ObjectProperty hasEnhancer rdf:type owl:ObjectProperty ;
    rdfs:label "Has Enhancer" ;
    rdfs:comment "The enhancer involved in a transcription factor to enhancer interaction." ;
    rdfs:domain greg:TranscriptionFactorToEnhancerInteraction ;
    rdfs:range greg:Enhancer .

owl:ObjectProperty hasTargetGene rdf:type owl:ObjectProperty ;
    rdfs:label "Has Target Gene" ;
    rdfs:comment "The target gene involved in an enhancer to gene interaction." ;
    rdfs:domain greg:EnhancerToGeneInteraction ;
    rdfs:range greg:TargetGene .

owl:ObjectProperty associatedWithDisease rdf:type owl:ObjectProperty ;
    rdfs:label "Associated With Disease" ;
    rdfs:comment "The disease associated with a genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range greg:Disease .

owl:ObjectProperty occursInCellLine rdf:type owl:ObjectProperty ;
    rdfs:label "Occurs In Cell Line" ;
    rdfs:comment "The cell line in which a genetic regulatory element occurs." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range greg:CellLine .

owl:ObjectProperty involvesMutation rdf:type owl:ObjectProperty ;
    rdfs:label "Involves Mutation" ;
    rdfs:comment "The mutation involved in a genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range greg:Mutation .

owl:ObjectProperty publishedInArticle rdf:type owl:ObjectProperty ;
    rdfs:label "Published In Article" ;
    rdfs:comment "The article in which a genetic regulatory element is published." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range greg:PubMedArticle .

owl:ObjectProperty hasAssemblyVersion rdf:type owl:ObjectProperty ;
    rdfs:label "Has Assembly Version" ;
    rdfs:comment "The assembly version associated with a genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range greg:AssemblyVersion .

owl:ObjectProperty locatedOnChromosome rdf:type owl:ObjectProperty ;
    rdfs:label "Located On Chromosome" ;
    rdfs:comment "The chromosome on which a genetic regulatory element is located." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range greg:Chromosome .

owl:Class GeneticRegulatoryElement rdf:type owl:Class ;
    rdfs:label "Genetic Regulatory Element" ;
    rdfs:comment "A general class representing a genetic regulatory element." ;
    rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf greg:TranscriptionFactorToEnhancerInteraction ;
    rdfs:subClassOf greg:EnhancerToGeneInteraction .

owl:Class TranscriptionFactor rdf:type owl:Class ;
    rdfs:label "Transcription Factor" ;
    rdfs:comment "A class representing a transcription factor." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class Enhancer rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "A class representing an enhancer." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class SuperEnhancer rdf:type owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:comment "A class representing a super enhancer." ;
    rdfs:subClassOf greg:Enhancer ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf greg:Enhancer ] .

owl:Class TargetGene rdf:type owl:Class ;
    rdfs:label "Target Gene" ;
    rdfs:comment "A class representing a target gene." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class Disease rdf:type owl:Class ;
    rdfs:label "Disease" ;
    rdfs:comment "A class representing a disease." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class CellLine rdf:type owl:Class ;
    rdfs:label "Cell Line" ;
    rdfs:comment "A class representing a cell line." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class Mutation rdf:type owl:Class ;
    rdfs:label "Mutation" ;
    rdfs:comment "A class representing a mutation." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class PubMedArticle rdf:type owl:Class ;
    rdfs:label "PubMed Article" ;
    rdfs:comment "A class representing a PubMed article." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class AssemblyVersion rdf:type owl:Class ;
    rdfs:label "Assembly Version" ;
    rdfs:comment "A class representing an assembly version." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class Chromosome rdf:type owl:Class ;
    rdfs:label "Chromosome" ;
    rdfs:comment "A class representing a chromosome." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class ClusterRegionModule rdf:type owl:Class ;
    rdfs:label "Cluster Region Module" ;
    rdfs:comment "A class representing a cluster region module." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .