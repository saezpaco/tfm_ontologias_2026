<#TriplesMapGeneticRegulatoryElementProperties> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:predicateObjectMap [
        rr:predicate greg:pmid;
        rr:objectMap [
            rr:template "{{pmid}}";
        ]
    ].
