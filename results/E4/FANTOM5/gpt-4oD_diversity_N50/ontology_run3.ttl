@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

base:chromEnd a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:double ;
    rdfs:label "chromEnd" ;
    skos:definition "End position of the genomic feature on the chromosome" .

base:chromStart a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:double ;
    rdfs:label "chromStart" ;
    skos:definition "Start position of the genomic feature on the chromosome" .

base:score a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:double ;
    rdfs:label "score" ;
    skos:definition "Score associated with the genomic feature" .

base:thickEnd a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:double ;
    rdfs:label "thickEnd" ;
    skos:definition "End position of the thick part of the feature" .

base:thickStart a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:double ;
    rdfs:label "thickStart" ;
    skos:definition "Start position of the thick part of the feature" .

base:itemRgb a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "itemRgb" ;
    skos:definition "RGB value for the feature" .

base:name a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "name" ;
    skos:definition "Name of the feature" .

base:hasChromosome a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:Chromosome ;
    rdfs:label "hasChromosome" ;
    skos:definition "Chromosome on which the feature is located" .

base:hasBlockCount a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:BlockCount ;
    rdfs:label "hasBlockCount" ;
    skos:definition "Number of blocks in the genomic feature" .

base:hasBlockSizes a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:BlockSizes ;
    rdfs:label "hasBlockSizes" ;
    skos:definition "Sizes of the blocks in the feature" .

base:hasBlockStarts a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:BlockStarts ;
    rdfs:label "hasBlockStarts" ;
    skos:definition "Start positions of the blocks in the feature" .

base:hasStrand a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:Strand ;
    rdfs:label "hasStrand" ;
    skos:definition "Strand of the feature" .

base:GenomicFeature a owl:Class ;
    rdfs:label "GenomicFeature" ;
    skos:definition "A feature located on a genome" ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty base:chromEnd ;
        owl:allValuesFrom xsd:double
    ], [
        a owl:Restriction ;
        owl:onProperty base:chromStart ;
        owl:allValuesFrom xsd:double
    ], [
        a owl:Restriction ;
        owl:onProperty base:score ;
        owl:allValuesFrom xsd:double
    ], [
        a owl:Restriction ;
        owl:onProperty base:thickEnd ;
        owl:allValuesFrom xsd:double
    ], [
        a owl:Restriction ;
        owl:onProperty base:thickStart ;
        owl:allValuesFrom xsd:double
    ], [
        a owl:Restriction ;
        owl:onProperty base:itemRgb ;
        owl:allValuesFrom xsd:string
    ], [
        a owl:Restriction ;
        owl:onProperty base:name ;
        owl:allValuesFrom xsd:string
    ], [
        a owl:Restriction ;
        owl:onProperty base:hasChromosome ;
        owl:allValuesFrom base:Chromosome
    ], [
        a owl:Restriction ;
        owl:onProperty base:hasBlockCount ;
        owl:allValuesFrom base:BlockCount
    ], [
        a owl:Restriction ;
        owl:onProperty base:hasBlockSizes ;
        owl:allValuesFrom base:BlockSizes
    ], [
        a owl:Restriction ;
        owl:onProperty base:hasBlockStarts ;
        owl:allValuesFrom base:BlockStarts
    ], [
        a owl:Restriction ;
        owl:onProperty base:hasStrand ;
        owl:allValuesFrom base:Strand
    ] .

base:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    skos:definition "A subclass of GenomicFeature representing an enhancer" ;
    rdfs:subClassOf base:GenomicFeature .

base:SuperEnhancer a owl:Class ;
    rdfs:label "SuperEnhancer" ;
    skos:definition "A subclass of GenomicFeature representing a super enhancer" ;
    rdfs:subClassOf base:GenomicFeature .

base:Chromosome a owl:Class ;
    rdfs:label "Chromosome" ;
    skos:definition "A chromosome on which a genomic feature is located" .

base:BlockCount a owl:Class ;
    rdfs:label "BlockCount" ;
    skos:definition "Number of blocks in the genomic feature" .

base:BlockSizes a owl:Class ;
    rdfs:label "BlockSizes" ;
    skos:definition "Sizes of the blocks in the feature" .

base:BlockStarts a owl:Class ;
    rdfs:label "BlockStarts" ;
    skos:definition "Start positions of the blocks in the feature" .

base:Strand a owl:Class ;
    rdfs:label "Strand" ;
    skos:definition "Strand of the feature" .