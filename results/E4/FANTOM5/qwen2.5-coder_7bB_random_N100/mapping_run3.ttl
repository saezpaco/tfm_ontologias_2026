```ttl
<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{TFs2enh_PMID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPMID>;
        ]
    ],
    [
        rr:predicate genreg:method;
        rr:objectMap [
            rr:constant "TFs2enh_method";
        ]
    ],
    [
        rr:predicate genreg:chromosomeNumber;
        rr:objectMap [
            rr:constant "current_chr";
        ]
    ],
    [
        rr:predicate genreg:scoreValue;
        rr:objectMap [
            rr:constant "score";
        ]
    ],
    [
        rr:predicate genreg:assemblyVersion;
        rr:objectMap [
            rr:constant "current_assembly";
        ]
    ],
    [
        rr:predicate genreg:hgncSymbol;
        rr:objectMap [
            rr:constant "hgnc_symbol_TFs";
        ]
    ],
    [
        rr:predicate genreg:startPosition;
        rr:objectMap [
            rr:constant "current_start";
        ]
    ],
    [
        rr:predicate genreg:endPosition;
        rr:objectMap [
            rr:constant "current_end";
        ]
    ].

