@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

base:blockCount a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "blockCount" ;
    skos:definition "Number of blocks in the genomic feature" .

base:chromEnd a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "chromEnd" ;
    skos:definition "End position of the genomic feature on the chromosome" .

base:chromStart a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "chromStart" ;
    skos:definition "Start position of the genomic feature on the chromosome" .

base:score a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "score" ;
    skos:definition "Score associated with the genomic feature" .

base:thickEnd a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "thickEnd" ;
    skos:definition "End position of the thick part of the feature" .

base:thickStart a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:integer ;
    rdfs:label "thickStart" ;
    skos:definition "Start position of the thick part of the feature" .

base:blockSizes a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "blockSizes" ;
    skos:definition "Sizes of the blocks" .

base:blockStarts a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "blockStarts" ;
    skos:definition "Start positions of the blocks" .

base:chrom a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "chrom" ;
    skos:definition "Chromosome on which the feature is located" .

base:itemRgb a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "itemRgb" ;
    skos:definition "RGB value for the item" .

base:name a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "name" ;
    skos:definition "Name of the genomic feature" .

base:strand a owl:DatatypeProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "strand" ;
    skos:definition "Strand of the genomic feature" .

base:hasChromosome a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:Chromosome ;
    rdfs:label "hasChromosome" ;
    skos:definition "Associates a genomic feature with a chromosome" .

base:hasBlock a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:Block ;
    rdfs:label "hasBlock" ;
    skos:definition "Associates a genomic feature with a block" .

base:hasScore a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:Score ;
    rdfs:label "hasScore" ;
    skos:definition "Associates a genomic feature with a score" .

base:hasThickRegion a owl:ObjectProperty ;
    rdfs:domain base:GenomicFeature ;
    rdfs:range base:ThickRegion ;
    rdfs:label "hasThickRegion" ;
    skos:definition "Associates a genomic feature with a thick region" .

base:GenomicFeature a owl:Class ;
    rdfs:label "GenomicFeature" ;
    skos:definition "A feature on the genome" .

base:Enhancer a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "Enhancer" ;
    skos:definition "A subclass of GenomicFeature representing an enhancer" .

base:SuperEnhancer a owl:Class ;
    rdfs:subClassOf base:GenomicFeature ;
    rdfs:label "SuperEnhancer" ;
    skos:definition "A subclass of GenomicFeature representing a super enhancer" .

base:Chromosome a owl:Class ;
    rdfs:label "Chromosome" ;
    skos:definition "A chromosome on which genomic features are located" .

base:Block a owl:Class ;
    rdfs:label "Block" ;
    skos:definition "A block within a genomic feature" .

base:Score a owl:Class ;
    rdfs:label "Score" ;
    skos:definition "A score associated with a genomic feature" .

base:ThickRegion a owl:Class ;
    rdfs:label "ThickRegion" ;
    skos:definition "A thick region within a genomic feature" .

base:GenomicFeature rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:hasChromosome ;
    owl:someValuesFrom base:Chromosome
], [
    a owl:Restriction ;
    owl:onProperty base:hasBlock ;
    owl:someValuesFrom base:Block
], [
    a owl:Restriction ;
    owl:onProperty base:hasScore ;
    owl:someValuesFrom base:Score
], [
    a owl:Restriction ;
    owl:onProperty base:hasThickRegion ;
    owl:someValuesFrom base:ThickRegion
] .