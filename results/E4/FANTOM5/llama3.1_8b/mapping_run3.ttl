<#TriplesMapClassEntity5> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "EntityURI/{{class_entity}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate base_ontology:associated_with_transcription_factor;
        rr:objectMap [
