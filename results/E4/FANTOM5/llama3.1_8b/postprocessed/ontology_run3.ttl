@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix base_ontology: <https://base_ontology.com#> .

<owl:Ontology rdf:about="https://base_ontology.com/base_ontology">

  <!-- Classes -->
  <owl:Class rdf:ID="class_entity">
    <rdfs:label>Entity</rdfs:label>
    <rdfs:comment>A general class for entities.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>

  <owl:Class rdf:ID="entity_name">
    <rdfs:label>Entity Name</rdfs:label>
    <rdfs:comment>A subclass of Entity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#class_entity"/>
  </owl:Class>

  <!-- Object Properties -->
  <owl:ObjectProperty rdf:ID="associated_with">
    <rdfs:label>Associated With</rdfs:label>
    <rdfs:comment>An object property for associating entities with biosamples.</rdfs:comment>
    <rdfs:domain rdf:resource="#class_entity"/>
    <rdfs:range rdf:resource="#biosample"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="has_PMID">
    <rdfs:label>Has PubMed ID</rdfs:label>
    <rdfs:comment>An object property for associating entities with PubMed IDs.</rdfs:comment>
    <rdfs:domain rdf:resource="#class_entity"/>
    <rdfs:range rdf:resource="#TFs2enh_PMID"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="has_method">
    <rdfs:label>Has Method</rdfs:label>
    <rdfs:comment>An object property for associating entities with methods.</rdfs:comment>
    <rdfs:domain rdf:resource="#class_entity"/>
    <rdfs:range rdf:resource="#TFs2enh_method"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="has_disease_PMID">
    <rdfs:label>Has Disease PubMed ID</rdfs:label>
    <rdfs:comment>An object property for associating entities with disease PubMed IDs.</rdfs:comment>
    <rdfs:domain rdf:resource="#class_entity"/>
    <rdfs:range rdf:resource="#disease_PMID"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="has_disease_method">
    <rdfs:label>Has Disease Method</rdfs:label>
    <rdfs:comment>An object property for associating entities with disease methods.</rdfs:comment>
    <rdfs:domain rdf:resource="#class_entity"/>
    <rdfs:range rdf:resource="#disease_method"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="has_enhancer_PMID">
    <rdfs:label>Has Enhancer PubMed ID</rdfs:label>
    <rdfs:comment>An object property for associating entities with enhancer PubMed IDs.</rdfs:comment>
    <rdfs:domain rdf:resource="#class_entity"/>
    <rdfs:range rdf:resource="#enh_PMID"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="has_enhancer_method">
    <rdfs:label>Has Enhancer Method</rdfs:label>
    <rdfs:comment>An object property for associating entities with enhancer methods.</rdfs:comment>
    <rdfs:domain rdf:resource="#class_entity"/>
    <rdfs:range rdf:resource="#enh_method"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="targets_gene">
    <rdfs:label>Targets Gene</rdfs:label>
    <rdfs:comment>An object property for associating entities with target genes.</rdfs:comment>
    <rdfs:domain rdf:resource="#class_entity"/>
    <rdfs:range rdf:resource="#hgnc_symbol_target_genes"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="associated_with_transcription_factor">
    <rdfs:label>Associated With Transcription Factor</rdfs:label>
    <rdfs:comment>An object property for associating entities with transcription factors.</rdfs:comment>
    <rdfs:domain rdf:resource="#class_entity"/>
    <rdfs:range rdf:resource="#hgnc_symbol_TFs"/>
  </owl:ObjectProperty>

  <!-- Data Properties -->
  <owl:DatatypeProperty rdf:ID="has_PMID_value">
    <rdfs:label>Has PubMed ID Value</rdfs:label>
    <rdfs:comment>A data property for associating entities with PubMed IDs.</rdfs:comment>
    <rdfs:domain rdf:resource="#TFs2enh_PMID"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="has_method_value">
    <rdfs:label>Has Method Value</rdfs:label>
    <rdfs:comment>A data property for associating entities with methods.</rdfs:comment>
    <rdfs:domain rdf:resource="#TFs2enh_method"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="has_disease_PMID_value">
    <rdfs:label>Has Disease PubMed ID Value</rdfs:label>
    <rdfs:comment>A data property for associating entities with disease PubMed IDs.</rdfs:comment>
    <rdfs:domain rdf:resource="#disease_PMID"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="has_disease_method_value">
    <rdfs:label>Has Disease Method Value</rdfs:label>
    <rdfs:comment>A data property for associating entities with disease methods.</rdfs:comment>
    <rdfs:domain rdf:resource="#disease_method"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="has_enhancer_PMID_value">
    <rdfs:label>Has Enhancer PubMed ID Value</rdfs:label>
    <rdfs:comment>A data property for associating entities with enhancer PubMed IDs.</rdfs:comment>
    <rdfs:domain rdf:resource="#enh_PMID"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="has_enhancer_method_value">
    <rdfs:label>Has Enhancer Method Value</rdfs:label>
    <rdfs:comment>A data property for associating entities with enhancer methods.</rdfs:comment>
    <rdfs:domain rdf:resource="#enh_method"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="targets_gene_value">
    <rdfs:label>Targets Gene Value</rdfs:label>
    <rdfs:comment>A data property for associating entities with target genes.</rdfs:comment>
    <rdfs:domain rdf:resource="#hgnc_symbol_target_genes"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="associated_with_transcription_factor_value">
    <rdfs:label>Associated With Transcription Factor Value</rdfs:label>
    <rdfs:comment>A data property for associating entities with transcription factors.</rdfs:comment>
    <rdfs:domain rdf:resource="#hgnc_symbol_TFs"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

</owl:Ontology>