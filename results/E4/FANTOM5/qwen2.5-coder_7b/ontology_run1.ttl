@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gr: <https://genetic_regulatory_elements.com#> .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasPubMedID" ;
    rdfs:comment "The PubMed ID associated with a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasMethod" ;
    rdfs:comment "The method used in a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasMethod ;
        owl:someValuesFrom xsd:string
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasAssembly" ;
    rdfs:comment "The genome assembly associated with a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasAssembly ;
        owl:someValuesFrom xsd:string
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasChromosome" ;
    rdfs:comment "The chromosome number associated with a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasChromosome ;
        owl:someValuesFrom xsd:int
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasScore" ;
    rdfs:comment "The score associated with a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasScore ;
        owl:someValuesFrom xsd:float
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasRatio" ;
    rdfs:comment "The ratio associated with a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasRatio ;
        owl:someValuesFrom xsd:float
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasStartPosition" ;
    rdfs:comment "The start position of a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasStartPosition ;
        owl:someValuesFrom xsd:int
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasEndPosition" ;
    rdfs:comment "The end position of a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasEndPosition ;
        owl:someValuesFrom xsd:int
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "hasTranscriptionFactor" ;
    rdfs:comment "The transcription factor associated with a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasTranscriptionFactor ;
        owl:someValuesFrom gr:TranscriptionFactor
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "hasEnhancer" ;
    rdfs:comment "The enhancer associated with a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasEnhancer ;
        owl:someValuesFrom gr:Enhancer
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "hasTargetGene" ;
    rdfs:comment "The target gene associated with an enhancer." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasTargetGene ;
        owl:someValuesFrom gr:TargetGene
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "associatedWithDisease" ;
    rdfs:comment "The disease associated with a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:associatedWithDisease ;
        owl:someValuesFrom gr:Disease
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "occursInCellLineOrBiosample" ;
    rdfs:comment "The cell line or biosample in which a genetic regulatory element occurs." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:occursInCellLineOrBiosample ;
        owl:someValuesFrom gr:CellLineOrBiosample
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "involvesMutation" ;
    rdfs:comment "The mutation involved in a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:involvesMutation ;
        owl:someValuesFrom gr:Mutation
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "GeneticRegulatoryElement" ;
    rdfs:comment "A genetic regulatory element, such as an enhancer or super-enhancer." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasScore ;
        owl:someValuesFrom xsd:float
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "TranscriptionFactor" ;
    rdfs:comment "A transcription factor involved in a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "An enhancer, a type of genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "SuperEnhancer" ;
    rdfs:comment "A super-enhancer, a type of genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "TargetGene" ;
    rdfs:comment "A target gene associated with an enhancer." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "Disease" ;
    rdfs:comment "A disease associated with a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "CellLineOrBiosample" ;
    rdfs:comment "A cell line or biosample in which a genetic regulatory element occurs." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "Mutation" ;
    rdfs:comment "A mutation involved in a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty gr:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "TranscriptionFactorToEnhancerRelationship" ;
    rdfs:comment "A relationship between a transcription factor and an enhancer." ;
    rdfs:subClassOf gr:GeneticRegulatoryElement .

owl:Class rdf:type owl:Class ;
    rdfs:label "EnhancerToGeneRelationship" ;
    rdfs:comment "A relationship between an enhancer and a target gene." ;
    rdfs:subClassOf gr:GeneticRegulatoryElement .