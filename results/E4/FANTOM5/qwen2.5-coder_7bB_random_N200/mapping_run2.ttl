```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix greg: <https://genetic_regulatory_elements.com#> .

<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "FANTOM5.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:GeneticRegulatoryElement/{{FAIR_URI}}";
    ];
    rr:predicateObjectMap [
        rr:predicate greg:pmid;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPMID>;
        ]
    ],
    [
        rr:predicate greg:method;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapMethod>;
        ]
    ],
    [
        rr:predicate greg:chromosomeNumber;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapChromosomeNumber>;
        ]
    ],
    [
        rr:predicate greg:scoreValue;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapScoreValue>;
        ]
    ],
    [
        rr:predicate greg:assemblyVersion;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapAssemblyVersion>;
        ]
    ],
    [
        rr:predicate greg:hgncSymbol;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapHGNCsymbol>;
        ]
    ],
    [
        rr:predicate greg:startPosition;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapStartPosition>;
        ]
    ],
    [
        rr:predicate greg:endPosition;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapEndPosition>;
        ]
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
