@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ge: <https://genetic_regulatory_elements.com#> .

ge:GenomicCoordinates a owl:Class ;
    rdfs:label "Genomic Coordinates" ;
    rdfs:comment "Represents the genomic coordinates of an element." ;
    rdfs:subClassOf ge:GeneticElement ;
    owl:equivalentClass [ rdf:type owl:Class ; 
        owl:intersectionOf (ge:GeneticElement
            [ owl:onProperty ge:startPosition ; owl:someValuesFrom xsd:int ] )
    ] .

ge:Enhancer a owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "Represents an enhancer element." ;
    rdfs:subClassOf ge:GeneticElement ;
    owl:equivalentClass [ rdf:type owl:Class ; 
        owl:intersectionOf (ge:GeneticElement
            [ owl:onProperty ge:startPosition ; owl:someValuesFrom xsd:int ] )
    ] .

ge:SuperEnhancer a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:comment "Represents a super-enhancer element." ;
    rdfs:subClassOf ge:GeneticElement ;
    owl:equivalentClass [ rdf:type owl:Class ; 
        owl:intersectionOf (ge:GeneticElement
            [ owl:onProperty ge:startPosition ; owl:someValuesFrom xsd:int ] )
    ] .

ge:CellLine a owl:Class ;
    rdfs:label "Cell Line" ;
    rdfs:comment "Represents a cell line or biosample." ;
    rdfs:subClassOf ge:GeneticElement ;
    owl:equivalentClass [ rdf:type owl:Class ; 
        owl:intersectionOf (ge:GeneticElement
            [ owl:onProperty ge:startPosition ; owl:someValuesFrom xsd:int ] )
    ] .

ge:TargetGene a owl:Class ;
    rdfs:label "Target Gene" ;
    rdfs:comment "Represents a target gene." ;
    rdfs:subClassOf ge:GeneticElement ;
    owl:equivalentClass [ rdf:type owl:Class ; 
        owl:intersectionOf (ge:GeneticElement
            [ owl:onProperty ge:startPosition ; owl:someValuesFrom xsd:int ] )
    ] .

ge:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    rdfs:comment "Represents a transcription factor." ;
    rdfs:subClassOf ge:GeneticElement ;
    owl:equivalentClass [ rdf:type owl:Class ; 
        owl:intersectionOf (ge:GeneticElement
            [ owl:onProperty ge:startPosition ; owl:someValuesFrom xsd:int ] )
    ] .

ge:DiseaseAssociation a owl:Class ;
    rdfs:label "Disease Association" ;
    rdfs:comment "Represents a disease association." ;
    rdfs:subClassOf ge:GeneticElement ;
    owl:equivalentClass [ rdf:type owl:Class ; 
        owl:intersectionOf (ge:GeneticElement
            [ owl:onProperty ge:startPosition ; owl:someValuesFrom xsd:int ] )
    ] .

ge:hasGenomicCoordinates a owl:ObjectProperty ;
    rdfs:label "Has Genomic Coordinates" ;
    rdfs:comment "Indicates the genomic coordinates of an element." ;
    rdfs:domain ge:GeneticElement ;
    rdfs:range ge:GenomicCoordinates ;

ge:associatedWithCellLine a owl:ObjectProperty ;
    rdfs:label "Associated With Cell Line" ;
    rdfs:comment "Indicates the cell line or biosample associated with an element." ;
    rdfs:domain ge:GeneticElement ;
    rdfs:range ge:CellLine ;

ge:targetsGene a owl:ObjectProperty ;
    rdfs:label "Targets Gene" ;
    rdfs:comment "Indicates the target gene of an enhancer or super-enhancer." ;
    rdfs:domain ge:Enhancer , ge:SuperEnhancer ;
    rdfs:range ge:TargetGene ;

ge:regulatedByTranscriptionFactor a owl:ObjectProperty ;
    rdfs:label "Regulated By Transcription Factor" ;
    rdfs:comment "Indicates the transcription factor regulating an enhancer or super-enhancer." ;
    rdfs:domain ge:Enhancer , ge:SuperEnhancer ;
    rdfs:range ge:TranscriptionFactor ;

ge:associatedWithDisease a owl:ObjectProperty ;
    rdfs:label "Associated With Disease" ;
    rdfs:comment "Indicates the disease associated with an element." ;
    rdfs:domain ge:GeneticElement ;
    rdfs:range ge:DiseaseAssociation ;

ge:rankValue a owl:DatatypeProperty ;
    rdfs:label "Rank Value" ;
    rdfs:comment "Represents the rank value of an enhancer or super-enhancer." ;
    rdfs:domain ge:Enhancer , ge:SuperEnhancer ;
    rdfs:range xsd:int ;
    skos:definition "An integer representing the rank of the enhancer or super-enhancer, ranging from 20 to 1079." ;

ge:startPosition a owl:DatatypeProperty ;
    rdfs:label "Start Position" ;
    rdfs:comment "Represents the genomic start position of an element." ;
    rdfs:domain ge:GenomicCoordinates ;
    rdfs:range xsd:int ;
    skos:definition "An integer representing the genomic start position, ranging from 1,088,778 to 235,489,531." ;

ge:stopPosition a owl:DatatypeProperty ;
    rdfs:label "Stop Position" ;
    rdfs:comment "Represents the genomic stop position of an element." ;
    rdfs:domain ge:GenomicCoordinates ;
    rdfs:range xsd:int ;
    skos:definition "An integer representing the genomic stop position, ranging from 1,110,655 to 235,500,911." .