@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix ql: <http://www.w3.org/TR/2011/PR-rdf-sparql-json-20111206#>.
@prefix ex: <http://example.org/ontology#>.

<#TriplesMapClassEntity> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "EntityURI/{{Entity}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate ex:class;
        rr:objectMap [
            rr:constant <http://example.org/ontology#class_entity>
        ]
    ].

<#TriplesMapClassEntityName> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "EntityURI/{{Entity}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate ex:name;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapClassEntity>;
            rr:joinCondition [
                rr:child <ex:class>;
                rr:parent <ex:name>
            ]
        ]
    ].

