```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix greg: <https://genetic_regulatory_elements.com#> .

<#TriplesMapGeneticElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:GeneticElement/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate greg:hasPubMedID;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPubMedID>;
        ]
    ],
    [
        rr:predicate greg:hasMethod;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapMethod>;
        ]
    ],
    [
        rr:predicate greg:hasChromosomeNumber;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapChromosomeNumber>;
        ]
    ],
    [
        rr:predicate greg:hasScore;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapScore>;
        ]
    ],
    [
        rr:predicate greg:hasStartPosition;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapStartPosition>;
        ]
    ],
    [
        rr:predicate greg:hasEndPosition;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapEndPosition>;
        ]
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:TranscriptionFactor/{{hgnc_symbol_TFs}}{FAIR_URI}";
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:Enhancer/{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapSuperEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:SuperEnhancer/{{original_ID}}{FAIR_URI}";
    ].

