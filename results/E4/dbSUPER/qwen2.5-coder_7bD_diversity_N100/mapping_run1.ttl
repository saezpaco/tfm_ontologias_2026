    ];
    rr:subjectMap [
        rr:template "greg:CellLineOrBiosample/{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapMutation> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:Mutation/{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapChromatinRegulatoryModule> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:ChromatinRegulatoryModule/{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapTranscriptionFactorToEnhancerInteraction> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:TranscriptionFactorToEnhancerInteraction/{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapEnhancerToGeneInteraction> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:EnhancerToGeneInteraction/{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapPubMedID> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:predicateObjectMap [
        rr:predicate greg:hasPubMedID;
        rr:objectMap [
            rr:template "{{TF_EID}}";
        ]
    ].

<#TriplesMapMethod> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
