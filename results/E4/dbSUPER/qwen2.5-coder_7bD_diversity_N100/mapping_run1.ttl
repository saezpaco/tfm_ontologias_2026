    ];
    rr:predicateObjectMap [
        rr:predicate greg:hasChromosomeNumber;
        rr:objectMap [
            rr:template "{{TF_EID}}";
        ]
    ].

<#TriplesMapScore> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:predicateObjectMap [
        rr:predicate greg:hasScore;
        rr:objectMap [
            rr:template "{{TF_EID}}";
        ]
    ].

<#TriplesMapStartPosition> a rr:TriplesMap;
