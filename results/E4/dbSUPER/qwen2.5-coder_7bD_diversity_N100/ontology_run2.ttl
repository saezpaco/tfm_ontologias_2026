@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix greg: <https://genetic_regulatory_elements.com#> .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasPubMedID" ;
    rdfs:comment "The PubMed ID associated with the genetic element." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasMethod" ;
    rdfs:comment "The method used in the genetic element study." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasMethod ;
        owl:someValuesFrom xsd:string ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasHGNCsymbol" ;
    rdfs:comment "The HGNC symbol of the genetic element." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasHGNCsymbol ;
        owl:someValuesFrom xsd:string ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasChromosomeNumber" ;
    rdfs:comment "The chromosome number of the genetic element." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasChromosomeNumber ;
        owl:someValuesFrom xsd:string ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasScore" ;
    rdfs:comment "The score associated with the genetic element." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasScore ;
        owl:someValuesFrom xsd:float ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasStartPosition" ;
    rdfs:comment "The start position of the genetic element." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasStartPosition ;
        owl:someValuesFrom xsd:int ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasEndPosition" ;
    rdfs:comment "The end position of the genetic element." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasEndPosition ;
        owl:someValuesFrom xsd:int ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "hasTranscriptionFactor" ;
    rdfs:comment "The transcription factor associated with the genetic element." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasTranscriptionFactor ;
        owl:someValuesFrom greg:TranscriptionFactor ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "hasEnhancer" ;
    rdfs:comment "The enhancer associated with the genetic element." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasEnhancer ;
        owl:someValuesFrom greg:Enhancer ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "hasTargetGene" ;
    rdfs:comment "The target gene associated with the genetic element." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasTargetGene ;
        owl:someValuesFrom greg:TargetGene ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "associatedWithDisease" ;
    rdfs:comment "The disease associated with the genetic element." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:associatedWithDisease ;
        owl:someValuesFrom greg:Disease ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "occursInCellLineOrBiosample" ;
    rdfs:comment "The cell line or biosample in which the genetic element occurs." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:occursInCellLineOrBiosample ;
        owl:someValuesFrom greg:CellLineOrBiosample ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "involvesMutation" ;
    rdfs:comment "The mutation involved in the genetic element." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:involvesMutation ;
        owl:someValuesFrom greg:Mutation ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "partOfChromatinRegulatoryModule" ;
    rdfs:comment "The chromatin regulatory module that the genetic element is part of." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:partOfChromatinRegulatoryModule ;
        owl:someValuesFrom greg:ChromatinRegulatoryModule ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "GeneticElement" ;
    rdfs:comment "A genetic element such as an enhancer or super-enhancer." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "TranscriptionFactor" ;
    rdfs:comment "A transcription factor involved in genetic regulation." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasHGNCsymbol ;
        owl:someValuesFrom xsd:string ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "An enhancer that regulates gene expression." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasChromosomeNumber ;
        owl:someValuesFrom xsd:string ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "SuperEnhancer" ;
    rdfs:comment "A super-enhancer that regulates gene expression." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasChromosomeNumber ;
        owl:someValuesFrom xsd:string ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "TargetGene" ;
    rdfs:comment "A target gene regulated by an enhancer or super-enhancer." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasHGNCsymbol ;
        owl:someValuesFrom xsd:string ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "Disease" ;
    rdfs:comment "A disease associated with genetic elements." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "CellLineOrBiosample" ;
    rdfs:comment "A cell line or biosample in which genetic elements occur." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "Mutation" ;
    rdfs:comment "A mutation involved in genetic elements." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "ChromatinRegulatoryModule" ;
    rdfs:comment "A chromatin regulatory module that contains genetic elements." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "TranscriptionFactorToEnhancerInteraction" ;
    rdfs:comment "A transcription factor to enhancer interaction." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasTranscriptionFactor ;
        owl:someValuesFrom greg:TranscriptionFactor ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "EnhancerToGeneInteraction" ;
    rdfs:comment "An enhancer to gene interaction." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty greg:hasEnhancer ;
        owl:someValuesFrom greg:Enhancer ] .