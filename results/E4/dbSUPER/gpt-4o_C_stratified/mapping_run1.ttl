@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .

<#TriplesMapCellLine> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#CellLine/{cell_name}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:cellName;
        rr:objectMap [
            rml:reference "cell_name"
        ]
    ].

<#TriplesMapChromosome> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#Chromosome/{chrom}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:chromName;
        rr:objectMap [
            rml:reference "chrom"
        ]
    ].

<#TriplesMapGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#Gene/{gene_symbol}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:geneSymbol;
        rr:objectMap [
            rml:reference "gene_symbol"
        ]
    ].

<#TriplesMapSuperEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#SuperEnhancer/{se_id}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:seID;
        rr:objectMap [
            rml:reference "se_id"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:rankValue;
        rr:objectMap [
            rml:reference "rank"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasChromosome;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapChromosome>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:targetsGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGene>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:locatedIn;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGenomicRegion>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:expressedIn;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapCellLine>
        ]
    ].

<#TriplesMapGenomicRegion> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GenomicRegion/{start}_{stop}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:startCoordinate;
        rr:objectMap [
            rml:reference "start"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:stopCoordinate;
        rr:objectMap [
            rml:reference "stop"
        ]
    ].