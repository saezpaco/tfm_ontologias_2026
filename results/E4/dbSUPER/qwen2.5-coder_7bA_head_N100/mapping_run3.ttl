```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix genreg: <https://genetic_regulatory_elements.com#> .

<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPubMedArticle>;
        ]
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:Enhancer/{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapSuperEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:SuperEnhancer/{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:TranscriptionFactor/{{hgnc_symbol_TFs}}{FAIR_URI}";
    ].

<#TriplesMapTargetGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:TargetGene/{{hgnc_symbol_target_genes}}{FAIR_URI}";
    ].

<#TriplesMapDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:Disease/{{disease}}{FAIR_URI}";
    ].

<#TriplesMapCellLineOrBiosample> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:CellLineOrBiosample/{{biosample_name}}{FAIR_URI}";
    ].

<#TriplesMapPubMedArticle> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:PubMedArticle/{{pmid}}{FAIR_URI}";
    ].

<#TriplesMapEnhancerTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate genreg:hasTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>;
        ]
    ].

<#TriplesMapEnhancerTargetGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate genreg:hasTargetGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetGene>;
        ]
    ].

<#TriplesMapSuperEnhancerTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate genreg:hasTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>;
        ]
    ].

<#TriplesMapSuperEnhancerTargetGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate genreg:hasTargetGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetGene>;
        ]
    ].

<#TriplesMapDiseaseGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:Disease/{{disease}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate genreg:associatedWithDisease;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement>;
        ]
    ].

<#TriplesMapCellLineOrBiosampleGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:CellLineOrBiosample/{{biosample_name}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate genreg:occursInCellLineOrBiosample;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement>;
        ]
    ].

<#TriplesMapPubMedArticleGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:PubMedArticle/{{pmid}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate genreg:hasPubMedArticle;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement>;
        ]
    ].
```