@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix genreg: <https://genetic_regulatory_elements.com#> .

owl:DatatypeProperty pmid
    a owl:DatatypeProperty ;
    rdfs:label "PubMed ID" ;
    rdfs:comment "The PubMed ID associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty method
    a owl:DatatypeProperty ;
    rdfs:label "Method" ;
    rdfs:comment "The method used in the study of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty assemblyVersion
    a owl:DatatypeProperty ;
    rdfs:label "Assembly Version" ;
    rdfs:comment "The genome assembly version of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty chromosomeNumber
    a owl:DatatypeProperty ;
    rdfs:label "Chromosome Number" ;
    rdfs:comment "The chromosome number of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:DatatypeProperty hgncSymbol
    a owl:DatatypeProperty ;
    rdfs:label "HGNC Symbol" ;
    rdfs:comment "The HGNC symbol of the genetic regulatory element." ;
    rdfs:domain genreg:TranscriptionFactor, genreg:TargetGene ;
    rdfs:range xsd:string .

owl:DatatypeProperty scoreValue
    a owl:DatatypeProperty ;
    rdfs:label "Score Value" ;
    rdfs:comment "The score value of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:float .

owl:DatatypeProperty startPosition
    a owl:DatatypeProperty ;
    rdfs:label "Start Position" ;
    rdfs:comment "The start position of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:DatatypeProperty endPosition
    a owl:DatatypeProperty ;
    rdfs:label "End Position" ;
    rdfs:comment "The end position of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:ObjectProperty hasTranscriptionFactor
    a owl:ObjectProperty ;
    rdfs:label "Has Transcription Factor" ;
    rdfs:comment "The transcription factor associated with the enhancer or super-enhancer." ;
    rdfs:domain genreg:Enhancer, genreg:SuperEnhancer ;
    rdfs:range genreg:TranscriptionFactor .

owl:ObjectProperty hasTargetGene
    a owl:ObjectProperty ;
    rdfs:label "Has Target Gene" ;
    rdfs:comment "The target gene associated with the enhancer, super-enhancer, or transcription factor." ;
    rdfs:domain genreg:Enhancer, genreg:SuperEnhancer, genreg:TranscriptionFactor ;
    rdfs:range genreg:TargetGene .

owl:ObjectProperty associatedWithDisease
    a owl:ObjectProperty ;
    rdfs:label "Associated With Disease" ;
    rdfs:comment "The disease associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:Disease .

owl:ObjectProperty occursInCellLineOrBiosample
    a owl:ObjectProperty ;
    rdfs:label "Occurs In Cell Line Or Biosample" ;
    rdfs:comment "The cell line or biosample in which the genetic regulatory element occurs." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:CellLineOrBiosample .

owl:ObjectProperty hasPubMedArticle
    a owl:ObjectProperty ;
    rdfs:label "Has PubMed Article" ;
    rdfs:comment "The PubMed article associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:PubMedArticle .

owl:Class GeneticRegulatoryElement
    a owl:Class ;
    rdfs:label "Genetic Regulatory Element" ;
    rdfs:comment "A general class representing genetic regulatory elements." ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:hasTranscriptionFactor ;
        owl:someValuesFrom genreg:TranscriptionFactor
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:hasTargetGene ;
        owl:someValuesFrom genreg:TargetGene
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:associatedWithDisease ;
        owl:someValuesFrom genreg:Disease
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:occursInCellLineOrBiosample ;
        owl:someValuesFrom genreg:CellLineOrBiosample
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:hasPubMedArticle ;
        owl:someValuesFrom genreg:PubMedArticle
    ] .

owl:Class Enhancer
    a owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "A class representing enhancers." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class SuperEnhancer
    a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:comment "A class representing super-enhancers." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class TranscriptionFactor
    a owl:Class ;
    rdfs:label "Transcription Factor" ;
    rdfs:comment "A class representing transcription factors." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class TargetGene
    a owl:Class ;
    rdfs:label "Target Gene" ;
    rdfs:comment "A class representing target genes." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class Disease
    a owl:Class ;
    rdfs:label "Disease" ;
    rdfs:comment "A class representing diseases." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class CellLineOrBiosample
    a owl:Class ;
    rdfs:label "Cell Line Or Biosample" ;
    rdfs:comment "A class representing cell lines or biosamples." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class PubMedArticle
    a owl:Class ;
    rdfs:label "PubMed Article" ;
    rdfs:comment "A class representing PubMed articles." .