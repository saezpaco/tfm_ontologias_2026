        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://genetic_regulatory_elements.com/TargetGene/{{gene_symbol}}_{FAIR_URI}";
    ].

<#TriplesMapChromosomeNumber> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:predicateObjectMap [
        rr:predicate ge:chromosomeNumber;
        rr:objectMap [
            rr:constant ?chrom;
        ]
    ].

