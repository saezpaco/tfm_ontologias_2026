```ttl
<#TriplesMapGeneticElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://genetic_regulatory_elements.com/GeneticElement/{{cell_name}}_{{chrom}}_{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate ge:chromosomeNumber;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapChromosomeNumber>;
        ]
    ],
    [
        rr:predicate ge:genomicStart;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGenomicStart>;
        ]
    ],
    [
        rr:predicate ge:genomicStop;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGenomicStop>;
        ]
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://genetic_regulatory_elements.com/Enhancer/{{se_id}}_{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate ge:rankScore;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapRankScore>;
        ]
    ],
    [
        rr:predicate ge:hasCellLine;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapHasCellLine>;
        ]
    ],
    [
        rr:predicate ge:targetsGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetsGene>;
        ]
    ].

<#TriplesMapSuperEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://genetic_regulatory_elements.com/SuperEnhancer/{{se_id}}_{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate ge:rankScore;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapRankScore>;
        ]
    ],
    [
        rr:predicate ge:hasCellLine;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapHasCellLine>;
        ]
    ],
    [
        rr:predicate ge:targetsGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetsGene>;
        ]
    ].

<#TriplesMapCellLine> a rr:TriplesMap;
