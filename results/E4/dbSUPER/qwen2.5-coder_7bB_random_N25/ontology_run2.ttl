@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gr: <https://genetic_regulatory_elements.com#> .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "cellName" ;
    rdfs:comment "The name of the cell line or biosample." ;
    rdfs:subPropertyOf xsd:string .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "chromosome" ;
    rdfs:comment "The chromosome number." ;
    rdfs:subPropertyOf xsd:string .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "geneSymbol" ;
    rdfs:comment "The symbol of the target gene." ;
    rdfs:subPropertyOf xsd:string .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "enhancerId" ;
    rdfs:comment "The unique identifier for an enhancer." ;
    rdfs:subPropertyOf xsd:string .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "superEnhancerId" ;
    rdfs:comment "The unique identifier for a super-enhancer." ;
    rdfs:subPropertyOf xsd:string .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "rankValue" ;
    rdfs:comment "The rank of the enhancer or super-enhancer." ;
    rdfs:subPropertyOf xsd:integer .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "startPosition" ;
    rdfs:comment "The genomic start position of the enhancer or super-enhancer." ;
    rdfs:subPropertyOf xsd:integer .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "stopPosition" ;
    rdfs:comment "The genomic stop position of the enhancer or super-enhancer." ;
    rdfs:subPropertyOf xsd:integer .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "hasCellLineOrBiosample" ;
    rdfs:comment "The cell line or biosample associated with a genetic element." ;
    rdfs:domain gr:GeneticElement ;
    rdfs:range gr:CellLineOrBiosample .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "targetsGene" ;
    rdfs:comment "The target gene of a genetic element." ;
    rdfs:domain gr:GeneticElement ;
    rdfs:range gr:TargetGene .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "regulatedByTranscriptionFactor" ;
    rdfs:comment "The transcription factor that regulates a genetic element." ;
    rdfs:domain gr:GeneticElement ;
    rdfs:range gr:TranscriptionFactor .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "associatedWithDisease" ;
    rdfs:comment "A disease associated with a genetic element." ;
    rdfs:domain gr:GeneticElement ;
    rdfs:range gr:DiseaseAssociation .

owl:Class rdf:type owl:Class ;
    rdfs:label "GeneticElement" ;
    rdfs:comment "A generic class representing a genetic regulatory element." ;
    rdfs:subClassOf owl:Thing .

owl:Class rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "A specific type of genetic element that acts as an enhancer." ;
    rdfs:subClassOf gr:GeneticElement .

owl:Class rdf:type owl:Class ;
    rdfs:label "SuperEnhancer" ;
    rdfs:comment "A specific type of genetic element that acts as a super-enhancer." ;
    rdfs:subClassOf gr:GeneticElement .

owl:Class rdf:type owl:Class ;
    rdfs:label "CellLineOrBiosample" ;
    rdfs:comment "A class representing a cell line or biosample." ;
    rdfs:subClassOf owl:Thing .

owl:Class rdf:type owl:Class ;
    rdfs:label "TargetGene" ;
    rdfs:comment "A class representing a target gene." ;
    rdfs:subClassOf owl:Thing .

owl:Class rdf:type owl:Class ;
    rdfs:label "TranscriptionFactor" ;
    rdfs:comment "A class representing a transcription factor." ;
    rdfs:subClassOf owl:Thing .

owl:Class rdf:type owl:Class ;
    rdfs:label "DiseaseAssociation" ;
    rdfs:comment "A class representing a disease association with a genetic element." ;
    rdfs:subClassOf owl:Thing .