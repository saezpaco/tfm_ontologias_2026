@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .

<#TriplesMapGeneticElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GeneticElement/{original_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:crossrefID;
        rr:objectMap [
            rml:reference "crossref"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:minimumRatio;
        rr:objectMap [
            rml:reference "minimum_ratio"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:score;
        rr:objectMap [
            rml:reference "score"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:source;
        rr:objectMap [
            rml:reference "source"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:type;
        rr:objectMap [
            rml:reference "type"
        ]
    ].

<#TriplesMapGenomicCoordinate> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GenomicCoordinate/{original_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:currentAssembly;
        rr:objectMap [
            rml:reference "current_assembly"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:currentChr;
        rr:objectMap [
            rml:reference "current_chr"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:currentEnd;
        rr:objectMap [
            rml:reference "current_end"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:currentStart;
        rr:objectMap [
            rml:reference "current_start"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:origAssembly;
        rr:objectMap [
            rml:reference "orig_assembly"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:origChr;
        rr:objectMap [
            rml:reference "orig_chr"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:origEnd;
        rr:objectMap [
            rml:reference "orig_end"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:origStart;
        rr:objectMap [
            rml:reference "orig_start"
        ]
    ].

