```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gr: <https://genetic_regulatory_elements.com#> .

<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:GeneticRegulatoryElement/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:Enhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapSuperEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:SuperEnhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:TranscriptionFactor/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapTargetGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:TargetGene/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:Disease/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapCellLineOrBiosample> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:CellLineOrBiosample/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapMutation> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:Mutation/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapChromatinRegulatoryModule> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:ChromatinRegulatoryModule/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapEnhancerHasTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:Enhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate gr:hasTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>;
        ]
    ].

<#TriplesMapEnhancerHasTargetGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:Enhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate gr:hasTargetGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetGene>;
        ]
    ].

<#TriplesMapEnhancerHasDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:Enhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate gr:hasDisease;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapDisease>;
        ]
    ].

<#TriplesMapEnhancerHasCellLineOrBiosample> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:Enhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate gr:hasCellLineOrBiosample;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapCellLineOrBiosample>;
        ]
    ].

<#TriplesMapEnhancerInvolvesMutation> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:Enhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate gr:involvesMutation;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapMutation>;
        ]
    ].

<#TriplesMapSuperEnhancerPartOfChromatinRegulatoryModule> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "gr:SuperEnhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate gr:partOfChromatinRegulatoryModule;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapChromatinRegulatoryModule>;
        ]
    ].
```