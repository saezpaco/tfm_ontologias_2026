```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix greg: <https://genetic_regulatory_elements.com#> .

<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:GeneticRegulatoryElement/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:Enhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapSuperEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:SuperEnhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:TranscriptionFactor/{{hgnc_symbol_TFs}}{FAIR_URI}";
    ].

<#TriplesMapTargetGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:TargetGene/{{hgnc_symbol_target_genes}}{FAIR_URI}";
    ].

<#TriplesMapDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:Disease/{{disease}}{FAIR_URI}";
    ].

<#TriplesMapCellLineOrBiosample> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:CellLineOrBiosample/{{biosample}}{FAIR_URI}";
    ].

<#TriplesMapMutation> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:Mutation/{{mutation}}{FAIR_URI}";
    ].

<#TriplesMapChromatinRegulatoryModule> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:ChromatinRegulatoryModule/{{crm}}{FAIR_URI}";
    ].

<#TriplesMapGeneticRegulatoryElementProperties> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:GeneticRegulatoryElement/{{TFs2enh_PMID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate greg:hasPubMedID;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElementProperties>;
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate greg:TFs2enh_PMID;
        rr:objectMap [
            rr:constant xsd:string("TFs2enh_PMID");
        ]
    ].
```