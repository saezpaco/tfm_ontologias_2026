@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix greg: <https://genetic_regulatory_elements.com#> .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasPubMedID" ;
    rdfs:comment "The PubMed ID associated with a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasMethod" ;
    rdfs:comment "The method used in a genetic regulatory element study." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasMethod ;
        owl:someValuesFrom xsd:string
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasHGNCsymbol" ;
    rdfs:comment "The HGNC symbol of a transcription factor or target gene." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasHGNCsymbol ;
        owl:someValuesFrom xsd:string
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasScore" ;
    rdfs:comment "The score value associated with a genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasScore ;
        owl:someValuesFrom xsd:float
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasChromosomeNumber" ;
    rdfs:comment "The chromosome number in the current or original assembly." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasChromosomeNumber ;
        owl:someValuesFrom xsd:string
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasStartPosition" ;
    rdfs:comment "The start position in the current or original assembly." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasStartPosition ;
        owl:someValuesFrom xsd:int
    ] .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasEndPosition" ;
    rdfs:comment "The end position in the current or original assembly." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasEndPosition ;
        owl:someValuesFrom xsd:int
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "hasTranscriptionFactor" ;
    rdfs:comment "The transcription factor associated with an enhancer or superenhancer." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasTranscriptionFactor ;
        owl:someValuesFrom greg:TranscriptionFactor
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "hasTargetGene" ;
    rdfs:comment "The target gene associated with an enhancer or superenhancer." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasTargetGene ;
        owl:someValuesFrom greg:TargetGene
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "associatedWithDisease" ;
    rdfs:comment "The disease associated with an enhancer or superenhancer." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:associatedWithDisease ;
        owl:someValuesFrom greg:Disease
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "occursInCellLineOrBiosample" ;
    rdfs:comment "The cell line or biosample in which an enhancer or superenhancer occurs." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:occursInCellLineOrBiosample ;
        owl:someValuesFrom greg:CellLineOrBiosample
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "involvesMutation" ;
    rdfs:comment "The mutation involved in an enhancer or superenhancer." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:involvesMutation ;
        owl:someValuesFrom greg:Mutation
    ] .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "partOfChromatinRegulatoryModule" ;
    rdfs:comment "The chromatin regulatory module that an enhancer or superenhancer is part of." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:partOfChromatinRegulatoryModule ;
        owl:someValuesFrom greg:ChromatinRegulatoryModule
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "GeneticRegulatoryElement" ;
    rdfs:comment "A general class for genetic regulatory elements." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "A class for enhancers, a type of genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "SuperEnhancer" ;
    rdfs:comment "A class for superenhancers, a type of enhancer." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "TranscriptionFactor" ;
    rdfs:comment "A class for transcription factors, a type of genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "TargetGene" ;
    rdfs:comment "A class for target genes, a type of genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "Disease" ;
    rdfs:comment "A class for diseases, a type of genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "CellLineOrBiosample" ;
    rdfs:comment "A class for cell lines or biosamples, a type of genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "Mutation" ;
    rdfs:comment "A class for mutations, a type of genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "ChromatinRegulatoryModule" ;
    rdfs:comment "A class for chromatin regulatory modules, a type of genetic regulatory element." ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty greg:hasPubMedID ;
        owl:someValuesFrom xsd:string
    ] .