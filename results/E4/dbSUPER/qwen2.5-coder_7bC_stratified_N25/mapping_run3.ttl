```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ge: <https://genetic_regulatory_elements.com#> .

<#TriplesMapGeneticElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{cell_name}}{FAIR_URI}";
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{cell_name}}_enhancer_{{se_id}}{FAIR_URI}";
    ].

<#TriplesMapSuperEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{cell_name}}_super_enhancer_{{se_id}}{FAIR_URI}";
    ].

<#TriplesMapCellLine> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{cell_name}}{FAIR_URI}";
    ].

<#TriplesMapTargetGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{gene_symbol}}{FAIR_URI}";
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{transcription_factor}}{FAIR_URI}";
    ].

<#TriplesMapDiseaseAssociation> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{disease}}{FAIR_URI}";
    ].

<#TriplesMapGeneticElement_hasCellLine> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{cell_name}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate ge:hasCellLine;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapCellLine>;
        ]
    ].

<#TriplesMapEnhancer_targetsGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{cell_name}}_enhancer_{{se_id}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate ge:targetsGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetGene>;
        ]
    ].

<#TriplesMapSuperEnhancer_targetsGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{cell_name}}_super_enhancer_{{se_id}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate ge:targetsGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetGene>;
        ]
    ].

<#TriplesMapEnhancer_regulatedByTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{cell_name}}_enhancer_{{se_id}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate ge:regulatedByTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>;
        ]
    ].

<#TriplesMapSuperEnhancer_regulatedByTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{cell_name}}_super_enhancer_{{se_id}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate ge:regulatedByTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>;
        ]
    ].

<#TriplesMapGeneticElement_associatedWithDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ge:{{cell_name}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate ge:associatedWithDisease;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapDiseaseAssociation>;
        ]
    ].
```