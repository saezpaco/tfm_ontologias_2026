```ttl
<#TriplesMapGeneticElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://genetic_regulatory_elements.com/GeneticElement/{{cell_name}}_{{se_id}}_{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate ge:hasCellLine;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapCellLine>;
        ]
    ],
    [
        rr:predicate ge:locatedOnChromosome;
        rr:objectMap [
            rr:template "https://genetic_regulatory_elements.com/Chromosome/{{chrom}}";
        ]
    ],
    [
        rr:predicate ge:hasRank;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapRank>;
        ]
    ],
    [
        rr:predicate ge:start;
        rr:objectMap [
            rr:template "{{start}}";
        ]
    ],
    [
        rr:predicate ge:stop;
        rr:objectMap [
            rr:template "{{stop}}";
        ]
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://genetic_regulatory_elements.com/Enhancer/{{cell_name}}_{{se_id}}_{FAIR_URI}";
    ].

