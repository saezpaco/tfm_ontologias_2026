```ttl
<#GeneticElementMapping> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://genetic_regulatory_elements.com/GeneticElement/{{se_id}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate ge:cellName;
        rr:objectMap [
            rml:reference "cell_name";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate ge:chromosome;
        rr:objectMap [
            rml:reference "chrom";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate ge:geneSymbol;
        rr:objectMap [
            rml:reference "gene_symbol";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate ge:enhancerId;
        rr:objectMap [
            rml:reference "se_id";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate ge:rankValue;
        rr:objectMap [
            rml:reference "rank";
            rr:datatype xsd:integer
        ]
    ],
    [
        rr:predicate ge:startPosition;
        rr:objectMap [
            rml:reference "start";
            rr:datatype xsd:integer
        ]
    ],
    [
        rr:predicate ge:stopPosition;
        rr:objectMap [
            rml:reference "stop";
            rr:datatype xsd:integer
        ]
    ].

<#EnhancerMapping> a rr:TriplesMap;
