```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix genreg: <https://genetic_regulatory_elements.com#> .

<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:assemblyVersion;
        rr:objectMap [
            rml:reference "current_assembly";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate genreg:chromosomeNumber;
        rr:objectMap [
            rml:reference "current_chr";
            rr:datatype xsd:int
        ]
    ],
    [
        rr:predicate genreg:endPosition;
        rr:objectMap [
            rml:reference "current_end";
            rr:datatype xsd:int
        ]
    ],
    [
        rr:predicate genreg:startPosition;
        rr:objectMap [
            rml:reference "current_start";
            rr:datatype xsd:int
        ]
    ],
    [
        rr:predicate genreg:scoreValue;
        rr:objectMap [
            rml:reference "score";
            rr:datatype xsd:float
        ]
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:Enhancer/{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapSuperEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:SuperEnhancer/{{original_ID}}{FAIR_URI}";
    ].

<#TriplesMapDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:Disease/{{disease}}{FAIR_URI}";
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:TranscriptionFactor/{{hgnc_symbol_TFs}}{FAIR_URI}";
    ].

<#TriplesMapGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:Gene/{{hgnc_symbol_target_genes}}{FAIR_URI}";
    ].

<#TriplesMapPubMedID> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasPubMedID;
        rr:objectMap [
            rml:reference "TFs2enh_PMID";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate genreg:hasPubMedID;
        rr:objectMap [
            rml:reference "enh2gene_PMID";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate genreg:hasPubMedID;
        rr:objectMap [
            rml:reference "enh_PMID";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate genreg:hasPubMedID;
        rr:objectMap [
            rml:reference "mutation_PMID";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate genreg:hasPubMedID;
        rr:objectMap [
            rml:reference "disease_PMID";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapMethod> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:Method/{{TFs2enh_method}}{FAIR_URI}";
    ].

<#TriplesMapHasTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasTranscriptionFactor;
        rr:objectMap [
            rml:reference "hgnc_symbol_TFs";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapHasGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasGene;
        rr:objectMap [
            rml:reference "hgnc_symbol_target_genes";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapHasDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasDisease;
        rr:objectMap [
            rml:reference "disease";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapHasMethod> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{original_ID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasMethod;
        rr:objectMap [
            rml:reference "TFs2enh_method";
            rr:datatype xsd:string
        ]
    ].
```