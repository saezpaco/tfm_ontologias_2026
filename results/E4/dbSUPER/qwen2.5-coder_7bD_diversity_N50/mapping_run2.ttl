```ttl
<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "{FAIR_URI}GeneticRegulatoryElement/{{original_ID}}";
    ];
    rr:predicateObjectMap [
        rr:predicate :type;
        rr:objectMap [
            rr:constant :GeneticRegulatoryElement;
        ]
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
