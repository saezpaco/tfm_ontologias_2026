    ].

<#TriplesMapSuperEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#SuperEnhancer/{crm_ID}";
    ].

<#TriplesMapGeneticElementToGenomicCoordinate> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GeneticElement/{crm_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasGenomicCoordinate;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGenomicCoordinate>
        ]
    ].

<#TriplesMapGeneticElementToBiosample> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GeneticElement/{crm_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:associatedWithBiosample;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapBiosample>
        ]
    ].

<#TriplesMapGeneticElementToGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GeneticElement/{crm_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:targetsGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGene>
        ]
    ].

<#TriplesMapGeneticElementToTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GeneticElement/{crm_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:regulatedByTF;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>
        ]
    ].

<#TriplesMapGeneticElementToDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#GeneticElement/{crm_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:associatedWithDisease;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapDisease>
        ]
    ].