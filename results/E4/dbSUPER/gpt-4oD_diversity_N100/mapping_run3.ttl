<#TriplesMapDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#Disease/{disease}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:disease;
        rr:objectMap [
            rml:reference "disease"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:disease_PMID;
        rr:objectMap [
            rml:reference "disease_PMID"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:disease_method;
        rr:objectMap [
            rml:reference "disease_method"
        ]
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com#Enhancer/{crm_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:enh_PMID;
        rr:objectMap [
            rml:reference "enh_PMID"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:enh_method;
        rr:objectMap [
