@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix genreg: <https://genetic_regulatory_elements.com#> .

owl:DatatypeProperty pmid
    a owl:DatatypeProperty ;
    rdfs:label "PubMed ID" ;
    rdfs:comment "A PubMed ID associated with the genetic regulatory element." ;
    rdfs:subPropertyOf rdf:value ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty method
    a owl:DatatypeProperty ;
    rdfs:label "Method" ;
    rdfs:comment "A method used in the study of genetic regulatory elements." ;
    rdfs:subPropertyOf rdf:value ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty chromosomeNumber
    a owl:DatatypeProperty ;
    rdfs:label "Chromosome Number" ;
    rdfs:comment "The chromosome number in the assembly." ;
    rdfs:subPropertyOf rdf:value ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:DatatypeProperty scoreValue
    a owl:DatatypeProperty ;
    rdfs:label "Score Value" ;
    rdfs:comment "A score value associated with the genetic regulatory element." ;
    rdfs:subPropertyOf rdf:value ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:float .

owl:ObjectProperty hasTranscriptionFactor
    a owl:ObjectProperty ;
    rdfs:label "Has Transcription Factor" ;
    rdfs:comment "A transcription factor involved in the genetic regulatory element." ;
    rdfs:domain genreg:TranscriptionFactorToEnhancerInteraction ;
    rdfs:range genreg:TranscriptionFactor .

owl:ObjectProperty hasEnhancer
    a owl:ObjectProperty ;
    rdfs:label "Has Enhancer" ;
    rdfs:comment "An enhancer involved in the genetic regulatory element." ;
    rdfs:domain genreg:TranscriptionFactorToEnhancerInteraction ;
    rdfs:range genreg:Enhancer .

owl:ObjectProperty hasTargetGene
    a owl:ObjectProperty ;
    rdfs:label "Has Target Gene" ;
    rdfs:comment "A target gene involved in the genetic regulatory element." ;
    rdfs:domain genreg:EnhancerToGeneInteraction ;
    rdfs:range genreg:TargetGene .

owl:ObjectProperty associatedWithDisease
    a owl:ObjectProperty ;
    rdfs:label "Associated With Disease" ;
    rdfs:comment "A disease associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:Disease .

owl:ObjectProperty occursInCellLineOrBiosample
    a owl:ObjectProperty ;
    rdfs:label "Occurs In Cell Line Or Biosample" ;
    rdfs:comment "A cell line or biosample where the genetic regulatory element occurs." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:CellLineOrBiosample .

owl:ObjectProperty involvesMutation
    a owl:ObjectProperty ;
    rdfs:label "Involves Mutation" ;
    rdfs:comment "A mutation involved in the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:Mutation .

owl:ObjectProperty partOfChromatinRegionModule
    a owl:ObjectProperty ;
    rdfs:label "Part Of Chromatin Region Module" ;
    rdfs:comment "A chromatin region module that the enhancer is part of." ;
    rdfs:domain genreg:Enhancer ;
    rdfs:range genreg:ChromatinRegionModule .

owl:Class GeneticRegulatoryElement
    a owl:Class ;
    rdfs:label "Genetic Regulatory Element" ;
    rdfs:comment "A general class representing genetic regulatory elements." ;
    rdfs:subClassOf genreg:TranscriptionFactorToEnhancerInteraction ;
    rdfs:subClassOf genreg:EnhancerToGeneInteraction .

owl:Class TranscriptionFactor
    a owl:Class ;
    rdfs:label "Transcription Factor" ;
    rdfs:comment "A class representing transcription factors." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .

owl:Class Enhancer
    a owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "A class representing enhancers." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .

owl:Class SuperEnhancer
    a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:comment "A subclass of enhancers with enhanced regulatory activity." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:Enhancer ] .

owl:Class TargetGene
    a owl:Class ;
    rdfs:label "Target Gene" ;
    rdfs:comment "A class representing target genes." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .

owl:Class Disease
    a owl:Class ;
    rdfs:label "Disease" ;
    rdfs:comment "A class representing diseases associated with genetic regulatory elements." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .

owl:Class CellLineOrBiosample
    a owl:Class ;
    rdfs:label "Cell Line Or Biosample" ;
    rdfs:comment "A class representing cell lines or biosamples." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .

owl:Class Mutation
    a owl:Class ;
    rdfs:label "Mutation" ;
    rdfs:comment "A class representing mutations involved in genetic regulatory elements." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:GeneticRegulatoryElement ] .

owl:Class ChromatinRegionModule
    a owl:Class ;
    rdfs:label "Chromatin Region Module" ;
    rdfs:comment "A class representing chromatin region modules." ;
    rdfs:equivalentClass [ rdf:type owl:Class ; rdfs:subClassOf genreg:Enhancer ] .