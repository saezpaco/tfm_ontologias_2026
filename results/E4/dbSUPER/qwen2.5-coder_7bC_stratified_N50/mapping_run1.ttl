```ttl
<#TriplesMapGeneticElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://genetic_regulatory_elements.com/GeneticElement/{{cell_name}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate gr:cellName;
        rr:objectMap [
            rml:reference "cell_name";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate gr:chromosome;
        rr:objectMap [
            rml:reference "chrom";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "dbSUPER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://genetic_regulatory_elements.com/Enhancer/{{se_id}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate gr:superEnhancerID;
        rr:objectMap [
            rml:reference "se_id";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate gr:rankValue;
        rr:objectMap [
            rml:reference "rank";
            rr:datatype xsd:integer
        ]
    ],
    [
        rr:predicate gr:startPosition;
        rr:objectMap [
            rml:reference "start";
            rr:datatype xsd:integer
        ]
    ],
    [
        rr:predicate gr:stopPosition;
        rr:objectMap [
            rml:reference "stop";
            rr:datatype xsd:integer
        ]
    ].

