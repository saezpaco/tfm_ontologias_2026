```ttl
@prefix ex: <http://example.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://w3id.org/ql#> .

<#TriplesMapEntity> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ex:GeneticData/{{FAIR_URI}}";
    ];
    rr:predicateObjectMap [
        rr:predicate ex:hasTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TranscriptionFactor>;
        ]
    ],
    [
        rr:predicate ex:hasEnhancer;
        rr:objectMap [
            rr:parentTriplesMap <#Enhancer>;
        ]
    ],
    [
        rr:predicate ex:hasDisease;
        rr:objectMap [
            rr:parentTriplesMap <#Disease>;
        ]
    ],
    [
        rr:predicate ex:hasGene;
        rr:objectMap [
            rr:parentTriplesMap <#Gene>;
        ]
    ],
    [
        rr:predicate ex:hasTranscriptionFactorSymbol;
        rr:objectMap [
            rr:parentTriplesMap <#TranscriptionFactorSymbol>;
        ]
    ],
    [
        rr:predicate ex:hasGeneSymbol;
        rr:objectMap [
            rr:parentTriplesMap <#GeneSymbol>;
        ]
    ],
    [
        rr:predicate ex:hasRatio;
        rr:objectMap [
            rr:parentTriplesMap <#Ratio>;
        ]
    ],
    [
        rr:predicate ex:hasMutation;
        rr:objectMap [
            rr:parentTriplesMap <#Mutation>;
        ]
    ],
    [
        rr:predicate ex:hasScoreValue;
        rr:objectMap [
            rr:parentTriplesMap <#ScoreValue>;
        ]
    ],
    [
        rr:predicate ex:hasID;
        rr:objectMap [
            rr:parentTriplesMap <#ID>;
        ]
    ],
    [
        rr:predicate ex:hasRSID;
        rr:objectMap [
            rr:parentTriplesMap <#RSID>;
        ]
    ],
    [
        rr:predicate ex:hasBiosample;
        rr:objectMap [
            rr:parentTriplesMap <#Biosample>;
        ]
    ],
    [
        rr:predicate ex:hasCRISPRCas9TargetRegion;
        rr:objectMap [
            rr:parentTriplesMap <#CRISPRCas9TargetRegion>;
        ]
    ],
    [
        rr:predicate ex:hasReference;
        rr:objectMap [
            rr:parentTriplesMap <#Reference>;
        ]
    ],
    [
        rr:predicate ex:hasAssemblyVersion;
        rr:objectMap [
            rr:parentTriplesMap <#AssemblyVersion>;
        ]
    ],
    [
        rr:predicate ex:hasChromosomeNumber;
        rr:objectMap [
            rr:parentTriplesMap <#ChromosomeNumber>;
        ]
    ],
    [
        rr:predicate ex:hasEndPosition;
        rr:objectMap [
            rr:parentTriplesMap <#EndPosition>;
        ]
    ],
    [
        rr:predicate ex:hasStartPosition;
        rr:objectMap [
            rr:parentTriplesMap <#StartPosition>;
        ]
    ],
    [
        rr:predicate ex:hasMethod;
        rr:objectMap [
            rr:parentTriplesMap <#Method>;
        ]
    ].

<#TranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "ex:TranscriptionFactor/{{FAIR_URI}}";
    ].

<#Enhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
