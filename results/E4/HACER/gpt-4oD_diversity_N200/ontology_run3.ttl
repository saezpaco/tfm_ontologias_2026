@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

base:TFs2enh_PMID a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "TFs2enh PMID" ;
    skos:definition "PMID for transcription factors to enhancer" .

base:TFs2enh_method a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "TFs2enh method" ;
    skos:definition "Method used for transcription factors to enhancer" .

base:biosample_name a owl:DatatypeProperty ;
    rdfs:domain base:Biosample ;
    rdfs:range xsd:string ;
    rdfs:label "Biosample name" ;
    skos:definition "Name of the biosample" .

base:crm_ID a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "CRM ID" ;
    skos:definition "CRM identifier" .

base:crossref a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Cross-reference" ;
    skos:definition "Cross-reference identifier" .

base:current_assembly a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "Current assembly" ;
    skos:definition "Current genome assembly" .

base:current_chr a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "Current chromosome" ;
    skos:definition "Current chromosome" .

base:disease a owl:DatatypeProperty ;
    rdfs:domain base:Disease ;
    rdfs:range xsd:string ;
    rdfs:label "Disease" ;
    skos:definition "Disease associated" .

base:disease_PMID a owl:DatatypeProperty ;
    rdfs:domain base:Disease ;
    rdfs:range xsd:string ;
    rdfs:label "Disease PMID" ;
    skos:definition "PMID for disease" .

base:disease_method a owl:DatatypeProperty ;
    rdfs:domain base:Disease ;
    rdfs:range xsd:string ;
    rdfs:label "Disease method" ;
    skos:definition "Method used for disease association" .

base:enh2gene_PMID a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Enh2gene PMID" ;
    skos:definition "PMID for enhancer to gene" .

base:enh2gene_method a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Enh2gene method" ;
    skos:definition "Method used for enhancer to gene" .

base:enh_PMID a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Enh PMID" ;
    skos:definition "PMID for enhancer" .

base:enh_method a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Enh method" ;
    skos:definition "Method used for enhancer" .

base:hgnc_symbol_TFs a owl:DatatypeProperty ;
    rdfs:domain base:TranscriptionFactor ;
    rdfs:range xsd:string ;
    rdfs:label "HGNC symbol TFs" ;
    skos:definition "HGNC symbol for transcription factors" .

base:hgnc_symbol_target_genes a owl:DatatypeProperty ;
    rdfs:domain base:Gene ;
    rdfs:range xsd:string ;
    rdfs:label "HGNC symbol target genes" ;
    skos:definition "HGNC symbol for target genes" .

base:minimum_ratio a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:float ;
    rdfs:label "Minimum ratio" ;
    skos:definition "Minimum ratio" .

base:mutation_PMID a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Mutation PMID" ;
    skos:definition "PMID for mutation" .

base:mutation_method a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Mutation method" ;
    skos:definition "Method used for mutation" .

base:orig_assembly a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "Original assembly" ;
    skos:definition "Original genome assembly" .

base:orig_chr a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "Original chromosome" ;
    skos:definition "Original chromosome" .

base:original_ID a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Original ID" ;
    skos:definition "Original identifier" .

base:refsnp_ID a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "RefSNP ID" ;
    skos:definition "Reference SNP identifier" .

base:score a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:float ;
    rdfs:label "Score" ;
    skos:definition "Score" .

base:source a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Source" ;
    skos:definition "Source" .

base:type a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:string ;
    rdfs:label "Type" ;
    skos:definition "Type" .

base:current_end a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "Current end" ;
    skos:definition "Current end position" .

base:current_start a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "Current start" ;
    skos:definition "Current start position" .

base:orig_end a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "Original end" ;
    skos:definition "Original end position" .

base:orig_start a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "Original start" ;
    skos:definition "Original start position" .

base:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:GenomicCoordinate ;
    rdfs:label "has genomic coordinate" ;
    skos:definition "Associates a genetic element with its genomic coordinate" .

base:hasBiosample a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Biosample ;
    rdfs:label "has biosample" ;
    skos:definition "Associates a genetic element with a biosample" .

base:targetsGene a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Gene ;
    rdfs:label "targets gene" ;
    skos:definition "Associates a genetic element with a target gene" .

base:regulatedBy a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:TranscriptionFactor ;
    rdfs:label "regulated by" ;
    skos:definition "Associates a genetic element with a transcription factor" .

base:associatedWithDisease a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Disease ;
    rdfs:label "associated with disease" ;
    skos:definition "Associates a genetic element with a disease" .

base:GeneticElement a owl:Class ;
    rdfs:label "Genetic Element" ;
    skos:definition "A genetic element" .

base:GenomicCoordinate a owl:Class ;
    rdfs:label "Genomic Coordinate" ;
    skos:definition "A genomic coordinate" .

base:Biosample a owl:Class ;
    rdfs:label "Biosample" ;
    skos:definition "A biosample" .

base:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:definition "A gene" .

base:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:definition "A transcription factor" .

base:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:definition "A disease" .

base:Enhancer a owl:Class ;
    rdfs:subClassOf base:GeneticElement ;
    rdfs:label "Enhancer" ;
    skos:definition "An enhancer" .

base:SuperEnhancer a owl:Class ;
    rdfs:subClassOf base:GeneticElement ;
    rdfs:label "Super Enhancer" ;
    skos:definition "A super enhancer" .

base:GeneticElement rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:hasGenomicCoordinate ;
    owl:someValuesFrom base:GenomicCoordinate
] .

base:GeneticElement rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:hasBiosample ;
    owl:someValuesFrom base:Biosample
] .

base:GeneticElement rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:targetsGene ;
    owl:someValuesFrom base:Gene
] .

base:GeneticElement rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:regulatedBy ;
    owl:someValuesFrom base:TranscriptionFactor
] .

base:GeneticElement rdf:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:associatedWithDisease ;
    owl:someValuesFrom base:Disease
] .