```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix genreg: <https://genetic_regulatory_elements.com#> .

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:Enhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>;
        ]
    ],
    [
        rr:predicate genreg:hasTargetGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetGene>;
        ]
    ],
    [
        rr:predicate genreg:associatedWithDisease;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapDisease>;
        ]
    ],
    [
        rr:predicate genreg:occursInCellLineOrBiosample;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapCellLineOrBiosample>;
        ]
    ],
    [
        rr:predicate genreg:hasPubMedID;
        rr:objectMap [
            rr:template "{{TFs2enh_PMID}}";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate genreg:usesMethod;
        rr:objectMap [
            rr:template "{{TFs2enh_method}}";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapSuperEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:SuperEnhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:hasTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>;
        ]
    ],
    [
        rr:predicate genreg:associatedWithDisease;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapDisease>;
        ]
    ],
    [
        rr:predicate genreg:occursInCellLineOrBiosample;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapCellLineOrBiosample>;
        ]
    ],
    [
        rr:predicate genreg:hasPubMedID;
        rr:objectMap [
            rr:template "{{TFs2enh_PMID}}";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate genreg:usesMethod;
        rr:objectMap [
            rr:template "{{TFs2enh_method}}";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:TranscriptionFactor/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapTargetGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:TargetGene/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:Disease/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

<#TriplesMapCellLineOrBiosample> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:CellLineOrBiosample/{{TFs2enh_PMID}}{FAIR_URI}";
    ].
