@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix ql: <http://www.w3.org/TR/2011/PR-rdf-sparql-json-20111206#>.
@prefix ex: <http://example.org/>.
@prefix base: <http://example.org/base/>.

<#TriplesMapEntity> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "EntityURI/{{Entity1}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate ex:class;
        rr:objectMap [
            rr:parentTriplesMap <#ClassMapping>
        ]
    ].

<#TriplesMapEntity2> a rr:TriplesMap;
