```ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix greg: <https://genetic_regulatory_elements.com#> .

<#TriplesMapGeneticElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:GeneticElement/{{TFs2enh_PMID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate greg:hasPubMedID;
        rr:objectMap [
            rr:constant "{{TFs2enh_PMID}}"
        ]
    ],
    [
        rr:predicate greg:usesMethod;
        rr:objectMap [
            rr:constant "{{TFs2enh_PMID}}"
        ]
    ],
    [
        rr:predicate greg:chromosomeNumber;
        rr:objectMap [
            rr:constant "{{orig_chromosome}}"
        ]
    ],
    [
        rr:predicate greg:startPosition;
        rr:objectMap [
            rr:constant "{{start_position}}"
        ]
    ],
    [
        rr:predicate greg:endPosition;
        rr:objectMap [
            rr:constant "{{end_position}}"
        ]
    ],
    [
        rr:predicate greg:scoreValue;
        rr:objectMap [
            rr:constant "{{TFs2enh_score}}"
        ]
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "greg:Enhancer/{{TFs2enh_PMID}}{FAIR_URI}";
    ].

