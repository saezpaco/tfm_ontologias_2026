@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix greg: <https://genetic_regulatory_elements.com#> .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasPMID" ;
    rdfs:comment "PubMed ID associated with the genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "usesMethod" ;
    rdfs:comment "Method used in the study of the genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasAssemblyVersion" ;
    rdfs:comment "Current genome assembly version." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasChromosomeNumber" ;
    rdfs:comment "Chromosome number in the current assembly." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasScore" ;
    rdfs:comment "Score value associated with the genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:float .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasSource" ;
    rdfs:comment "Data source of the genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasType" ;
    rdfs:comment "Type of the genetic regulatory element (e.g., enhancer, super-enhancer)." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasStartPosition" ;
    rdfs:comment "Start position in the current assembly." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:DatatypeProperty rdf:type owl:DatatypeProperty ;
    rdfs:label "hasEndPosition" ;
    rdfs:comment "End position in the current assembly." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "hasTranscriptionFactor" ;
    rdfs:comment "Transcription factor associated with the enhancer or super-enhancer." ;
    rdfs:domain greg:Enhancer ;
    rdfs:range greg:TranscriptionFactor .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "hasTargetGene" ;
    rdfs:comment "Target gene associated with the enhancer or super-enhancer." ;
    rdfs:domain greg:Enhancer ;
    rdfs:range greg:TargetGene .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "associatedWithDisease" ;
    rdfs:comment "Disease associated with the genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range greg:Disease .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "occursInCellLineOrBiosample" ;
    rdfs:comment "Cell line or biosample in which the genetic regulatory element occurs." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range greg:CellLineOrBiosample .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "involvesMutation" ;
    rdfs:comment "Mutation involved in the genetic regulatory element." ;
    rdfs:domain greg:GeneticRegulatoryElement ;
    rdfs:range greg:Mutation .

owl:ObjectProperty rdf:type owl:ObjectProperty ;
    rdfs:label "partOfChromatinRegulatoryModule" ;
    rdfs:comment "Chromatin regulatory module to which the enhancer or super-enhancer belongs." ;
    rdfs:domain greg:Enhancer ;
    rdfs:range greg:ChromatinRegulatoryModule .

owl:Class rdf:type owl:Class ;
    rdfs:label "GeneticRegulatoryElement" ;
    rdfs:comment "A general class representing a genetic regulatory element." ;
    rdfs:subClassOf owl:Thing .

owl:Class rdf:type owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "A subclass of GeneticRegulatoryElement representing an enhancer." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ a owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "SuperEnhancer" ;
    rdfs:comment "A subclass of Enhancer representing a super-enhancer." ;
    rdfs:subClassOf greg:Enhancer ;
    rdfs:equivalentClass [ a owl:Class ; rdfs:subClassOf greg:Enhancer ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "TranscriptionFactor" ;
    rdfs:comment "A subclass of GeneticRegulatoryElement representing a transcription factor." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ a owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "TargetGene" ;
    rdfs:comment "A subclass of GeneticRegulatoryElement representing a target gene." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ a owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "Disease" ;
    rdfs:comment "A subclass of GeneticRegulatoryElement representing a disease." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ a owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "CellLineOrBiosample" ;
    rdfs:comment "A subclass of GeneticRegulatoryElement representing a cell line or biosample." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ a owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "Mutation" ;
    rdfs:comment "A subclass of GeneticRegulatoryElement representing a mutation." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ a owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .

owl:Class rdf:type owl:Class ;
    rdfs:label "ChromatinRegulatoryModule" ;
    rdfs:comment "A subclass of GeneticRegulatoryElement representing a chromatin regulatory module." ;
    rdfs:subClassOf greg:GeneticRegulatoryElement ;
    rdfs:equivalentClass [ a owl:Class ; rdfs:subClassOf greg:GeneticRegulatoryElement ] .