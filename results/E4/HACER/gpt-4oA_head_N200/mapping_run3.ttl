<#TriplesMapMutation> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Mutation/{refsnp_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:mutationID;
        rr:objectMap [
            rml:reference "refsnp_ID";
        ]
    ].