        ]
    ].

<#TriplesMapGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Gene/{hgnc_symbol_target_genes}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:geneSymbol;
        rr:objectMap [
            rml:reference "hgnc_symbol_target_genes";
        ]
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/TranscriptionFactor/{hgnc_symbol_TFs}";
