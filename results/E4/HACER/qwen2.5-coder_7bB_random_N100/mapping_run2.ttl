```ttl
<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "{FAIR_URI}GeneticRegulatoryElement/{{type}}_{{crm_ID}}";
    ];
    rr:predicateObjectMap [
        rr:predicate :pmid;
        rr:objectMap [
            rml:reference "TFs2enh_PMID";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate :method;
        rr:objectMap [
            rml:reference "TFs2enh_method";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate :associatedWithDisease;
        rr:objectMap [
            rml:reference "disease";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "{FAIR_URI}TranscriptionFactor/{{hgnc_symbol_TFs}}";
    ];
    rr:predicateObjectMap [
        rr:predicate :pmid;
        rr:objectMap [
            rml:reference "TFs2enh_PMID";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate :method;
        rr:objectMap [
            rml:reference "TFs2enh_method";
            rr:datatype xsd:string
        ]
    ],
    [
        rr:predicate :interactsWithEnhancer;
        rr:objectMap [
            rml:template "{FAIR_URI}Enhancer/{{crm_ID}}";
            rr:datatype xsd:string
        ]
    ].

