<#TriplesMapGeneticRegulatoryElement_pmid> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:GeneticRegulatoryElement/{{TFs2enh_PMID}}{FAIR_URI}";
    ].
    rr:predicateObjectMap [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticRegulatoryElement_pmid>;
        ]
    ].

