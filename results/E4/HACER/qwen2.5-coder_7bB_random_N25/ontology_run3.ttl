@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix genreg: <https://genetic_regulatory_elements.com#> .

owl:DatatypeProperty pmid
    a owl:DatatypeProperty ;
    rdfs:label "PubMed ID" ;
    rdfs:comment "A PubMed ID for the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty method
    a owl:DatatypeProperty ;
    rdfs:label "Method" ;
    rdfs:comment "The method used in the study of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty hgncSymbol
    a owl:DatatypeProperty ;
    rdfs:label "HGNC Symbol" ;
    rdfs:comment "The HGNC symbol of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:string .

owl:DatatypeProperty chromosomeNumber
    a owl:DatatypeProperty ;
    rdfs:label "Chromosome Number" ;
    rdfs:comment "The chromosome number of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:int .

owl:DatatypeProperty scoreValue
    a owl:DatatypeProperty ;
    rdfs:label "Score Value" ;
    rdfs:comment "The score value of the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range xsd:float .

owl:ObjectProperty hasTranscriptionFactor
    a owl:ObjectProperty ;
    rdfs:label "Has Transcription Factor" ;
    rdfs:comment "The transcription factor involved in the genetic regulatory element." ;
    rdfs:domain genreg:TranscriptionFactorToEnhancerInteraction ;
    rdfs:range genreg:TranscriptionFactor .

owl:ObjectProperty hasEnhancer
    a owl:ObjectProperty ;
    rdfs:label "Has Enhancer" ;
    rdfs:comment "The enhancer involved in the genetic regulatory element." ;
    rdfs:domain genreg:TranscriptionFactorToEnhancerInteraction ;
    rdfs:range genreg:Enhancer .

owl:ObjectProperty hasTargetGene
    a owl:ObjectProperty ;
    rdfs:label "Has Target Gene" ;
    rdfs:comment "The target gene involved in the genetic regulatory element." ;
    rdfs:domain genreg:EnhancerToGeneInteraction ;
    rdfs:range genreg:TargetGene .

owl:ObjectProperty associatedWithDisease
    a owl:ObjectProperty ;
    rdfs:label "Associated With Disease" ;
    rdfs:comment "The disease associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:Disease .

owl:ObjectProperty associatedWithMutation
    a owl:ObjectProperty ;
    rdfs:label "Associated With Mutation" ;
    rdfs:comment "The mutation associated with the genetic regulatory element." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:Mutation .

owl:ObjectProperty partOfChromatinRegulatoryModule
    a owl:ObjectProperty ;
    rdfs:label "Part Of Chromatin Regulatory Module" ;
    rdfs:comment "The chromatin regulatory module the genetic regulatory element is part of." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:ChromatinRegulatoryModule .

owl:ObjectProperty occursInCellLineOrBiosample
    a owl:ObjectProperty ;
    rdfs:label "Occurs In Cell Line Or Biosample" ;
    rdfs:comment "The cell line or biosample the genetic regulatory element occurs in." ;
    rdfs:domain genreg:GeneticRegulatoryElement ;
    rdfs:range genreg:CellLineOrBiosample .

owl:Class GeneticRegulatoryElement
    a owl:Class ;
    rdfs:label "Genetic Regulatory Element" ;
    rdfs:comment "A genetic regulatory element such as an enhancer or super-enhancer." ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:pmid ;
        owl:someValuesFrom xsd:string
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:method ;
        owl:someValuesFrom xsd:string
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:hgncSymbol ;
        owl:someValuesFrom xsd:string
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:chromosomeNumber ;
        owl:someValuesFrom xsd:int
    ] , [
        rdf:type owl:Restriction ;
        owl:onProperty genreg:scoreValue ;
        owl:someValuesFrom xsd:float
    ] .

owl:Class TranscriptionFactor
    a owl:Class ;
    rdfs:label "Transcription Factor" ;
    rdfs:comment "A transcription factor involved in the genetic regulatory element." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class Enhancer
    a owl:Class ;
    rdfs:label "Enhancer" ;
    rdfs:comment "An enhancer involved in the genetic regulatory element." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class SuperEnhancer
    a owl:Class ;
    rdfs:label "Super Enhancer" ;
    rdfs:comment "A super-enhancer involved in the genetic regulatory element." ;
    rdfs:subClassOf genreg:Enhancer .

owl:Class TargetGene
    a owl:Class ;
    rdfs:label "Target Gene" ;
    rdfs:comment "A target gene involved in the genetic regulatory element." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class Disease
    a owl:Class ;
    rdfs:label "Disease" ;
    rdfs:comment "A disease associated with the genetic regulatory element." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class Mutation
    a owl:Class ;
    rdfs:label "Mutation" ;
    rdfs:comment "A mutation associated with the genetic regulatory element." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class ChromatinRegulatoryModule
    a owl:Class ;
    rdfs:label "Chromatin Regulatory Module" ;
    rdfs:comment "A chromatin regulatory module the genetic regulatory element is part of." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .

owl:Class CellLineOrBiosample
    a owl:Class ;
    rdfs:label "Cell Line Or Biosample" ;
    rdfs:comment "A cell line or biosample the genetic regulatory element occurs in." ;
    rdfs:subClassOf genreg:GeneticRegulatoryElement .