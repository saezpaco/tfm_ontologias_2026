        rr:objectMap [
            rr:constant "{{TFs2enh_method}}";
        ]
    ].

<#TriplesMapTargetGeneProperties> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
