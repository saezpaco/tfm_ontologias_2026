@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

base:biosampleName a owl:DatatypeProperty ;
    rdfs:domain base:Biosample ;
    rdfs:range xsd:string ;
    rdfs:label "Biosample Name" ;
    skos:definition "Name of the biosample" .

base:chromosome a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:string ;
    rdfs:label "Chromosome" ;
    skos:definition "Chromosome identifier" .

base:startPosition a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "Start Position" ;
    skos:definition "Start position in the genome assembly" .

base:endPosition a owl:DatatypeProperty ;
    rdfs:domain base:GenomicCoordinate ;
    rdfs:range xsd:integer ;
    rdfs:label "End Position" ;
    skos:definition "End position in the genome assembly" .

base:hgncSymbol a owl:DatatypeProperty ;
    rdfs:domain base:Gene ;
    rdfs:range xsd:string ;
    rdfs:label "HGNC Symbol" ;
    skos:definition "HGNC symbol for the gene" .

base:tfSymbol a owl:DatatypeProperty ;
    rdfs:domain base:TranscriptionFactor ;
    rdfs:range xsd:string ;
    rdfs:label "TF Symbol" ;
    skos:definition "HGNC symbol for the transcription factor" .

base:diseaseName a owl:DatatypeProperty ;
    rdfs:domain base:Disease ;
    rdfs:range xsd:string ;
    rdfs:label "Disease Name" ;
    skos:definition "Name of the disease" .

base:methodName a owl:DatatypeProperty ;
    rdfs:domain base:Method ;
    rdfs:range xsd:string ;
    rdfs:label "Method Name" ;
    skos:definition "Name of the method used" .

base:pubmedID a owl:DatatypeProperty ;
    rdfs:domain base:Publication ;
    rdfs:range xsd:string ;
    rdfs:label "PubMed ID" ;
    skos:definition "PubMed ID for the publication" .

base:scoreValue a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:float ;
    rdfs:label "Score Value" ;
    skos:definition "Score value associated with the genetic element" .

base:minimumRatioValue a owl:DatatypeProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range xsd:float ;
    rdfs:label "Minimum Ratio Value" ;
    skos:definition "Minimum ratio value associated with the genetic element" .

base:hasGenomicCoordinate a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:GenomicCoordinate ;
    rdfs:label "Has Genomic Coordinate" ;
    skos:definition "Associates a genetic element with its genomic coordinate" .

base:associatedWithBiosample a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Biosample ;
    rdfs:label "Associated with Biosample" ;
    skos:definition "Associates a genetic element with a biosample" .

base:targetsGene a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Gene ;
    rdfs:label "Targets Gene" ;
    skos:definition "Associates a genetic element with a target gene" .

base:regulatedByTF a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:TranscriptionFactor ;
    rdfs:label "Regulated by Transcription Factor" ;
    skos:definition "Associates a genetic element with a transcription factor" .

base:associatedWithDisease a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Disease ;
    rdfs:label "Associated with Disease" ;
    skos:definition "Associates a genetic element with a disease" .

base:identifiedByMethod a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Method ;
    rdfs:label "Identified by Method" ;
    skos:definition "Associates a genetic element with a method used for its identification" .

base:referencedInPublication a owl:ObjectProperty ;
    rdfs:domain base:GeneticElement ;
    rdfs:range base:Publication ;
    rdfs:label "Referenced in Publication" ;
    skos:definition "Associates a genetic element with a publication" .

base:GeneticElement a owl:Class ;
    rdfs:label "Genetic Element" ;
    skos:definition "A genetic element such as an enhancer, super-enhancer, cis-regulatory module, or mutation" .

base:GenomicCoordinate a owl:Class ;
    rdfs:label "Genomic Coordinate" ;
    skos:definition "A genomic coordinate specifying the location of a genetic element" .

base:Biosample a owl:Class ;
    rdfs:label "Biosample" ;
    skos:definition "A biosample from which genetic data is derived" .

base:Gene a owl:Class ;
    rdfs:label "Gene" ;
    skos:definition "A gene targeted by a genetic element" .

base:TranscriptionFactor a owl:Class ;
    rdfs:label "Transcription Factor" ;
    skos:definition "A transcription factor regulating a genetic element" .

base:Disease a owl:Class ;
    rdfs:label "Disease" ;
    skos:definition "A disease associated with a genetic element" .

base:Method a owl:Class ;
    rdfs:label "Method" ;
    skos:definition "A method used for identifying or associating a genetic element" .

base:Publication a owl:Class ;
    rdfs:label "Publication" ;
    skos:definition "A publication referencing a genetic element" .

base:Enhancer a owl:Class ;
    rdfs:subClassOf base:GeneticElement ;
    rdfs:label "Enhancer" ;
    skos:definition "An enhancer element" .

base:SuperEnhancer a owl:Class ;
    rdfs:subClassOf base:GeneticElement ;
    rdfs:label "Super Enhancer" ;
    skos:definition "A super-enhancer element" .

base:CisRegulatoryModule a owl:Class ;
    rdfs:subClassOf base:GeneticElement ;
    rdfs:label "Cis-Regulatory Module" ;
    skos:definition "A cis-regulatory module" .

base:Mutation a owl:Class ;
    rdfs:subClassOf base:GeneticElement ;
    rdfs:label "Mutation" ;
    skos:definition "A mutation element" .

base:GeneticElement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:hasGenomicCoordinate ;
    owl:someValuesFrom base:GenomicCoordinate
], [
    a owl:Restriction ;
    owl:onProperty base:associatedWithBiosample ;
    owl:someValuesFrom base:Biosample
], [
    a owl:Restriction ;
    owl:onProperty base:targetsGene ;
    owl:someValuesFrom base:Gene
], [
    a owl:Restriction ;
    owl:onProperty base:regulatedByTF ;
    owl:someValuesFrom base:TranscriptionFactor
], [
    a owl:Restriction ;
    owl:onProperty base:associatedWithDisease ;
    owl:someValuesFrom base:Disease
], [
    a owl:Restriction ;
    owl:onProperty base:identifiedByMethod ;
    owl:someValuesFrom base:Method
], [
    a owl:Restriction ;
    owl:onProperty base:referencedInPublication ;
    owl:someValuesFrom base:Publication
], [
    a owl:Restriction ;
    owl:onProperty base:scoreValue ;
    owl:someValuesFrom xsd:float
], [
    a owl:Restriction ;
    owl:onProperty base:minimumRatioValue ;
    owl:someValuesFrom xsd:float
] .

base:GenomicCoordinate rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:chromosome ;
    owl:someValuesFrom xsd:string
], [
    a owl:Restriction ;
    owl:onProperty base:startPosition ;
    owl:someValuesFrom xsd:integer
], [
    a owl:Restriction ;
    owl:onProperty base:endPosition ;
    owl:someValuesFrom xsd:integer
] .

base:Biosample rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:biosampleName ;
    owl:someValuesFrom xsd:string
] .

base:Gene rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:hgncSymbol ;
    owl:someValuesFrom xsd:string
] .

base:TranscriptionFactor rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:tfSymbol ;
    owl:someValuesFrom xsd:string
] .

base:Disease rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:diseaseName ;
    owl:someValuesFrom xsd:string
] .

base:Method rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:methodName ;
    owl:someValuesFrom xsd:string
] .

base:Publication rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty base:pubmedID ;
    owl:someValuesFrom xsd:string
] .