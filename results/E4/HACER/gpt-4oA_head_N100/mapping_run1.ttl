@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .

<#TriplesMapGeneticElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/GeneticElement/{original_ID}";
        rr:class base:GeneticElement
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasGenomicCoordinate;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGenomicCoordinate>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:associatedWithBiosample;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapBiosample>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:targetsGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGene>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:regulatedByTF;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:associatedWithDisease;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapDisease>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:identifiedByMethod;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapMethod>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:referencedInPublication;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPublication>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:scoreValue;
        rr:objectMap [
            rml:reference "score";
            rr:datatype xsd:float
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:minimumRatioValue;
        rr:objectMap [
            rml:reference "minimum_ratio";
            rr:datatype xsd:float
        ]
    ].

<#TriplesMapGenomicCoordinate> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/GenomicCoordinate/{current_chr}_{current_start}_{current_end}";
        rr:class base:GenomicCoordinate
    ];
    rr:predicateObjectMap [
        rr:predicate base:chromosome;
        rr:objectMap [
            rml:reference "current_chr";
            rr:datatype xsd:string
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:startPosition;
        rr:objectMap [
            rml:reference "current_start";
            rr:datatype xsd:integer
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:endPosition;
        rr:objectMap [
            rml:reference "current_end";
            rr:datatype xsd:integer
        ]
    ].

<#TriplesMapBiosample> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Biosample/{biosample_name}";
        rr:class base:Biosample
    ];
    rr:predicateObjectMap [
        rr:predicate base:biosampleName;
        rr:objectMap [
            rml:reference "biosample_name";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapGene> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Gene/{hgnc_symbol_target_genes}";
        rr:class base:Gene
    ];
    rr:predicateObjectMap [
        rr:predicate base:hgncSymbol;
        rr:objectMap [
            rml:reference "hgnc_symbol_target_genes";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/TranscriptionFactor/{hgnc_symbol_TFs}";
        rr:class base:TranscriptionFactor
    ];
    rr:predicateObjectMap [
        rr:predicate base:tfSymbol;
        rr:objectMap [
            rml:reference "hgnc_symbol_TFs";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Disease/{disease}";
        rr:class base:Disease
    ];
    rr:predicateObjectMap [
        rr:predicate base:diseaseName;
        rr:objectMap [
            rml:reference "disease";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapMethod> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Method/{TFs2enh_method}";
        rr:class base:Method
    ];
    rr:predicateObjectMap [
        rr:predicate base:methodName;
        rr:objectMap [
            rml:reference "TFs2enh_method";
            rr:datatype xsd:string
        ]
    ].

<#TriplesMapPublication> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Publication/{TFs2enh_PMID}";
        rr:class base:Publication
    ];
    rr:predicateObjectMap [
        rr:predicate base:pubmedID;
        rr:objectMap [
            rml:reference "TFs2enh_PMID";
            rr:datatype xsd:string
        ]
    ].