    [
        rr:predicate greg:hasMethod;
        rr:objectMap [
            rr:constant "enh2gene_method";
        ]
    ],
    [
        rr:predicate greg:hasTargetGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetGene>;
        ]
    ].

