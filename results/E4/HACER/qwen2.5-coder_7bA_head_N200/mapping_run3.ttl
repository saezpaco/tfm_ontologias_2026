```ttl
<#TriplesMapTranscriptionFactorToEnhancerRelationship> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://genetic_regulatory_elements.com/TranscriptionFactorToEnhancerRelationship/{{TFs2enh_PMID}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate greg:hasPubMedID;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGeneticElement>;
        ]
    ],
    [
        rr:predicate greg:hasMethod;
        rr:objectMap [
            rr:constant "TFs2enh_method";
        ]
    ],
    [
        rr:predicate greg:hasTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>;
        ]
    ],
    [
        rr:predicate greg:hasEnhancer;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapEnhancer>;
        ]
    ].

<#TriplesMapEnhancerToGeneRelationship> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
