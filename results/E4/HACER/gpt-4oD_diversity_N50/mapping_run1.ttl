<#TriplesMapSource> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Source/{source}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:sourceName;
        rr:objectMap [
            rml:reference "source"
        ]
    ].