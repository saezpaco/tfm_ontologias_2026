@prefix base: <https://base_ontology.com#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .

<#TriplesMapGeneticElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/GeneticElement/{original_ID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:crossrefID;
        rr:objectMap [
            rml:reference "crossref"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:minimumRatio;
        rr:objectMap [
            rml:reference "minimum_ratio"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:originalID;
        rr:objectMap [
            rml:reference "original_ID"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:refsnpID;
        rr:objectMap [
            rml:reference "refsnp_ID"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:score;
        rr:objectMap [
            rml:reference "score"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:typeName;
        rr:objectMap [
            rml:reference "type"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasGenomicCoordinate;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapGenomicCoordinate>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:associatedWithBiosample;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapBiosample>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:associatedWithDisease;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapDisease>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:identifiedByMethod;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapMethod>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:referencedInPublication;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPublication>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:regulatesTranscriptionFactor;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTranscriptionFactor>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:targetsGene;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapTargetGene>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:associatedWithMutation;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapMutation>
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:hasSource;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapSource>
        ]
    ].

<#TriplesMapGenomicCoordinate> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/GenomicCoordinate/{current_chr}_{current_start}_{current_end}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:currentAssembly;
        rr:objectMap [
            rml:reference "current_assembly"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:currentChr;
        rr:objectMap [
            rml:reference "current_chr"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:currentEnd;
        rr:objectMap [
            rml:reference "current_end"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:currentStart;
        rr:objectMap [
            rml:reference "current_start"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:origAssembly;
        rr:objectMap [
            rml:reference "orig_assembly"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:origChr;
        rr:objectMap [
            rml:reference "orig_chr"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:origEnd;
        rr:objectMap [
            rml:reference "orig_end"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:origStart;
        rr:objectMap [
            rml:reference "orig_start"
        ]
    ].

<#TriplesMapBiosample> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Biosample/{biosample_name}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:biosampleName;
        rr:objectMap [
            rml:reference "biosample_name"
        ]
    ].

<#TriplesMapDisease> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Disease/{disease}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:diseaseName;
        rr:objectMap [
            rml:reference "disease"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:diseasePMID;
        rr:objectMap [
            rml:reference "disease_PMID"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:diseaseMethod;
        rr:objectMap [
            rml:reference "disease_method"
        ]
    ].

<#TriplesMapMethod> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Method/{TFs2enh_method}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:enh2geneMethod;
        rr:objectMap [
            rml:reference "enh2gene_method"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:enhMethod;
        rr:objectMap [
            rml:reference "enh_method"
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate base:mutationMethod;
        rr:objectMap [
            rml:reference "mutation_method"
        ]
    ].

