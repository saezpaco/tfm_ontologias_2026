        ]
    ].

<#TriplesMapMutation> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://base_ontology.com/Mutation/{mutation_PMID}";
    ];
    rr:predicateObjectMap [
        rr:predicate base:mutationPMID;
        rr:objectMap [
            rml:reference "mutation_PMID"
