        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{biosample_name}}{FAIR_URI}";
    ].

<#TriplesMapPubMedID> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:constant "{{TFs2enh_PMID}}";
        ]
    ],
    [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:constant "{{enh2gene_PMID}}";
        ]
    ],
    [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:constant "{{disease_PMID}}";
        ]
    ],
    [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:constant "{{mutation_PMID}}";
        ]
    ].

<#TriplesMapChromosomeNumber> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:chromosomeNumber;
        rr:objectMap [
            rr:constant "{{orig_chr}}";
        ]
    ],
    [
        rr:predicate genreg:chromosomeNumber;
        rr:objectMap [
            rr:constant "{{current_chr}}";
        ]
    ].

<#TriplesMapScoreValue> a rr:TriplesMap;
