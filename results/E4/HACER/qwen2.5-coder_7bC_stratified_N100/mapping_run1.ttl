```ttl
<#TriplesMapGeneticRegulatoryElement> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{type}}{FAIR_URI}";
    ];
    rr:predicateObjectMap [
        rr:predicate genreg:pmid;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapPubMedID>;
        ]
    ],
    [
        rr:predicate genreg:method;
        rr:objectMap [
            rr:constant "{{method}}";
        ]
    ],
    [
        rr:predicate genreg:chromosomeNumber;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapChromosomeNumber>;
        ]
    ],
    [
        rr:predicate genreg:scoreValue;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapScoreValue>;
        ]
    ].

<#TriplesMapTranscriptionFactor> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{hgnc_symbol_TFs}}{FAIR_URI}";
    ].

<#TriplesMapEnhancer> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "HACER.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "genreg:{{crm_ID}}{FAIR_URI}";
    ].

