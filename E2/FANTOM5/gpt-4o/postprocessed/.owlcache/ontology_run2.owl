<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/ontology/databaseSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>database source</skos:prefLabel>
    <skos:definition>Database from which the cis-regulatory module information is sourced.</skos:definition>
    <skos:exactMatch rdf:resource="http://example.org/vocab/database_name"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/chromosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>chromosome</skos:prefLabel>
    <skos:definition>Chromosome where the cis-regulatory module is located.</skos:definition>
    <skos:exactMatch rdf:resource="http://example.org/vocab/chr_name"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gene</skos:prefLabel>
    <skos:definition>A gene that is a target of a cis-regulatory module.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/startPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:prefLabel>start position</skos:prefLabel>
    <skos:definition>Start position of the cis-regulatory module on the chromosome.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Disease"/>
    <skos:prefLabel>associated with disease</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and disease.</skos:definition>
    <skos:exactMatch rdf:resource="http://example.org/vocab/bgw!crm_ID--doid!doid"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Gene"/>
    <skos:prefLabel>has target gene</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and its target gene.</skos:definition>
    <skos:exactMatch rdf:resource="http://example.org/vocab/bgw!crm_ID--hgncsymbol!9606/gene_symbol"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/assembly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>genome assembly</skos:prefLabel>
    <skos:definition>Genome assembly version for the cis-regulatory module coordinates.</skos:definition>
    <skos:exactMatch rdf:resource="http://example.org/vocab/GRCh38"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/experimentalMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>experimental method</skos:prefLabel>
    <skos:definition>Experimental method used to identify the cis-regulatory module.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/interactsWithTF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/TranscriptionFactor"/>
    <skos:prefLabel>interacts with transcription factor</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and transcription factor.</skos:definition>
    <skos:exactMatch rdf:resource="http://example.org/vocab/bgw!crm_ID--uniprot!uniprot_ID"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/score">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <skos:prefLabel>score</skos:prefLabel>
    <skos:definition>Score indicating the confidence or strength of the cis-regulatory module.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/FANTOM5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>FANTOM5 Enhancer Ontology</rdfs:label>
    <rdfs:comment>Ontology for enhancers identified by CAGE-seq in the FANTOM5 database.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/endPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:prefLabel>end position</skos:prefLabel>
    <skos:definition>End position of the cis-regulatory module on the chromosome.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/minimumRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <skos:prefLabel>minimum ratio</skos:prefLabel>
    <skos:definition>Minimum ratio value associated with the cis-regulatory module.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Disease</skos:prefLabel>
    <skos:definition>A disease associated with a cis-regulatory module.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cis-regulatory module</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position</skos:definition>
    <skos:exactMatch rdf:resource="http://example.org/vocab/crm/crm_ID"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
    <skos:definition>A transcription factor that interacts with a cis-regulatory module.</skos:definition>
  </rdf:Description>
</rdf:RDF>
