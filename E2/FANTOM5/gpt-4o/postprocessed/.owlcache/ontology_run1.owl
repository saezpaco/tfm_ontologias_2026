<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasChromosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has chromosome</skos:prefLabel>
    <skos:definition>Chromosome where the cis-regulatory module is located.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gene</skos:prefLabel>
    <skos:definition>A gene that is a target of a cis-regulatory module.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasStartPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has start position</skos:prefLabel>
    <skos:definition>Start position of the cis-regulatory module on the chromosome.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/associatedWithTF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>associated with transcription factor</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and transcription factor.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CRM"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/TranscriptionFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has method</skos:prefLabel>
    <skos:definition>Method used to identify the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasMinimumRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has minimum ratio</skos:prefLabel>
    <skos:definition>Minimum ratio of enhancer activity.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>has target gene</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and its target gene.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CRM"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has source</skos:prefLabel>
    <skos:definition>Source database or project that identified the enhancer.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has score</skos:prefLabel>
    <skos:definition>Score representing the confidence of enhancer activity.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/FANTOM5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>FANTOM5 Enhancer Ontology</rdfs:label>
    <rdfs:comment>Ontology for enhancers identified by CAGE-seq in the FANTOM5 database.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>CRM</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasAssemblyVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has assembly version</skos:prefLabel>
    <skos:definition>Genome assembly version used for the coordinates.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
    <skos:definition>A protein that binds to specific DNA sequences, thereby controlling the rate of transcription of genetic information.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Disease</skos:prefLabel>
    <skos:definition>A disorder or abnormal condition that is associated with a cis-regulatory module.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>associated with disease</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and disease.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CRM"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/Disease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/hasEndPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>has end position</skos:prefLabel>
    <skos:definition>End position of the cis-regulatory module on the chromosome.</skos:definition>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
</rdf:RDF>
