<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/ontology/hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>bgw!crm_ID--hgncsymbol!9606/gene_symbol</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and gene gene_symbol</skos:definition>
    <skos:exactMatch rdf:resource="http://example.org/ontology/bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/interactsWithTF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>bgw!crm_ID--uniprot!uniprot_ID</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and transcription factor uniprot_ID</skos:definition>
    <skos:exactMatch rdf:resource="http://example.org/ontology/bgw!crm_ID--uniprot!uniprot_ID#database_name"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/TranscriptionFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>database_name</skos:prefLabel>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>bgw!crm_ID--doid!doid</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and disease DOID:doid</skos:definition>
    <skos:exactMatch rdf:resource="http://example.org/ontology/bgw!crm_ID--doid!doid#database_name"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/DOID_4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasGenomicCoordinates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>chr_name</skos:prefLabel>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/FANTOM5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>FANTOM5 Enhancer Ontology</rdfs:label>
    <rdfs:comment>Ontology for enhancers identified by CAGE-seq in the FANTOM5 database.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>CRM</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position</skos:definition>
    <skos:exactMatch rdf:resource="http://example.org/ontology/crm/crm_ID"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasPMID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasMinimumRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/Database">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Database</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/GRCh38">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>GRCh38</skos:prefLabel>
  </rdf:Description>
</rdf:RDF>
