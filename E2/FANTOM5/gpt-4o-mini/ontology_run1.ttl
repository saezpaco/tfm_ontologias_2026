@prefix crm: <http://example.org/ontology/crm#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix doid: <http://purl.obolibrary.org/obo/DOID_> .
@prefix uniprot: <http://purl.uniprot.org/uniprot/> .

crm:CRM a owl:Class ;
    skos:prefLabel "CRM" ;
    skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

crm:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "Gene associated with a cis-regulatory module" .

crm:TranscriptionFactor a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "Transcription factor associated with a cis-regulatory module" .

crm:Disease a owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "Disease associated with a cis-regulatory module" .

crm:hasTargetGene a owl:ObjectProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range crm:Gene ;
    skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
    skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name" .

crm:hasTranscriptionFactor a owl:ObjectProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range crm:TranscriptionFactor ;
    skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
    skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID" .

crm:hasDisease a owl:ObjectProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range crm:Disease ;
    skos:prefLabel "bgw!crm_ID--doid!doid" ;
    skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid" .

crm:hasGenomicCoordinates a owl:DatatypeProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "Genomic Coordinates" ;
    skos:definition "Genomic coordinates of the cis-regulatory module" .

crm:hasScore a owl:DatatypeProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range xsd:float ;
    skos:prefLabel "Score" ;
    skos:definition "Score associated with the cis-regulatory module" .

crm:hasSource a owl:DatatypeProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "Source" ;
    skos:definition "Source of the cis-regulatory module data" .

crm:hasMethod a owl:DatatypeProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "Method" ;
    skos:definition "Method used to identify the cis-regulatory module" .

crm:hasPMID a owl:DatatypeProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "PMID" ;
    skos:definition "PubMed ID associated with the cis-regulatory module" .

crm:hasID a owl:DatatypeProperty ;
    rdfs:domain crm:CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "CRM ID" ;
    skos:definition "Unique identifier for the cis-regulatory module" .