<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Disease</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--doid!doid</skos:prefLabel>
    <skos:definition>Disease associated with the cis-regulatory module.</skos:definition>
    <obo:hasSynonym>cis-regulatory element disease</obo:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/database">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Database</rdfs:label>
    <skos:prefLabel>database_name</skos:prefLabel>
    <skos:definition>Database where the cis-regulatory module was identified.</skos:definition>
    <obo:hasSynonym>cis-regulatory element database</obo:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/geneSymbol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Gene symbol</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--hgncsymbol!9606/gene_sybmol</skos:prefLabel>
    <skos:definition>Symbol for the gene associated with the cis-regulatory module.</skos:definition>
    <obo:hasSynonym>cis-regulatory element gene symbol</obo:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/chrName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Chromosome name</rdfs:label>
    <skos:prefLabel>chr_name</skos:prefLabel>
    <skos:definition>Name of the chromosome where the cis-regulatory module is located.</skos:definition>
    <obo:hasSynonym>chromosome name</obo:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/databaseName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Database name</rdfs:label>
    <skos:prefLabel>database_name</skos:prefLabel>
    <skos:definition>Name of the database where the cis-regulatory module was identified.</skos:definition>
    <obo:hasSynonym>cis-regulatory element database name</obo:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/endPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>End position</rdfs:label>
    <skos:prefLabel>end_position</skos:prefLabel>
    <skos:definition>Ending position of the cis-regulatory module on the chromosome.</skos:definition>
    <obo:hasSynonym>cis-regulatory element end position</obo:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/association">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Association</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--hgncsymbol!9606/gene_sybmol#database_name</skos:prefLabel>
    <skos:definition>Association between the cis-regulatory module and another entity.</skos:definition>
    <obo:hasSynonym>cis-regulatory element association</obo:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/Module">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cis-regulatory module</rdfs:label>
    <skos:prefLabel>CRM</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position</skos:definition>
    <obo:hasSynonym>cis-regulatory element</obo:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/ModuleID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Cis-regulatory module ID</rdfs:label>
    <skos:prefLabel>crm/crm_ID</skos:prefLabel>
    <skos:definition>Unique identifier for a cis-regulatory module.</skos:definition>
    <obo:hasSynonym>cis-regulatory element ID</obo:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/startPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Start position</rdfs:label>
    <skos:prefLabel>start_position</skos:prefLabel>
    <skos:definition>Starting position of the cis-regulatory module on the chromosome.</skos:definition>
    <obo:hasSynonym>cis-regulatory element start position</obo:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/cisreg-ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Cis-regulatory Module Ontology</rdfs:label>
    <skos:prefLabel>CRM Ontology</skos:prefLabel>
    <skos:definition>Ontology for describing cis-regulatory modules in Homo sapiens.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/transcriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Transcription factor</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--uniprot!uniprot_ID</skos:prefLabel>
    <skos:definition>Transcription factor associated with the cis-regulatory module.</skos:definition>
    <obo:hasSynonym>cis-regulatory element transcription factor</obo:hasSynonym>
  </rdf:Description>
</rdf:RDF>
