@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/cisreg>
  a owl:Ontology ;
  rdfs:label "cis-regulatory module ontology" .

crm a owl:Class ;
  skos:prefLabel "CRM" ;
  skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

crm_ID a owl:ObjectProperty ;
  rdfs:label "crm ID" ;
  skos:prefLabel "crm/crm_ID" ;
  skos:exactMatch <http://example.org/crm#crm_ID> .

chr_name a owl:DatatypeProperty ;
  rdfs:label "chromosome name" ;
  skos:prefLabel "chr_name" ;
  xsd:type xsd:string .

start_position a owl:DatatypeProperty ;
  rdfs:label "start position" ;
  skos:prefLabel "start_position" ;
  xsd:type xsd:integer .

end_position a owl:DatatypeProperty ;
  rdfs:label "end position" ;
  skos:prefLabel "end_position" ;
  xsd:type xsd:integer .

database_name a owl:DatatypeProperty ;
  rdfs:label "database name" ;
  skos:prefLabel "database_name" ;
  xsd:type xsd:string .

hgnc_symbol_target_genes a owl:ObjectProperty ;
  rdfs:label "HGNC symbol target genes" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" ;
  skos:exactMatch <http://example.org/crm#crm_ID--hgncsymbol!9606/gene_symbol> .

enh2gene_PMID a owl:ObjectProperty ;
  rdfs:label "Enhancer to gene PMID" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/PMID" ;
  xsd:type xsd:string .

enh2gene_method a owl:DatatypeProperty ;
  rdfs:label "Enhancer to gene method" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/method" ;
  xsd:type xsd:string .

hgnc_symbol_TFs a owl:ObjectProperty ;
  rdfs:label "HGNC symbol transcription factors" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
  skos:exactMatch <http://example.org/crm#crm_ID--uniprot!uniprot_ID> .

TFs2enh_PMID a owl:ObjectProperty ;
  rdfs:label "Transcription factors to enhancer PMID" ;
  skos:prefLabel "bgw!crm_ID--uniprot!PMID" ;
  xsd:type xsd:string .

TFs2enh_method a owl:DatatypeProperty ;
  rdfs:label "Transcription factors to enhancer method" ;
  skos:prefLabel "bgw!crm_ID--uniprot!method" ;
  xsd:type xsd:string .

disease a owl:ObjectProperty ;
  rdfs:label "Disease" ;
  skos:prefLabel "bgw!crm_ID--doid!doid" ;
  skos:exactMatch <http://example.org/crm#crm_ID--doid!doid> .

disease_PMID a owl:ObjectProperty ;
  rdfs:label "Disease PMID" ;
  skos:prefLabel "bgw!crm_ID--doid!PMID" ;
  xsd:type xsd:string .

disease_method a owl:DatatypeProperty ;
  rdfs:label "Disease method" ;
  skos:prefLabel "bgw!crm_ID--doid!method" ;
  xsd:type xsd:string .