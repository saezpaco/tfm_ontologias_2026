@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://rdf.biogateway.eu/crm/> .

<http://example.org/cisreg-ontology>
  a owl:Ontology ;
  rdfs:label "Cis-regulatory Module Ontology" ;
  skos:prefLabel "CRM Ontology" .

crm:CRM
  a owl:Class ;
  rdfs:label "Cis-regulatory module" ;
  skos:prefLabel "CRM" ;
  skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

crm:hasChrName
  a owl:ObjectProperty ;
  rdfs:label "Has chromosome name" ;
  skos:prefLabel "chr_name" ;
  obo:IAO_0000115 "has_part" .

crm:hasStartPosition
  a owl:ObjectProperty ;
  rdfs:label "Has start position" ;
  skos:prefLabel "start_position" ;
  obo:IAO_0000115 "has_part" .

crm:hasEndPosition
  a owl:ObjectProperty ;
  rdfs:label "Has end position" ;
  skos:prefLabel "end_position" ;
  obo:IAO_0000115 "has_part" .

crm:hasDatabaseName
  a owl:ObjectProperty ;
  rdfs:label "Has database name" ;
  skos:prefLabel "database_name" ;
  obo:IAO_0000115 "has_part" .

crm:isLocatedIn
  a owl:ObjectProperty ;
  rdfs:label "Is located in" ;
  skos:prefLabel "chr_name" ;
  obo:IAO_0000115 "part_of" .

crm:hasAssembly
  a owl:ObjectProperty ;
  rdfs:label "Has assembly" ;
  skos:prefLabel "assembly" ;
  obo:IAO_0000115 "has_part" .

crm:hasMinimumRatio
  a owl:DatatypeProperty ;
  rdfs:label "Has minimum ratio" ;
  skos:prefLabel "minimum_ratio" ;
  xsd:dataType xsd:float .

crm:hasScore
  a owl:DatatypeProperty ;
  rdfs:label "Has score" ;
  skos:prefLabel "score" ;
  xsd:dataType xsd:float .

crm:hasOriginalID
  a owl:ObjectProperty ;
  rdfs:label "Has original ID" ;
  skos:prefLabel "original_ID" ;
  obo:IAO_0000115 "has_part" .

crm:hasCrossref
  a owl:ObjectProperty ;
  rdfs:label "Has cross reference" ;
  skos:prefLabel "crossref" ;
  obo:IAO_0000115 "has_part" .

crm:hasPMID
  a owl:ObjectProperty ;
  rdfs:label "Has PMID" ;
  skos:prefLabel "enh_PMID" ;
  obo:IAO_0000115 "has_part" .

crm:hasBiosample
  a owl:ObjectProperty ;
  rdfs:label "Has biosample" ;
  skos:prefLabel "biosample" ;
  obo:IAO_0000115 "has_part" .

crm:hasEnhMethod
  a owl:ObjectProperty ;
  rdfs:label "Has enhancer method" ;
  skos:prefLabel "enh_method" ;
  obo:IAO_0000115 "has_part" .

crm:hasType
  a owl:ObjectProperty ;
  rdfs:label "Has type" ;
  skos:prefLabel "type" ;
  obo:IAO_0000115 "has_part" .

crm:hasSource
  a owl:ObjectProperty ;
  rdfs:label "Has source" ;
  skos:prefLabel "source" ;
  obo:IAO_0000115 "has_part" .

crm:hasDatabaseName
  a owl:ObjectProperty ;
  rdfs:label "Has database name" ;
  skos:prefLabel "database_name" ;
  obo:IAO_0000115 "has_part" .

crm:isAssociatedWithGene
  a owl:ObjectProperty ;
  rdfs:label "Is associated with gene" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" ;
  obo:IAO_0000115 "part_of" .

crm:isAssociatedWithDisease
  a owl:ObjectProperty ;
  rdfs:label "Is associated with disease" ;
  skos:prefLabel "bgw!crm_ID--doid!doid#database_name" ;
  obo:IAO_0000115 "part_of" .

crm:isAssociatedWithTranscriptionFactor
  a owl:ObjectProperty ;
  rdfs:label "Is associated with transcription factor" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID#database_name" ;
  obo:IAO_0000115 "part_of" .

crm:hasChrNameExactMatch
  a owl:ObjectProperty ;
  rdfs:label "Has chromosome name exact match" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" ;
  obo:IAO_0000115 "exact_match" .

crm:hasDiseaseExactMatch
  a owl:ObjectProperty ;
  rdfs:label "Has disease exact match" ;
  skos:prefLabel "bgw!crm_ID--doid!doid#database_name" ;
  obo:IAO_0000115 "exact_match" .

crm:hasTranscriptionFactorExactMatch
  a owl:ObjectProperty ;
  rdfs:label "Has transcription factor exact match" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID#database_name" ;
  obo:IAO_0000115 "exact_match" .

crm:hasChrNameCloseMatch
  a owl:ObjectProperty ;
  rdfs:label "Has chromosome name close match" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" ;
  obo:IAO_0000115 "close_match" .

crm:hasDiseaseCloseMatch
  a owl:ObjectProperty ;
  rdfs:label "Has disease close match" ;
  skos:prefLabel "bgw!crm_ID--doid!doid#database_name" ;
  obo:IAO_0000115 "close_match" .

crm:hasTranscriptionFactorCloseMatch
  a owl:ObjectProperty ;
  rdfs:label "Has transcription factor close match" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID#database_name" ;
  obo:IAO_0000115 "close_match" .
