@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://rdf.biogateway.eu/crm/> .

<http://example.org/cisreg-ontology>
  a owl:Ontology ;
  rdfs:label "Cis-regulatory Module Ontology" ;
  skos:prefLabel "CRM Ontology" ;
  skos:definition "Ontology for describing cis-regulatory modules in Homo sapiens." .

crm:Module
  a owl:Class ;
  rdfs:label "Cis-regulatory module" ;
  skos:prefLabel "CRM" ;
  skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" ;
  obo:hasSynonym "cis-regulatory element" .

crm:ModuleID
  a owl:ObjectProperty ;
  rdfs:label "Cis-regulatory module ID" ;
  skos:prefLabel "crm/crm_ID" ;
  skos:definition "Unique identifier for a cis-regulatory module." ;
  obo:hasSynonym "cis-regulatory element ID" .

crm:chrName
  a owl:ObjectProperty ;
  rdfs:label "Chromosome name" ;
  skos:prefLabel "chr_name" ;
  skos:definition "Name of the chromosome where the cis-regulatory module is located." ;
  obo:hasSynonym "chromosome name" .

crm:startPosition
  a owl:ObjectProperty ;
  rdfs:label "Start position" ;
  skos:prefLabel "start_position" ;
  skos:definition "Starting position of the cis-regulatory module on the chromosome." ;
  obo:hasSynonym "cis-regulatory element start position" .

crm:endPosition
  a owl:ObjectProperty ;
  rdfs:label "End position" ;
  skos:prefLabel "end_position" ;
  skos:definition "Ending position of the cis-regulatory module on the chromosome." ;
  obo:hasSynonym "cis-regulatory element end position" .

crm:databaseName
  a owl:ObjectProperty ;
  rdfs:label "Database name" ;
  skos:prefLabel "database_name" ;
  skos:definition "Name of the database where the cis-regulatory module was identified." ;
  obo:hasSynonym "cis-regulatory element database name" .

crm:geneSymbol
  a owl:ObjectProperty ;
  rdfs:label "Gene symbol" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" ;
  skos:definition "Symbol for the gene associated with the cis-regulatory module." ;
  obo:hasSynonym "cis-regulatory element gene symbol" .

crm:disease
  a owl:ObjectProperty ;
  rdfs:label "Disease" ;
  skos:prefLabel "bgw!crm_ID--doid!doid" ;
  skos:definition "Disease associated with the cis-regulatory module." ;
  obo:hasSynonym "cis-regulatory element disease" .

crm:transcriptionFactor
  a owl:ObjectProperty ;
  rdfs:label "Transcription factor" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
  skos:definition "Transcription factor associated with the cis-regulatory module." ;
  obo:hasSynonym "cis-regulatory element transcription factor" .

crm:association
  a owl:ObjectProperty ;
  rdfs:label "Association" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol#database_name" ;
  skos:definition "Association between the cis-regulatory module and another entity." ;
  obo:hasSynonym "cis-regulatory element association" .

crm:database
  a owl:ObjectProperty ;
  rdfs:label "Database" ;
  skos:prefLabel "database_name" ;
  skos:definition "Database where the cis-regulatory module was identified." ;
  obo:hasSynonym "cis-regulatory element database" .
