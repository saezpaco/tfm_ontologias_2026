   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasCRMID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>crm_ID</skos:prefLabel>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasStartPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>start_position</skos:prefLabel>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/Database">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Database</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003674"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/TranscriptionFactorAssociation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
