  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/CisRegulatoryModule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cis-regulatory module</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0001824"/>
