    <rdfs:range rdf:resource="http://rdf.biogateway.eu/crm/TranscriptionFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasEndPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>end_position</skos:prefLabel>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasGeneSymbol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>hgncsymbol</skos:prefLabel>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/Association"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasDOID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel>doid</skos:prefLabel>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/DiseaseAssociation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003705"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/Association">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel>Association</skos:prefLabel>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CisRegulatoryModule"/>
