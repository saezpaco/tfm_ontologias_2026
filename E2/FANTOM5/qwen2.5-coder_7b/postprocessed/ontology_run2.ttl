@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://rdf.biogateway.eu/crm/> .

crm:TranscriptionFactor a owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    rdfs:subClassOf obo:GO_0003705 .

crm:CisRegulatoryModule a owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    rdfs:subClassOf obo:SO_0001849 .

crm:Database a owl:Class ;
    skos:prefLabel "Database" ;
    rdfs:subClassOf obo:GO_0003674 .

crm:Association a owl:ObjectProperty ;
    skos:prefLabel "Association" ;
    rdfs:domain crm:CisRegulatoryModule ;
    rdfs:range crm:Gene .

crm:TranscriptionFactorAssociation a owl:ObjectProperty ;
    skos:prefLabel "Transcription Factor Association" ;
    rdfs:domain crm:CisRegulatoryModule ;
    rdfs:range crm:TranscriptionFactor .

crm:Gene a owl:Class ;
    skos:prefLabel "Gene" ;
    rdfs:subClassOf obo:SO_0001217 .

crm:Disease a owl:Class ;
    skos:prefLabel "Disease" ;
    rdfs:subClassOf obo:GO_0043226 .

crm:CisRegulatoryModuleDatabase a owl:ObjectProperty ;
    skos:prefLabel "Cis-regulatory module database association" ;
    rdfs:domain crm:CisRegulatoryModule ;
    rdfs:range crm:Database .

crm:TranscriptionFactorUniprot a owl:ObjectProperty ;
    skos:prefLabel "Transcription Factor Uniprot Association" ;
    rdfs:domain crm:CisRegulatoryModule ;
    rdfs:range xsd:string .

crm:DiseaseDOID a owl:ObjectProperty ;
    skos:prefLabel "Disease DOID Association" ;
    rdfs:domain crm:CisRegulatoryModule ;
    rdfs:range xsd:string .

crm:GeneSymbol a owl:ObjectProperty ;
    skos:prefLabel "Gene Symbol Association" ;
    rdfs:domain crm:CisRegulatoryModule ;
    rdfs:range xsd:string .

crm:Chromosome a owl:Class ;
    skos:prefLabel "Chromosome" ;
    rdfs:subClassOf obo:SO_0001217 .

crm:StartPosition a owl:DatatypeProperty ;
    skos:prefLabel "Start Position" ;
    rdf:type xsd:integer ;
    rdfs:domain crm:CisRegulatoryModule ;

crm:EndPosition a owl:DatatypeProperty ;
    skos:prefLabel "End Position" ;
    rdf:type xsd:integer ;
    rdfs:domain crm:CisRegulatoryModule .

crm:ChromosomeName a owl:DatatypeProperty ;
    skos:prefLabel "Chromosome Name" ;
    rdf:type xsd:string ;
    rdfs:domain crm:CisRegulatoryModule ;

crm:GRCh38 a owl:Class ;
    skos:prefLabel "GRCh38" ;
    rdfs:subClassOf obo:SO_0001217 .

crm:HomoSapiens a owl:Class ;
    skos:prefLabel "Homo sapiens" ;
    rdfs:subClassOf obo:NCBITaxon_9606 .
