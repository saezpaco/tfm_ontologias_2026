<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>dbSUPER Ontology</rdfs:label>
    <rdfs:comment>Ontology for representing super-enhancers from the dbSUPER database.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#hasAssembly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/dbSUPER#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>GRCh38</skos:prefLabel>
    <skos:definition>Genome assembly version for the cis-regulatory module coordinates.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gene</skos:prefLabel>
    <skos:definition>A gene that is a target of a cis-regulatory module.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#hasStartPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/dbSUPER#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:prefLabel>start_position</skos:prefLabel>
    <skos:definition>Start position of the cis-regulatory module on the chromosome.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#interactsWithTF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/dbSUPER#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://example.org/ontology/dbSUPER#TranscriptionFactor"/>
    <skos:prefLabel>bgw!crm_ID--uniprot!uniprot_ID</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and transcription factor uniprot_ID</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/dbSUPER#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://example.org/ontology/dbSUPER#Gene"/>
    <skos:prefLabel>bgw!crm_ID--hgncsymbol!9606/gene_symbol</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#hasDatabase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/dbSUPER#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>database_name</skos:prefLabel>
    <skos:definition>Name of the database providing the cis-regulatory module information.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#hasChromosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/dbSUPER#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>chr_name</skos:prefLabel>
    <skos:definition>Chromosome where the cis-regulatory module is located.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
    <skos:definition>A transcription factor that interacts with a cis-regulatory module.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/dbSUPER#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://example.org/ontology/dbSUPER#Disease"/>
    <skos:prefLabel>bgw!crm_ID--doid!doid</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and disease DOID:doid</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#hasEndPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/dbSUPER#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:prefLabel>end_position</skos:prefLabel>
    <skos:definition>End position of the cis-regulatory module on the chromosome.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#CisRegulatoryModule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>CRM</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/dbSUPER#Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Disease</skos:prefLabel>
    <skos:definition>A disease associated with a cis-regulatory module.</skos:definition>
  </rdf:Description>
</rdf:RDF>
