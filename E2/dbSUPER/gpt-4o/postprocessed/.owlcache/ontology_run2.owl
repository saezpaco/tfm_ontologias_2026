<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/ontology#TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
    <skos:definition>A protein that binds to specific DNA sequences to regulate transcription</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Disease</skos:prefLabel>
    <skos:definition>A disorder or condition associated with a cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasTranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://example.org/ontology#TranscriptionFactor"/>
    <skos:prefLabel>bgw!crm_ID--uniprot!uniprot_ID</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and transcription factor uniprot_ID</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CisRegulatoryModule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>CRM</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gene</skos:prefLabel>
    <skos:definition>A target gene regulated by a cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasExperimentalMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>Experimental Method</skos:prefLabel>
    <skos:definition>The method used to identify the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Gene"/>
    <skos:prefLabel>bgw!crm_ID--hgncsymbol!9606/gene_symbol</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and gene gene_symbol</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Disease"/>
    <skos:prefLabel>bgw!crm_ID--doid!doid</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and disease DOID:doid</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasDatabaseSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>Database</skos:prefLabel>
    <skos:definition>The database from which the cis-regulatory module information is sourced</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <skos:prefLabel>Score</skos:prefLabel>
    <skos:definition>The score representing the confidence or activity level of the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasGenomicCoordinates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>Genomic Coordinates</skos:prefLabel>
    <skos:definition>The genomic coordinates of the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#SuperEnhancer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Super-enhancer</skos:prefLabel>
    <skos:definition>A type of cis-regulatory module with high transcriptional activity</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#hasBiosample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#CisRegulatoryModule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>Biosample Name</skos:prefLabel>
    <skos:definition>The biosample in which the cis-regulatory module is active</skos:definition>
  </rdf:Description>
</rdf:RDF>
