<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/dbSUPER">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>dbSUPER</rdfs:label>
    <skos:prefLabel>dbSUPER</skos:prefLabel>
    <skos:definition>Super-enhancers con coordenadas, líneas celulares y genes diana</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasChrName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>chr_name</rdfs:label>
    <skos:prefLabel>chr_name</skos:prefLabel>
    <skos:definition>The chromosome name where the cis-regulatory module is located</skos:definition>
    <obo:hasValue rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasTranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>bgw!crm_ID--uniprot!uniprot_ID</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--uniprot!uniprot_ID</skos:prefLabel>
    <skos:definition>The transcription factor associated with the cis-regulatory module</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasDiseaseCloseMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>skos:closeMatch</rdfs:label>
    <skos:prefLabel>skos:closeMatch</skos:prefLabel>
    <skos:definition>The close match of the disease in another database</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasTranscriptionFactorCloseMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>skos:closeMatch</rdfs:label>
    <skos:prefLabel>skos:closeMatch</skos:prefLabel>
    <skos:definition>The close match of the transcription factor in another database</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasEndPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>end_position</rdfs:label>
    <skos:prefLabel>end_position</skos:prefLabel>
    <skos:definition>The end position of the cis-regulatory module on the chromosome</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#base_pair"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasGeneSymbolCloseMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>skos:closeMatch</rdfs:label>
    <skos:prefLabel>skos:closeMatch</skos:prefLabel>
    <skos:definition>The close match of the gene symbol in another database</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>bgw!crm_ID--doid!doid</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--doid!doid</skos:prefLabel>
    <skos:definition>The disease associated with the cis-regulatory module</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasGeneSymbol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>bgw!crm_ID--hgncsymbol!9606/gene_symbol</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--hgncsymbol!9606/gene_sybmol</skos:prefLabel>
    <skos:definition>The gene symbol associated with the cis-regulatory module</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasDatabaseNameCloseMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>skos:closeMatch</rdfs:label>
    <skos:prefLabel>skos:closeMatch</skos:prefLabel>
    <skos:definition>The close match of the database name in another database</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasDatabaseName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>database_name</rdfs:label>
    <skos:prefLabel>database_name</skos:prefLabel>
    <skos:definition>The database where the cis-regulatory module is located</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasChrNameExactMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>skos:exactMatch</rdfs:label>
    <skos:prefLabel>skos:exactMatch</skos:prefLabel>
    <skos:definition>The exact match of the chromosome name in another database</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasStartPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>start_position</rdfs:label>
    <skos:prefLabel>start_position</skos:prefLabel>
    <skos:definition>The start position of the cis-regulatory module on the chromosome</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#base_pair"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasCrmIdCloseMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>skos:closeMatch</rdfs:label>
    <skos:prefLabel>skos:closeMatch</skos:prefLabel>
    <skos:definition>The close match of the cis-regulatory module identifier in another database</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/hasCrmId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>crm_ID</rdfs:label>
    <skos:prefLabel>crm/crm_ID</skos:prefLabel>
    <skos:definition>The unique identifier of the cis-regulatory module in the database</skos:definition>
    <obo:range rdf:resource="http://purl.obolibrary.org/obo/units#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cis-regulatory module</rdfs:label>
    <skos:prefLabel>CRM</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position</skos:definition>
  </rdf:Description>
</rdf:RDF>
