@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://example.org/dbSUPER>
  a owl:Ontology ;
  rdfs:label "dbSUPER Ontology" ;
  skos:prefLabel "dbSUPER Ontology" ;
  skos:definition "Super-enhancers con coordenadas, líneas celulares y genes diana" .

crm:CRM
  a owl:Class ;
  rdfs:label "Cis-regulatory module" ;
  skos:prefLabel "CRM" ;
  skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

crm:hasChrName
  a owl:ObjectProperty ;
  rdfs:label "Has chromosome name" ;
  skos:prefLabel "chr_name" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/NCBITaxon_9606> .

crm:hasStartPosition
  a owl:DatatypeProperty ;
  rdfs:label "Has start position" ;
  xsd:type xsd:int ;
  skos:prefLabel "start_position" .

crm:hasEndPosition
  a owl:DatatypeProperty ;
  rdfs:label "Has end position" ;
  xsd:type xsd:int ;
  skos:prefLabel "end_position" .

crm:hasDatabaseName
  a owl:ObjectProperty ;
  rdfs:label "Has database name" ;
  skos:prefLabel "database_name" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/NCBITaxon_9606> .

crm:isLocatedIn
  a owl:ObjectProperty ;
  rdfs:label "Is located in" ;
  skos:prefLabel "crm#crm_ID#database_name" ;
  skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position according to database_name" .

crm:hasAssociation
  a owl:ObjectProperty ;
  rdfs:label "Has association" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" ;
  skos:definition "Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name" .

crm:hasDiseaseAssociation
  a owl:ObjectProperty ;
  rdfs:label "Has disease association" ;
  skos:prefLabel "bgw!crm_ID--doid!doid#database_name" ;
  skos:definition "Association between cis-regulatory module crm_ID and disease DOID:doid according to database_name" .

crm:hasTranscriptionFactor
  a owl:ObjectProperty ;
  rdfs:label "Has transcription factor" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID#database_name" ;
  skos:definition "Association between cis-regulatory module crm_ID and transcription factor uniprot_ID according to database_name" .

crm:hasGeneSymbol
  a owl:ObjectProperty ;
  rdfs:label "Has gene symbol" ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/HGNC:TBX5> .

crm:hasDisease
  a owl:ObjectProperty ;
  rdfs:label "Has disease" ;
  skos:prefLabel "bgw!crm_ID--doid!doid" ;
  skos:exactMatch <http://purl.obolibrary.org/obo/DOID:12345> .

crm:hasTranscriptionFactorUniprot
  a owl:ObjectProperty ;
  rdfs:label "Has transcription factor uniprot ID" ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" ;
  skos:exactMatch <http://purl.uniprot.org/uniprot/UniProtKB:P12345> .