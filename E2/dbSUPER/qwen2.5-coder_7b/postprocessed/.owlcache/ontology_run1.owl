<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Disease</rdfs:label>
    <skos:prefLabel>doid!doid#database_name</skos:prefLabel>
    <skos:definition>A disorder or condition affecting the normal functioning of an organism</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0001250"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Gene</rdfs:label>
    <skos:prefLabel>hgncsymbol!9606/gene_symbol</skos:prefLabel>
    <skos:definition>A segment of DNA that codes for a protein or RNA molecule</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0001217"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/TranscriptionFactorAssociation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Transcription Factor Association</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--uniprot!uniprot_ID#database_name</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and transcription factor uniprot_ID according to database_name</skos:definition>
    <owl:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <owl:range rdf:resource="http://rdf.biogateway.eu/crm/TranscriptionFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/start_position">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>start_position</rdfs:label>
    <skos:prefLabel>start_position</skos:prefLabel>
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</xsd:minInclusive>
    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2147483647</xsd:maxInclusive>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/Database">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Database</rdfs:label>
    <skos:prefLabel>database_name</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position according to database_name</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0001657"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/Association">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Association</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and gene gene_symbol according to database_name</skos:definition>
    <owl:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <owl:range rdf:resource="http://rdf.biogateway.eu/crm/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Transcription Factor</rdfs:label>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
    <skos:definition>A protein that binds to DNA and regulates the transcription of genes</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0001657"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/chr_name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>chr_name</rdfs:label>
    <skos:prefLabel>chr_name</skos:prefLabel>
    <xsd:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</xsd:minLength>
    <xsd:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#string">255</xsd:maxLength>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/end_position">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>end_position</rdfs:label>
    <skos:prefLabel>end_position</skos:prefLabel>
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</xsd:minInclusive>
    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2147483647</xsd:maxInclusive>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cis-regulatory module</rdfs:label>
    <skos:prefLabel>crm/crm_ID</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0001657"/>
  </rdf:Description>
</rdf:RDF>
