@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://bioinfo.vanderbilt.edu/AE/HACER/>
  a owl:Ontology ;
  rdfs:label "Human Active Cis-regulatory Elements database" .

crm a owl:Class ;
  skos:prefLabel "CRM" ;
  skos:definition "Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position" .

crm_ID a obo:OBI_0000073 ;
  rdfs:label "crm/crm_ID" ;
  rdfs:comment "Unique identifier for the cis-regulatory module" ;
  skos:prefLabel "crm#crm_ID#database_name" ;
  owl:equivalentClass <http://bioinfo.vanderbilt.edu/AE/HACER#crm_ID> .

chr_name a obo:OBI_0000074 ;
  rdfs:label "chr_name" ;
  skos:prefLabel "GRCh38" ;
  rdfs:comment "Genomic chromosome name (e.g. chr1)" .

start_position a xsd:int ;
  rdfs:label "start_position" ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#crm> ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" .

end_position a xsd:int ;
  rdfs:label "end_position" ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#crm> ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" .

database_name a obo:OBI_0000075 ;
  rdfs:label "database_name" ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#crm> ;
  skos:prefLabel "Database" .

association a owl:ObjectProperty ;
  rdfs:label "Association between cis-regulatory module and gene/transcription factor/disease" ;
  owl:inverseOf <http://bioinfo.vanderbilt.edu/AE/HACER#target_gene_association> ;
  owl:inverseOf <http://bioinfo.vanderbilt.edu/AE/HACER#transcription_factor_association> ;
  owl:inverseOf <http://bioinfo.vanderbilt.edu/AE/HACER#disease_association> .

target_gene a obo:OBI_0000076 ;
  rdfs:label "Target gene" ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#association> ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" .

transcription_factor a obo:OBI_0000077 ;
  rdfs:label "Transcription factor" ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#association> ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" .

disease a obo:OBI_0000078 ;
  rdfs:label "Disease" ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#association> ;
  skos:prefLabel "bgw!crm_ID--doid!doid" .

gene_symbol a obo:OBI_0000079 ;
  rdfs:label "Gene symbol" ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#target_gene> ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_symbol#database_name" .

uniprot_ID a obo:OBI_0000080 ;
  rdfs:label "UniProt ID" ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#transcription_factor> ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID#database_name" .

doid a obo:OBI_0000081 ;
  rdfs:label "Disease Ontology ID" ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#disease> ;
  skos:prefLabel "bgw!crm_ID--doid!doid#database_name" .

crm_ID_transcription_factor_association a owl:ObjectProperty ;
  rdfs:label "Association between cis-regulatory module and transcription factor" ;
  owl:inverseOf <http://bioinfo.vanderbilt.edu/AE/HACER#transcription_factor> ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#crm_ID> .

crm_ID_disease_association a owl:ObjectProperty ;
  rdfs:label "Association between cis-regulatory module and disease" ;
  owl:inverseOf <http://bioinfo.vanderbilt.edu/AE/HACER#disease> ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#crm_ID> .

crm_ID_target_gene_association a owl:ObjectProperty ;
  rdfs:label "Association between cis-regulatory module and target gene" ;
  owl:inverseOf <http://bioinfo.vanderbilt.edu/AE/HACER#target_gene> ;
  owl:propertyOf <http://bioinfo.vanderbilt.edu/AE/HACER#crm_ID> .

transcription_factor a obo:OBI_0000077 ;
  rdfs:label "Transcription factor" ;
  owl:inverseOf <http://bioinfo.vanderbilt.edu/AE/HACER#crm_ID_transcription_factor_association> ;
  skos:prefLabel "bgw!crm_ID--uniprot!uniprot_ID" .

disease a obo:OBI_0000078 ;
  rdfs:label "Disease" ;
  owl:inverseOf <http://bioinfo.vanderbilt.edu/AE/HACER#crm_ID_disease_association> ;
  skos:prefLabel "bgw!crm_ID--doid!doid" .

target_gene a obo:OBI_0000076 ;
  rdfs:label "Target gene" ;
  owl:inverseOf <http://bioinfo.vanderbilt.edu/AE/HACER#crm_ID_target_gene_association> ;
  skos:prefLabel "bgw!crm_ID--hgncsymbol!9606/gene_sybmol" .