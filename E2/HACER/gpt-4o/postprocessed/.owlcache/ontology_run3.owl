<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/ontology/hasScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <skos:prefLabel>has score</skos:prefLabel>
    <skos:definition>Score indicating the confidence of the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasGenomicCoordinates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>has genomic coordinates</skos:prefLabel>
    <skos:definition>Genomic coordinates of the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>HACER Ontology</rdfs:label>
    <rdfs:comment>Ontology for the Human Active Cis-regulatory Elements database</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/interactsWithTF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/TranscriptionFactor"/>
    <skos:prefLabel>interacts with transcription factor</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and transcription factor</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasMinimumRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <skos:prefLabel>has minimum ratio</skos:prefLabel>
    <skos:definition>Minimum ratio for the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Disease"/>
    <skos:prefLabel>associated with disease</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and disease</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/activeInCellLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/CellLine"/>
    <skos:prefLabel>active in cell line</skos:prefLabel>
    <skos:definition>Cis-regulatory module activity in specific cell line</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cis-regulatory Module</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Gene"/>
    <skos:prefLabel>has target gene</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and target gene</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasExperimentalEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>has experimental evidence</skos:prefLabel>
    <skos:definition>Experimental evidence supporting the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gene</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/HACER">
    <rdf:type rdf:resource="http://example.org/ontology/Database"/>
    <skos:prefLabel>HACER</skos:prefLabel>
    <skos:definition>Human Active Cis-regulatory Elements database</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/GRCh38">
    <rdf:type rdf:resource="http://example.org/ontology/GenomeAssembly"/>
    <skos:prefLabel>GRCh38</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Disease</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CellLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cell Line</skos:prefLabel>
  </rdf:Description>
</rdf:RDF>
