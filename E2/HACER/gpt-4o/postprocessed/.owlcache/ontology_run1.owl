<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/interactsWithTF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/TranscriptionFactor"/>
    <skos:prefLabel>interacts with transcription factor</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and transcription factor</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0002437"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/hasExperimentalEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>has experimental evidence</skos:prefLabel>
    <skos:definition>Experimental evidence supporting the activity of the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/Gene"/>
    <skos:prefLabel>has target gene</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and its target gene</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0002436"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/activeInCellLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>active in cell line</skos:prefLabel>
    <skos:definition>Cell line in which the cis-regulatory module is active</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/Disease"/>
    <skos:prefLabel>associated with disease</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and disease</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0002458"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/hasGenomicCoordinates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>has genomic coordinates</skos:prefLabel>
    <skos:definition>Genomic coordinates of the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>CRM</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000165"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Disease</skos:prefLabel>
    <skos:definition>A disorder of structure or function in a human, animal, or plant, especially one that produces specific symptoms</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
    <skos:definition>Protein that binds to specific DNA sequences, thereby controlling the rate of transcription</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/GO_0003700"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <skos:prefLabel>HACER Ontology</skos:prefLabel>
    <skos:definition>Ontology for the Human Active Cis-regulatory Elements database</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gene</skos:prefLabel>
    <skos:definition>A gene is a sequence of nucleotides in DNA or RNA that encodes the synthesis of a gene product, either RNA or protein</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/SO_0000704"/>
  </rdf:Description>
</rdf:RDF>
