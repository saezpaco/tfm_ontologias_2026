<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/interactsWithTF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/TranscriptionFactor"/>
    <skos:prefLabel>bgw!crm_ID--uniprot!uniprot_ID</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and transcription factor uniprot_ID</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/Gene"/>
    <skos:prefLabel>bgw!crm_ID--hgncsymbol!9606/gene_symbol</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and gene gene_symbol</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/Disease"/>
    <skos:prefLabel>bgw!crm_ID--doid!doid</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module crm_ID and disease DOID:doid</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/hasGenomicCoordinates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>chr_name</skos:prefLabel>
    <skos:definition>Genomic coordinates of the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/hasScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <skos:prefLabel>score</skos:prefLabel>
    <skos:definition>Score of the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>HACER Ontology</rdfs:label>
    <skos:prefLabel>HACER</skos:prefLabel>
    <skos:definition>Human Active Cis-regulatory Elements database</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Disease</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>CRM</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/hasBiosampleName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>biosample_name</skos:prefLabel>
    <skos:definition>Name of the biosample where the CRM is active</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/hasMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://bioinfo.vanderbilt.edu/AE/HACER/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>enh_method</skos:prefLabel>
    <skos:definition>Method used to identify the CRM</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gene</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://bioinfo.vanderbilt.edu/AE/HACER/Database">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Database</skos:prefLabel>
  </rdf:Description>
</rdf:RDF>
