<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/ChrName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Chromosome name</rdfs:label>
    <skos:prefLabel>chr_name</skos:prefLabel>
    <skos:definition>Chromosome name of the cis-regulatory module.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/Chr">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Chromosome</rdfs:label>
    <skos:prefLabel>chr_name</skos:prefLabel>
    <skos:definition>Chromosome where the cis-regulatory module is located.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/DatabaseName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Database name</rdfs:label>
    <skos:prefLabel>database_name</skos:prefLabel>
    <skos:definition>Database name where the cis-regulatory module is located.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/CrmTranscriptionFactorAssociation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Cis-regulatory module transcription factor association</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--uniprot!uniprot_ID</skos:prefLabel>
    <skos:definition>Association between the cis-regulatory module and the transcription factor.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/EndPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>End position</rdfs:label>
    <skos:prefLabel>end_position</skos:prefLabel>
    <skos:definition>End position of the cis-regulatory module.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/GeneSymbol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Gene symbol</rdfs:label>
    <skos:prefLabel>gene_symbol</skos:prefLabel>
    <skos:definition>Gene symbol associated with the cis-regulatory module.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/CrmDatabaseAssociation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Cis-regulatory module database association</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--database_name</skos:prefLabel>
    <skos:definition>Association between the cis-regulatory module and the database.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/Assembly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Genomic assembly</rdfs:label>
    <skos:prefLabel>assembly</skos:prefLabel>
    <skos:definition>Genomic assembly of the cis-regulatory module.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/CrmDiseaseAssociation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Cis-regulatory module disease association</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--doid!doid</skos:prefLabel>
    <skos:definition>Association between the cis-regulatory module and the disease.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/CrmGeneAssociation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Cis-regulatory module gene association</rdfs:label>
    <skos:prefLabel>bgw!crm_ID--hgncsymbol!9606/gene_symbol</skos:prefLabel>
    <skos:definition>Association between the cis-regulatory module and the gene.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Disease</rdfs:label>
    <skos:prefLabel>disease</skos:prefLabel>
    <skos:definition>Disease associated with the cis-regulatory module.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://biocc.hrbmu.edu.cn/DiseaseEnhancer/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>DiseaseEnhancer Ontology</rdfs:label>
    <skos:prefLabel>DiseaseEnhancer Ontology</skos:prefLabel>
    <skos:definition>Ontology for enhancers associated with diseases.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Transcription factor</rdfs:label>
    <skos:prefLabel>transcription_factor</skos:prefLabel>
    <skos:definition>Transcription factor associated with the cis-regulatory module.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/CrmId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Cis-regulatory module ID</rdfs:label>
    <skos:prefLabel>crm_ID</skos:prefLabel>
    <skos:definition>Unique identifier of the cis-regulatory module.</skos:definition>
    <rdfs:domain rdf:resource="http://rdf.biogateway.eu/crm/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/StartPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Start position</rdfs:label>
    <skos:prefLabel>start_position</skos:prefLabel>
    <skos:definition>Start position of the cis-regulatory module.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf.biogateway.eu/crm/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cis-regulatory module</rdfs:label>
    <skos:prefLabel>CRM</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens chr_name between start_position and end_position.</skos:definition>
  </rdf:Description>
</rdf:RDF>
