@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://biocc.hrbmu.edu.cn/DiseaseEnhancer/> rdf:type owl:Ontology ;
    rdfs:label "DiseaseEnhancer Ontology" ;
    skos:prefLabel "DiseaseEnhancer" ;
    skos:definition "Ontology for enhancers associated with diseases" .

### Classes ###
:CRM rdf:type owl:Class ;
    skos:prefLabel "Cis-regulatory module" ;
    skos:definition "Cis-regulatory module located in Homo sapiens" .

:Gene rdf:type owl:Class ;
    skos:prefLabel "Gene" ;
    skos:definition "A gene that is a target of a cis-regulatory module" .

:Disease rdf:type owl:Class ;
    skos:prefLabel "Disease" ;
    skos:definition "A disease associated with a cis-regulatory module" .

:TranscriptionFactor rdf:type owl:Class ;
    skos:prefLabel "Transcription Factor" ;
    skos:definition "A transcription factor interacting with a cis-regulatory module" .

### Object Properties ###
:hasTargetGene rdf:type owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :Gene ;
    skos:prefLabel "has target gene" ;
    skos:definition "Association between cis-regulatory module and its target gene" .

:associatedWithDisease rdf:type owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :Disease ;
    skos:prefLabel "associated with disease" ;
    skos:definition "Association between cis-regulatory module and a disease" .

:interactsWithTF rdf:type owl:ObjectProperty ;
    rdfs:domain :CRM ;
    rdfs:range :TranscriptionFactor ;
    skos:prefLabel "interacts with transcription factor" ;
    skos:definition "Association between cis-regulatory module and a transcription factor" .

### Datatype Properties ###
:hasGenomicCoordinates rdf:type owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:string ;
    skos:prefLabel "has genomic coordinates" ;
    skos:definition "Genomic coordinates of the cis-regulatory module" .

:hasScore rdf:type owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:float ;
    skos:prefLabel "has score" ;
    skos:definition "Score indicating the confidence of the cis-regulatory module" .

:hasMinimumRatio rdf:type owl:DatatypeProperty ;
    rdfs:domain :CRM ;
    rdfs:range xsd:float ;
    skos:prefLabel "has minimum ratio" ;
    skos:definition "Minimum ratio of the cis-regulatory module activity" .

### Instances ###
:CRMHS00000001594 rdf:type :CRM ;
    :hasGenomicCoordinates "chr5:125315470-125318494" ;
    :hasScore 1.0 ;
    :hasMinimumRatio 0.95 ;
    :hasTargetGene :LMNB1 ;
    :associatedWithDisease obo:OMIM_169500 .

:LMNB1 rdf:type :Gene ;
    skos:prefLabel "LMNB1" .

obo:OMIM_169500 rdf:type :Disease ;
    skos:prefLabel "Leukodystrophy, autosomal dominant, adult-onset" .

### Additional Instances and Relationships can be added similarly ###