<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns="http://example.org/ontology/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OMIM_169500">
    <rdf:type rdf:resource="http://example.org/ontology/Disease"/>
    <skos:prefLabel>Leukodystrophy, autosomal dominant, adult-onset</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <skos:prefLabel>has score</skos:prefLabel>
    <skos:definition>Score indicating the confidence of the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasGenomicCoordinates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel>has genomic coordinates</skos:prefLabel>
    <skos:definition>Genomic coordinates of the cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasMinimumRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <skos:prefLabel>has minimum ratio</skos:prefLabel>
    <skos:definition>Minimum ratio of the cis-regulatory module activity</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CRMHS00000001594">
    <rdf:type rdf:resource="http://example.org/ontology/CRM"/>
    <hasGenomicCoordinates>chr5:125315470-125318494</hasGenomicCoordinates>
    <hasScore rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</hasScore>
    <hasMinimumRatio rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.95</hasMinimumRatio>
    <hasTargetGene rdf:resource="http://example.org/ontology/LMNB1"/>
    <associatedWithDisease rdf:resource="http://purl.obolibrary.org/obo/OMIM_169500"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/associatedWithDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Disease"/>
    <skos:prefLabel>associated with disease</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and a disease</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/interactsWithTF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/TranscriptionFactor"/>
    <skos:prefLabel>interacts with transcription factor</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and a transcription factor</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/hasTargetGene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/CRM"/>
    <rdfs:range rdf:resource="http://example.org/ontology/Gene"/>
    <skos:prefLabel>has target gene</skos:prefLabel>
    <skos:definition>Association between cis-regulatory module and its target gene</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/TranscriptionFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transcription Factor</skos:prefLabel>
    <skos:definition>A transcription factor interacting with a cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Disease</skos:prefLabel>
    <skos:definition>A disease associated with a cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gene</skos:prefLabel>
    <skos:definition>A gene that is a target of a cis-regulatory module</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/LMNB1">
    <rdf:type rdf:resource="http://example.org/ontology/Gene"/>
    <skos:prefLabel>LMNB1</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://biocc.hrbmu.edu.cn/DiseaseEnhancer/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>DiseaseEnhancer Ontology</rdfs:label>
    <skos:prefLabel>DiseaseEnhancer</skos:prefLabel>
    <skos:definition>Ontology for enhancers associated with diseases</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Cis-regulatory module</skos:prefLabel>
    <skos:definition>Cis-regulatory module located in Homo sapiens</skos:definition>
  </rdf:Description>
</rdf:RDF>
