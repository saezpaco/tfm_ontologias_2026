@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/ontology#>
  a owl:Ontology;

  rdfs:comment "Genetic Regulatory Elements Ontology" ;
  skos:description "This ontology describes the relationships between genetic regulatory elements, including enhancers, super-enhancers, chromatin modification regions, genes, transcription factors, disease associations, mutations, and genomic coordinates." .

<http://example.org/ontology#class_entity>
  a owl:Class;
  rdfs:label "Entity" ;
  skos:description "A general class for entities in the ontology"^^xsd:string.

<http://example.org/ontology#entity_name>
  a owl:Class;
  rdfs:subClassOf <http://example.org/ontology#class_entity> ;
  rdfs:label "Entity Name" ;
  skos:description "An entity with a name"^^xsd:string.

<http://example.org/ontology#enhancer>
  a owl:Class;
  rdfs:subClassOf <http://example.org/ontology#entity_name> ;
  rdfs:label "Enhancer" ;
  skos:description "A type of genetic regulatory element that enhances gene expression"^^xsd:string.

<http://example.org/ontology#super_enhancer>
  a owl:Class;
  rdfs:subClassOf <http://example.org/ontology#entity_name> ;
  rdfs:label "Super-Enhancer" ;
  skos:description "A type of genetic regulatory element that has a higher level of enhancer activity than regular enhancers"^^xsd:string.

<http://example.org/ontology#chromatin_modification_region>
  a owl:Class;
  rdfs:subClassOf <http://example.org/ontology#entity_name> ;
  rdfs:label "Chromatin Modification Region" ;
  skos:description "A region of the genome where chromatin modification occurs"^^xsd:string.

<http://example.org/ontology#gene>
  a owl:Class;
  rdfs:subClassOf <http://example.org/ontology#entity_name> ;
  rdfs:label "Gene" ;
  skos:description "A unit of heredity that is passed from one generation to the next"^^xsd:string.

<http://example.org/ontology#transcription_factor>
  a owl:Class;
  rdfs:subClassOf <http://example.org/ontology#entity_name> ;
  rdfs:label "Transcription Factor" ;
  skos:description "A protein that binds to specific DNA sequences and regulates gene expression"^^xsd:string.

<http://example.org/ontology#disease_association>
  a owl:Class;
  rdfs:subClassOf <http://example.org/ontology#entity_name> ;
  rdfs:label "Disease Association" ;
  skos:description "A relationship between a genetic regulatory element and a disease"^^xsd:string.

<http://example.org/ontology#mutation>
  a owl:Class;
  rdfs:subClassOf <http://example.org/ontology#entity_name> ;
  rdfs:label "Mutation" ;
  skos:description "A change in the DNA sequence of an organism"^^xsd:string.

<http://example.org/ontology#genomic_coordinate>
  a owl:Class;
  rdfs:subClassOf <http://example.org/ontology#entity_name> ;
  rdfs:label "Genomic Coordinate" ;
  skos:description "A location on the genome where a genetic regulatory element is located"^^xsd:string.

<http://example.org/ontology#biosample>
  a owl:Class;
  rdfs:subClassOf <http://example.org/ontology#entity_name> ;
  rdfs:label "Biosample" ;
  skos:description "A sample of biological material used in research"^^xsd:string.

<http://example.org/ontology#has_PMID>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:string> ;
  rdfs:label "Has PubMed ID" ;
  skos:description "A property that relates an entity to its corresponding PubMed ID"^^xsd:string.

<http://example.org/ontology#has_method>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:string> ;
  rdfs:label "Has Method" ;
  skos:description "A property that relates an entity to the method used to identify it"^^xsd:string.

<http://example.org/ontology#is_target_of>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#gene> ;
  rdfs:range <http://example.org/ontology#transcription_factor> ;
  rdfs:label "Is Target Of" ;
  skos:description "A property that relates a gene to the transcription factor it is targeted by"^^xsd:string.

<http://example.org/ontology#is_associated_with>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#disease_association> ;
  rdfs:range <http://example.org/ontology#disease> ;
  rdfs:label "Is Associated With" ;
  skos:description "A property that relates a disease association to the disease it is associated with"^^xsd:string.

<http://example.org/ontology#has_score>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:float> ;
  rdfs:label "Has Score" ;
  skos:description "A property that relates an entity to its corresponding score"^^xsd:string.

<http://example.org/ontology#has_source>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:string> ;
  rdfs:label "Has Source" ;
  skos:description "A property that relates an entity to its corresponding source"^^xsd:string.

<http://example.org/ontology#has_type>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:string> ;
  rdfs:label "Has Type" ;
  skos:description "A property that relates an entity to its corresponding type"^^xsd:string.

<http://example.org/ontology#has_coordinates>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#genomic_coordinate> ;
  rdfs:range <xsd:int> ;
  rdfs:label "Has Coordinates" ;
  skos:description "A property that relates a genomic coordinate to its corresponding coordinates"^^xsd:string.

<http://example.org/ontology#is_part_of>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#chromatin_modification_region> ;
  rdfs:range <http://example.org/ontology#enhancer> ;
  rdfs:label "Is Part Of" ;
  skos:description "A property that relates a chromatin modification region to the enhancer it is part of"^^xsd:string.

<http://example.org/ontology#has_refSNP_ID>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:string> ;
  rdfs:label "Has RefSNP ID" ;
  skos:description "A property that relates an entity to its corresponding RefSNP ID"^^xsd:string.

<http://example.org/ontology#has_PMID>
  a owl:DatatypeProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:string> ;
  rdfs:label "Has PubMed ID" ;
  skos:description "A property that relates an entity to its corresponding PubMed ID"^^xsd:string.

<http://example.org/ontology#has_method>
  a owl:DatatypeProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:string> ;
  rdfs:label "Has Method" ;
  skos:description "A property that relates an entity to the method used to identify it"^^xsd:string.

<http://example.org/ontology#is_target_of>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#gene> ;
  rdfs:range <http://example.org/ontology#transcription_factor> ;
  rdfs:label "Is Target Of" ;
  skos:description "A property that relates a gene to the transcription factor it is targeted by"^^xsd:string.

<http://example.org/ontology#is_associated_with>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#disease_association> ;
  rdfs:range <http://example.org/ontology#disease> ;
  rdfs:label "Is Associated With" ;
  skos:description "A property that relates a disease association to the disease it is associated with"^^xsd:string.

<http://example.org/ontology#has_score>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:float> ;
  rdfs:label "Has Score" ;
  skos:description "A property that relates an entity to its corresponding score"^^xsd:string.

<http://example.org/ontology#has_source>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:string> ;
  rdfs:label "Has Source" ;
  skos:description "A property that relates an entity to its corresponding source"^^xsd:string.

<http://example.org/ontology#has_type>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:string> ;
  rdfs:label "Has Type" ;
  skos:description "A property that relates an entity to its corresponding type"^^xsd:string.

<http://example.org/ontology#has_coordinates>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#genomic_coordinate> ;
  rdfs:range <xsd:int> ;
  rdfs:label "Has Coordinates" ;
  skos:description "A property that relates a genomic coordinate to its corresponding coordinates"^^xsd:string.

<http://example.org/ontology#is_part_of>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#chromatin_modification_region> ;
  rdfs:range <http://example.org/ontology#enhancer> ;
  rdfs:label "Is Part Of" ;
  skos:description "A property that relates a chromatin modification region to the enhancer it is part of"^^xsd:string.

<http://example.org/ontology#has_refSNP_ID>
  a owl:ObjectProperty;
  rdfs:domain <http://example.org/ontology#class_entity> ;
  rdfs:range <xsd:string> ;
  rdfs:label "Has RefSNP ID" ;
  skos:description "A property that relates an entity to its corresponding RefSNP ID"^^xsd:string.