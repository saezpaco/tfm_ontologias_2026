@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix base_ontology: <https://base_ontology.com#> .

<owl:Ontology rdf:about="">

  <!-- Classes -->
  <owl:Class rdf:ID="class_entity">
    <rdfs:label xml:lang="en">Class Entity</rdfs:label>
    <skos:definition xml:lang="en">A class entity is a general concept that can be instantiated.</skos:definition>
  </owl:Class>

  <owl:Class rdf:ID="entity_name">
    <rdfs:subClassOf rdf:resource="#class_entity"/>
    <rdfs:label xml:lang="en">Entity Name</rdfs:label>
    <skos:definition xml:lang="en">An entity name is a specific instance of a class entity.</skos:definition>
  </owl:Class>

  <owl:Class rdf:ID="enhancer">
    <rdfs:subClassOf rdf:resource="#class_entity"/>
    <rdfs:label xml:lang="en">Enhancer</rdfs:label>
    <skos:definition xml:lang="en">An enhancer is a specific type of class entity that regulates gene expression.</skos:definition>
  </owl:Class>

  <owl:Class rdf:ID="super_enhancer">
    <rdfs:subClassOf rdf:resource="#enhancer"/>
    <rdfs:label xml:lang="en">Super Enhancer</rdfs:label>
    <skos:definition xml:lang="en">A super enhancer is a specific type of enhancer that has a higher regulatory activity.</skos:definition>
  </owl:Class>

  <owl:Class rdf:ID="chromatin_modification_region">
    <rdfs:subClassOf rdf:resource="#class_entity"/>
    <rdfs:label xml:lang="en">Chromatin Modification Region</rdfs:label>
    <skos:definition xml:lang="en">A chromatin modification region is a specific type of class entity that regulates gene expression through chromatin modifications.</skos:definition>
  </owl:Class>

  <owl:Class rdf:ID="cell_line">
    <rdfs:subClassOf rdf:resource="#class_entity"/>
    <rdfs:label xml:lang="en">Cell Line</rdfs:label>
    <skos:definition xml:lang="en">A cell line is a specific type of class entity that represents a cultured cell population.</skos:definition>
  </owl:Class>

  <owl:Class rdf:ID="biosample">
    <rdfs:subClassOf rdf:resource="#class_entity"/>
    <rdfs:label xml:lang="en">Biosample</rdfs:label>
    <skos:definition xml:lang="en">A biosample is a specific type of class entity that represents a biological sample.</skos:definition>
  </owl:Class>

  <owl:Class rdf:ID="target_gene">
    <rdfs:subClassOf rdf:resource="#class_entity"/>
    <rdfs:label xml:lang="en">Target Gene</rdfs:label>
    <skos:definition xml:lang="en">A target gene is a specific type of class entity that represents the gene being regulated by an enhancer.</skos:definition>
  </owl:Class>

  <owl:Class rdf:ID="transcription_factor">
    <rdfs:subClassOf rdf:resource="#class_entity"/>
    <rdfs:label xml:lang="en">Transcription Factor</rdfs:label>
    <skos:definition xml:lang="en">A transcription factor is a specific type of class entity that regulates gene expression by binding to DNA.</skos:definition>
  </owl:Class>

  <owl:Class rdf:ID="disease_association">
    <rdfs:subClassOf rdf:resource="#class_entity"/>
    <rdfs:label xml:lang="en">Disease Association</rdfs:label>
    <skos:definition xml:lang="en">A disease association is a specific type of class entity that represents the relationship between an enhancer and a disease.</skos:definition>
  </owl:Class>

  <owl:Class rdf:ID="mutation">
    <rdfs:subClassOf rdf:resource="#class_entity"/>
    <rdfs:label xml:lang="en">Mutation</rdfs:label>
    <skos:definition xml:lang="en">A mutation is a specific type of class entity that represents a change in the DNA sequence.</skos:definition>
  </owl:Class>

  <!-- Object Properties -->
  <owl:ObjectProperty rdf:ID="has_PMID">
    <rdfs:label xml:lang="en">Has PubMed ID</rdfs:label>
    <skos:definition xml:lang="en">The property that relates an enhancer to its corresponding PubMed ID.</skos:definition>
    <rdfs:domain rdf:resource="#enhancer"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="is_associated_with">
    <rdfs:label xml:lang="en">Is Associated With</rdfs:label>
    <skos:definition xml:lang="en">The property that relates an enhancer to its corresponding target gene.</skos:definition>
    <rdfs:domain rdf:resource="#enhancer"/>
    <rdfs:range rdf:resource="#target_gene"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="has_method">
    <rdfs:label xml:lang="en">Has Method</rdfs:label>
    <skos:definition xml:lang="en">The property that relates an enhancer to its corresponding method.</skos:definition>
    <rdfs:domain rdf:resource="#enhancer"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="has_chromatin_modification_region">
    <rdfs:label xml:lang="en">Has Chromatin Modification Region</rdfs:label>
    <skos:definition xml:lang="en">The property that relates a chromatin modification region to its corresponding enhancer.</skos:definition>
    <rdfs:domain rdf:resource="#chromatin_modification_region"/>
    <rdfs:range rdf:resource="#enhancer"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="has_cell_line">
    <rdfs:label xml:lang="en">Has Cell Line</rdfs:label>
    <skos:definition xml:lang="en">The property that relates a cell line to its corresponding biosample.</skos:definition>
    <rdfs:domain rdf:resource="#cell_line"/>
    <rdfs:range rdf:resource="#biosample"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="has_transcription_factor">
    <rdfs:label xml:lang="en">Has Transcription Factor</rdfs:label>
    <skos:definition xml:lang="en">The property that relates a transcription factor to its corresponding enhancer.</skos:definition>
    <rdfs:domain rdf:resource="#transcription_factor"/>
    <rdfs:range rdf:resource="#enhancer"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="is_disease_associated_with">
    <rdfs:label xml:lang="en">Is Disease Associated With</rdfs:label>
    <skos:definition xml:lang="en">The property that relates a disease association to its corresponding enhancer.</skos:definition>
    <rdfs:domain rdf:resource="#disease_association"/>
    <rdfs:range rdf:resource="#enhancer"/>
  </owl:ObjectProperty>

  <!-- Data Properties -->
  <owl:DatatypeProperty rdf:ID="has_PMID_value">
    <rdfs:label xml:lang="en">Has PubMed ID Value</rdfs:label>
    <skos:definition xml:lang="en">The property that relates an enhancer to its corresponding PubMed ID value.</skos:definition>
    <rdfs:domain rdf:resource="#enhancer"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="has_method_name">
    <rdfs:label xml:lang="en">Has Method Name</rdfs:label>
    <skos:definition xml:lang="en">The property that relates an enhancer to its corresponding method name.</skos:definition>
    <rdfs:domain rdf:resource="#enhancer"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="has_chromatin_modification_region_ID">
    <rdfs:label xml:lang="en">Has Chromatin Modification Region ID</rdfs:label>
    <skos:definition xml:lang="en">The property that relates a chromatin modification region to its corresponding ID.</skos:definition>
    <rdfs:domain rdf:resource="#chromatin_modification_region"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="has_cell_line_name">
    <rdfs:label xml:lang="en">Has Cell Line Name</rdfs:label>
    <skos:definition xml:lang="en">The property that relates a cell line to its corresponding name.</skos:definition>
    <rdfs:domain rdf:resource="#cell_line"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="has_transcription_factor_HGNC_symbol">
    <rdfs:label xml:lang="en">Has Transcription Factor HGNC Symbol</rdfs:label>
    <skos:definition xml:lang="en">The property that relates a transcription factor to its corresponding HGNC symbol.</skos:definition>
    <rdfs:domain rdf:resource="#transcription_factor"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:ID="has_disease_association_name">
    <rdfs:label xml:lang="en">Has Disease Association Name</rdfs:label>
    <skos:definition xml:lang="en">The property that relates a disease association to its corresponding name.</skos:definition>
    <rdfs:domain rdf:resource="#disease_association"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:DatatypeProperty>

  <!-- Class Inclusions -->
  <rdf:type rdf:resource="#enhancer" rdf:resource="#super_enhancer"/>

</rdf:RDF>